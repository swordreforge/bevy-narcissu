args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，过了一会儿她就一直叫着我的名字。\n她微微地睁开双眼，无力地叫着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「T同学…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "再叫我一次吧，就一遍，只要再叫一遍……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "真的就只要再叫一遍……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她露出了，那张一如往常的羞涩笑脸。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "于是，我用力地握住了S美的手。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知为何，就是想这么做。\n只是觉得绝对不能松开。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "片刻后。\n我反应过来时S美已经没有了呼吸。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00171",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这时候，我才明白S美已经死去的事实。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00172",
),
),
(
cmd: set_bg,
args: (
image: "ato_w",
transition: Some(fade(
duration: 0.8,
)),
),
),
