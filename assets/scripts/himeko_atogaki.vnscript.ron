),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "月末的晚上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我又一次拜托之前的伙伴，借来了车子。\n只是这回没有司机，只有一辆破车。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "顺理成章的，我无证驾驶。\n我还没有到考驾照的年龄。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "S美和M也坐了上来，我不太习惯地踩着车子的离合，在深夜里驾驶着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们的目的地是，离这里不远的N海滩。\n开车的话只要15分钟就到了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: set_bg,
args: (
image: "ato_09",
transition: Some(fade(
duration: 0.8,
)),
),
),
