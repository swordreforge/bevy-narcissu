args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "7月。\n那年是个盛夏。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00095",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然我们用用电扇就好，但还是会担心这样会影响S美的身体。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00096",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，没关系的」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00097",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如同往常一样笑着回答的S美。\n在我们看来，却显得更加悲哀。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00098",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "连空调都没有，还是孩子的我们为自己的无力感到悔恨。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00099",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "想要能早点变成大人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00100",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "第二天，我硬是用螺丝刀和扳手，把自己房间里的空调卸了下来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00101",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为之前经常搬家已经是见怪不怪了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00102",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "之后和M两人一起\n把非常重的空调外机搬上4楼，总算给S美的房间装上了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00103",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "制冷剂也漏了不少，制冷也只能算是有点。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00104",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哇啊，好凉快～」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00105",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然而，她依旧笑着这么说道。\n非常的开心。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00106",
),
),
(
cmd: set_bg,
args: (
image: "ato_b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
