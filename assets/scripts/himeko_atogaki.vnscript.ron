),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一天晚上，吹着破破烂烂的空调，\n我们三个人制定了一个作战计划。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然花了很长时间说了各种各样的话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，最终……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们决定去S美想要去的地方。\n做S美想要做的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "仅此而已。\n这些完全是小孩子的想法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
