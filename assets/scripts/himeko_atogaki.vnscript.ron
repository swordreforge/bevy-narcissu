),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那一夜，M找了我谈话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00049",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "总之，现在的生活费很窘迫。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对我们这些一开始就不依靠亲人的人来说，M的话是软弱的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00051",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不想就这样待在家里」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00052",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，听了他的话之后，我有多少理解了他的想法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00053",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说是不想待在家里，我想肯定是因为他要片刻不停地照顾妹妹。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00054",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹妹才刚出院，这个是可以想得到的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00055",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，如果一直在家的话，就没有办法去挣生活费了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00056",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从来都是自力更生的M，在这个问题上很有说服力。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00057",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "第二天，我把我自己的零钱攒起来，准备了7万元给他。\nM很高兴。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00058",
),
),
(
cmd: set_bg,
args: (
image: "ato_01",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
