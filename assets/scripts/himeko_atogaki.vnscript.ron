),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "到了海边之后。\n在无人的沙滩上，我们放起了烟火。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "把堆成山一样的火箭和喷火烟花，当成篝火一样点起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在章鱼形状的大滑梯里面玩着。\n我和M还互相拿烟花对射。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "手上虽然满是火药的臭味，但S美仍开心的笑着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后三个人，坐在沙滩上喝起了饮料。\n我和M是罐装可乐，那天S美也要了橙汁。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "阵阵的波浪声混着湿润的海风。\n仰望着夜空，夏日的星座闪闪发光。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "波浪拍打岸边时的白色泡沫，到处留下蜿蜒的痕迹。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "谁也没有说话，三个人就这么眺望着……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
(
cmd: set_bg,
args: (
image: "ato_b",
transition: Some(fade(
duration: 0.8,
)),
),
),
