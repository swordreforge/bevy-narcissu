args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她叫了我的名字。她握住我的手是那么温暖。\n她喜欢喝橙汁。她最后朝我笑了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00173",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就这样S美消失了。\n但她却在我的故事里留下了深深的印记。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00174",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…国道延伸，沿线的游戏屋不断地建起，校园暴力之类的词语开始流行起来…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00175",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "1980\u{3000}少年时代的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00176",
),
),
(
cmd: set_bg,
args: (
image: "ato_01",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
