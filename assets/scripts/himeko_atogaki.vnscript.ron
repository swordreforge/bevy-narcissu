),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "5月。\n跟我关系非常好的朋友M……给我打来了电话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "姑且算是一个非常麻烦的事情吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那个时候，由于M一周都没来上学，我多多少少有点担心他的情况。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然我不知道自己能不能应对这件事，总之和他谈谈看看吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「老爸不回来了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "M一张口，说出了这样的话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "本来，M的家庭里没有母亲，接受生活保障的状态。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以M，从一开始没有依赖亲人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "经常和他一起到弹珠店里面玩，也知道他还在打工。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我觉得我们肯定是特殊的，毕竟在我的伙伴中，无人依赖亲人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以一个小孩的方式独立地生活着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: set_bg,
args: (
image: "ato_06",
transition: Some(fade(
duration: 0.8,
)),
),
),
