),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "9月。\n空气中还残留着热气，S美第三次出院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们都很高兴。\n本来还担心，再也用不着出院了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是恐怕，再也无法回到医院了。\nM这么说道。我也是相同的想法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "依旧是从同伴那里借了辆小四轮回家，两个人把S美抱上了4楼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00138",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "感觉的S美比之前又轻了不少，再次悲伤了起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那段时间里，学校的老师，志愿者还有帮忙的人，偶尔会来看望一下。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不多，但让我知道了还是有好心的大人的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: set_bg,
args: (
image: "ato_b",
transition: Some(fade(
duration: 0.8,
)),
),
),
