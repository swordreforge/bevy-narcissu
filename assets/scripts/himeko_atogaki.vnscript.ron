args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "无聊的，暧昧的，冷静的，无情的现实。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不像电视剧和电影那样充满戏剧感，察觉不到变化的，单调无趣的每一天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明没有什么值得期待的行程，却又数着手指盼着周末的每一天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "轻视着无聊的日常，寻求着假想的刺激，探索者自己的容身之地，\n竖立着只属于自己的价值观，总是想要将自己处于安全范围之内的世界。",
voice: None,
),
),
(
