),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "8月。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00110",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "S美第三次入院了。\n这次也是乘的急救车。我当时没在。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00111",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "之后在候诊室和M谈了一会。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00112",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "爸爸不在，也没有其他亲戚，说不定M已经听说了医生的话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00113",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "总之好像是没有使用特效抗癌药的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00114",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "由于没有成年血亲家属在，说不定医生也很难判断要如何医治。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00115",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我想，这大概是最后一次了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00116",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "M这么自言自语道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00117",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那家伙所说的“最后”，肯定是，S美以后再也回不了家了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00118",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "或者是，就算能够回家，也再也无法回到这个病房了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00119",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "白色的墙壁，简陋的折叠椅，身形高大的M就缩着身子，坐在那个椅子上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00120",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "和之前一样带着氧气面罩的S美，偶尔也会注意到我，眯起眼睛朝我笑。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00121",
),
),
