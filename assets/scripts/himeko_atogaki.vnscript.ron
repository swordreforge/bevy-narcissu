),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "2周之后。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00088",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "S美酱…不，这时候应该叫S美。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00089",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "已经是第二次从临终疗养院出院了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00090",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "入院的时候乘的是救护车，出院的时候却没有。\n我们也没有多余的钱去坐的士。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00091",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以只能再次拜托伙伴，借了一个破烂小四轮回家。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00092",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，我和M两个人一起，把她轻轻地抱上了位于住宅区4楼的家。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00093",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看上去就很瘦的S美抱起来也很轻。\n这是多么令人感到悲哀的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00094",
),
),
(
cmd: set_bg,
args: (
image: "ato_08",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
