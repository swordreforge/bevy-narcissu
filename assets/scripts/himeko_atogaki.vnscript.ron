),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "第二天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00076",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我和M，两个人发誓要一起合作。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00077",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我晚上在工地埋土，白天M就在附近的游戏厅打工。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00078",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然大家在打工之前，都隐瞒了自己的年龄。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00079",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "两个人只要有空，就会去医院，这个是一个尽量不让S美酱独自一人的作战。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00080",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即使这样，我也会偶尔去一下学校，但M则完全没有。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00081",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知道去了哪儿的M的老爸，完全没有回来的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00082",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "于是，空闲的时候我和M轮流出现在病房中。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00083",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "每日每日，坐在简陋的折叠椅上，面对着白墙，和S美酱聊着各种各样的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00084",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然普通病房还有探病时间限制，但临终疗养院，却随时可以。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00085",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我喜欢的时间，是早上体温检测之后的8点左右。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00086",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我喜欢6月清爽的阳光，还有她高兴的，浅浅的，有些含羞的笑容。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00087",
),
),
(
