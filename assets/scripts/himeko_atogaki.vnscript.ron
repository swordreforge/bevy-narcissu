),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―星期二\u{3000}凌晨2点―",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那天我也住在M家。\nM就躺在里面。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00161",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "他一直在照顾着S美，没有好好休息过。\n所以轮到我起来照顾S美了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00162",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "想着S美应该是渴了我拿了点冰水给她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00163",
),
),
(
cmd: set_bg,
args: (
image: "ato_04",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
