),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "6月。\nS美酱又一次入院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00059",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "救护车来的时候。\n我也坐了上去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00060",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那个时候，M才第一次详细地告诉了我S美酱的病情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00061",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "其实S美酱住的，不是普通的病房，是临终关怀疗养院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00062",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "好像M的亲人还在的时候就已经是这个样子了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00063",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而起，他还告诉我虽然已经将胃整个摘除，\n但是已经转移到了其他部位，已经没有什么办法了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00064",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，S美酱才不住在普通病房，而是临终关怀疗养院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00065",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她的症状稳定下来才可以回家，要是症状恶化的话，又要回到疗养院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00066",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这种来回往返…并不是说病情自身在好转。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00067",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不知道还能够往返家几次…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00068",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "M这么说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00069",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「S美酱，她本人知道么？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00070",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "M没有回答我的问题。\n可是，她本人也隐隐约约感觉到了吧，M补充道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00071",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我来到病房，S美酱就像是在电视上看到的那样，正带着氧气面罩。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00072",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她微微睁开了眼睛，发现是我，有点害羞地笑了起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00073",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…还好吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00074",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一成不变的问候。\n那时的我，除了这种话其他的已经说不出口了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00075",
),
),
(
cmd: set_bg,
args: (
image: "ato_02",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
