args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那天晚上，我们三个人，就在这不太好用的空调前庆祝七夕。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00107",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我和M拿着冰镇罐装可乐，S美喝着果汁。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00108",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然没有竹枝也没有许愿签，却是一个愉快的七夕。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00109",
),
),
(
cmd: set_bg,
args: (
image: "ato_04",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
