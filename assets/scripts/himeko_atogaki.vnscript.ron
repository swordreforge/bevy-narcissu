),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "总之从伙伴那里借来了一辆车，我从稍微有点远的医院把S美酱接了回来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「K君，谢谢你」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "好久没见的S美酱，看上去稍稍瘦了一点。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，她稍显羞涩的笑脸，却一点都没有变。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00047",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那时，我想只要她出了院，肯定马上能就会恢复健康。",
voice: None,
),
),
(
