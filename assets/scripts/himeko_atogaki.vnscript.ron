),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "2天后。\n灼热的阳光和蝉声。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00122",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "通往医院道路的沥青，翻滚着热浪。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00123",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我坐在折叠椅上，和S美说着话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00124",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，K君…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "突然，S美露出了寂寞的表情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我，已经，不行了呢」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "突然，我听到了这句我最不愿意听到的话。\nS美她自己也一定很清楚的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，我不想再接她的话。我害怕不知道该说什么好…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "其实，不是这样的，我可以说“马上就会好起来”之类的话，去否定S美的想法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "可是，我没有那么坚强…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "结果除了沉默着点着头之外，我什么都没能说出来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从窗外射进来灼热的阳光，让纯白的病房变得更加刺眼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "S美发出了小小的哭声。\n我想，那个时候我大概也想哭吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
