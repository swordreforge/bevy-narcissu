),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "把衣服和身体都一并洗了之后，我们在河滩上点火取暖。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00194",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "夜空的月亮，变得更大更明朗。黎明前一定会相当冷吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00195",
),
),
