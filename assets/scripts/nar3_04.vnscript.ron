file: "kiru02",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "马上一挥刀，砍倒了他们的脚。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00303",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唔挖~~」",
