),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……你真奇怪啊」",
voice: Some("li/n3iri_0117"),
),
),
(
cmd: label,
args: (
name: "block_00204",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "背对着我的那家伙，开口说话了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00205",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「在说什么？」",
voice: Some("li/yohanp_1098"),
),
),
(
cmd: label,
args: (
name: "block_00206",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你刚才，把蟋蟀杀了吧」",
voice: Some("li/n3iri_0118"),
),
),
(
cmd: label,
args: (
name: "block_00207",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……那又怎么样？」",
voice: Some("li/yohanp_1099"),
),
),
(
cmd: label,
args: (
name: "block_00208",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「杀蟋蟀很不吉利哦」",
voice: Some("li/n3iri_0119"),
),
),
(
cmd: label,
args: (
name: "block_00209",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……不吉利？才刚想她究竟想说什么……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00210",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我才不知道那蟋蟀传出来的谣言」",
voice: Some("li/yohanp_1100"),
),
),
(
cmd: label,
args: (
name: "block_00211",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……蟋蟀传出来的？」",
voice: Some("li/n3iri_0120"),
),
),
(
cmd: label,
args: (
name: "block_00212",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，是为了保护自己，才流传出去的吧……」",
voice: Some("li/yohanp_1101"),
),
),
(
cmd: label,
args: (
name: "block_00213",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「原来如此……」",
voice: Some("li/n3iri_0121"),
),
),
(
cmd: label,
args: (
name: "block_00214",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，我本是想开玩笑的，这家伙却露出了一面钦佩的表情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00215",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你意外的聪明啊……」",
voice: Some("li/n3iri_0122"),
),
),
(
cmd: label,
args: (
name: "block_00216",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……“意外的”是多余的」",
voice: Some("li/yohanp_1102"),
),
),
(
cmd: label,
args: (
name: "block_00217",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我笑了笑，然后向夜空看去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00218",
),
),
