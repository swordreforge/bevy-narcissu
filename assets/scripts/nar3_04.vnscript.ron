),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说不定会像小麦那样，发出芽来呢」",
voice: Some("li/yohanp_1062"),
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然这只是开玩笑。也有点讽刺她这意味不明的举动。",
