),
),
(
cmd: label,
args: (
name: "block_00266",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "确定他们没有增援后，我示意公主，在他们面前出现。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00267",
),
),
