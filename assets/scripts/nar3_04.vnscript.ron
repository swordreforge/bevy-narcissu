),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "噼里啪啦燃烧的火。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "取暖是必然的，但在这时期湿着身子的话，可是会冻死的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00197",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们都把衣服晾在旁边的树干上，裸赤裸着靠着火取暖……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算是这位公主殿下，也感到不好意思吧，她转过身子，背对着火焰。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
