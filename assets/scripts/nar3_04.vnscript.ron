),
),
(
cmd: label,
args: (
name: "block_00341",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不时，对旁边这家伙发出指示。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00342",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，这也是你在杀人的日子里知道的么？」",
voice: Some("li/n3iri_0143"),
),
),
(
cmd: label,
args: (
name: "block_00343",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「当然」",
