),
),
(
cmd: label,
args: (
name: "block_00323",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知为何，我不可思议的觉得这样才像是她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00324",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是你…… 普通地战斗，也很强不是嘛？」",
voice: Some("li/n3iri_0140"),
),
),
(
cmd: label,
args: (
name: "block_00325",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「恩。别看我这样，其实我是个骑士」",
