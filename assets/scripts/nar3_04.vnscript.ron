),
),
(
cmd: label,
args: (
name: "block_00357",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即使这样，抱着没有屯驻士兵的希望，眯着眼睛一看……",
voice: None,
),
),
(
