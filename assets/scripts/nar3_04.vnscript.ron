),
),
(
cmd: label,
args: (
name: "block_00229",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "回想起那久远的记忆……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00230",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这家伙也嘟哝一声，继续说话了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00231",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，这也知道吗？」",
voice: Some("li/n3iri_0125"),
),
),
(
cmd: label,
args: (
name: "block_00232",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后再次向夜空望去……",
voice: None,
),
),
(
