channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那几个不知名的士兵可能没想到我们会突然出现吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00268",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "显得有些惊讶。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00269",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从服装上看不像是山贼之类的，但是又不像是正规士兵。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00270",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……那样的话，是我这样的佣兵吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00271",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从没有装备短弓看来，应该是受委托抓这家伙回去的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00272",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「（……呐，想怎么办？）」",
voice: Some("li/n3iri_0132"),
),
),
(
cmd: label,
args: (
name: "block_00273",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「（没问题，交给我吧）」",
voice: Some("li/yohanp_1112"),
),
),
(
cmd: label,
args: (
name: "block_00274",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "暂且，按住旁边的这个家伙。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00275",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从正面冲突的话，可能会两败俱伤。他们也知道这种事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00276",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "首先，由我向对方搭话。",
voice: None,
),
),
(
