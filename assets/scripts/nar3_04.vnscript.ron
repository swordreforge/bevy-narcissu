args: (
name: "block_00359",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不仅是士兵，连骑兵也看见。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00360",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "被发现就麻烦了，而且迂回的道路也没有。",
