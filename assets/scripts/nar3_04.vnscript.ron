),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对方是谁并不知道。有可能性太多了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00253",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有可能是追杀这家伙也说不定，又或者是为了在路上被我们杀死的人复仇的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00254",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，无论哪方面，会有敌人出现都是预料之中的事情。\n也没想过可以顺顺利利直截了当走出这个国家。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00255",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/n3iri_0130"),
),
),
(
cmd: label,
args: (
name: "block_00256",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "公主看着我，似乎觉察着我在想什么。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00257",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……不安吗？」",
voice: Some("li/yohanp_1109"),
),
),
(
cmd: label,
args: (
name: "block_00258",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……你觉得我为了什么才跟你一起走？」",
voice: Some("li/n3iri_0131"),
),
),
(
cmd: label,
args: (
name: "block_00259",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，原来如此」",
voice: Some("li/yohanp_1110"),
),
),
(
cmd: label,
args: (
name: "block_00260",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "首先我向能预先观察对方的地方移动。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00261",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样的场合，跟对方正面相对才是上策。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00262",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算能从这里逃跑，躲起来。问题并不会解决。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00263",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "反而会被一直跟踪着，在没防备时受到突然袭击就麻烦了。",
voice: None,
),
),
(
