),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我有点在意，跟了上去……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在铺着薄雪的地面不知挖出了什么东西，拿在手里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那是什么东西……」",
voice: Some("li/yohanp_1059"),
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……是浮雕贝壳」",
voice: Some("li/n3iri_0078"),
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还是那样简单的回答。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……看上去上面有烧焦的痕迹，有点陈旧，肮脏破碎的贝壳而已……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知为何，这家伙很珍惜的看着那件东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难道是你以前埋下的？」",
voice: Some("li/yohanp_1060"),
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/n3iri_0079"),
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她并没有作出任何回答。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是默默的把手中的东西放开……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "再次把它埋起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这家伙到底想干什么？难得挖了出来，又把它埋了？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
