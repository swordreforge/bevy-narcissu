),
),
(
cmd: label,
args: (
name: "block_00304",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "抱着流血的脚在地上打滚的三人。在寂静的山谷间，回响着他们的悲鸣。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00305",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……并不是会立刻死掉的致命伤也行。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00306",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "把他们弄成像这样，无法逃跑，又不能好好战斗的状态的话也一样。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00307",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在战场的话……濒死就等于死亡。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00308",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这就是我战斗的方法，思考的方法。我可不想跟敌人在正面白刃交锋。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00309",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "之后慢慢的，一个个割破喉咙就好了。人的生命，脆弱得一瞬间就可以毁灭掉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00310",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「别杀我，我们只是被委托了而已……」",
voice: Some("li/npetcm36_014"),
),
),
(
cmd: label,
args: (
name: "block_00311",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「很遗憾，我不能放过你们」",
voice: Some("li/yohanp_1117"),
),
),
(
cmd: label,
args: (
name: "block_00312",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……真是天真。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00313",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有空去捡金币，倒不如先把对方砍倒了再说。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00314",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那种东西，明明可以杀死我们后，慢慢抢的……",
