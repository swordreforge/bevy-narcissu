),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……真是个不好笑的笑话呢」",
voice: Some("li/n3iri_0141"),
),
),
(
cmd: label,
args: (
name: "block_00327",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「恩，是个不好笑的笑话……」",
