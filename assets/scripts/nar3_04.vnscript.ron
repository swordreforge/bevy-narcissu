),
),
(
cmd: label,
args: (
name: "block_00285",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就这样，拿钱离开好吗？」",
voice: Some("li/yohanp_1114"),
),
),
(
cmd: label,
args: (
