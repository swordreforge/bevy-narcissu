),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「有看守在？」",
voice: Some("li/n3iri_0147"),
),
),
(
cmd: label,
args: (
name: "block_00370",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，虽然这里不能确认，但肯定有不会错的」",
voice: Some("li/yohanp_1131"),
),
),
(
cmd: label,
args: (
name: "block_00371",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……为什么那样断言？」",
voice: Some("li/n3iri_0148"),
),
),
(
cmd: label,
args: (
name: "block_00372",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那是因为，我的直觉对越糟糕的事就越准」",
voice: Some("li/yohanp_1132"),
),
),
(
cmd: label,
args: (
name: "block_00373",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那就是了」",
voice: Some("li/n3iri_0149"),
),
),
(
cmd: label,
args: (
name: "block_00374",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "公主殿下马上就相信我了。肯定这家伙和我一样吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00375",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且不仅仅是直觉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00376",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "战后不久的这个国家的话，应该还会驻守一定的士兵在那里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00377",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话说在前， 别想着把对方干掉什么的啊」",
voice: Some("li/yohanp_1133"),
),
),
(
cmd: label,
args: (
name: "block_00378",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "首先要制止边上的公主殿下。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00379",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这家伙到现在所杀的，都只是回乡的士兵。还是从背后偷袭才得手的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00380",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但现在是正规军。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00381",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算我能跟几名山贼佣兵之类的战斗，但跟军队根本没得打。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00382",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……被发现了的话，不会轻易了事的。肯定不会有错，会用长弓硬弩招呼我们吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00383",
),
),
(
cmd: dialogue,
args: (
speaker: None,
