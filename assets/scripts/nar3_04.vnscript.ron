(
cmd: dialogue,
args: (
speaker: None,
text: "「……怎么了？」",
voice: Some("li/n3iri_0097"),
),
),
(
cmd: label,
args: (
name: "block_00101",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没什么，只是想你一点也没变啊……」",
voice: Some("li/yohanp_1074"),
),
),
(
cmd: label,
args: (
name: "block_00102",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……没办法，对我来说，没有其他活下去的道路了」",
voice: Some("li/n3iri_0098"),
),
),
(
cmd: label,
args: (
name: "block_00103",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛，可能的确如此……」",
voice: Some("li/yohanp_1075"),
),
),
(
cmd: label,
args: (
name: "block_00104",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就像以前所说的那样，这家伙似乎没有归宿。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00105",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且还被人追杀着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00106",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于这个国家来说，\n是不会对一个即将行刑的人的逃跑视而不见的。况且还是战败国王族的幸存者。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00107",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "至少在离开这个国家之前，被追杀也不奇怪。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00108",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然并不是想维护她，\n也不是不能理解她那每次发现士兵的时候，都想把士兵杀死的心情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00109",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……虽然这么说，但为了面包就杀人还是有点那个……」",
voice: Some("li/yohanp_1076"),
),
),
(
cmd: label,
args: (
name: "block_00110",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对着我那像是自言自语的问题，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00111",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对我来说，只能这样做了……」",
voice: Some("li/n3iri_0099"),
),
),
(
cmd: label,
args: (
name: "block_00112",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她嘟囔了一句。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00113",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「还是说……你可以教我种小麦的方法吗？」",
voice: Some("li/n3iri_0100"),
),
),
(
cmd: label,
args: (
name: "block_00114",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不好意思……很可惜的是，我也是除了杀人外，什么也不会」",
voice: Some("li/yohanp_1077"),
),
),
(
cmd: label,
args: (
name: "block_00115",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那就闭嘴……」",
voice: Some("li/n3iri_0101"),
),
),
(
cmd: label,
args: (
name: "block_00116",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，脸上露出少许寂寞的样子低下头去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00117",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……肯定，这家伙也是知道的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00118",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "总不能一直过着这种生活。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00119",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然直到现在，都是出其不意偷袭对方才赢得了的，\n但如果是多对一，或者对付正规军队，骑士之类我想是行不通的。",
voice: None,
),
),
