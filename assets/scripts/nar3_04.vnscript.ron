),
),
(
cmd: label,
args: (
name: "block_00331",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，活着回去的话，肯定会对其他人说起这件事。所以要杀他们灭口。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00332",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「（不过，就算是这样…… 像他们那样的家伙还会来吧……）」",
voice: Some("li/yohanp_1122"),
),
),
(
cmd: label,
args: (
name: "block_00333",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "跟普通死刑犯逃亡不同。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00334",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "战败国王族的幸存者，不可能轻易就饶恕。至少在离开这个国家前是不会太平的。",
voice: None,
),
),
(
cmd: label,
args: (
