args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "公主殿下罕见的开口了。不知为何她在一块旧的告示牌前站着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，看来这是原国界」",
voice: Some("li/yohanp_1056"),
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "“原”是指，如今这个国家也已经战败，全部都已经被吞并了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为战争的原因，\n现在离开这个国家所需要的距离多了近一倍……喂，你要去哪里」",
voice: Some("li/yohanp_1057"),
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知为何，公主殿下开始往眼前的森林中走去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "禁不住，观察周围，看是不是有士兵出现，完全没有人的气息。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「等一下啊」",
voice: Some("li/yohanp_1058"),
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知是不是真的听不见我的声音，那家伙没有理会我，继续走进森林。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……真没办法……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
