),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那个脸，显得比平常任何时候都孤单，还是第一次见到这家伙时的表情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
