),
),
(
cmd: label,
args: (
name: "block_00292",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "毕竟只是被钱雇佣的家伙。他们也就只有这种程度吧。",
voice: None,
),
),
(
