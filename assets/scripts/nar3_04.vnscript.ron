),
),
(
cmd: label,
args: (
name: "block_00344",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……从那开始我就想。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00345",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即使要离开这个国家，也不是说去哪个国家都好。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00346",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "现在的这个国家，并没有关系特别好的国家，\n到和这个国家随时都会爆发战争的国家是最理想的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00347",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在那么紧张的状态的地方的话，很难想象会越过国界追捕我们。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00348",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……从前几天的那些佣兵来到的日数计算，必须尽快离开这个国家了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00349",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，即使知道“危险”，也选择了跨过这个荒野。",
