args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明亮的月，无数的繁星。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00219",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "星光虽然被月光掩盖了，但依然微弱地闪烁着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00220",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那点小小的星光是北极星。指着北方。\n指向巨人的左脚——参宿七，和御夫座α星的前方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00221",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并且，高高闪耀着的金星是冬天的证明。这全都是以前的远征经验告诉我的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00222",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「离春天还很久呢……」",
voice: Some("li/yohanp_1103"),
),
),
(
cmd: label,
args: (
name: "block_00223",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「看星星就能知道？」",
voice: Some("li/n3iri_0123"),
),
),
(
cmd: label,
args: (
name: "block_00224",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「恩，看星座的位置我大概就能知道了」",
voice: Some("li/yohanp_1104"),
),
),
(
cmd: label,
args: (
name: "block_00225",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「知识很渊博呢……还说除了杀人以外什么都不懂」",
voice: Some("li/n3iri_0124"),
),
),
(
cmd: label,
args: (
name: "block_00226",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真遗憾，那也是作为杀人的一环知道的」",
voice: Some("li/yohanp_1105"),
),
),
(
cmd: label,
args: (
name: "block_00227",
),
),
