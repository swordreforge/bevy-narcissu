),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……已经有二十年了……不，可能有三十年了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00228",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "学会的时候，我还是一个小孩子。",
