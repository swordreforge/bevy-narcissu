),
),
(
cmd: label,
args: (
name: "block_00062",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "接着跟平常一样，从染了血的皮袋里，找出面包，往嘴里送去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00063",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「还是那样毫不留情啊，公主……明明可以不置他于死地的」",
voice: Some("li/yohanp_1067"),
),
),
(
cmd: label,
args: (
name: "block_00064",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……我可不想被先去拿面包的人说教」",
voice: Some("li/n3iri_0090"),
),
),
(
cmd: label,
args: (
name: "block_00065",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，也对」",
voice: Some("li/yohanp_1068"),
),
),
(
cmd: label,
args: (
name: "block_00066",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "经过了几天相处，相对来说开始了解这家伙了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00067",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她的剑术还算不错。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00068",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然一直都是在对方身后冷不防地出剑，看过的人都知道。那是正统的刀法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00069",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，在实际的战场上是行不通的。因为太过端正了，并不是在乱战时使用的刀法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00070",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，一对一战斗的话，也不会输给山贼或佣兵程度的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00071",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "再者，这家伙最厉害的地方是，毫不留情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00072",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "换句话说，就是对活着有着极大执着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00073",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不过啊，你连同胞也毫不留情呢……」",
voice: Some("li/yohanp_1069"),
),
),
(
cmd: label,
args: (
name: "block_00074",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……同胞？」",
voice: Some("li/n3iri_0091"),
),
),
(
cmd: label,
args: (
name: "block_00075",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「恩，再怎么说你也是这个国家的人吧」",
voice: Some("li/yohanp_1070"),
),
),
(
cmd: label,
args: (
name: "block_00076",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你错了，而且，除了自己以外，所有人都是外人」",
voice: Some("li/n3iri_0092"),
),
),
(
cmd: label,
args: (
name: "block_00077",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后指着躺在地上的尸体，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00078",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「活下去的道路只有一条……而死亡的道路却有无数条」",
voice: Some("li/n3iri_0093"),
),
),
(
cmd: label,
args: (
name: "block_00079",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「原来如此……那么这士兵的惨死，只是无数种死法其中的一种吧？」",
voice: Some("li/yohanp_1071"),
),
),
(
cmd: label,
args: (
name: "block_00080",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是的。 我的生存之道，除此以外再无其他」",
voice: Some("li/n3iri_0094"),
),
),
(
cmd: label,
args: (
name: "block_00081",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边说着，一边把这再不会动的尸体，踢下山谷。",
voice: None,
),
),
(
