),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "首先要确定对方的人数，我们先在树荫里监视着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00265",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「（……看上去，只有三个人而已……）」",
