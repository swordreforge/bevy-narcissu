),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……毫不留情地杀死求饶的对方，把食物银币抢夺过来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00098",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "脸上染着血迹，口中吃着面包干粮。无情，冷酷，残忍，染满鲜血。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00099",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也就是说……这就是平常的公主殿下。",
