),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「公主殿下，再问你一个问题可以吗？」",
voice: Some("li/yohanp_1072"),
),
),
(
cmd: label,
args: (
name: "block_00086",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……什么？」",
voice: Some("li/n3iri_0095"),
),
),
(
cmd: label,
args: (
name: "block_00087",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你……就那么想活命吗？」",
voice: Some("li/yohanp_1073"),
),
),
(
cmd: label,
args: (
name: "block_00088",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没错，因为生命只有一次」",
voice: Some("li/n3iri_0096"),
),
),
(
cmd: label,
args: (
name: "block_00089",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不假思索地回答。一点犹豫的样子也没有。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00090",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……那么年轻，却杀人不眨眼，毫不留情……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00091",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我并不觉得这是种悲哀。反倒觉得，悲哀的应该是这个世界……",
voice: None,
),
),
