),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……嗯？」",
voice: Some("li/yohanp_1097"),
),
),
(
cmd: label,
args: (
name: "block_00200",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "偶然一看，一只飞虫停着在手臂上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00201",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边想在这季节很罕见，一边毫不犹豫地把它投进火堆里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00202",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对我来说，这是自然而然的动作……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00203",
),
),
(
