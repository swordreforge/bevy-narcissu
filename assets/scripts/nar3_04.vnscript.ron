),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "突然一个同伴被砍倒了，剩下的两人十分惊恐和狼狈。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00301",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对着这两个人，我连给他们抽剑的机会也没给。",
voice: None,
),
),
(
