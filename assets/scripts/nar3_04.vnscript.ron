),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那家伙连看都不看，一句话没说的把剑上的血迹抹去。也不在意脸上的血。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00084",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我一边看着她，一边说。",
