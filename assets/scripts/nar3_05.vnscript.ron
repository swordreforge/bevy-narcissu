),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……就这样，我向着下一个战地出发了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00194",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我并不知道这种杀人的旅途要延续到什么时候。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00195",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我也不知道允不允许途中离开队伍，也就一直跟着行军了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，杀人后的痛苦心情……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00197",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……减少了。正确来说应该是变麻痹了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后我发现……自己的眼睛也变得暗淡无光了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「人的心灵真是脆弱的东西……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00200",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……所以才要穿着铠甲吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00201",
),
),
(
cmd: set_bg,
args: (
image: "bg_0013",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那之后的数个月，依旧是行军之中。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00202",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂……能等我一下吗……」",
voice: Some("li/npetcm37_009"),
),
),
(
cmd: label,
args: (
name: "block_00203",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不明出处的一个士兵用孱弱的声音跟我搭话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00204",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "由于前些天的战斗脚负伤了，似乎很勉强才追得上进军的步伐。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00205",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……呐，你是怎么想的？」",
voice: Some("li/npetcm37_010"),
),
),
(
cmd: label,
args: (
name: "block_00206",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哪方面？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00207",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「虽然说是为了正义，但神真的会原谅我们吗……」",
voice: Some("li/npetcm37_011"),
),
),
(
cmd: label,
args: (
name: "block_00208",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，看了看自己负伤的脚。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00209",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「谁知道呢……不久之后就会明白了吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00210",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我只能这样回答他。同时也找不到其他语句来回答他了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00211",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们两人都……不，这里不管是谁都杀了无数的，是掠夺无数的人……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00212",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是被丢在这个地方，就意味着死亡。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00213",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "他也是个站在生与死的边界上的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00214",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……你啊，能帮帮我吗？」",
voice: Some("li/npetcm37_012"),
),
),
(
cmd: label,
args: (
name: "block_00215",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「抱歉，我不是医生……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00216",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那样的话，请一起祈祷吧……」",
voice: Some("li/npetcm37_013"),
),
),
(
cmd: label,
args: (
name: "block_00217",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "于是，那士兵合起双手，开始祈祷。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00218",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "闭起了的暗淡的眼中流出了泪水，虔诚祈祷的摸样，犹如已经不是一个杀人者了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00219",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然而，我只是漠然地看着他。在我眼中，他已经是个“死人”了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00220",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我知道，在这里，信仰是没用的。我学习到……在这里，濒死就跟如同死了一样。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00221",
),
),
(
cmd: set_bg,
args: (
image: "bg_0011b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……通往死亡的道路有着无数条……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00222",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，我的生存之道，仅此一条。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00223",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "首先如果我不去赚钱，家人就会饥饿。如果我死了，家人也会死。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00224",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知为何……想起了那被人称之“匪徒”的父亲。想起了那拥有灰暗眼睛的杀人者……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00225",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「现在……妹妹是不是健康地活着……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00226",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "突然，想起了留在祖国的妹妹。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00227",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "想起了在我背上哭累了睡着了的，年幼的妹妹……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00228",
),
),
