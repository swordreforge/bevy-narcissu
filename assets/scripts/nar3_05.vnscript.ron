(
cmd: dialogue,
args: (
speaker: None,
text: "―那是一个非常美丽的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00001",
),
),
(
cmd: set_bg,
args: (
image: "bg_3108",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
