channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……对。这并不是为了帮助她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00242",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这只是心血来潮。不这样的话，我就只是为了自己才回去的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00243",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "为了扫除担忧，用我这双手斩草除根……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00244",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我还真是……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00245",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "竟然说出这么难听的借口。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00246",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，除此以外不能有其他任何理由。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00247",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于只会杀人的我来说，其他的理由都是不被允许的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00248",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那是，作为一个拥有灰暗眼睛……心变成空洞的人的命运……」",
voice: Some("li/yohanp_1166"),
),
),
(
cmd: label,
args: (
name: "block_00249",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "口中一边这样嘟哝着，我渐渐加快了步伐。心想着，躲在云后的月亮不要出来啊。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00250",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我真的是为了杀了那家伙才返回的吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00251",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不禁反复的问着自己这个问题。我每次都坚定地肯定着这个问题。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00252",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……然而，心中某处却希望那家伙平安无事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00253",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我发现自己的行为还真不像是自己……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00254",
),
),
