args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "仰视灰暗的天空，小声的嘟哝。说不定明天早上会有积雪。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00230",
),
),
(
cmd: play_bgm,
args: (
id: "134",
volume: Some(0.78431374),
fade_ms: Some(500),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……恐怕因此，月亮有阵子都不会出来了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00231",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边想着这事情，从刚才开始，就很在意那家伙的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00232",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……是时候忘记那家伙的事情了……」",
voice: Some("li/yohanp_1164"),
),
),
(
cmd: label,
args: (
name: "block_00233",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "反正到了早上的话，会被捉起来杀掉。不会有机会第2次遇见的了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00234",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "没什么好介意的，心里是这样想……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00235",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但不知为何我的脚步显得沉重。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00236",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一定是因为，我没有亲眼看到她死，才心神不定吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00237",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "再有那家伙被捉的时候，也不知会不会对士兵说起我的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00238",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也就是说，有危及我的可能性。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00239",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好吧……还是回去」",
voice: Some("li/yohanp_1165"),
),
),
(
cmd: label,
args: (
name: "block_00240",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边这样细声说着，一边转身往回跑去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00241",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
