args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「请，请饶我一命吧……」",
voice: Some("li/npetcm38_006"),
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这些日子里，不知听到过多少句了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你看，这银币也给你吧……」",
voice: Some("li/npetcm38_007"),
),
),
(
cmd: label,
args: (
name: "block_00180",
),
),
(
cmd: play_se,
args: (
file: "kiru01_1",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "已经没必要让他继续说了。我毫不犹豫一剑挥落。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……没必要为此而烦恼。杀死后再夺过来就好了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00182",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我一言不发，把染了血的银币捡了起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然没明文规定，但随身物品，我们可以随意抢夺。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然当中也有坚定原来意志，认为这是圣战才参加的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是基本上的人都是以抢夺为目标。才不知道那些高尚的命题。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这只是单纯的抢掠和杀人。圣战什么的，只是公家说出来的口号而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，要是放走敌人可是要遭受严厉惩罚的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果被发现了，反过来我们的立场会有危险。听说还有的人处理不好，被处刑了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「抱歉了……虽然跟你无冤无仇……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只说了一句。憋住呼吸，对着这个不知名的谁。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那个时候……不知是哪里，有一处地方很痛，很苦……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00192",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明自己没受伤，不知为何，感觉自己沾满鲜血……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00193",
),
),
(
cmd: set_bg,
args: (
image: "bg_0011",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
