),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "终于到达目的地的时候，我和十多名民兵，还有一位年轻的辅祭编在一起。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00123",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "似乎那些人，已经有几次远征的经验了。并没有对我有什么质问，似乎已经是习惯了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00124",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是，那眼睛是暗淡无光的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "迄今为止，也许杀过很多人，跟我那父亲的眼睛一样，是杀人者的灰暗的眼睛。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
