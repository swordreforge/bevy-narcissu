),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "之后，我们加入了更大的部队，我们进入了目的地的街道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然最初，因为被告诉是“圣战”，对于到底要我们做什么抱有着疑问……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但在那里被给予的任务并不困难。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主要就是全部杀掉。不管是否是教徒，只有这样而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……不久，走了几条街后，凄惨的情景出现在我的眼前。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: set_bg,
args: (
image: "na03_51",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
