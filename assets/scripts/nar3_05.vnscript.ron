channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……在那里，有正在逃亡的，以及后面追杀的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "强行进屋，把里面的人杀害凌辱，抢夺金银的。也有不顾后果，胡乱放火的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这就是，“圣战”么……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "现实不及想象。忽然想出这样的话语。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，至少在这里连一个像敌方士兵的人也没看见。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "没有传闻中的异教徒，反而袭击了同样是基督教的教会。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说真的，一开始，惊讶更大一些。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00138",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，就算本来进军的意图不清楚，也不需要为难。这并不是那么困难的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……单纯的杀人。抢夺就好了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我是这样理解的，估计也没猜错多少吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "本来我就有以小孩来说比较大的体格，\n而全部都是战斗前就想逃跑的人，也没有抵抗的人……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
