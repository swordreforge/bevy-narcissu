),
),
(
cmd: label,
args: (
name: "block_00078",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是在招募远征的志愿兵。从前开始，就数次听到过“圣战”这个叫法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00079",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前我的父亲对此一笑而过，没去争取机会，不过，此次，好像是来自领主的布告。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00080",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "特别是，非常欢迎骑士加入，听说教会也会全面援助。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00081",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……怎么办呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00082",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，已经没时间可犹豫。虽然详细的东西并不清楚，但也没其他路可走了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00083",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我拖着弟妹的手，向城镇里的教会走去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00084",
),
),
