),
),
(
cmd: label,
args: (
name: "block_00101",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主教还说，以我安全完成任务为条件，在远征回来这段时间里，为我照顾我的弟妹。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00102",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "要说突然间松了口气确实是，但对我来说，感到安心的程度更高。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00103",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……不知道为何会受到这么好的待遇。还有也不清楚教会的意图。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00104",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，觉察到他们也需考虑面子问题。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00105",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果我建了战功，就会变成他们的功劳，假如我死了那也无所谓。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00106",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "让过多的人去参加这场圣战这行为，正是为他们在这小国中建立自身的地位。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00107",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是，这跟我没关系。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00108",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我只是已经没有其他的方法活下去了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00109",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我把年幼的弟弟妹妹委托给教会，听从主教的指示赶往战地。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00110",
),
),
