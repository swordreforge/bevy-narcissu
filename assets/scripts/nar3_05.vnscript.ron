),
),
(
cmd: label,
args: (
name: "block_00097",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "至少，这个地方小领主的国家的参加战争，\n不过是对宗主国表现其贡献度的手段而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00098",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以……如果有自称是骑士的人，那他就是骑士了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00099",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即使是稍稍察觉到我是假的，他们也只是想要凑人数和“威信”而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00100",
),
),
