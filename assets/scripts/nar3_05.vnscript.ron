),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "道路上到处倒着不会再动的尸体，燃烧着的房屋和教会。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不时，看见双手交合的人在祈祷着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是，他不会得救。也没有救他的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "头被轻易地砍下来，手上的十字架掉落在地上，染着鲜血。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "他们追随的，供奉的“神”，大概是没慈悲心的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还是说……那位神有着我这等凡人的思虑无法推测出的意图。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00171",
),
),
(
cmd: set_bg,
args: (
image: "w",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
