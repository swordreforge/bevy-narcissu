),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一来到教会，首先对主教说明参加意愿。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00088",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然不会忘掉把父亲的剑给他看。以前整天听父亲说，那是骑士的证据。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00089",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我为了不被发现是小孩，尽量压低声音，装得威风凛凛。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00090",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……如果在这里被拒绝的话，我们就会生活不下去。那么我们的生存之道就会消失了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00091",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以我也拼了死命的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00092",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，与我那不安相反，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00093",
),
),
(
cmd: dialogue,
args: (
speaker: None,
