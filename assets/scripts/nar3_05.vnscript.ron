),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "拿着主教给的书信，以及一点点的路费，我向会合地点前进了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00111",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那里是很远的地方，还是有生以来第1次到其他国家。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00112",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "离会合地点近了，看见士兵样子的人也多了。偶尔，还可以看见骑兵。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00113",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不久，我把主教的书信给了军队的人看，便被编入了不知哪里的小队。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00114",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，我第一次知道了详细的情况。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00115",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "似乎这已经是第3次远征了。虽然在传闻中已经听过，但似乎这叫做“圣战”。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00116",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然我连一点信仰心也没有。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00117",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然亡故的母亲非常虔诚，但看她死的那样子，想让我相信宗教是不可能的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00118",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，因为主教给的介绍信，不知为何我受到的待遇并不坏。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00119",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "肯定在中途参加的人中，全部都是民兵，骑士比较少吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00120",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以我把胡须留长，压低声线，也没脱盔甲。不得不装成，成年人骑士的样子。",
voice: None,
),
),
(
