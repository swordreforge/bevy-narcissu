),
),
(
cmd: label,
args: (
name: "block_00075",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只有我一个人还好，但对于年幼的弟弟妹妹来说是不行的。很明显迟早会走投无路。",
