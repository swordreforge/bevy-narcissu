),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「请，请饶我一命吧……」",
voice: Some("li/npetcm38_003"),
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那个不知名的某人，边说着边求饶。对把刀锋指向他的我开口说着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「给，给，这个金币给你」",
voice: Some("li/npetcm38_004"),
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……金币？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，对，罗马时代的真货，请放过我吧」",
voice: Some("li/npetcm38_005"),
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "手里抓着的，2枚金币给我看了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我以前见都没见过，怕是中世纪的金币。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……有了这金币的话……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "年幼弟妹生活便有着落。我也不用做这杀人的勾当……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我不禁这样想着，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: play_se,
args: (
file: "kiru01_1",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在旁边的士兵一刀砍过来。这一刀没有任何犹豫和姑息。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……有什么好多想的？ 杀了抢过来不就行了」",
voice: Some("li/npetcm37_006"),
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，恩，我知道……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然我这样回答着，但并不是没有动摇。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这么简单的把人杀了，真的好吗……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，和我当时想的不同，杀人的那个人却毫不犹豫捡起了染血的钱币，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「来，一枚给你……」",
voice: Some("li/npetcm37_007"),
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……这样拿了真的好吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我说啊……你是为什么来这里的？」",
voice: Some("li/npetcm37_008"),
),
),
(
cmd: label,
args: (
name: "block_00161",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "唾弃般的丢下这句话，那家伙就匆匆走上了楼梯。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00162",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "立刻传出了年轻女性的悲鸣声，悲鸣声也只持续了一会儿，很快便沉默了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00163",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "能活着离开这间房子的人应该只有我们吧。在其他地方一定也上演着类似的场景……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，出了大街，这种凄惨的情况也没有停止。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
(
