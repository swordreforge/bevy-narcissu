),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……如今明白了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00096",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是不是真正被任命的骑士，根本没关系。",
