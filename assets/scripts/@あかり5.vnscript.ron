(
cmd: dialogue,
args: (
speaker: None,
text: "已经看了好多遍的书，大致的故事梗概全都记住了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00349",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边这么想着，一边翻着书页……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00350",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "健：「嗯，我看看……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00351",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "健：「很早很早以前，北方的塔里住着一位公主……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00352",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "健：「但是，公主一直都是孤身一人。 因为被关在了塔顶上……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00353",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "小明：「别读出来嘛」",
voice: Some("li/2koa_0160"),
),
),
(
cmd: label,
args: (
name: "block_00354",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "健：「没什么吧，反正无聊」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00355",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说到是因为无聊，也就难以反驳了。自己也那样过所以十分清楚。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00356",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "健：「我看看……在某一天，公主下定了一个决心」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00357",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "健：「要逃离这个地方，然后每天都要吃汉堡」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00358",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "小明：「哈?」",
voice: Some("li/2koa_0161"),
),
),
(
cmd: label,
args: (
name: "block_00359",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "健：「可是为了让饿肚子公主，从塔里逃出来的话，\n必须要打败坏心眼的皇后和魔法师……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00360",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "健：「饿肚子公主向联合国提出了控诉，要求出动ＮＡＴＯ（北约）的军队」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00361",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……总感觉，越来越乱七八糟的了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00362",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "健：「但是，坏心眼的皇后以干涉内政为由，驳回了此事」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00363",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "健：「走投无路的饿肚子公主，作为偶像出道了，成为了世界级的歌手。可喜可贺」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00364",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "小明：「……在胡说八道些什么啊……」",
voice: Some("li/2koa_0162"),
),
),
(
cmd: label,
args: (
name: "block_00365",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "健：「我感觉这样会更有趣些」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00366",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "小明：「一点都不有趣。而且，饿肚子公主是说谁啊？」",
voice: Some("li/2koa_0163"),
),
),
(
cmd: label,
args: (
name: "block_00367",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "健：「诶呀，因为老是在吃着什么所以……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00368",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边说着，一边笑嘻嘻的看着我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00369",
),
),
