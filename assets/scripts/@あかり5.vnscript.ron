args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "倒也不是身体有什么不适，毕竟是公认的，充满活力的孩子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……只是，经常会打瞌睡。上课时也睡着过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我想应该只是游戏玩多了，保健老师却建议我入院检查一下什么的。\n倒也没有强制我去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "想到每年只有一次，大概三天就可以结束。正好是暑假，医院离家也不远。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后最重要的，因为想要有一次住院的经历，\n我就参加了这个“住院体检”还是什么的玩意。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: set_bg,
args: (
image: "bg_a0007",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
