args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "来到邻街的医院后，发现除了自己外还有30来人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但其他的孩子，年龄都比我大些，没有年龄差不多大的孩子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "大夫宣读着各种注意事项。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说是最快3天，最长也就1周左右。\n因为是为了检查身体而住的院，所以没有什么好担心的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也没说什么特别重要的事。全是来这里前就听到过的话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
