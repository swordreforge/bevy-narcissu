channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在2楼的一个四人间里，其他人全都比我年纪大。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在随行的父母回去后，周围的人自然的聊起天来，只有自己搭不上话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因此待在病房里太无聊了，我来到了走廊上。",
