voice: None,
),
),
(
cmd: label,
args: (
name: "block_00372",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……仔细想了想，我……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00373",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "察觉到了，至今为止自己连一个能称之为“朋友”的存在都没有。",
voice: None,
),
),
