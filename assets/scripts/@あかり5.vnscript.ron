),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果要举出三个，班上最有人气的人的话，其中肯定会有我的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00003",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "活泼又阳光，是公认的元气小孩的时候。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "暑假时，在市民游泳馆晒得黝黑已是日常……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知烦恼和悲伤为何物，与装睡和谄笑也无缘的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "小学4年级的夏天。大概9、10岁的时候。我经历了住院这回事",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: set_bg,
args: (
image: "bg_a0002",
