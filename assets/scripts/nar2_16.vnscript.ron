),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……为什么这么肯定？」",
voice: Some("li/setsumi_0336"),
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为……全日本的地图我都已经记下了喔。」",
