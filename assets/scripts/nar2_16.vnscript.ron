),
),
(
cmd: label,
args: (
name: "block_00124",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是这样说的话，因为太过抽象而不明白。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不过，在国道之前，大概会决定吧。」",
