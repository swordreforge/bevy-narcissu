),
),
(
cmd: label,
args: (
name: "block_00220",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "稍微思考了一下后，我横着摇了头。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00221",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "比起还没驾照的问题，觉得自己不应该收下。",
voice: None,
),
),
(
