),
),
(
cmd: label,
args: (
name: "block_00213",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这个表情感觉似乎有点寂寞，又像是在怀念着什么的感觉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00214",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你也…喜欢…车么？」",
