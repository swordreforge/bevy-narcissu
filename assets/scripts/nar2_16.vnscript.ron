),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也不是在怀疑姬子所说的话，不过我实在没办法去相信。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「而且呢，我现在需要的，既不是导航系统也不是医生喔。」",
