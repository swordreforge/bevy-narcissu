),
),
(
cmd: label,
args: (
name: "block_00210",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真不可思议呢……」",
voice: Some("li/hime1_0604"),
),
),
(
cmd: label,
args: (
name: "block_00211",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「在决定要到7楼之后，更加的喜欢汽车了。」",
voice: Some("li/hime1_0605"),
),
),
(
cmd: label,
args: (
name: "block_00212",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样自言自语着，配合着眼前的大型弯道，慢慢地转动着方向盘。",
