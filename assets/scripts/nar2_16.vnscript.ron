args: (
name: "block_00176",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，还在烦恼中呢……」",
voice: Some("li/hime1_0437"),
),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是告诉我要去的是很高的地方，到底是在烦恼着什么，我也不知道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「果然，说到很高的地方还是富士山吧……」",
voice: Some("li/hime1_0438"),
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……富士山？」",
voice: Some("li/setsumi_0345"),
),
),
(
cmd: label,
args: (
name: "block_00180",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "没听错的话，的确是这么说的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不管怎么样，也是日本第一呢。」",
voice: Some("li/hime1_0439"),
),
),
(
cmd: label,
args: (
name: "block_00182",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……没想到，会认真到这种程度。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "富士山。海拔3776米。\n大概是理所当然的吧，日本第一高山。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不知道详细的情况，听说即使夏天也会有残雪。\n冬天的时候，不是真正的登山者要爬上去是不可能的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，目标决定了，富士山吧。」",
voice: Some("li/hime1_0440"),
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……不管怎么说，太乱来吧。」",
voice: Some("li/setsumi_0346"),
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我知道啦，我也不是笨蛋啊，并不是以巅峰为目标。」",
voice: Some("li/hime1_0441"),
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「五合目之前汽车是可以通行的，即使是那里也只有海拔2000米。」",
voice: Some("li/hime1_0442"),
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算这样，也用不着跑到那种地方去吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对正常人来说都是那种地方了，而我们两人，至少称不上健康。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……更何况姬子还是7楼的病人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00192",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「而且呢……和7楼比的话可是100倍高的地方喔。」",
voice: Some("li/hime1_0443"),
),
),
(
cmd: label,
args: (
name: "block_00193",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于这句话，我默默地聆听着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00194",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然还不是很确定，不过姬子果然，还是想从那里飞身而下吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00195",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前在天台的时候，也看着围栏自言自语地说着“只有这样的高度，是不够的”。",
voice: None,
),
),
(
