),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……从这里到富士山，到底距离有多远呢？我，连大约有多远都不知道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，我所知道的是……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00200",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "姬子……不是开玩笑，而是认真的。\n以及恐怕，是不会迷路的吧。",
