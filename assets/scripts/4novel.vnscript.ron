),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我是真心觉得和那些老人相处会更好，不仅仅是因为它是家业。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00221",
),
),
(
