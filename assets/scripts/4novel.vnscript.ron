),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「哎，妈妈你怎么看？」",
voice: Some("li/np4syu_1499"),
),
),
(
cmd: label,
args: (
name: "block_02633",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "母亲：「这不是挺好的嘛，我很支持哦」",
voice: Some("li/np4mama_1010"),
),
),
(
cmd: label,
args: (
name: "block_02634",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲：「啊，我也同意」",
voice: Some("li/np4papa_1053"),
),
),
(
cmd: label,
args: (
name: "block_02635",
),
),
(
