args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「但是，这段时间，家里的事我就帮不上忙了」",
voice: Some("li/np4syu_1500"),
),
),
(
cmd: label,
args: (
name: "block_02636",
),
),
(
