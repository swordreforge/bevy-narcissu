args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲：「哎你，说话这么客气干什么」",
voice: Some("li/np4papa_1054"),
),
),
(
cmd: label,
args: (
name: "block_02637",
),
),
(
