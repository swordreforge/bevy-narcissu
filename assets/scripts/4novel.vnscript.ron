args: (
speaker: None,
text: "做出决定以后，我准备从拿到的联系簿上拨打电话……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就在那时，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「不用了博史」",
voice: Some("li/np4papa_1008"),
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是父亲。不知何时已经站在了我的身后。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公★：「不用了……难道说状态已经稳定了吗？」",
voice: Some("li/np4syu_1014"),
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「那倒不是，只是不用通知家人」",
voice: Some("li/np4papa_1009"),
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我完全无法理解。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "考虑到那个人的年纪，情况不好的话，可能会就此离开人世。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这意味着，再也无法和家人相见。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "至少，把老人送到这里的家人，也一定预想过会有这样的情况发生。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00161",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正因如此，这种情况下我们理应联系他们才对吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00162",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不清楚是出于义务还是法律，但我个人是这样认为的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00163",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当我还在想那些事的时候，父亲继续对我说。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「博史……现在几点？」",
voice: Some("li/np4papa_1010"),
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公★：「咦，嗯……３点吧。凌晨」",
voice: Some("li/np4syu_1015"),
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「所以你应该也很清楚吧？」",
voice: Some("li/np4papa_1011"),
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲这样回答。即便我能理解，也难以接受。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "的确在这个时间段打电话对她家人来说很唐突……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「她的家人也有自己的工作和安排」",
voice: Some("li/np4papa_1012"),
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「他们不像你，因为觉得困，就随便翘课」",
voice: Some("li/np4papa_1013"),
),
),
(
cmd: label,
args: (
name: "block_00171",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公★：「不是，这个我也知道……」",
voice: Some("li/np4syu_1016"),
),
),
(
cmd: label,
args: (
name: "block_00172",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对依然无法接受的我，父亲叹了一口气……",
voice: None,
),
),
(
