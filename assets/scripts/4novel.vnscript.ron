),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "边说着我边把今天上课的笔记和一直以来的交换日记递给她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02494",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「抱歉啊，明明莳绘君也很忙的」",
