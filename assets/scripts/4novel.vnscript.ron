),
),
(
cmd: label,
args: (
name: "block_02525",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "仔细想想，除了做甜甜圈以外，她平时对院里的活动也都非常的热心。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02526",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对院里那些长辈们来说，因为跟孙女差不多的年龄，就更加如此吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02527",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹：「而且……哥哥你现在看起来就是最为寂寞的一个呢」",
