),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我还从来没想过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02589",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「……让我，去做医生……」",
voice: Some("li/np4syu_1492"),
),
),
(
cmd: label,
args: (
name: "block_02590",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "确实，养老院里是需要一个医生的，我也考虑过好几次。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02591",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，那个人不会是我，我没想过自己去当医生这件事。",
voice: None,
),
),
(
