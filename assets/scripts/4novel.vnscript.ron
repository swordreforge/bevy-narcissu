channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "道理上来讲，以成为医师为目标也是应该的。虽然我知道这点，也不免有许多牵挂。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02629",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "其中之一就是会跟日下分开。而另一方面，就是在那期间养老院的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02630",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……如果我真的打算成为医师，最少也要花去六年。明明现今也通过全家的努力终于能维持住这里了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02631",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "纠结到最后，我决定跟父母谈谈。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02632",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
