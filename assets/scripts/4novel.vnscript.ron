),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「那我走了……」",
voice: Some("li/np4syu_1505"),
),
),
(
cmd: label,
args: (
name: "block_02676",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「嗯。一路顺风……」",
voice: Some("li/n4yoko_0437"),
),
),
(
cmd: label,
args: (
name: "block_02677",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "清晨的车站还没有什么人。我和来到月台为我送行的日下一起等待着电车。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02678",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……想起来，自从第一次并肩行走的那天开始，我们就一直在一起。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02679",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不管做什么都在一起。不管去哪里都在一起。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02680",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们做出一个又一个约定，心照不宣的事情也很多。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02681",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知不觉中，她在我的身边已经是一件理所当然的事情……对于我们从今往后也会一直在一起这个想法也从未抱持疑问。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02682",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对我们来说，第一次这样子分开，或许称得上是『试炼』了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02683",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正因如此，我郑重地跟她说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02684",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「日下……我不会说要你一直等我」",
voice: Some("li/np4syu_1506"),
),
),
(
cmd: label,
args: (
name: "block_02685",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「我希望的是，你也能尽快到我这里来」",
voice: Some("li/np4syu_1507"),
),
),
(
cmd: label,
args: (
name: "block_02686",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「………………」",
voice: Some("li/n4yoko_0438"),
),
),
(
cmd: label,
args: (
name: "block_02687",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我并不是想要让她也努力升学或是以成为医师为目标。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02688",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我只是，希望她在我的身边。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02689",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即使这是我个人的私心……我也希望她能够在我身边。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02690",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "本以为我们能够一直在一起生活下去，却未曾料到如今竟要分隔数年。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02691",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以我不愿意留下她一个人，我希望她能到我这里来……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02692",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「然后，我们再一起回这里来」",
voice: Some("li/np4syu_1508"),
),
),
(
cmd: label,
args: (
name: "block_02693",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「但，但是，那个……」",
voice: Some("li/n4yoko_0439"),
),
),
(
