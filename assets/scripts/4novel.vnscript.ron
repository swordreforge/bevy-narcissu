),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「笨蛋，说什么呢……就算没了日下还不是……」",
voice: Some("li/np4syu_1480"),
),
),
(
cmd: label,
args: (
name: "block_02529",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一样。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02530",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "哪怕是故作坚强，我也没能说下去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02531",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且在一直守望着我俩直到今天的妹妹面前，这种逞强不管用。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02532",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹：「呐，有件事我以前就在想了……」",
