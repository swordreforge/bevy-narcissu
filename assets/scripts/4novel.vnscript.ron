args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……全都如妹妹所说。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02983",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "最开始的几页有那家伙的字迹……那之后，一直都是我一个人接着在写。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02984",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "简直就像是一种毫无成果的行为，妹妹哭泣的声音中带着几分寂寞。",
