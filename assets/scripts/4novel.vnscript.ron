),
),
(
cmd: label,
args: (
name: "block_03427",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是位平时就和我关系很好的外科医生。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03428",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当问他到底在说什么的时候……",
