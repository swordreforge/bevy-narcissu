args: (
name: "block_02595",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「你看，这本课堂笔记……基本上都是莳绘君写的吧？」",
