),
),
(
cmd: label,
args: (
name: "block_02944",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果把这些弄丢了，那家伙就好像会从我心中消失……",
