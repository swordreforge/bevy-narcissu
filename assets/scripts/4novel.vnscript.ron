),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我把从她那儿接过的日记的今天的部分写好。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02884",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―不用再还给我也没关系的―",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02885",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那时候，她这样对我说，但是我到现在还，偶尔，会记这本日记。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02886",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「……算起来，已经休息两天了……」",
voice: Some("li/np4syu_1542"),
),
),
(
cmd: label,
args: (
name: "block_02887",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边嘟囔着，我一边用自动铅笔笔走龙蛇。以前，似乎也定过这条规定。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02888",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……那之后已经过了两周。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02889",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这期间，也想过会不会再有什么联络。也想过会不会也可能突然间露面。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02890",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，并没有那种事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02891",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "尽管对妹妹说了还是不要调查那家伙的去向比较好，事实上，我有好几次想要委托私人侦探所，试图认真寻找。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02892",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然而每次，一想到从我面前消失，对她来说一定有自己的意义，就放弃了那种想法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02893",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……只是，为什么那时候的我……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02894",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「我爱你，请一直陪伴在我身边……\u{3000}说不出这样的话呢……」",
voice: Some("li/np4syu_1543"),
),
),
(
cmd: label,
args: (
name: "block_02895",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明知道即便怀抱再多想法，有时候必须用言语表达出来……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02896",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果我爱你，就说我爱你。如果不想离开你，就说我不想离开你。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02897",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "为什么，没能说出来呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02898",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
