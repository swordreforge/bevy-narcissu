),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「喂博史，你可不要误会了。\u{3000}这不只是家属方面的意思」",
