),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹：「啊，哥回来了啊」",
voice: Some("li/np4imo_1093"),
),
),
(
cmd: label,
args: (
name: "block_02612",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「……嗯啊，回来了……」",
voice: Some("li/np4syu_1495"),
),
),
(
cmd: label,
args: (
name: "block_02613",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我轻声跟跑来的妹妹打了招呼。她像是刚好做完明天的准备。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02614",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹：「嗯？\u{3000}没什么精神嘛……」",
voice: Some("li/np4imo_1094"),
),
),
(
cmd: label,
args: (
name: "block_02615",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然我脸上并没有什么表情变化，博美还是关切地看着我。她跟日下一样，在她们面前隐瞒不了什么。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02616",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看着妹妹，我决定问问她关于刚才我思考的事情的想法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02617",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「我问你啊，你觉得我们这有必要找一个医生吗？」",
voice: Some("li/np4syu_1496"),
),
),
(
cmd: label,
args: (
name: "block_02618",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹：「怎么了，突然问这个？」",
voice: Some("li/np4imo_1095"),
),
),
(
cmd: label,
args: (
name: "block_02619",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「你就说有没有必要嘛」",
voice: Some("li/np4syu_1497"),
),
),
(
cmd: label,
args: (
name: "block_02620",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「作为一样在这里工作的人，客观地说下你的想法吧」",
voice: Some("li/np4syu_1498"),
),
),
(
cmd: label,
args: (
name: "block_02621",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹：「那肯定还是有一个比较好吧……」",
voice: Some("li/np4imo_1096"),
),
),
(
cmd: label,
args: (
name: "block_02622",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她的回答在我意料之中。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02623",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为妹妹也跟我一样，到现在已经送走了许多人，这样的回答也是当然的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02624",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "鲜有离开这里后能回到自己家的人。大多数都是去了医院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02625",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这里不是医疗设施。虽说如此，也不是个普通的家。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02626",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即便，这里连什么正经的医疗设备都没有……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02627",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正因为是这样的场所，就更希望能有一个医生……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02628",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
