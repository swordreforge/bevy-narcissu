args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然并不是每天都能写日记，但现在偶尔还是会记上一笔。这也是曾经的规定。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02935",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「现在，她在哪里，在做什么呢……」",
voice: Some("li/np4syu_1546"),
),
),
(
cmd: label,
args: (
name: "block_02936",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从以前开始身体就很弱。也知道她性格怕生。",
