args: (
name: "block_02594",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是她无视了我的犹豫接着说道。",
voice: None,
),
),
(
