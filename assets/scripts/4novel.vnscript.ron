args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完妹妹奔向自行车。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02859",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我看着她的背影，松了一口气。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02860",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "难道就这样不知那家伙的去向，再也无法见面了吗，一想到这个就觉得害怕。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02861",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还能够再见到的。想到这个，就感觉快要哭出来了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02862",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不知道为什么突然搬家……简直就像，要从我身边逃走一般的消失……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02863",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……什么叫“不要找”啊……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02864",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样想着的时候，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02865",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: set_bg,
args: (
image: "n4bg_001a",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
