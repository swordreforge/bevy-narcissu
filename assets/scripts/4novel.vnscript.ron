args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "本来我对学校这种地方，就抱着消极的心态，到现在，这种感觉更加高涨了。",
voice: None,
),
),
(
cmd: label,
args: (
