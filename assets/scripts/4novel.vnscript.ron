),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，老爸在这件事上唠叨了很多，所以我也没办法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00223",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，连家里的爷爷奶奶们也对我说，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00224",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只有学校必须要去",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00225",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "被这么一说，我态度也软了下来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00226",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知为何，虽然我对大人们的话总是很不耐烦，但对老人们的话却很是认同。",
voice: None,
),
),
(
cmd: label,
args: (
