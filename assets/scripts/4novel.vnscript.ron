args: (
name: "block_02972",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于没能说出我爱你的我，还有无视她的意愿去见面的权力吗……",
voice: None,
),
),
(
cmd: label,
args: (
