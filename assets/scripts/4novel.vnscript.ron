),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "深秋时节的夜晚变得格外短暂。大大的月亮也在这澄澈的夜空中露出了脸。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02604",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我一边抬头看着月亮，一边独自走在回家路上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02605",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「我要以医生……不，医师为目标吗……」",
voice: Some("li/np4syu_1494"),
),
),
(
cmd: label,
args: (
name: "block_02606",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我不停地喃喃自语着同样的话。不管怎么说我依然对这件事毫无实感。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02607",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "事情发展到这一步，完全超乎了我的意料……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02608",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我确实多次想过需要一个医生这件事。也不是真的完全没考虑过我自己当医生。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02609",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……只是，认识了她以后……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02610",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "比起期望有一个医生的心情，我觉得能跟她生活在一起才是最重要的事……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02611",
),
),
(
cmd: wait,
args: (
