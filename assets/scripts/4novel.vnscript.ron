),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是，无论对谁都一样的平等之事。即避不开，也逃不掉。",
voice: None,
),
),
(
