),
),
(
cmd: label,
args: (
name: "block_01055",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，向家人联络是另一码事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01056",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看了一眼时钟，现在才晚上九点，这个时间的话应该不会添麻烦。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01057",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并不是从家人那边接到了不要联络的指示，不如说，对于这位老爷爷我们被家人叮嘱过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01058",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，我不能视而不见。他家人确实说过不联络她的话便会怨恨我们。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01059",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是对于这样的我来说……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01060",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "老爷爷★：「……家里，也请不要联络」",
