),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然我也想，但这样做真的好吗……？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02968",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这个想法从以前开始就没有改变。我也没有一天不想和她见面。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02969",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这几年里，说不定哪天她会突然到来也曾做过这样的梦。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02970",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……只是，那家伙从我面前消失，一定有她自己的理由……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02971",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不管怎样，对于当初没能好好挽留的我……",
voice: None,
),
),
(
