args: (
name: "block_03452",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我单刀直入地表达了想要做临终关怀工作者的意愿，对方既不是特别生气，也不是过于吃惊的样子。",
voice: None,
),
),
(
