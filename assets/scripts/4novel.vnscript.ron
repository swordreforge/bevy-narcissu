),
),
(
cmd: label,
args: (
name: "block_02523",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我点了点头。没有她在，养老院里的气氛都冷清了起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02524",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这么一想，那家伙的存在已经变得不可或缺了。",
