args: (
name: "block_02979",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹：「可、可是那本日记……\u{3000}只、只有哥哥一个人在写了不是吗……」",
