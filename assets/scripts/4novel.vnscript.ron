cmd: label,
args: (
name: "block_02515",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "博美几天前开始去美容院打工了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02516",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前我都以为她是在开玩笑，但是现在看来她是真的想成为一名美容师。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02517",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……以前还只是模糊的目标或梦想。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02518",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "无论本人愿意与否，到了高三这个年纪，都将要把理想向着现实改变。",
