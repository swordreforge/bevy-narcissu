channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是，那是办不到的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02878",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我想，就算是那家伙一直像是一副不可靠的样子……也是她按她的考虑做出的决定。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02879",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "没有其他人。最清楚那家伙的人就是我……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02880",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "决定默默地从我身边消失，一定是有什么理由的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02881",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "应该不希望我去寻找的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02882",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
