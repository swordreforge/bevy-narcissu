channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "轻轻地拉开拉环的声音响起。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03947",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "优花：「咕咕咕……呼」",
