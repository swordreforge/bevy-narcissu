args: (
name: "block_02592",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「哎嘿嘿，其实，我也开始觉得自己是不是有点勉强了」",
