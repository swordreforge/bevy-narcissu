args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在去学校的路上，我这么抱怨着。从一开始，我对学校的事就没那么挂念。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00214",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "意识到时，已经习惯性地过了一个多月，我对学校的厌恶变得比以前更强烈了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00215",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "去年是一年级，今年依然是一年级。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00216",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "幸运的是，妹妹没有和我分在同班，班里也没有认识我的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00217",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "他们本来就比我小一岁，这也是理所应当的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00218",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
