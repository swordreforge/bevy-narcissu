),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "比起这个，她所说的『去年也是同班』。这句话，让我大致掌握了状况。",
voice: None,
),
),
(
cmd: label,
