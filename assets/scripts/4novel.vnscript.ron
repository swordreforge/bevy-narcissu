args: (
name: "block_00114",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即便偶尔妹妹也会帮忙，每天，三餐的时候也让母亲没有休息的时间。",
