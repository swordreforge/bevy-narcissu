),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公★：「是的……因为我被这样嘱咐了」",
voice: Some("li/np4syu_1192"),
),
),
(
cmd: label,
args: (
name: "block_01054",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "叫救护车这件事，如果本人否定的话作罢也没关系。",
