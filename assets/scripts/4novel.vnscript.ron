),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……以前被教导的，离去者和被留下者的故事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03248",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "绝对不会相交的两者。无法走近，也无法跨越的明确界限。",
voice: None,
),
),
(
