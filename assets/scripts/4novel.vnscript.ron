args: (
name: "block_02539",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我们俩之间，有着几个只有我们才能领会的规矩或是约定。也有很多事即使不说出口也能相互明白。",
voice: None,
),
),
(
