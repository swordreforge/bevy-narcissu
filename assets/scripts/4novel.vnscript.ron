),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如此漫长的冬天过去了……到了街边樱花树都同时盛开的四月。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02670",
),
),
(
