),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "原本，这栋楼房并没有建的很大……但随着不断地扩建，三楼部分的问题变得有些严重。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00582",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因此我在铁皮加固过的地方，又涂了一层煤焦油来加固。",
