),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「……临终关怀？\u{3000}是指那个终末期医疗吗？」",
voice: Some("li/np4syu_1612"),
),
),
(
cmd: label,
args: (
name: "block_03430",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "同僚：「嗯，在欧美那边，已经在开展了。」",
voice: Some("li/etcm1_1014"),
),
),
(
cmd: label,
args: (
name: "block_03431",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从他的话语中得知，开展临终关怀服务的医院最近开始诞生了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03432",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……临终关怀，终末期医疗。在我还是医科大学的学生时曾学到过，但并不了解详细情况。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03433",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "觉得至少在日本，开展终末期医疗应该是很久以后的事情……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03434",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "恐怕……不，这一定是国内的首次尝试吧。",
