),
),
(
cmd: label,
args: (
name: "block_00573",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "某种意义上来说，这是身为父亲的正常反应，而我用和往常一样的语气回应到。",
voice: None,
),
),
(
cmd: label,
args: (
