args: (
name: "block_00173",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「只有在去世的时候才能打紧急电话。\u{3000}除此之外都不行」",
voice: Some("li/np4papa_1014"),
),
),
(
