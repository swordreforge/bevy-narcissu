),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "强劲的冷风，摇曳着远处的松原。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02659",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们在海边坐下，互相都沉默地眺望着大海。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02660",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「已经变得这么冷了……」",
voice: Some("li/n4yoko_0433"),
),
),
(
cmd: label,
args: (
name: "block_02661",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「是啊……已经变得这么冷了」",
voice: Some("li/np4syu_1503"),
),
),
(
cmd: label,
args: (
name: "block_02662",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们都下意识地伸出各自的手握在了一起。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02663",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在冰冷的寒风中，身体有些微微发抖。唯独紧握的双手，变得特别温暖。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02664",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「呐，日下，我，打算参加大学的考试了。」",
voice: Some("li/np4syu_1504"),
),
),
(
cmd: label,
args: (
name: "block_02665",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「嗯，这样我也感到很高兴」",
voice: Some("li/n4yoko_0434"),
),
),
(
cmd: label,
args: (
name: "block_02666",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对话仅此而已，然后又继续沉默地眺望大海。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02667",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并没有再说些什么，就这样一直眺望大海……",
voice: None,
),
),
(
