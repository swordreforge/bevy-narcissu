args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "按照以前的约定，我会把课上教的内容再教给她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02507",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我不禁想起以前却是恰好相反的情形。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02508",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前总是因为我家里的工作而常常请假。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02509",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下总是给那时候的我讲授当天上过的课程。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02510",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，不知道从什么时候开始，我教她的次数开始多了起来……",
