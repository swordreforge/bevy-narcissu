args: (
speaker: None,
text: "虽然第一反应觉得可能是隔壁班的人，但姓名牌上写着１－Ａ。是和我同班的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00255",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明距新学期开学已经过去一个多月了，却没有注意过她……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00256",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，对方好像还知道我的名字，果然应该是同一个班的吧？",
