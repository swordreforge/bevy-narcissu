args: (
name: "block_03948",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就好像泡完澡一样一手插着腰开始喝，又递给我一罐。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03949",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "用手接过冷藏过的罐装咖啡，我终于问了一直很在意的问题。",
