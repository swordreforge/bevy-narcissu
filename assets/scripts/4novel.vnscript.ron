),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完这句话，父亲走出了房间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01111",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "被一个人留下来的我，考虑了各种各样的事情。与其说是在动脑筋思考，倒不如说是在整理那些不成熟的想法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01112",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……离去的人，牵挂着留下的人。被留下的人，牵挂着离去的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01113",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "两者互不相容。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01114",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果说，这就是人类的本质的话……那是多么温情又脆弱啊……",
voice: None,
),
),
(
