),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "面对父亲强硬干脆的回答。我不禁哑口无言。",
