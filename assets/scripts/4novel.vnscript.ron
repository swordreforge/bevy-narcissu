),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，到底是不是像现在这样不见面为好，我也不知道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02974",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是一次又一次重复着同样的自问自答，直到现在。",
