args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "要学的事情也还很多，单纯能让他们感到高兴的话我也会感觉开心。",
voice: None,
),
),
(
cmd: label,
args: (
