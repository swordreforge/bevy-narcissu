),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―几天后。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01036",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一如往常的晚饭后，到了定期巡视的时间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01037",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公★：「不……不要紧吧？老爷爷」",
voice: Some("li/np4syu_1188"),
),
),
(
cmd: label,
args: (
name: "block_01038",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是之前的那个人。晚饭后，我在走廊发现了蹲着的他。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01039",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公★：「我马上叫人过来，请您先躺好」",
voice: Some("li/np4syu_1189"),
),
),
(
cmd: label,
args: (
name: "block_01040",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "老爷爷★：「不，不用了……我没事，这点程度……」",
voice: Some("li/etcm3_1010"),
),
),
(
cmd: label,
args: (
name: "block_01041",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然那样回答了，可是他的脸色明显不是平常那样。况且也听说他有老毛病，也有发病的可能性。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01042",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我为了立刻叫到救护车，在电话的拨盘上拨下了119……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01043",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "老爷爷★：「没事了……已经平息下来了……请不要叫来救护车……」",
voice: Some("li/etcm3_1011"),
),
),
(
cmd: label,
args: (
name: "block_01044",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公★：「可是……」",
voice: Some("li/np4syu_1190"),
),
),
(
cmd: label,
args: (
name: "block_01045",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "老爷爷★：「不，真的已经没事了……」",
voice: Some("li/etcm3_1012"),
),
),
(
cmd: label,
args: (
name: "block_01046",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这么说着，老爷爷摇摇晃晃地站起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01047",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我只考虑了一瞬应该怎么做才好，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01048",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公★：「……明白了」",
voice: Some("li/np4syu_1191"),
),
),
(
cmd: label,
args: (
name: "block_01049",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然很不得已，只能对老爷爷这样回答道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01050",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "根据这里的规定，如果本人回答没问题的话，尽可能不要叫救护车。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01051",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那么接下来，就要向家人取得联系……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01052",
),
),
(
