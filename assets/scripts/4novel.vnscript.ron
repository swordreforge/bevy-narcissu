channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……一直在一起度过了那么久……明明觉得这以后，也一直会在一起……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03241",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是不可能实现的，在那天我“觉悟”了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03242",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明并没有做什么，却感受到了罪恶感。明明并没有失去什么，却感受到了丧失感。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03243",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―能让他幸福吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03244",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有谁这样说道。我身体里的谁在问。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03245",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "于是，烦恼的答案就是这个。并不是因为喜欢才逃避的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03246",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，做个好人，明明只是想做个好人而已……",
voice: None,
),
),
(
