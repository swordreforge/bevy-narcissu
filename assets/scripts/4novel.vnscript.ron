),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公★：「呐老爸……这样做真的好么」",
voice: Some("li/np4syu_1199"),
),
),
(
cmd: label,
args: (
name: "block_01092",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「啊啊，没有别的办法」",
voice: Some("li/np4papa_1032"),
),
),
(
cmd: label,
args: (
name: "block_01093",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "某种意义上来说，这是最佳答案。至少对我们来说，并没有其他选项。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01094",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……无论是那个老爷爷，还是他的家人，互相都不想让对方担心吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01095",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正因为明白这一点，所以处在他们两者之间的我们的立场才会很艰难。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01096",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "优先哪一方的意思什么的，我难以办到……但却不能做出选择……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01097",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "面对正发着呆，考虑着这些事的我，父亲说道，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01098",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「喂，博史，你可不要搞错啊」",
voice: Some("li/np4papa_1033"),
),
),
(
cmd: label,
args: (
name: "block_01099",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「虽然听上去很冷淡，但这里并不是医疗设施」",
voice: Some("li/np4papa_1034"),
),
),
(
cmd: label,
args: (
name: "block_01100",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公★：「那种事我还是知道的……」",
voice: Some("li/np4syu_1200"),
),
),
(
cmd: label,
args: (
name: "block_01101",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽说如此，这里也不是公寓或者居民楼那样的出租行业。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01102",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「如果，没有叫救护车，也没有联系家里人……万一发生了意外的时候怎么办？」",
voice: Some("li/np4papa_1035"),
),
),
(
cmd: label,
args: (
name: "block_01103",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「就算他的死亡是大限已至，你觉得他的家人能接受么？」",
voice: Some("li/np4papa_1036"),
),
),
(
cmd: label,
args: (
name: "block_01104",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公★：「不，感觉那很难……」",
voice: Some("li/np4syu_1201"),
),
),
(
cmd: label,
args: (
name: "block_01105",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是啊。就算满足了本人，家人也不会接受吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01106",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果是在医院去世的话，也许可以死心……但如果是在这样的地方去世的话……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01107",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「所以我们的工作就是……不要让家人留下“遗憾”」",
voice: Some("li/np4papa_1037"),
),
),
(
cmd: label,
args: (
name: "block_01108",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公★：「……只是家人？\u{3000}那本人呢？」",
voice: Some("li/np4syu_1202"),
),
),
(
cmd: label,
args: (
name: "block_01109",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲★：「要实现两边的愿望是不可能的……这从一开始就是矛盾的」",
voice: Some("li/np4papa_1038"),
),
),
(
