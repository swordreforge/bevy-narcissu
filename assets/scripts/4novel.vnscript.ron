),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「呜、呜呜、（抽泣）」",
voice: Some("li/n4yoko_0464"),
),
),
(
cmd: label,
args: (
name: "block_03237",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「笨、笨蛋、什么啊、１０秒屏障……」",
voice: Some("li/n4yoko_0465"),
),
),
(
cmd: label,
args: (
name: "block_03238",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明已经决定不会再哭泣了，却已泪流满面。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03239",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我唯一擅长的事是硬着头皮忍耐。不知为何，总觉得我好像比自己想象中还要脆弱……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03240",
),
),
(
