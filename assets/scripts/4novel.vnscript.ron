channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "打开笔记本。是那家伙留下来的日记。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02899",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从她写过的最后一页开始，已经写了多少页了呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02900",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "已经变得只剩我的文字了。感到非常寂寞。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02901",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……无法知晓那家伙离去的理由。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02902",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，即使知道了也许我也不知道应该怎么办吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02903",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「……现在，以成为医生为目标吧……」",
voice: Some("li/np4syu_1544"),
),
),
(
cmd: label,
args: (
name: "block_02904",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我一边写下今天份的日记一边嘟囔着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02905",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……就算现在无法见面也总有一天会再相见的。如果这样，那么现在，我能做到的事就是成为一名医生。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02906",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那家伙也一定这样希望的吧……",
