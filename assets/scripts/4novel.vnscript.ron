args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "母亲：「就是呀。\u{3000}这里的事你不用担心，总会有办法的」",
voice: Some("li/np4mama_1011"),
),
),
(
cmd: label,
args: (
