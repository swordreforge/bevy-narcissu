),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不愧是，希望尽早致力于终末期医疗的人们才有的事情。即便对于像我这样的年轻人，他们也郑重地回应了。",
voice: None,
),
),
(
