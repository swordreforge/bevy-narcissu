),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹：「真希望她能早点好起来呀……\u{3000}院里的人们也都在担心她呢」",
voice: Some("li/np4imo_1085"),
),
),
(
