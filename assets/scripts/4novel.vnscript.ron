),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「……为什么，出现了啊……」",
voice: Some("li/n4yoko_0463"),
),
),
(
cmd: label,
args: (
name: "block_03213",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "黑暗的房间里，我嘟囔着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03214",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并不是在生气，也不是在怨恨。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03215",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不如说，已经做好了不会再次见面的觉悟，却因为再次相见而感到喜悦。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03216",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是，比起喜悦的心情……抱歉的心情更甚。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03217",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即使他这样来了，也没有任何回报的办法。现在的我连做个甜甜圈都很难。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03218",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……所以，明明想就那样消失……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03219",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
