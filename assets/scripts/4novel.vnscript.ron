args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "换作平时，我们应该一同穿过樱花树的拱门。应该还在同一个班级，正要跟那家伙大声嬉闹……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02671",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "最终，我考上了大学。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02672",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样一来，成为医师的这个目标，我算是成功了第一步……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02673",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，总觉得心中还留有一个去不掉的心结。不舍的是，在此暂时要和日下分开了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02674",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "东京很远。６年很长。",
