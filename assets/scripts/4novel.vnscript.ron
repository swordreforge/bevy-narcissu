),
),
(
cmd: label,
args: (
name: "block_02978",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹妹突然哭起来。从以前起就以开朗为长处一般的妹妹，第一次看到她那样哭泣。",
voice: None,
),
),
(
