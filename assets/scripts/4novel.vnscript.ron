),
),
(
cmd: label,
args: (
name: "block_02943",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一定，是因为和她的“联系”。和到现在还在继续写的日记一样。",
