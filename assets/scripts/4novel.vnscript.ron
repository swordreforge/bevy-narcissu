args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前日下差不多会一周请一天假。现在变成了一周请两天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02497",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然请假的理由都是因为生病……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02498",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但也只是在屋子里躺着，看上去也不像很严重的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02499",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……当然，我也不大清楚，她具体得了什么病或者有什么症状等等。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02500",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，我知道她不是那种会因为偷懒请假不去学校的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02501",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且像这样请假的情况，之前也有见过几次。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02502",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……她身体很弱。这是我以前就知道的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02503",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我也知道她从不勉强自己，一直都挺保重身体，这几年也都平平安安地健康度过了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02504",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是最近突然开始动不动就请假，这让我感到很担心。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02505",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
