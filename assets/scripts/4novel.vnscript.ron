),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在那里，记录了那些日子里发生的鸡毛蒜皮的小事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03226",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "午饭吃了什么呀，学习真麻烦呀……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03227",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―日下，你知道吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03228",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那个人行横道的岩浆啊，据说最近的防御反击增加了１０秒屏障了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03229",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "净是些和那时候一样的漫不经心的内容。也有以前几乎从来没有画过的奇怪的插图。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03230",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，页面下的空白处。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03231",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前写阳子备忘录的地方，净写着担心我似的……鼓励似的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03232",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……手，不冷吗？……会寂寞地哭泣吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03233",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……你啊，太笨了所以不要勉强啊……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03234",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……而且……如果感到为难的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03235",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "无论何时都请告诉我……",
voice: None,
),
),
(
