args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「……等等，博美」",
voice: Some("li/np4syu_1539"),
),
),
(
cmd: label,
args: (
name: "block_02866",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我叫住了妹妹。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02867",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹：「怎么了？\u{3000}查的话很快就能知道了」",
voice: Some("li/np4imo_1107"),
),
),
(
cmd: label,
args: (
name: "block_02868",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「也许是这样……但还是不要查比较好」",
voice: Some("li/np4syu_1540"),
),
),
(
cmd: label,
args: (
name: "block_02869",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹：「但是这样的话，就不知道阳子的去处了」",
voice: Some("li/np4imo_1108"),
),
),
(
cmd: label,
args: (
name: "block_02870",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「啊啊……那样也没关系……」",
voice: Some("li/np4syu_1541"),
),
),
(
cmd: label,
args: (
name: "block_02871",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是的。搬家的事不是问题。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02872",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "比起那个，更重要的是为何默默地从我眼前消失了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02873",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对我来说，好想现在就见到她。见面之后，再狠狠训斥她一顿。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02874",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对我有事相瞒也好，把日记托付我一个人也好……想因为她违反了好几条规则而狠狠训斥她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02875",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是在最后，想要原谅她……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02876",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "会说到「真拿你没办法呢」，然后去拥抱她。希望她再次像以前一样，一直待在我身边……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02877",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
