args: (
name: "block_00239",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "他们不能刚见面就不用敬语，更何况我不知为何还被他们当成了不良少年……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00240",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不管怎么说，我在这个班里是孤身一人。这种程度的自觉还是有的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00241",
),
),
(
