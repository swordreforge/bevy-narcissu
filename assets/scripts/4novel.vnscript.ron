text: "优花：「嗯～，来过几次呢。\u{3000}因为我以前每天都会来这里探望」",
voice: Some("li/yukanp_1237"),
),
),
(
cmd: label,
args: (
name: "block_03938",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "和７楼的天花板差不多高的围栏前面，让人想到初夏的强烈的日光。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03939",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "春天温暖的阳光、和屋顶上吹拂的强风。她长长的整齐的直发飘动着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03940",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "优花：「那，然后怎么做？」",
voice: Some("li/yukanp_1238"),
),
),
(
cmd: label,
args: (
name: "block_03941",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "阿东：「啊、不、不做什么……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03942",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "优花：「哈？\u{3000}什么啊你，没劲了啊。\u{3000}明明已经按你说的，把你带到屋顶了啊」",
voice: Some("li/yukanp_1239"),
),
),
(
cmd: label,
args: (
name: "block_03943",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "阿东：「对不起，\u{3000}我真的只是想来一下而已……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03944",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "优花：「呼……但是，嘛，算了。\u{3000}这种天气的日子，待在屋顶上也不坏」",
voice: Some("li/yukanp_1240"),
),
),
(
cmd: label,
args: (
name: "block_03945",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "边这么说着，从包里拿出一听罐装咖啡，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03946",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
