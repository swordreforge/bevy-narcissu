args: (
name: "block_03454",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "医局长：「老实说，作为我们，也只能从现在开始摸索」",
voice: Some("li/etcm2_1016"),
),
),
(
cmd: label,
args: (
name: "block_03455",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "教授：「虽然我知道你成绩很优秀……」",
