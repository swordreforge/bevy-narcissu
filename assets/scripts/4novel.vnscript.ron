),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「但是老爸……」",
voice: Some("li/np4syu_1501"),
),
),
(
cmd: label,
args: (
name: "block_02639",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我知道家里人手一直都很紧。毕竟我从小就开始在家里帮忙也不是装装样子的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02640",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我也知道妹妹博美为了成为美容师打算去上专科学校了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02641",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且我家也没有那么富裕。不过是整个家族一起经营了一个小小的养老院而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02642",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，我正在考虑这些事的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02643",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "父亲：「我说博史，你的人生，是你自己的东西……不是吗？」",
voice: Some("li/np4papa_1055"),
),
),
(
cmd: label,
args: (
name: "block_02644",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "母亲：「应该说到现在为止一直都太依赖你们了才是」",
voice: Some("li/np4mama_1012"),
),
),
(
cmd: label,
args: (
