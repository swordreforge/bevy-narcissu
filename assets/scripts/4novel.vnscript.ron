args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「嗯，我明白」",
voice: Some("li/np4syu_1614"),
),
),
(
cmd: label,
args: (
name: "block_03451",
),
),
(
