),
),
(
cmd: label,
args: (
name: "block_00580",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "平常的中小雨还没事，但遇到台风或者大暴雨的时候，院里的屋顶有些地方就会开始漏雨。",
voice: None,
),
),
(
