),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着说着妹妹话语中便带起了哭腔，我无言以对。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02966",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……的确，我想正如妹妹所说。",
voice: None,
),
),
(
