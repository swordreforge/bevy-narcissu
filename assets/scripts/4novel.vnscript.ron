(
cmd: dialogue,
args: (
speaker: None,
text: "海潮的声音静静响起。海边一片漆黑空无一人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01812",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "黑暗的天空融入海里，海平线向远方无限延伸。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01813",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这之中，日下长长的头发随风飘扬。手里握着据说是那个老奶奶做的连衣裙。",
