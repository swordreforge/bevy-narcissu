),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那家伙在我身边轻快地跳着踩过人行横道。当然，只挑白色的安全地带。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02653",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「啊，莳绘君，小心，岩浆岩浆」",
voice: Some("li/n4yoko_0436"),
),
),
(
cmd: label,
args: (
name: "block_02654",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如此这般，我们还是跟往常一样日常模式。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02655",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……至今为止，这些日常景象已经不知道重复了多少次。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02656",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "终于，快要看到那个路口了。往那边左转是我家，直走的话就是日下的家。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02657",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是今天我们向右转，去那片我们一直去的海边。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02658",
),
),
(
