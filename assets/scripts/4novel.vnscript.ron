),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「嗯，本来她身体也不是很好」",
voice: Some("li/np4syu_1478"),
),
),
(
