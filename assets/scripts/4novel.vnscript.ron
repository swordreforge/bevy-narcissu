args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……最初的约定。我曾告诉过她不要和来养老院的人许下约定。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03321",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "意思便是不要和能看到死亡的人约定将来……不要和在等候室里排队等候的人产生关联的规矩。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03322",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……离开的人和被留下的人，永远没有交集。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03323",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这两者无法妥协或让步。彼此之间有绝对不可能跨越的界限。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03324",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……那些事情，我也知道。",
voice: None,
),
),
