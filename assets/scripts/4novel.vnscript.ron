channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在膝盖上翻开那本笔记本。这是刚收到的，那本交换日记。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03220",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在那本笔记最开始好像很眼熟的地方，似乎是自己以前写的内容。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03221",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那天，他要在东京开始一个人生活的时候写下的注意事项。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03222",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这是，自己最后写的日记了。和他最后见面的那天……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03223",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是，从那之后的页面，也都密密麻麻地记着日记。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03224",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "和我小小的看上去靠不住的字体不同，那坚定而有力的字体一直持续着……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_03225",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
