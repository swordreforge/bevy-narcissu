),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「怎么样？\u{3000}差不多明白了吗？」",
voice: Some("li/np4syu_1483"),
),
),
(
cmd: label,
args: (
name: "block_02553",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「唔，好像……可能，大概……」",
voice: Some("li/n4yoko_0421"),
),
),
(
cmd: label,
args: (
name: "block_02554",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「喂喂，这里都是重点，一定要好好记住」",
voice: Some("li/np4syu_1484"),
),
),
(
cmd: label,
args: (
name: "block_02555",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从夏天开始日下就常常请假在家。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02556",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且请假的天数逐渐开始越来越多，现在差不多一周已有一半的时间都在家休息了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02557",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "反过来说，一周也有一半的时间去上学，也还是会跟以前一样到养老院里来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02558",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "到现在也没听她说具体得了什么病，也并没觉得有那么严重……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02559",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是眼下马上就要到考试季了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02560",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……如果日下真的是以成为医生为目标的话，是必须要考上好大学的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02561",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前她的目标是去东京上国立大学。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02562",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「……呐，莳绘君准备考哪里？」",
voice: Some("li/n4yoko_0422"),
),
),
(
cmd: label,
args: (
name: "block_02563",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「这个，不是早就决定过了吗……」",
voice: Some("li/np4syu_1485"),
),
),
(
cmd: label,
args: (
name: "block_02564",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「你忘啦，这不是以前的约定吗？」",
voice: Some("li/np4syu_1486"),
),
),
(
cmd: label,
args: (
name: "block_02565",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「………………」",
voice: Some("li/n4yoko_0438"),
),
),
(
cmd: label,
args: (
name: "block_02566",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我当然是打算跟她上同一所学校。虽然我没有说出来过，但我觉得这是理所当然的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02567",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我以为对我来说这是自然而然的事，也以为她也对此心知肚明。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02568",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然而，不知道为什么日下的表情有些低落。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02569",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正当我打算问她到底怎么了的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02570",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「其实……今天，学校的老师跟我说……」",
voice: Some("li/n4yoko_0423"),
),
),
(
cmd: label,
args: (
name: "block_02571",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「我，今年可能要留级了」",
voice: Some("li/n4yoko_0424"),
),
),
(
cmd: label,
args: (
name: "block_02572",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「哎？……」",
voice: Some("li/np4syu_1487"),
),
),
(
cmd: label,
args: (
name: "block_02573",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……留级？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02574",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "啊，不过……这也不是没可能。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02575",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然突然听到这个消息有点惊讶，但是日下从进入三年级开始……尤其从这个夏天开始一直在频繁休学。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02576",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「但是，你现在的情况，只要在考试里取得好一点的成绩就可以了吧？」",
voice: Some("li/np4syu_1488"),
),
),
(
cmd: label,
args: (
name: "block_02577",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「啊，嗯，要毕业的话应该还是没问题的……」",
voice: Some("li/n4yoko_0425"),
),
),
(
cmd: label,
args: (
name: "block_02578",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「但是，考大学的话，就比较勉强了……」",
voice: Some("li/n4yoko_0426"),
),
),
(
cmd: label,
args: (
name: "block_02579",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「那，降一点标准怎么样？\u{3000}也不是非得上国立的嘛」",
voice: Some("li/np4syu_1489"),
),
),
(
cmd: label,
args: (
name: "block_02580",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「不用，莳绘君不用管我，去考你想上的大学就好」",
voice: Some("li/n4yoko_0427"),
),
),
(
cmd: label,
args: (
name: "block_02581",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「喂日下……这样不就没有意义了……」",
voice: Some("li/np4syu_1490"),
),
),
(
cmd: label,
args: (
name: "block_02582",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我本来连高中也没有升学的打算。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02583",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然如此，明明是为了能陪伴她上学为前提才努力到现在的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02584",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下能不能以医生为目标我都无所谓，但是如果就这样分开的话，不就完全是本末倒置了吗。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_02585",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「那个，也不是啦……」",
voice: Some("li/n4yoko_0428"),
),
),
(
cmd: label,
args: (
name: "block_02586",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "女主角：「不如，莳绘君成为医生吧」",
voice: Some("li/n4yoko_0429"),
),
),
(
cmd: label,
args: (
name: "block_02587",
),
),
(
