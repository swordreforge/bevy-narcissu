),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这个地方……每个月，都会有人搬来。然后就好像交替一样，会有人离去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01116",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……常常有人到来，也有人离去……无穷无尽。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_01117",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就像是等候室一样的这个地方，就算自认为变得再怎么亲密，我们自己也不过是个旁观者……",
voice: None,
),
),
(
