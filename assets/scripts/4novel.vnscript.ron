),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "教授：「莳绘君，终末期医疗是多么敏感的问题你能够理解吧？」",
voice: Some("li/etcm2_1015"),
),
),
(
cmd: label,
args: (
name: "block_03450",
),
),
(
