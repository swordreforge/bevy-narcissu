),
),
(
cmd: label,
args: (
name: "block_03435",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "主人公：「喂，引入那个的医院，是我们的体系医院吗？」",
voice: Some("li/np4syu_1613"),
),
),
(
cmd: label,
args: (
