args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……难道说，这是个很危险的状况吗。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然不是在害怕这个公主，而是指我的立场有危险。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "粗略的看了下，周围似乎都是像我一样被银币召集过来的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这个战后不久的国家，像我这样沦落为佣兵的人要多少都有吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……再怎么说也是与王族有关联的人，不经过正式的处刑，而是这样暗杀般的杀死。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且不知为何，这个任务，不是交给正规士兵，而是聚集起我们这种佣兵来进行。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "到底是什么理由想都不用去想。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "完事后，大概会把我们全部灭口吧。\n详细的事我就不知道了，但他们应该是想把事情永远掩埋在黑暗之中。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "很遗憾，我的直觉对于越糟糕的情况就越准确。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「（真是对不住了……我可不能为了这种无聊的理由而死掉……）」",
voice: Some("li/yohanp_1005"),
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "将事态理解到这地步后，我观察了下周围的情况。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00161",
),
),
(
