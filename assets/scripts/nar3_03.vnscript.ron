),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "数日后。真正的冬天渐渐地来了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00042",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从昨天开始便一直下着的雪终于停了，天空露出了久违的晴朗。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知为何，今天老师并不在。连锁也没上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然要想逃跑的话是能跑掉的，但他知道我并没有逃跑的意思。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "出了这个牢房，也只是城内。我知道不可能逃得出去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
