),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对方在跟平常差不多的那位置滑了下。我在那个瞬间，一剑封喉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看来这个兵大叔E，也是做出蹲下状。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「求，求求你，放过我……」",
voice: Some("li/npetcm35_018"),
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不可能了……反正中了毒一样要死的」",
voice: Some("li/n3iri_0031"),
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边说着一边把剑从他的背后移到了脖子上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，猛的一用力。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
