),
),
(
cmd: label,
args: (
name: "block_00120",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……但那是骗人的。不管谁都是先有了目的才会踏上旅途的」",
voice: Some("li/yohanp_1002"),
),
),
