channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然途中回头看时她都跟在后面，不过反正过段时间就会自己离开了吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00262",
),
),
(
