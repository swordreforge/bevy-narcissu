),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "选项是……逃跑，或是把这里的人全部杀光。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00162",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "视野所及，也没人在附近停马。就这样直接跑出去的话，应该能逃进森林里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00163",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，也没人拿短弓，即使取出了，射之前也能逃掉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但即使现在能逃得掉也没用。既然我已经知道了这件事，总有一天会被追兵追上杀死。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……那样的话，只有把他们全杀了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……右边4人，左边2……3人？正对面的公主无视的好了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "要动手的话，在他们还没拔剑的现在就是最好时机。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "幸运的是，或许他们因为对手是个小姑娘而大意了吧，好好穿着护甲的只有我一个人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "应该能行吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
(
