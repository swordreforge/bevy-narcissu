channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然老师以前指示过，要尽可能摆出软弱的架势，装出害怕的表情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但那时候无需特别去伪装，自然而然的就会那样。真的是感到害怕。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但现在……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "演技却是必要的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知用同一种方法杀掉了多少人后，嘴角有时会不由自主的露出微笑。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……在那里，只要再踏出一步的话，你的脚就会踩中陷阱。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在下一个瞬间就会被我用剑刺中你的脸，当场蹲下去。又或者是，把剑胡乱挥舞吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，没什么好担心的。不管是哪种情况，不久你都会死去……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明对方没有带随从，我却向老师使了个眼色。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
