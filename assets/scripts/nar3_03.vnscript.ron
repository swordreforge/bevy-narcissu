args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并没有什么目的，只是单纯的开始往南边走。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00311",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽说如此，因为前几天的那件事，我也在避开人烟前进。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00312",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从山里出发然后穿过荒野会绕很远的路，\n但有一个月时间的话也应该能离开这个国家了吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00313",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在离开这个国家前，这个公主殿下能自己跑到别的地方去也好。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00314",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果跟来的话，也与我无关……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00315",
),
),
(
cmd: set_bg,
args: (
image: "bg_0003",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―两天后。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00316",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "雪从白天就开始飞舞，渐渐变大。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00317",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "冷风毫不留情地把体温从身体夺走，看来冬天，还有一段很长时间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00318",
),
),
(
cmd: set_bg,
args: (
image: "3020",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我，不，是我们……今天继续在森林中前进。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00319",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那之后整整过了一天，不过公主还是跟在我身后。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00320",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并没遇到什么大问题，只是现在，手头上的食物快没有了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00321",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，钱是带着的。也有其他值钱的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00322",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，这了无人烟的地方钱没用。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00323",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "金银财宝在没人的地方换不到食物。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00324",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……虽然这么说，但也不能进入城镇。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00325",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "已经决定绕远路，通过人烟稀少的深山离开这个国家。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00326",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为要攀山涉水，所以不能骑马。这个季节，山中也没什么食物。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00327",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「（……早知道会这样，那时候真不该去接那份工作）」",
voice: Some("li/yohanp_1044"),
),
),
(
cmd: label,
args: (
name: "block_00328",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我把前几天从祭司那里得到的大量的银币放在手中，口中发着牢骚。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00329",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……不过啊，肚子还真饿」",
voice: Some("li/yohanp_1045"),
),
),
(
cmd: label,
args: (
name: "block_00330",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是啊……」",
voice: Some("li/n3iri_0069"),
),
),
(
cmd: label,
args: (
name: "block_00331",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有时，我们会边走边说些无所谓的话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00332",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后我对于这个公主殿，也了解到了几点。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00333",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不是亲耳听到，看来这家伙是被人追杀着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00334",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "要说的话，就是亡国了的公主的感觉……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00335",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但普通稍微想想都知道。将要处刑的人没可能那么简单就会被放走的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00336",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "更不用说，那是战败国王族的幸存者。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00337",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……被她拖累之前，离开她吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00338",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这么想的时候，眼前出现了一个人影。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00339",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那是……」",
voice: Some("li/yohanp_1046"),
),
),
(
cmd: label,
args: (
name: "block_00340",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一个垂着肩膀赶路的年轻士兵。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00341",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……看来是这个国家的士兵，恐怕并不是什么追兵。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00342",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为战事刚结束，大概不是被征收就是正要回自己的家吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00343",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐公主殿下，别动哦？ 以防万一，别乱来啊……」",
voice: Some("li/yohanp_1047"),
),
),
(
cmd: label,
args: (
name: "block_00344",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正要说着，我停住了。在旁边的公主，手握着了长剑。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00345",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂，太敏感了吧」",
voice: Some("li/yohanp_1048"),
),
),
(
cmd: label,
args: (
name: "block_00346",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……所以才能活到现在」",
voice: Some("li/n3iri_0070"),
),
),
(
cmd: label,
args: (
name: "block_00347",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，拔出了剑。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00348",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……难道你想动手？」",
voice: Some("li/yohanp_1049"),
),
),
(
cmd: label,
args: (
name: "block_00349",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没问题，一个人的话很轻松的」",
voice: Some("li/n3iri_0071"),
),
),
(
cmd: label,
args: (
name: "block_00350",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂，住手，那个只不过是一个回家的士兵」",
voice: Some("li/yohanp_1050"),
),
),
(
cmd: label,
args: (
name: "block_00351",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，没听我的劝阻，冲出了草堆。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00352",
),
),
(
cmd: set_bg,
args: (
image: "na03_27c",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎，啊……啊啊？」",
voice: Some("li/npetcm36_008"),
),
),
(
cmd: label,
args: (
name: "block_00353",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: play_se,
args: (
file: "kiru01_1",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哇啊~」",
voice: Some("li/npetcm36_009"),
),
),
(
cmd: label,
args: (
name: "block_00354",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "太过突然，那个年轻的士兵没有抵抗就这样死掉了。\n脸上还留着惊恐的表情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00355",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，公主便马上在这年轻士兵身上的皮包中，寻找食物。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00356",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呼，真拿没你办法……」",
voice: Some("li/yohanp_1051"),
),
),
(
cmd: label,
args: (
name: "block_00357",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边叹气，一边走近，像她一样地找着包中的食物。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00358",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，找到了薄薄的烧面包，一边大口吃着，一边跟这家伙说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00359",
),
),
(
cmd: set_bg,
args: (
image: "3020",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂， 也不至于要杀死他吧？」",
voice: Some("li/yohanp_1052"),
),
),
(
cmd: label,
args: (
name: "block_00360",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「吵死了……」",
voice: Some("li/n3iri_0072"),
),
),
(
cmd: label,
args: (
name: "block_00361",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边这样说着，一边和我一样大口吃着面包。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00362",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "接着，把包里的少许银币塞进自己的衣服里，\n用来祈祷的木制十字架，则扔到了林子的对面。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00363",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……脸被溅出来的血弄湿，却坦然吃着夺来的面包的她那身姿……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00364",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然我也没什么资格说别人……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00365",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "真过分啊，这真是。再怎么说也不会让人想到她是公主。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00366",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，公主殿下，可以问你一个问题吗」",
voice: Some("li/yohanp_1053"),
),
),
(
cmd: label,
args: (
name: "block_00367",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……什么？」",
voice: Some("li/n3iri_0073"),
),
),
(
cmd: label,
args: (
name: "block_00368",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那家伙做了什么必须被杀的坏事吗？」",
voice: Some("li/yohanp_1054"),
),
),
(
cmd: label,
args: (
name: "block_00369",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……谁知道」",
voice: Some("li/n3iri_0074"),
),
),
(
cmd: label,
args: (
name: "block_00370",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那样的话，也不用杀死他吧……」",
voice: Some("li/yohanp_1055"),
),
),
(
cmd: label,
args: (
name: "block_00371",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/n3iri_0075"),
),
),
(
cmd: label,
args: (
name: "block_00372",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……那么，我应该乖乖被人杀死吗？」",
voice: Some("li/n3iri_0076"),
),
),
(
cmd: label,
args: (
name: "block_00373",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，把已经不会动的尸体踢下了山崖。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00374",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "尸体一路滚下山去，发出树枝折断的声音。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00375",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对尸体看都不看一眼的她，把剑上的血迹擦掉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00376",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "沾在脸上的血却一点都不在意。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00377",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后像什么都没发生一样，又开始继续走了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00378",
),
),
(
cmd: set_bg,
args: (
image: "3020",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……的确，站在公主的立场想一想，也不是不能理解的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00379",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "万一被追兵发现了，不动手确实就是死路一条，即使不是那样，也会饿死。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00380",
),
),
(
cmd: dialogue,
