channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「（……不过啊，从最初看到这多的过分的银币时，就该怀疑事情不对了……）」",
voice: Some("li/yohanp_1019"),
),
),
(
cmd: label,
args: (
name: "block_00245",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边走一边想着，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00246",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂，你干什么？」",
voice: Some("li/yohanp_1020"),
),
),
(
cmd: label,
args: (
name: "block_00247",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "回头一看，刚才的公主殿下一直跟在我身后。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00248",
),
),
(
cmd: set_bg,
args: (
image: "3099",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不介意……我跟你一齐走吧？」",
voice: Some("li/n3iri_0054"),
),
),
(
cmd: label,
args: (
name: "block_00249",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「虽然不介意，但也要看是什么原因了」",
voice: Some("li/yohanp_1021"),
),
),
(
cmd: label,
args: (
name: "block_00250",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "至少这个公主殿下，是会被追杀的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00251",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以后可能有其他的追杀者跟随过来，跟她一起走，对我来说并没好处。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00252",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「跟你一起走，活下去的机会更高一点」",
voice: Some("li/n3iri_0055"),
),
),
(
cmd: label,
args: (
name: "block_00253",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「原来如此……你想活下去啊」",
voice: Some("li/yohanp_1022"),
),
),
(
cmd: label,
args: (
name: "block_00254",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "理所当然的回答。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00255",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是公主殿下，有件事我要先说清楚……」",
voice: Some("li/yohanp_1023"),
),
),
(
cmd: label,
args: (
name: "block_00256",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我并不想活下去」",
voice: Some("li/yohanp_1024"),
),
),
(
cmd: label,
args: (
name: "block_00257",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……那刚才是怎么回事？」",
voice: Some("li/n3iri_0056"),
),
),
(
cmd: label,
args: (
name: "block_00258",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我， 只是在寻找着适合自己的死法罢了」",
voice: Some("li/yohanp_1025"),
),
),
(
cmd: label,
args: (
name: "block_00259",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，跟这家伙说也不会理解吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00260",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边想着，我一边又开始向森林走去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00261",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
