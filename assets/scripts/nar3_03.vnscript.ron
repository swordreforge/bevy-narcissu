args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我安静地退到了后面。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00171",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "跟这种数量的人为敌的话，我不会傻傻的从正面砍过去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00172",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，那个祭司肯定要确实的杀掉。其他的佣兵也不能放跑了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00173",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果留了活口的话，他们的嘴巴就会乱说话，\n今天的事如果被说出去，总有一天会危及到我的性命。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00174",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「（那么，动手吧……）」",
voice: Some("li/yohanp_1007"),
),
),
(
cmd: label,
args: (
name: "block_00175",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "深吸了一口气，",
voice: None,
),
),
(
