),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不由得重复了老师说的话。过了很长时间才回过神来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00051",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不用问都知道哪一方胜利。从以前开始，就听说我的祖国处于弱势。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00052",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「王族全部都被杀死了。当然你的家人也是」",
voice: Some("li/n3hei_0089"),
),
),
(
cmd: label,
args: (
name: "block_00053",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是么……」",
voice: Some("li/n3iri_0036"),
),
),
(
cmd: label,
args: (
name: "block_00054",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "没有多大的感慨。本来就是连长什么样都记不得的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00055",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，这样一来就确定了一件事。",
