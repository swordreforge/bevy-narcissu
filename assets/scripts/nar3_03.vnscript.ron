),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―第二天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00263",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "天空很宽广，是冬季的天空。晴朗的天空，吹着冷风。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00264",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我在远离村落的深山中行走着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00265",
),
),
(
cmd: play_bgm,
args: (
id: "89",
volume: Some(0.78431374),
fade_ms: Some(500),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然我有目的，但并没有目的地，只不过是在流浪而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00266",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为前几天那件事的关系，我尽量躲开人烟在森林里前行。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00267",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，跟着我的步伐，那家伙也跟来了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00268",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「公主殿下，你要跟我跟到什么时候？」",
voice: Some("li/yohanp_1026"),
),
),
(
cmd: label,
args: (
name: "block_00269",
),
),
(
cmd: set_bg,
args: (
image: "bg_3007",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「至少要到离开这个国家为止……」",
voice: Some("li/n3iri_0057"),
),
),
(
cmd: label,
args: (
name: "block_00270",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……这个国家？」",
voice: Some("li/yohanp_1027"),
),
),
(
cmd: label,
args: (
name: "block_00271",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然只是随心地走，但我还是想快点离开这个国家，以其他领地作为目标。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00272",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你说要离开这个国家……你是这个国家的公主吧？」",
voice: Some("li/yohanp_1028"),
),
),
(
cmd: label,
args: (
name: "block_00273",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/n3iri_0058"),
),
),
(
cmd: label,
args: (
name: "block_00274",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "详细情况没有听说，之前从祭司那里听过一点点。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00275",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……那又怎么样？」",
voice: Some("li/n3iri_0059"),
),
),
(
cmd: label,
args: (
name: "block_00276",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊？」",
voice: Some("li/yohanp_1029"),
),
),
(
cmd: label,
args: (
name: "block_00277",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这个国家的公主，就不能离开这个国家了么？」",
voice: Some("li/n3iri_0060"),
),
),
(
cmd: label,
args: (
name: "block_00278",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，也没什么……随你喜欢」",
voice: Some("li/yohanp_1030"),
),
),
(
cmd: label,
args: (
name: "block_00279",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并不知道这家伙经历了什么。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00280",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但如果变成了累赘，甩掉她就行了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00281",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "万不得已时，也可以杀掉。在这森林之中，山狗野狼会帮我善后的了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00282",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话虽如此，你好歹也是个公主吧？」",
voice: Some("li/yohanp_1031"),
),
),
(
cmd: label,
args: (
name: "block_00283",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/n3iri_0066"),
),
),
(
cmd: label,
args: (
name: "block_00284",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那样的话回自己的国家……自己的家吧？」",
voice: Some("li/yohanp_1032"),
),
),
(
cmd: label,
args: (
name: "block_00285",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……怎么回去？」",
voice: Some("li/n3iri_0061"),
),
),
(
cmd: label,
args: (
name: "block_00286",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那并不是什么难事吧？」",
voice: Some("li/yohanp_1033"),
),
),
(
cmd: label,
args: (
name: "block_00287",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「回到家，打开门，说我回来了就行了」",
voice: Some("li/yohanp_1034"),
),
),
(
cmd: label,
args: (
name: "block_00288",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……很遗憾，家跟亲人都没了」",
voice: Some("li/n3iri_0062"),
),
),
(
cmd: label,
args: (
name: "block_00289",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哦，那我真是失言了」",
voice: Some("li/yohanp_1035"),
),
),
(
cmd: label,
args: (
name: "block_00290",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "话虽这么说，但我并不打算同情她。听说这个国家持续了将近十年的战事结束了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00291",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这种程度就同情的话会没完没了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00292",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「虽然那么说…… 不过我也赞成离开这个国家」",
voice: Some("li/yohanp_1036"),
),
),
(
cmd: label,
args: (
name: "block_00293",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……那不是很好嘛」",
voice: Some("li/n3iri_0063"),
),
),
(
cmd: label,
args: (
name: "block_00294",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「顺便告诉我，去哪个国家才好」",
voice: Some("li/yohanp_1037"),
),
),
(
cmd: label,
args: (
name: "block_00295",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这家伙好歹也是个王族。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00296",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "比起我这个微不足道的佣兵来，她应该对其他国家的事知道的更详细吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00297",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么样，如果是你的话应该会知道些国家内部的事情吧？」",
voice: Some("li/yohanp_1038"),
),
),
(
cmd: label,
args: (
name: "block_00298",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「邻国的…… 阿利娜被灭掉了，最好不要去」",
voice: Some("li/n3iri_0065"),
),
),
(
cmd: label,
args: (
name: "block_00299",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，那我知道，还有其他的嘛？」",
voice: Some("li/yohanp_1039"),
),
),
(
cmd: label,
args: (
name: "block_00300",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/n3iri_0066"),
),
),
(
cmd: label,
args: (
name: "block_00301",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……不知道」",
voice: Some("li/n3iri_0067"),
),
),
(
cmd: label,
args: (
name: "block_00302",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什么嘛，你还真是万事通啊……」",
voice: Some("li/yohanp_1040"),
),
),
(
cmd: label,
args: (
name: "block_00303",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……不好意思呢」",
voice: Some("li/n3iri_0068"),
),
),
(
cmd: label,
args: (
name: "block_00304",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于我的讽刺，公主盯着我如此回答。\n那是实在让人无法想到会是公主发出的，充满杀气的眼神。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00305",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「（……不过，这家伙还真是个怪人啊……）」",
voice: Some("li/yohanp_1041"),
),
),
(
cmd: label,
args: (
name: "block_00306",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "外表只是个小孩，却有着意想不到的胆量吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00307",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然比在我旁边一直找我搭话要好，但她绝对不主动说话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00308",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然也从没笑过，一直都板着脸，一副很生气的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00309",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「也罢，总之是往南边走吧」",
voice: Some("li/yohanp_1042"),
),
),
(
cmd: label,
args: (
name: "block_00310",
),
),
(
