text: "我把剑和身上的血迹擦去，开始往城镇的反方向走。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00241",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "恐怕看到像我们这样的佣兵聚集在一起，也不会有人跟踪过来或潜伏在这附近吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00242",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但也不能一直待在这种地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00243",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "要赶快走进森林离开。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00244",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
