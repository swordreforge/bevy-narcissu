channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "漫长的战斗终于迎来了结束的日子，我又错过了实现目标的机会。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并且，就算继续走下去，但却没有目的地……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "突然，被人叫住了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看起来这个人，在这个国家身居要职吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在刚结束战争的这个国家，因为什么理由而被叫住，大致也猜得出来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "反正，不是杀人，就是抢劫之类的事情吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果是向我这样的人打招呼，恐怕就是前者了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因此我决定留在这里。为了赚取那些数额惊人的非法外快。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是个刚入隆冬，离春天还有很远的日子的事情……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
