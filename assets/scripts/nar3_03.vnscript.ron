),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从一动不动的黑色水洼的死人身上，我拔起了自己的剑，把血抹掉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像以往一样使着眼色，催促老师快点处理掉尸体。已经是炉火纯青的地步了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "老师看着我，突然细声说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你变了……」",
voice: Some("li/n3hei_0086"),
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……可能吧」",
voice: Some("li/n3iri_0033"),
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "暧昧地回答着。虽然我自己没怎么认识到，但我确实是变了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，该怎么说呢……如果不改变的话，我可能早就死了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「还是说……想活下去是件坏事？」",
voice: Some("li/n3iri_0034"),
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，是件好事」",
voice: Some("li/n3hei_0087"),
),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "没错。死了的话就什么都没意义了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00035",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我面对着无数条通向死亡的道路，\n而生存下去的道路却只有这一条。却只有这一条。别无他法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00036",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……还是说在那个时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00037",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我就应该乖乖地死去呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "到现在也不知道哪一边才是正确的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00039",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只不过，我选择的是后者罢了，而幸运的是，我存活至今。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……也就仅仅是这样而已……",
voice: None,
),
),
(
