(
cmd: dialogue,
args: (
speaker: None,
text: "就算那只是很模糊的意识，但正因为有某种理由，人才会开始踏上旅途。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00122",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "至少我自己，是有目的和理由的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00123",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当意识到的时候，已经流浪了八年的时间……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00124",
),
),
(
