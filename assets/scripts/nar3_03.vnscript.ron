),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…………",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "第二天，夜晚。我被带到了城外杳无人烟的草原上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "发现周围有几个跟我类似的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "至少并不是正规士兵，大概跟我一样，是被金钱所召集起来的人吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为听说是要杀掉王族的人，我预想到应该要和一定人数的对手战斗。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00138",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「算了，船到桥头自然直……」",
voice: Some("li/yohanp_1003"),
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我如此想着，片刻后……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: set_bg,
args: (
image: "na03_14",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "总算出现了的，是个穿得有点脏的小女孩。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这是怎么回事？我确实被告知，是要杀死王族的人……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这么说的话，难道这个有点脏的人是公主吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还以为会有很多的护卫跟随呢，只有一个人么？\n而且那个人丝毫没有害怕的样子，也没有想逃跑的迹象。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我不由得跟旁边的人小声说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「（喂，你怎么看？）」",
voice: Some("li/yohanp_1004"),
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「（嗯？啊，看来这是件简单的工作啊……）」",
voice: Some("li/npetcm36_004"),
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那个不知出身哪里的佣兵，回答了我后便露出轻笑。我也一样笑着点了点头。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，我内心想着的却是……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "感觉到了死亡的气息。不是别人的，而是我自己的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
