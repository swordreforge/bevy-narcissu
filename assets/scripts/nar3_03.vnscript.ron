args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "静静地，不让任何人察觉地抽出了剑。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "瞄准的地方，只是膝背面的那一点。",
voice: None,
),
),
(
cmd: label,
