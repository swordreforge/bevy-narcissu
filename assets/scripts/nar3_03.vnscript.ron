),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "回想起来，从那天开始已经杀了数十人。但具体是多少就记不清了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "刚开始的几年还会记得住，但现在，已经不会再去想被我所杀的那些人的事情了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……为了能多活这8年，我并不后悔杀死这么多人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: set_bg,
args: (
image: "na03_18",
