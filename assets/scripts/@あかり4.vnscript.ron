),
),
(
cmd: label,
args: (
name: "block_00409",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不太清楚是说？」",
voice: Some("li/tpapa_0019"),
),
),
(
cmd: label,
args: (
name: "block_00410",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「毕竟临床病例也太少，还在研究阶段…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00411",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当时的我，他们到底在说什么，还不大明白。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00412",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，和平时不一样，两人都用着很认真的口气在说话的样子。",
