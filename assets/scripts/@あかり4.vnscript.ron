),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我闭着眼睛，竖起耳朵听着。我知道要是起来的话，反而会变得更麻烦。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00626",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真的是，麻烦死了，就为了这一个小孩」",
voice: Some("li/kanC_0014"),
),
),
(
cmd: label,
args: (
name: "block_00627",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就因为她，夜班都有了，真当自己是谁啊」",
