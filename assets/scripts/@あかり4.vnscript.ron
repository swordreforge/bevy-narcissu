),
),
(
cmd: label,
args: (
name: "block_00628",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我来这也是倒大霉了，好想转去其他地方」",
voice: Some("li/kanC_0015"),
),
),
(
cmd: label,
args: (
name: "block_00629",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看起来，二人正在发着牢骚。不知道具体是在说什么。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00630",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，是在针对我的牢骚这件事还是懂的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00631",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「可是啊，睡午觉的话，晚上又睡不着了岂不是很麻烦？」",
