),
),
(
cmd: label,
args: (
name: "block_00652",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为反应过来的时候就已经睡着了，无力的小孩子也没有什么抵抗的方法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00653",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，也想过告诉爸爸。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00654",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，害怕得做不到。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00655",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算是来探望我的，也只是和平时一样装睡度过了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00656",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然告诉了阿姨，但她完全不理我，她坚信护士是不会做坏事的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00657",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并以这肯定也是治疗的一环来反驳我。除此以外，就是一如既往的微笑而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00658",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……所以我，学会了」",
