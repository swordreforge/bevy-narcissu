),
),
(
cmd: label,
args: (
name: "block_00634",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "难道说，为了使我不睡午觉，把绘本全部没收掉吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00635",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然含糊的想着那样的事，事实却和我预想的完全不同。",
voice: None,
),
),
