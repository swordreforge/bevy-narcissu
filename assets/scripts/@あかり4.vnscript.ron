),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这么说着，嘻嘻作出微笑的女人。\n对即便还是孩子的我，用的也是非常礼貌的语气。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这个无所谓的人，貌似即将要变成新的妈妈了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "貌似……这么说的原因，是因为我没有什么实感。\n某一天，就算突然被这么告知，“妈妈”什么的也叫不出来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即将……这么说的原因，是因为还不是正式的妈妈。\n但还是时不时的，会到家里来，来照顾我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然爸爸对我说，让我和她好好相处……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "老实说，我不是很喜欢这个人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
