(
cmd: dialogue,
args: (
speaker: None,
text: "一个月后。暑假快要结束，新学期即将到来时。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00394",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我还在这里。好像是因为检查结果还是不怎么乐观。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00395",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……大概都是因为吃了那个药吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00396",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "自从最开始那次检查吃过以后，每次检查当天的早上，我都会偷偷地吃。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00397",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不知道是为什么，但只要继续这样做，就能一直待在这里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00398",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然在这里，也会有讨厌的护士和医生。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00399",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，爸爸会温柔地对待我。也不用看到那个讨厌的阿姨。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00400",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "搞清楚了这些的我，比起回家，选择了待在这里……",
