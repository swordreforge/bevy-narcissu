),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听说她马上就要来一起住了，我厌恶得不得了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "为什么，会讨厌到那种地步，我自己也不清楚。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00039",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，经过的路人的话，我想还不至于如此讨厌。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也许是因为想到“那种人变成了新妈妈”，就格外讨厌了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00041",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是对我来说，也没有其他能去的地方。\n明明是我出生成长的家，都是之后到来的阿姨的错。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00042",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，到了晚上，虽然爸爸也会回来，但也不怎么来陪我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然工作是很忙来着，但其实是，因为阿姨的孩子更小。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "最近爸爸的口癖是，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "－你已经当姐姐了，忍耐一下。",
voice: None,
),
),
(
