),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "据说爸爸是个了不起的人。好像也在做大公司老板的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，时不时就会像这样，有不认识的女人过来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，不论是谁都一样，喜欢不上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，就和妈妈一起出门吧」",
voice: Some("li/hima_0004"),
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "跟往常一样，笑脸相向的阿姨。不变的温柔语气，绝对不会呵斥我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是……，做出了笑眯眯样子了的，“眼睛”却没在笑。",
voice: None,
),
),
(
