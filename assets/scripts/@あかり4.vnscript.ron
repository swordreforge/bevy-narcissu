),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不论我说什么，做什么，都是一副笑眯眯的样子。\n只是，默默地，向父亲打小报告而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……为什么，在自己的家里，悠闲放松一下而已，\n这个人却，自作主张闯进来，来照顾我呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: dialogue,
args: (
speaker: None,
