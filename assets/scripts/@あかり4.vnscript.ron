),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一直都保持着这样的笑容。只是在笑着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00035",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是那只是……被称为“奉承笑容”的东西。以小孩子的心境也能明白。",
voice: None,
),
),
(
