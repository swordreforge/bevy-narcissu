),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶呀，好像睡着了，要叫醒她吗？」",
voice: Some("li/kanC_0005"),
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「放着别管了。叫起来被找茬的话反而麻烦」",
voice: Some("li/kana_0020"),
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听到这个声音我醒了过来。但依然保持着闭眼的状态。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为长久以来的经历让我学会了，只要睡着就不用面对那些讨厌的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是医生说，这样晚上会睡不着的……」",
voice: Some("li/kanC_0006"),
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没事的啦。反正，来这里的孩子，全都是装病的」",
voice: Some("li/kana_0021"),
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呀，这样说有点过了吧？」",
voice: Some("li/kanC_0007"),
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……装病？听到了这样的词语。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你今年才刚来，还不知道吧」",
voice: Some("li/kana_0022"),
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「2年前，这里建成的时候，住院体检是在5月的时候做的」\n（校对注：五月病）",
voice: Some("li/kana_0023"),
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，这我知道，然后呢？」",
voice: Some("li/kanC_0008"),
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「然后啊，从去年开始，改成暑假期间之后……」",
voice: Some("li/kana_0024"),
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「来看病的人，还不到以前的一半了」",
voice: Some("li/kana_0025"),
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这种就是，懒病哟，懒病。想睡觉什么的，不想动的那种」",
voice: Some("li/kana_0026"),
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，其中也有真正生病的人吧？」",
voice: Some("li/kanC_0009"),
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊哈哈，没有的没有的，都是小孩子在撒娇而已」",
