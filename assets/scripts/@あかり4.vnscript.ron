),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听到了爸爸的声音。还感觉到了其他几人的气息。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00403",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我刚想马上起床，却又停住了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00404",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果现在，直接起来的话，说不定装睡的事就会暴露掉了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00405",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如此想到的我，就接着那样继续装睡。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00406",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这也是，病情导致的吗？」",
voice: Some("li/tpapa_0018"),
),
),
(
cmd: label,
args: (
name: "block_00407",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，这是……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00408",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「老实说，我也不太清楚」",
