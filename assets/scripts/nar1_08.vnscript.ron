),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她慢慢地走向了大海。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: play_se,
args: (
file: "nami3",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "海浪拍打着沙滩。\n长发在冰冷的海风中飘动着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从空中飘下的点点雪花，更增添了几分寒意。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这样一幅背景下，她双手拿着鞋子...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "喜悦地，兴奋地，在水中漫步着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐...有模特的感觉吗？」",
voice: Some("li/nv391c"),
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，还可以吧...」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在寒冬的空气中，我们的气息化作了白雾。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "之后，我掏出了从车里带出的照相机。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...是那台简陋的一次性相机。\n里边还剩下最后的１张胶卷。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那我就准备拍了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
