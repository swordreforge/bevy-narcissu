),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有时，强风会带动松林摇摆，\n同时掀起海潮的声响。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00002",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，只有这个哦」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00003",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我将印刷着白石建筑公司字样的浴巾递给了她。\n那是我们曾经用来擦身的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「.........」",
voice: Some("li/n386"),
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「别那么失望嘛」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...嗯」",
voice: Some("li/n387"),
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她有些不满地接过了浴巾。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我根本就没办法去给她找泳装。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "何况，她居然在这个季节，\n这个地方，提出想要比基尼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我没有办法，只好在车里翻找了一通，\n最终从那堆衣物里找出了这白色的浴巾。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "片刻之后...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她穿着心爱的裙子，将浴巾卷在胸前回来了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...怎么样？」",
voice: Some("li/nv388b"),
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呃，该怎么说呢...」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「看上去...不奇怪吧？」",
voice: Some("li/nv389b"),
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯...大概没问题吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「..................」",
voice: Some("li/n055"),
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，一点问题也没有，一点也不奇怪的」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，知道了...」",
