),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「一定...会拍出更多模特的感觉来的」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，我举起了相机。",
