),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "或许是因为紧张，或许是因为害羞...\n她的表情显得很复杂。",
