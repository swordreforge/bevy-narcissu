),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "哗啦哗啦",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂，哇哇，好冷，冷死了」",
voice: Some("li/n4yoko_0368"),
),
),
(
cmd: label,
