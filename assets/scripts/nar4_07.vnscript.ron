channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你也现在才回来啊？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00249",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「恩，稍微晚了一点点」",
voice: Some("li/np4imo_1083"),
),
),
(
cmd: label,
args: (
name: "block_00250",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "博美几天前开始去美容院打工了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00251",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前我都以为她是在开玩笑，但是现在看来她是真的想成为一名美容师。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00252",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……以前还只是模糊的目标或梦想。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00253",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "无论本人愿意与否，到了高三这个年纪，都将要把理想向着现实改变。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00254",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「最近阳子好像都没去学校呢……」",
voice: Some("li/np4imo_1084"),
),
),
(
cmd: label,
args: (
name: "block_00255",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，本来她身体也不是很好」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00256",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真希望她能早点好起来呀……\u{3000}院里的人们也都在担心她呢」",
voice: Some("li/np4imo_1085"),
),
),
(
cmd: label,
args: (
name: "block_00257",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是啊」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00258",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我点了点头。没有她在，养老院里的气氛都冷清了起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00259",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这么一想，那家伙的存在已经变得不可或缺了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00260",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "仔细想想，除了做甜甜圈以外，她平时对院里的活动也都非常的热心。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00261",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对院里那些长辈们来说，因为跟孙女差不多的年龄，就更加如此吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00262",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「而且……哥哥你现在看起来就是最为寂寞的一个呢」",
voice: Some("li/np4imo_1086"),
),
),
(
cmd: label,
args: (
name: "block_00263",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「笨蛋，说什么呢……就算没了日下还不是……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00264",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一样。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00265",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "哪怕是故作坚强，我也没能说下去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00266",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且在一直守望着我俩直到今天的妹妹面前，这种逞强不管用。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00267",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，有件事我以前就在想了……」",
voice: Some("li/np4imo_1087"),
),
),
(
cmd: label,
args: (
name: "block_00268",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「为什么哥哥把阳子姐姐称作日下呢？」",
voice: Some("li/np4imo_1088"),
),
),
(
cmd: label,
args: (
name: "block_00269",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00270",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「明明都喜欢着对方，还不好意思呢？」",
voice: Some("li/np4imo_1089"),
),
),
(
cmd: label,
args: (
name: "block_00271",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹妹……不，这种事谁都无法理解的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00272",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……这样就好了，因为这是场与谋士的战斗」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00273",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「谋士？」",
voice: Some("li/np4imo_1090"),
),
),
(
cmd: label,
args: (
name: "block_00274",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我们俩之间，有着几个只有我们才能领会的规矩或是约定。\n也有很多事即使不说出口也能相互明白。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00275",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是妹妹这样对我说……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00276",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，我觉得有时候还是应该用语言表达一下呢。」",
voice: Some("li/np4imo_1091"),
),
),
(
cmd: label,
args: (
name: "block_00277",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00278",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「如果爱她，就告诉她呀」",
voice: Some("li/np4imo_1092"),
),
),
(
cmd: label,
args: (
name: "block_00279",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00280",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……或许是该这样吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00281",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "无论觉得多么心有灵犀，有些时候还是要用语言来表达的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00282",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，我们已经在一起生活了许多年……即便不说出口也能相互明白，正因为如此……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00283",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……也就多了很多，开不了口的事情……",
voice: None,
),
),
