),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，父亲低下了头。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00382",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "总会说我净瞎胡闹，一直把我当个混蛋小子看待的老爸……\n竟然在我的面前低下了头……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00383",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我能感觉到一丝喜悦，但又总觉得有些落寞。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00384",
),
),
