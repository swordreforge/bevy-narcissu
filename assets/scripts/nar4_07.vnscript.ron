),
),
(
cmd: label,
args: (
name: "block_00289",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂喂，这里都是重点，一定要好好记住」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00290",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从夏天开始日下就常常请假在家。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00291",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且请假的天数逐渐开始越来越多，现在差不多一周已有一半的时间都在家休息了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00292",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "反过来说，一周也有一半的时间去上学，也还是会跟以前一样到养老院里来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00293",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "到现在也没听她说具体得了什么病，也并没觉得有那么严重……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00294",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是眼下马上就要到考试季了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00295",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……如果日下真的是以成为医生为目标的话，是必须要考上好大学的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00296",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前她的目标是去东京上国立大学。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00297",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……呐，莳绘君准备考哪里？」",
voice: Some("li/n4yoko_0422"),
),
),
(
cmd: label,
args: (
name: "block_00298",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这个，不是早就决定过了吗……」",
voice: None,
),
),
(
