(
cmd: dialogue,
args: (
speaker: None,
text: "「而且你看呀，很多学校都没有医学部的……」",
voice: Some("li/n4yoko_0410"),
),
),
(
cmd: label,
args: (
name: "block_00192",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下相当不假思索地说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00193",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是的。目前，这家伙依然怀抱着一个成为医生的梦想。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00194",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然一开始并不知道她认真到什么程度……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00195",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但到了这个时候，她还这么说的话，或许真是认真的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，想到达成这个梦想，本人的学习实力有些不足也是事实。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00197",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是啊，要是真的上了国立大学，就要离开这个城市了吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: dialogue,
args: (
speaker: None,
