args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样说着，这次日下的提案是把院子里的树装饰成圣诞树。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "养老院里的老年人当中，很多人并不知道圣诞节是什么……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然她本人倒是毫不在意的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―阳子好像又要做什么呢。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这么笑着说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于日下这个有些奇怪？的提案，院里的人也照例接受，\n好像还不知不觉的有些期待着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
