args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对了，要不要做个蛋糕试试？」",
voice: Some("li/n4yoko_0400"),
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「蛋糕？\u{3000}你会做吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唔，虽然不太会，但是既然有烤箱，总归会有办法的吧」",
voice: Some("li/n4yoko_0401"),
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那就试着做做看了」",
voice: Some("li/n4yoko_0402"),
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
