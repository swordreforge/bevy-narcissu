args: (
name: "block_00285",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "漫长的夏季终于结束了。不知不觉，吹来的风都开始感到微微凉意了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00286",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "今天我也在她的房间里给她讲解笔记。",
voice: None,
),
),
(
