channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "强劲的冷风，摇曳着远处的松原。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00394",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们在海边坐下，互相都沉默地眺望着大海。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00395",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「已经变得这么冷了……」",
voice: Some("li/n4yoko_0433"),
),
),
(
cmd: label,
args: (
name: "block_00396",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是啊……已经变得这么冷了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00397",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们都下意识地伸出各自的手握在了一起。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00398",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在冰冷的寒风中，身体有些微微发抖。唯独紧握的双手，变得特别温暖。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00399",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，日下，我，打算参加大学的考试了。」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00400",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，这样我也感到很高兴」",
voice: Some("li/n4yoko_0434"),
),
),
(
cmd: label,
args: (
name: "block_00401",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对话仅此而已，然后又继续沉默地眺望大海。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00402",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并没有再说些什么，就这样一直眺望大海……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00403",
),
),
