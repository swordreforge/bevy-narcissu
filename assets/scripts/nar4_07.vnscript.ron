args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着二人就开始闹哄哄的装饰起屋子来。\n于是，远远围住看着她们的院里的人们也开始兴致勃勃地帮起忙来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我想这个设施一定在各方面都还处于摸索状态吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "现在像我们这样的养老设施本身就很稀少，来自美国或者欧洲发达国家的情报也很少。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以可学习的其他经验也很少。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，我想，也许在此之中莳绘之家也变化非常大……不，也许也在进步吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，这之中受到日下的影响很大。\n在那家伙出现在这里之前，到处都还是阴沉沉的氛围。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽说是有活动，但就只是新人来的时候做些甜甜圈而已，别的什么都没有……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
