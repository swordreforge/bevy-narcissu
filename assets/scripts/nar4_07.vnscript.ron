),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但也只是在屋子里躺着，看上去也不像很严重的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00234",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……当然，我也不大清楚，她具体得了什么病或者有什么症状等等。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00235",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，我知道她不是那种会因为偷懒请假不去学校的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00236",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且像这样请假的情况，之前也有见过几次。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00237",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……她身体很弱。这是我以前就知道的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00238",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我也知道她从不勉强自己，一直都挺保重身体，这几年也都平平安安的健康度过了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00239",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是最近突然开始动不动就请假，这让我感到很担心。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00240",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那开始学今天的数学吧……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00241",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "按照以前的约定，我会把课上教的内容再教给她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00242",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我不禁想起以前却是恰好相反的情形。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00243",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前总是因为我家里的工作而常常请假。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00244",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下总是给那时候的我讲授当天上过的课程。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00245",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，不知道从什么时候开始，我教她的次数开始多了起来……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00246",
),
),
(
