),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "于是日下带着妹妹走向了厨房。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "结果，没过多久……我在院子里等着的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
