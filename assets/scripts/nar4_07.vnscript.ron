(
cmd: dialogue,
args: (
speaker: None,
text: "「今年也还能在同一个班级，太好了呢」",
voice: Some("li/n4yoko_0406"),
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并排在我身边走着的日下说道。\n像这样一起在樱花树的道路走着也已经不知道是第几年了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，在这所升学高中，我们今年也是三年级生了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00180",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "回想起当初本来是陪着这家伙升学的我，不知不觉地也成为了一名真正的考生。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说起来，你想考哪里？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00182",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「当然是国立的一本咯。哎嘿」",
voice: Some("li/n4yoko_0407"),
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎嘿什么呀。之前的摸底考试排名多少啊？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
