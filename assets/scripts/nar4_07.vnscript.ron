channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她们两人就端着一盘谜之物体回来了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呜，对不起。好像失败了……」",
voice: Some("li/n4yoko_0403"),
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "总之我作为初次见识的提问是，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……卡斯特拉蛋糕？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哥哥真是失礼呀。至少要说成薄煎饼好吗」",
voice: Some("li/np4imo_1076"),
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我觉得不如说是人形烧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是她们两个还在毫不气馁地分给院里的人吃。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「来，给。很好吃的哦」",
voice: Some("li/np4imo_1077"),
),
),
(
cmd: label,
args: (
name: "block_00161",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「还有很多呢，大家不要客气哦」",
voice: Some("li/n4yoko_0404"),
),
),
(
cmd: label,
args: (
name: "block_00162",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「谢谢，人形烧还挺少吃到的」",
voice: Some("li/etcm3_1019"),
),
),
(
cmd: label,
args: (
name: "block_00163",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，这不是人形烧……而是薄煎饼啦……」",
voice: Some("li/np4imo_1078"),
),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「薄煎饼？」",
voice: Some("li/etcm3_1020"),
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，叫做薄煎饼哦」",
voice: Some("li/np4imo_1079"),
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂大家ー，博美她们，做了个薄煎人形烧哦」",
voice: Some("li/etcm3_1021"),
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嚯，这人形烧看上去还挺好吃的嘛」",
voice: Some("li/etcw2_1020"),
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，这不是普通的人形烧，好像是什么薄煎人形烧」",
voice: Some("li/etcm3_1022"),
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎，是人形烧的变种啊」",
voice: Some("li/etcw2_1021"),
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
