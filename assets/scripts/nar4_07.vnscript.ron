),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "秋日渐渐地过去，终于将要迎来冬天了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「马上就到圣诞节了呢」",
voice: Some("li/n4yoko_0398"),
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: set_bg,
