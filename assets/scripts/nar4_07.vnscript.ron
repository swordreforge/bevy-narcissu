),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―来年。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00404",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如此漫长的冬天过去了……到了街边樱花树都同时盛开的四月。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00405",
),
),
(
cmd: set_bg,
args: (
image: "sora01",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "换做平时，我们应该一同穿过樱花树的拱门。\n应该还在同一个班级，正要跟那家伙大声嬉闹……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00406",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "最终，我考上了大学。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00407",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样一来，成为医师的这个目标，我算是成功了第一步……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00408",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，总觉得心中还留有一个去不掉的心结。不舍的是，在此暂时要和日下分开了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00409",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "东京很远。６年很长。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00410",
),
),
(
