),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "顺便一提是整个年级４００人中的第２２０名。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这个升学学校里虽然也有格外努力的人，但是以国立大学作为目标还是太困难了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说起来，比陪她一起上学的我成绩还差是怎么回事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，你有考虑过放弃国立去上私大么？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
