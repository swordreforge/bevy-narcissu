),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……你，这样也愿意吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00200",
),
),
(
cmd: dialogue,
args: (
speaker: None,
