),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "１１月的纯白天空。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00385",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我陪着时隔３天才又去学校的日下，跟往常一样肩并肩放学回家。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00386",
),
),
(
