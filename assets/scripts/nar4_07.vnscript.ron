channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「阳子，有什么可以帮忙的吗？」",
voice: Some("li/np4imo_1074"),
),
),
(
cmd: label,
args: (
name: "block_00138",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我看看，那就拜托博美装饰一下谈话室吧。」",
voice: Some("li/n4yoko_0399"),
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，把彩纸裁好做成一个圈是吧」",
voice: Some("li/np4imo_1075"),
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_009a",
transition: Some(fade(
duration: 0.8,
)),
),
),
