channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "又到了太阳渐渐西沉的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00247",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，哥哥……」",
voice: Some("li/np4imo_1082"),
),
),
(
cmd: label,
args: (
name: "block_00248",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_001c",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
