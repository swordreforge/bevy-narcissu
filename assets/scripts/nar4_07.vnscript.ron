),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂喂，你是在挑衅我吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真是的，你倒是来追我呀。光我一个人在这里跑多丢脸呀……」",
voice: Some("li/n4yoko_0365"),
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这回还闹起了别扭。真是麻烦呐。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「看招——要泼水了哦」",
voice: Some("li/n4yoko_0366"),
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: play_se,
args: (
file: "water02",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「等，好冷」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这家伙，还用水泼我……而且一下子就把我上半身全部打湿了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哇，对不起。比预想的泼多了」",
voice: Some("li/n4yoko_0367"),
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「都这样了，道歉也太晚了点……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
