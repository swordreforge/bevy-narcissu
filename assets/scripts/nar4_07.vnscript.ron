args: (
speaker: None,
text: "我当然是打算跟她上同一所学校。虽然我没有说出来过，但我觉得这是理所当然的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00302",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我以为对我来说这是自然而然的事，也以为她也对此心知肚明。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00303",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然而，不知道为什么日下的表情有些低落。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00304",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正当我打算问她到底怎么了的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00305",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「其实……今天，学校的老师跟我说……」",
voice: Some("li/n4yoko_0423"),
),
),
(
cmd: label,
args: (
name: "block_00306",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我，今年可能要留级了」",
voice: Some("li/n4yoko_0424"),
),
),
(
cmd: label,
args: (
name: "block_00307",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎？……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00308",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……留级？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00309",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "啊，不过……这也不是没可能。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00310",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然突然听到这个消息有点惊讶，但是日下从进入三年级开始……\n尤其从这个夏天开始一直在频繁休学。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00311",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，你现在的情况，只要在考试里取得好一点的成绩就可以了吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00312",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嗯，要毕业的话应该还是没问题的……」",
voice: Some("li/n4yoko_0425"),
),
),
(
cmd: label,
args: (
name: "block_00313",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，考大学的话，就比较勉强了……」",
voice: Some("li/n4yoko_0426"),
),
),
(
cmd: label,
args: (
name: "block_00314",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，降一点标准怎么样？\u{3000}也不是非得上国立的嘛」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00315",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不用，莳绘君不用管我，去考你想上的大学就好」",
voice: Some("li/n4yoko_0427"),
),
),
(
cmd: label,
args: (
name: "block_00316",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂日下……这样不就没有意义了……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00317",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我本来连高中也没有升学的打算。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00318",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然如此，明明是为了能陪伴她上学为前提才努力到现在的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00319",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下能不能以医生为目标我都无所谓，\n但是如果就这样分开的话，不就完全是本末倒置了吗。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00320",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，也不是啦……」",
voice: Some("li/n4yoko_0428"),
),
),
(
cmd: label,
args: (
name: "block_00321",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不如，莳绘君成为医生吧」",
voice: Some("li/n4yoko_0429"),
),
),
(
cmd: label,
args: (
name: "block_00322",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶……我吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00323",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我还从来没想过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00324",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……让我，去做医生……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00325",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "确实，养老院里是需要一个医生的，我也考虑过好几次。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00326",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，那个人不会是我，我没想过自己去当医生这件事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00327",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎嘿嘿，其实，我也开始觉得自己是不是有点勉强了」",
voice: Some("li/n4yoko_0430"),
),
),
(
cmd: label,
args: (
name: "block_00328",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……日下……但是这……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00329",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是她无视了我的犹豫接着说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00330",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你看，这本课堂笔记……基本上都是莳绘君写的吧？」",
voice: Some("li/n4yoko_0431"),
),
),
(
cmd: label,
args: (
name: "block_00331",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，她看向那本我抄满了课堂笔记的本子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00332",
),
),
(
cmd: set_bg,
args: (
image: "n4ime_005",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我呢，只写了开头的几页而已……」",
voice: Some("li/n4yoko_0432"),
),
),
(
cmd: label,
args: (
name: "block_00333",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "笔记本上，我的字密密麻麻的写满了整页。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00334",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那确实是……日下的笔记本，但是里面的内容基本都是我在写。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00335",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "按照以前的约定，只是让我抄课堂笔记而已……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00336",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "与之相对的，那本交换日记。那里面是她写的文字。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00337",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "几乎跟课堂笔记成反比，她那本阳子备忘录的内容却在不断增加……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00338",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: set_bg,
args: (
image: "sora07",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "深秋时节的夜晚变得格外短暂。大大的月亮也在这澄澈的夜空中露出了脸。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00339",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我一边抬头看着月亮，一边独自走在回家路上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00340",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我要以医生……不，医师为目标吗……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00341",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我不停地喃喃自语着同样的话。不管怎么说我依然对这件事毫无实感。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00342",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "事情发展到这一步，完全超乎了我的意料……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00343",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我确实多次想过需要一个医生这件事。也不是真的完全没考虑过我自己当医生。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00344",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……只是，认识了她以后……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00345",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "比起期望有一个医生的心情，我觉得能跟她生活在一起才是最重要的事……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00346",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_004c",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，哥回来了啊」",
voice: Some("li/np4imo_1093"),
),
),
(
cmd: label,
args: (
name: "block_00347",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……嗯啊，回来了……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00348",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我轻声跟跑来的妹妹打了招呼。她像是刚好做完明天的准备。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00349",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯？\u{3000}没什么精神嘛……」",
voice: Some("li/np4imo_1094"),
),
),
(
cmd: label,
args: (
name: "block_00350",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然我脸上并没有什么表情变化，博美还是关切地看着我。\n她跟日下一样，在她们面前隐瞒不了什么。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00351",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看着妹妹，我决定问问她关于刚才我思考的事情的想法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00352",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我问你啊，你觉得我们这有必要找一个医生吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00353",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么了，突然问这个？」",
voice: Some("li/np4imo_1095"),
),
),
(
cmd: label,
args: (
name: "block_00354",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你就说有没有必要嘛」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00355",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「作为一样在这里工作的人，客观地说下你的想法吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00356",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那肯定还是有一个比较好吧……」",
voice: Some("li/np4imo_1096"),
),
),
(
cmd: label,
args: (
name: "block_00357",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她的回答在我意料之中。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00358",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为妹妹也跟我一样，到现在已经送走了许多人，这样的回答也是当然的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00359",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "鲜有离开这里后能回到自己家的人。大多数都是去了医院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00360",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这里不是医疗设施。虽说如此，也不是个普通的家。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00361",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即便，这里连什么正经的医疗设备都没有……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00362",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正因为是这样的场所，就更希望能有一个医生……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00363",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_003c",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "道理上来讲，以成为医师为目标也是应该的。虽然我知道这点，也不免有许多牵挂。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00364",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "其中之一就是会跟日下分开。而另一方面，就是在那期间养老院的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00365",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……如果我真的打算成为医师，最少也要花去六年。\n明明现今也通过全家的努力终于能维持住这里了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00366",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "纠结到最后，我决定跟父母谈谈。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00367",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_009c",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎，妈妈你怎么看？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00368",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这不是挺好的嘛，我很支持哦」",
voice: Some("li/np4mama_1010"),
),
),
(
cmd: label,
args: (
name: "block_00369",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，我也同意」",
voice: Some("li/np4papa_1053"),
),
),
(
cmd: label,
args: (
name: "block_00370",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，这段时间，家里的事我就帮不上忙了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00371",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎你，说话这么客气干什么」",
voice: Some("li/np4papa_1054"),
),
),
(
cmd: label,
args: (
name: "block_00372",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就是呀。\u{3000}这里的事你不用担心，总会有办法的」",
voice: Some("li/np4mama_1011"),
),
),
(
cmd: label,
args: (
name: "block_00373",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是老爸……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00374",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我知道家里人手一直都很紧。毕竟我从小就开始在家里帮忙也不是装装样子的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00375",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我也知道妹妹博美为了成为美容师打算去上专科学校了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00376",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且我家也没有那么富裕。不过是整个家族一起经营了一个小小的养老院而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00377",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，我正在考虑这些事的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00378",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我说博史，你的人生，是你自己的东西……不是吗？」",
voice: Some("li/np4papa_1055"),
),
),
(
cmd: label,
args: (
name: "block_00379",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「应该说到现在为止一直都太依赖你们了才是」",
voice: Some("li/np4mama_1012"),
),
),
(
cmd: label,
args: (
name: "block_00380",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「作为父母我们一直都觉得很抱歉……」",
voice: Some("li/np4papa_1056"),
),
),
(
cmd: label,
args: (
name: "block_00381",
),
),
(
