),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "窗外能看到，秋天的月亮。淡淡的月光，把房间里面也照亮了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "再次闭上眼睛的时候，听到了身边轻轻的呼吸声。偶尔，也会嘟哝几句梦话……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……到现在我们已经轮流写了三年多的交换日记。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那一天。也可以一道总结着写，新的规则诞生了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
