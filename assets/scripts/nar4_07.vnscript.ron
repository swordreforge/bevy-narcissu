),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那我走了……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00411",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯。一路顺风……」",
voice: Some("li/n4yoko_0437"),
),
),
(
cmd: label,
args: (
name: "block_00412",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "清晨的车站还没有什么人。我和来到月台为我送行的日下一起等待着电车。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00413",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……想起来，自从第一次并肩行走的那天开始，我们就一直在一起。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00414",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不管做什么都在一起。不管去哪里都在一起。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00415",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们做出一个又一个约定，心照不宣的事情也很多。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00416",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知不觉中，她在我的身边已经是一件理所当然的事情……\n对于我们从今往后也会一直在一起这个想法也从未抱持疑问。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00417",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对我们来说，第一次这样子分开，或许称得上是『试炼』了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00418",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正因如此，我郑重地跟她说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00419",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「日下……我不会说要你一直等我」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00420",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我希望的是，你也能尽快到我这里来」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00421",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/n4yoko_0438"),
),
),
(
cmd: label,
args: (
name: "block_00422",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我并不是想要让她也努力升学或是以成为医师为目标。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00423",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我只是，希望她在我的身边。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00424",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即使这是我个人的私心……我也希望她能够在我身边。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00425",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "本以为我们能够一直在一起生活下去，却未曾料到如今竟要分隔数年。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00426",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以我不愿意留下她一个人，我希望她能到我这里来……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00427",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「然后，我们再一起回这里来」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00428",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但，但是，那个……」",
voice: Some("li/n4yoko_0439"),
),
),
(
cmd: label,
args: (
name: "block_00429",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/n4yoko_0438"),
),
),
(
cmd: label,
args: (
name: "block_00430",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知道为什么，面对我的提案，她再次沉默了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00431",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……虽然从前没有说出口，但是如果是我的话，明明这么说应该就会明白的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00432",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明我觉得如果是她的话一定会很高兴的……但是，她只是落寞地低着头。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00433",
),
),
