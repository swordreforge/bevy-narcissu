),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下一脸悲惨样，怨恨地看着我。虽然怎样都无所谓，但她的表情还挺有趣的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，抱歉。好像玩过头了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真是的，太过分了，莳绘君……」",
