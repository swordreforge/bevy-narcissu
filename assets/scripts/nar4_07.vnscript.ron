),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "好久没来过海边了。我们如同以前一样在岸边玩耍。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然因为前几天的事情，现在情绪还有些低落。\n但又难得没什么工作，便久违地来到了这里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我说日下，我之前也说过……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯？\u{3000}怎么啦莳绘君？」",
voice: Some("li/n4yoko_0362"),
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这一带偶尔会有大浪拍过来，小心啊」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「放心啦。真是爱操心呢」",
voice: Some("li/n4yoko_0363"),
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从你嘴里说出的放心不可相信。因为，明明笨手笨脚的，也有得意忘形的一面。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下无视了我的担心，在沙滩上奔跑着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
