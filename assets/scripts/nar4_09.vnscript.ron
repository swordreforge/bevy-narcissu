),
),
(
cmd: label,
args: (
name: "block_00206",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「日下……我已经，想回东京去了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00207",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我觉得这样对你也有好处……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00208",
),
),
(
cmd: dialogue,
args: (
speaker: None,
