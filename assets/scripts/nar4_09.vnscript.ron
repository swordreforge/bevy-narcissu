),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在那之后也是以同样的感觉打招呼……和之前一样，她的态度没有变。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00172",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不如说感觉变得更糟了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00173",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前会回复『不了……』之类的话，现在什么话都不说，什么回复都没有。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00174",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "似乎和这种糟糕的反应成正比的，病情也一点点恶化了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00175",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "无论如何，不吃东西是不好的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00176",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「让我作为医生，而不是作为我个人对你说吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「最起码，还是请好好吃饭吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/n4yoko_0461"),
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，对这些话也没有特别的反应。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00180",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "眼睛像是看着我的方向，却并没看着我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就好像，看不到我的身影一样……仿佛在凝视着什么更远的地方……",
