name: "block_00122",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是，如果是这样……那会是让我无法承受的，悲伤的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00123",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「让我……不，能不能让我来当她的主治医师呢？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00124",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「莳绘先生，你来做吗？」",
voice: Some("li/etcm2_1013"),
),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着主治医师露出惊讶的表情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不用明说也能明白。这等于是同意退出现在的精英路线。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我倒没有关系……但你是想从东京的医科大学医院辞职吗？」",
voice: Some("li/etcm2_1013_1"),
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是的，没关系」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我坚定地回答。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
