args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哦。果然还是去找了呢……」",
voice: Some("li/n4setu_036"),
),
),
(
cmd: label,
args: (
name: "block_00003",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，就从那开始拼命地寻找了」",
voice: Some("li/np4syu_1554"),
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……找到了吗？」",
voice: Some("li/n4setu_037"),
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没有……哪里都没有」",
voice: Some("li/np4syu_1555"),
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「和妹妹两个人竭尽全力……」",
voice: Some("li/4syuji_064"),
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「也拜托了私人侦探所，结果还是没找到」",
voice: Some("li/4syuji_065"),
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "他继续落寞地回答道。和现在不同，也有受限于那个时代的缘故，他又补充道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这样啊……可惜呢……」",
voice: Some("li/n4setu_038"),
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，那之后不久……」",
voice: Some("li/4syuji_066"),
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，他再次开始讲述。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "应该是位医院里了不起的人物，不知为何却一直向我讲述着……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
