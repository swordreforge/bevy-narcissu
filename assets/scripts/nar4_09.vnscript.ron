text: "１１月澄澈的天空。吹拂的风，将要正式变成冬天的事物。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00001",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样的天气下，这位坐在中庭长椅上的人，仍在对我诉说他的故事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00002",
),
),
(
