args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明连私人调查所都拜托了，却也没找到……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是有一点我开始理解了。一直知道她从一开始就身体很弱。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00047",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而无论哪里的私人调查所，如果对方是在那里正常生活的话，是很容易找到的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00048",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是在特别的地方……比如，在医疗设施里长期住院的话，找起来就很困难了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00049",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并且她的情况，是为了躲避我，我觉得她的双亲也体察这个意思。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那么，至今为止无论怎么普通地去找怎么也找不到也是可以理解的。",
voice: None,
),
),
(
