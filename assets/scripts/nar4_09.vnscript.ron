args: (
speaker: None,
text: "沐浴着日光，混凝土大楼看起来在摇曳。蝉儿有些性急，努力宣告着现在就是夏天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00303",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "穿过响彻耳际的蝉鸣，我伸出手……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00304",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐……你啊，不冷吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00305",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶……」",
voice: Some("li/n4yoko_0469"),
),
),
(
cmd: label,
args: (
name: "block_00306",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我很冷啊……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00307",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/n4yoko_0470"),
),
),
(
cmd: label,
args: (
name: "block_00308",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯。是呢，有点冷呢」",
voice: Some("li/n4yoko_0471"),
),
),
(
cmd: label,
args: (
name: "block_00309",
),
),
(
cmd: set_bg,
args: (
image: "w",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后我们……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00310",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……牵起了手。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00311",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "相隔数年牵起的那只手，宛若曾经。小小的、软软的……又很温暖。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00312",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶嘿嘿，能这样相通的，只有我们吧」",
voice: Some("li/n4yoko_0472"),
),
),
(
cmd: label,
args: (
name: "block_00313",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「当然了……能这样相通的，找遍全世界也只有我们」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00314",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯、嗯嗯、是、是这样呢、嘤……」",
voice: Some("li/n4yoko_0473"),
),
),
(
cmd: label,
args: (
name: "block_00315",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「一、一定只有莳绘君呢……」",
voice: Some("li/n4yoko_0474"),
),
),
(
cmd: label,
args: (
name: "block_00316",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所，所以、已经……」",
voice: Some("li/n4yoko_0475"),
),
),
(
cmd: label,
args: (
name: "block_00317",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不、不要再和我的人生有关联了」",
voice: Some("li/n4yoko_0476"),
),
),
(
cmd: label,
args: (
name: "block_00318",
),
),
(
cmd: set_bg,
args: (
image: "n4ev_0012",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……那天，一下子偶然相识的我们……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00319",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明那么不可靠，在奇怪的地方却很来劲……\n无论做什么、无论去哪都一直在一起的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00320",
),
),
(
cmd: set_bg,
args: (
image: "n4ev_002b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "多少个夜晚聊到天亮，诞生了两个人之间的规矩……\n不知不觉，陪伴在身边已经成了理所当然……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00321",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……成了不可或缺的存在的日下。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00322",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那样的她，在哭泣。没有任何人的屋顶上，响着那悲伤的呜咽声。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00323",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―不要再和我的人生有关联了―",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00324",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是，为了否定我……为了否定迄今为止我们的全部而哭泣……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00325",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_019a",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那没法做到……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00326",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算，即使是偶然的相遇……如今，这样在一起，是我的意志。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00327",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，莳绘君、今后无论几年、几十年……」",
voice: Some("li/n4yoko_0477"),
),
),
(
cmd: label,
args: (
name: "block_00328",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「可以幸、幸福地生活、可以结婚、生孩子……」",
voice: Some("li/n4yoko_0478"),
),
),
(
cmd: label,
args: (
name: "block_00329",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「然而和我的交往、仅仅只有半年了……」",
voice: Some("li/n4yoko_0479"),
),
),
(
cmd: label,
args: (
name: "block_00330",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这是……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00331",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……最初的约定。我曾告诉过她不要和来养老院的人许下约定。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00332",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "意思便是不要和能看到死亡的人约定将来……\n不要和在等候室里排队等候的人产生关联的规矩。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00333",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……离开的人和被留下的人，永远没有交集。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00334",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这两者无法妥协或让步。彼此之间有绝对不可能跨越的界限。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00335",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……那些事情，我也知道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00336",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然知道……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00337",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……尽管如此……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00338",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……那，许下新的约定吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00339",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「再去海边玩吧……明年也去，后年也去」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00340",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶、但是……那就打破以前的约定了……」",
voice: Some("li/n4yoko_0480"),
),
),
(
cmd: label,
args: (
name: "block_00341",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……即使是那种无法实现的事情……即使是无法踏入的界限前方的对象……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00342",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不是其他人。正因为是我才要打破。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00343",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不是医生也不是神明大人……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00344",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是，是超越那些的人……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00345",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果对日下而言，那是我的话……并且，如果对我而言，日下就是那个对象的话……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00346",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就必须超越矛盾……必须打破规定……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00347",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……规则里，例外是常有的吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00348",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什、什么啊、这、这么狡猾、是犯规的哦」",
voice: Some("li/n4yoko_0481"),
),
),
(
cmd: label,
args: (
name: "block_00349",
),
),
