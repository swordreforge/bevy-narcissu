channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "回过头，在那里的是Ｘ光的医生同事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你好像在找人吧？」",
voice: Some("li/etcm1_1008"),
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……怎么了，突然说起这个？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，是你妹妹，博美拜托的……」",
voice: Some("li/etcm1_1009"),
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……博美那家伙？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，在寻找的当事人应该只有一个。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「前些天……我见过一个叫日下阳子的患者」",
voice: Some("li/etcm1_1010"),
),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00035",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛，虽然可能是同名同姓……\u{3000}是那个患者吗？你找的人？」",
voice: Some("li/etcm1_1011"),
),
),
(
cmd: label,
args: (
name: "block_00036",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不由得呼吸都停止了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00037",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们付出那么多努力，却没能找到……没想到会在这么意料之外的地方找到……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你说她住院了，在哪？\u{3000}在哪个医院？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00039",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂，冷静点，是在我们的金泽那边」",
voice: Some("li/etcm1_1012"),
),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "金泽。他指的是这个大学体系内的位于金泽的医院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00041",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "东京和金泽不仅隔得很远，认错人的可能性也有……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00042",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我连行李都没有拿，急忙赶去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
