channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「―这样的话，我终于成为一名真正的医生了―」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_0054",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
