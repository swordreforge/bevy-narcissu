),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "清晨的屋顶上，响起性急的蝉鸣声。也听到了和那声音混在一起的那家伙的哭声。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00350",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……那一天，我们……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00351",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……制定了新的规定。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00352",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "时隔数年后诞生的，那是……任何人都不能侵犯的约定。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00353",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只属于我们二人的，神圣之誓言……",
voice: None,
),
),
(
