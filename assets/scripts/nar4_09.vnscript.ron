),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，这个时候指的是我的存在。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也许，如果我不来这里，她也会正常地吃饭吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……本来以为是件好事，要是反倒对她没有好处的话……",
