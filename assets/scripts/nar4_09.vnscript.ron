),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "春天再次到来。到了实习期也已经结束的时候。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: set_bg,
args: (
image: "sora01",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
