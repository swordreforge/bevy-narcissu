),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边说着，我坐在床旁边的折叠椅上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00194",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这几天，虽然并没有特地的安排，来到这里却是每日的既定事项。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00195",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，日下，吃布丁吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/n4yoko_0470"),
),
),
(
cmd: label,
args: (
name: "block_00197",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这个很好吃哦。因为你喜欢吃布丁，我从儿科病房带过来了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并没有特别地回复，但我像往常一样继续说着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，说起来，以前人行横道的岩浆」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00200",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「作为那个的防御反击，最近据说增加了１０秒的屏障了哦」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00201",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着轻轻笑起来。当然，我知道她没有回应。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00202",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以就好像……在没有人的房间里一个人说话一样……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00203",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一个人，持续说着很开朗很开朗的话。冷冰冰的病房里，回响着我一个人的笑声……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00204",
),
),
