),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "呼。走出走廊，小小地呼出一口气。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00163",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……很明显，是在躲避我。从刚才她的样子，也能切实感受到。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从以前的主治医师那里，并没有听闻她有这样的态度。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那么，只是这样面对我吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……说是６年前吧……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "果然，可能从那个时间点开始就知道自己身体的事了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "本来身体就弱，我记得刚好是那个时候起就经常向学校请假。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正因如此，到如今也好像在躲避着我……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
