channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "相继搭乘新干线和特快列车，我奔赴金泽。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "摇晃的车厢里，我思考了各种各样的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_026",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
