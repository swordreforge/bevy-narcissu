channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……有一天，发生了这样的事……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂莳绘……」",
voice: Some("li/etcm1_1007"),
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
