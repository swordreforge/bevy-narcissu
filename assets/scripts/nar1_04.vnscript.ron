),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "何况，我既没有泳装，也没有必要去拥有一套泳装。",
