channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我想起了那一天，初一那年的６月。\n我第一次住院的日子…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "想起了自己曾经订购过一件泳装。\n几年前的那件泳装。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…从那天开始就失去了出场机会的泳装。",
voice: None,
),
),
(
cmd: label,
args: (
