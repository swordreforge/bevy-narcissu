),
),
(
cmd: label,
args: (
name: "block_00104",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "大概是手术留下的刀疤吧。\n虽然不清楚详细情况，但看上去，似乎比我的刀疤还要大。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00105",
),
),
(
