),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…为什么，她会有这么多钱呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我最初带着的几千日元，只是偶然放在身边的钱而已。",
