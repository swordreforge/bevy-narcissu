),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "很快，便找到了一处自助加油站。\n我将车停靠在了最外侧的加油器旁。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我去加点油…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯…」",
voice: Some("li/n079"),
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你可千万别下车啊」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…………」",
voice: Some("li/n186"),
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她没有回答。\n不过，她也一定理解了我的意思吧。",
voice: None,
),
),
(
cmd: label,
args: (
