channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「欢迎光临」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "刚刚还待在屋子里的店员。\n不知为何向我跑了过来。",
