),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我从衣柜中找出那件泳装，它依然保持着几年前的新姿。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我脱下平时穿着的睡衣，\n怀着不安的心情，试着穿上了那件深蓝色的泳装。",
