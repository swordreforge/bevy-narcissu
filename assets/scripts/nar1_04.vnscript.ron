channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「有些吃腻了吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00116",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「并没有…」",
voice: Some("li/n183"),
),
),
(
cmd: label,
args: (
name: "block_00117",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们一边吃着从便利店买来的饭团，一边交谈着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00118",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "与７楼的伙食相比，这的确要强上很多。\n但连续几天都吃这个的话，也难免会吃腻的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00119",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，考虑到钱的问题，即使是这种东西，恐怕也吃不上几次了吧",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00120",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…声音好吵。」",
voice: Some("li/n184"),
),
),
(
cmd: label,
args: (
name: "block_00121",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊？\u{3000}你在说什么？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00122",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「车的声音，比以前要吵得多…」",
voice: Some("li/n185"),
),
),
(
cmd: label,
args: (
name: "block_00123",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哦，的确呢…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00124",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "大概是前几天从赌场逃出的时候撞坏了消音器，\n是因为这个缘故才会这样的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "尽管我一直以来都没太在意，但这辆车的噪音的确比以前稍大了些。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…不过，反正又不会影响到驾驶。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "比起这个来，更紧要的问题是汽油。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "５分钟前，油量计就已经开始提示无油了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并且，我的手头只有９００日元左右。\n和上一次加油情况不一样，这点金额显然是不够的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…但等到汽油完全耗尽的话，就一切都太迟了…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "想到这里，我开始寻找起了加油站…并且是无人的自助型加油站。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
