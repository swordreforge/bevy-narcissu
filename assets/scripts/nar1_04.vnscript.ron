args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们依然毫无目的地前进着，\n不知不觉中，自那以后又过了将近３天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00111",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这期间，并没有遇到什么太大的变故。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00112",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果一定要说些什么的话，\n那就是我们居然在途中发现了一个近乎免费的露天温泉，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00113",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为周围很冷清，所以总算是能够好好地洗了个澡。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00114",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "除此之外，\n就是手头的钱即将用尽，汽油也快要再次用光了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00115",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: set_bg,
args: (
image: "shanai_michi01",
