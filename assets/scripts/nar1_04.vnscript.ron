channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我打开油箱盖，照葫芦画瓢地给车加起了油。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "旁边还有一辆车在加油，加油站内有一栋建筑物，\n门口摆设着几台自动售货机。里面还有几个像是店员的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…大概就是在那里进行结账吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我看了看挂在墙上的说明，\n似乎是加完油后拿着单据到那里去结账。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…趁现在的情况，应该可以逃得出去的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "环视着闲散的加油站，我这样想。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "２３、２４、２５、２６…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "表示着加油量的液晶数字。\n与上一次相反，这一次让我感到那变化是如此地缓慢。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我焦急地等待着油箱被灌满。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当计数刚刚超过４０升，油箱即将被灌满的时候…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
