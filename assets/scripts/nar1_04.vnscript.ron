),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她说过想靠着自己的双腿，走到能走得到的地方去。\n也曾经问过我，是想劝她留下来，还是想随她一起走。",
voice: None,
),
),
(
