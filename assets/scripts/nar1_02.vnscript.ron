args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唷，又到这里来了吗…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00061",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…唔」",
voice: Some("li/new_086"),
),
),
(
cmd: label,
args: (
name: "block_00062",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么了？\u{3000}身体又不舒服了吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00063",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…不是」",
voice: Some("li/n068"),
),
),
(
cmd: label,
args: (
name: "block_00064",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她凝视着窗外，简短地回答道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00065",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "最终，她的暂时出院被取消了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00066",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样一来，不知何时才会迎来下一次机会。\n恐怕不是延迟几天就可以了结的事，而是要几周时间吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00067",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，莫非…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00068",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「今天早上…你是在装病吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00069",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………」",
voice: Some("li/n055"),
),
),
(
cmd: label,
args: (
name: "block_00070",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，说是装病也有些奇怪。我们早就不是健康的人了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00071",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就是说…你不想暂时出院回家吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00072",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…我不明白你在说什么」",
voice: Some("li/new_089"),
),
),
(
cmd: label,
args: (
name: "block_00073",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你不是，在这次之后就没有机会了吗…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00074",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………」",
voice: Some("li/n143"),
),
),
(
cmd: label,
args: (
name: "block_00075",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "面对我的疑问，沉默的她什么也没有回答。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00076",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "过去，她曾经问过我很多次，会选择在哪一边迎接死亡。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00077",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于她的这个疑问，我至今还未得出答案。\n而她也说过，既不愿选择在家里，也不愿选择在７楼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00078",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你果然…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00079",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是没有什么可以去的地方了吧…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00080",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…就算是这样…和你又有什么关系呢？」",
voice: Some("li/new_090"),
),
),
(
cmd: label,
args: (
name: "block_00081",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哦，我只是随便问问而已…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00082",
),
),
(
cmd: wait,
args: (
time_ms: 400,
