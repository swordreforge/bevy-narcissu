),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "依旧一片漆黑的谈话室中。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00083",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她依然没有转头看我一眼，只是静静地注视着窗外。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00084",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然时间只是刚过１１点，但在医院的区域里，\n几乎所有的灯光都已经被熄灭。",
voice: None,
),
),
(
