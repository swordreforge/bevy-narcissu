),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不必了…已经没事了」",
voice: Some("li/new_087"),
),
),
(
cmd: label,
args: (
name: "block_00052",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她只说了这些，然后自己猛地站了起来。",
