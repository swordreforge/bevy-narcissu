),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于她的病情，我完全不了解。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我所知道的只有，她的名字叫濑津美，血型是Ｏ。\n这些都是记载在白色手环上的内容。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，我们都是７楼的居民。\n而且，她的病情至少要比我更严重。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00047",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，还是躺下等着医生过来吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00048",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，我指了指放在房间一角的长椅。\n这是以前在这个房间角落里就有的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00049",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「来吧，我扶着你」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
