),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「坚、坚持一下，我这就叫医生来」",
voice: Some("li/mom_a062"),
),
),
(
cmd: label,
args: (
