args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…这是「日常」世界与「异常」世界的边境。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00086",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "更何况我们是７楼的居民。\n我们已经没有在７楼和家之外进行选择的权利。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00087",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她从漆黑的７楼窗边，注视着外边的世界。\n那里，是「日常」的世界。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00088",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "高楼和民宅中依然亮着无数的灯光，\n大路上，匆匆赶路的行人向着自家的灯火前行。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00089",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "尽管自身还没有什么切实感触…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00090",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但我已经成为了7楼的居民，「异常」世界的居民。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00091",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "已经再也无法回到对面的那个世界中了吧…",
voice: None,
),
),
(
