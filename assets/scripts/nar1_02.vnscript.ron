),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…她却依然纹丝不动。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00035",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "尽管母亲拉住了她的手，\n但不知为何她却完全没有从折叠椅上站起来的意思。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00036",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么了，濑津美？」",
voice: Some("li/mom_a042"),
),
),
(
cmd: label,
args: (
name: "block_00037",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我有些…难受…」",
voice: Some("li/new_084b"),
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎？是哪里难受？\u{3000}是胸口？还是肚子？」",
