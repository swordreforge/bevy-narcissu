args: (
name: "block_00093",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这个只看得到自己的世界里…\n我送走了不知多少个季节…多少次下着梅雨的苍白天空…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00094",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "最初，我从窗口望着那些去学校的孩子们，以及快步赶路的行人们。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00095",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当我看倦了窗外景色时，总会打开电视机。\n没有其他事情可做，也没有其他事情能做。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00096",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即使窗外飘着雪花，电视屏幕中也依然艳阳高照。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00097",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在眼前展开的，是一个没有寒冷，没有炎热，没有痛苦的梦幻世界。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00098",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
