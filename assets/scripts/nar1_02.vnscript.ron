args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…在空想中寻求着安乐…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00099",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只有庞大繁杂的知识在头脑中积攒…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00100",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "用它们不断地，构筑起毫无意义的价值观…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00101",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知不觉中，电视中的影像失去了现实感。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00102",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "之后是书本中的内容，游戏中的情节，乃至于家族中的亲人…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00103",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "到最后，就连面对自己，\n我也只能用旁人的眼光去审视，再也无法体会到现实感了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00104",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因此，来到7楼时，我并没有感到吃惊。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00105",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只要闭上双眼，身边的世界随时都可以消失。\n所以我不在乎，也不想让自己去在乎。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00106",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "很快，我即将迎来第2次出院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00107",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "下次回到这里的时候，或许我将无法再下床行走了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00108",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "尽管心中很清楚，但我依然痛恨自己的无所作为。",
voice: None,
),
),
