),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "此时闻声走过来的，是一位不认识的阿姨。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "大概她就是濑津美的母亲吧。\n她也对坐在旁边的我轻轻地点了点头以示问候。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那、我们走吧，准备好了吗？」",
voice: Some("li/mom_a022"),
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…嗯。」",
voice: Some("li/new_082"),
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，我们就告辞了。」",
voice: Some("li/mom_a032"),
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她的母亲再次向我点头表示告辞，转过身去准备离开这里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，当她向女儿伸出手时…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…………」",
