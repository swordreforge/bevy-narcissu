args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...几天前开始，我就已经觉得她的样子不太对劲。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，我能想到的只有那一件事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「前几天的时候...」",
voice: Some("li/hime2_0180"),
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好像，有位不认识的老奶奶，来和你说话了对吧？」",
voice: Some("li/hime2_0181"),
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...嗯。」",
voice: Some("li/onnanoko_0141"),
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，难道说...」",
voice: Some("li/hime2_0182"),
),
),
(
cmd: label,
args: (
name: "block_00171",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...和规则什么的事情有关？」",
voice: Some("li/hime2_0183b"),
),
),
(
cmd: label,
args: (
name: "block_00172",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...............」",
voice: Some("li/onnanoko_0142"),
),
),
(
cmd: label,
args: (
name: "block_00173",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她没有回答这个问题。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00174",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，这个沉默不是代表着NO，而是在肯定的感觉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00175",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "原本我还以为一定是谣言...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00176",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过看来这样的信息是存在的，那么她一定，已经听说了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
