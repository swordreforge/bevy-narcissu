args: (
name: "block_00148",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没事吧？」",
voice: Some("li/hime2_0177"),
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯...」",
