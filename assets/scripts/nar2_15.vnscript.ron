),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一如往常的，她还是几乎什么都不吃。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我今天也待在她的身边，睡在医院病床上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
