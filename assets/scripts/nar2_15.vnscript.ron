),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个啊，这样的话，不一会儿就会慢慢变得虚弱喔。」",
voice: Some("li/hime2_0173"),
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...变得虚弱？」",
voice: Some("li/onnanoko_0134"),
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没错呢，不进食的话身体会受不了喔。」",
voice: Some("li/hime2_0174"),
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...那么，变虚弱之后呢？」",
