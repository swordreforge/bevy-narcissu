),
),
(
cmd: label,
args: (
name: "block_00002",
),
),
(
cmd: play_se,
args: (
file: "furo",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好啦，不要乱动啦。」",
voice: Some("li/hime2_0140"),
),
),
(
cmd: label,
args: (
name: "block_00003",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「虽然这么说说，可是很痒嘛。」",
voice: Some("li/onnanoko_0106"),
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "7楼的浴室。\n今天是一周两次的洗澡日。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我说，啊，连我都湿透了。」",
voice: Some("li/hime2_0141"),
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，对不起。」",
voice: Some("li/onnanoko_0107"),
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈哈，没关系喔，姐姐也，顺便洗一下吧。」",
voice: Some("li/hime2_0142"),
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽说宽广，但也只是比一般家庭的浴室，稍微大一点的程度。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "二个人进入浴缸后，还是有点窄窄的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，还没好吗？」",
voice: Some("li/onnanoko_0108"),
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「还没呢。\n再洗一小会头发就洗好了。」",
voice: Some("li/hime2_0143"),
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好～」",
voice: Some("li/onnanoko_0109"),
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "紧紧闭上眼睛，等着头发清洗干净的她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样的对话，也变成了我们日常的一部分。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: set_bg,
args: (
image: "byousitu2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，接下来是姬子理发店喔。」",
voice: Some("li/hime2_0144"),
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "打开垃圾袋的开口，把她的脑袋穿过去，然后让她坐在了椅子上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "要是没风的话也可以去天台理，不过基本上都是在病房里完成。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...我们陪护...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有时也会是园艺家啦和清洁工啦...有时也会变成理发师的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "咖嚓咖嚓...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么样？前面的头发也理齐了喔。」",
voice: Some("li/hime2_0145"),
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，好像有点怪怪的...」",
voice: Some("li/onnanoko_0110"),
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶呀？不喜欢直刘海吗？」",
voice: Some("li/hime2_0146"),
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不是这样的，感觉太短了点...」",
voice: Some("li/onnanoko_0111"),
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真是的，这不是很可爱吗,这样才像个小孩子嘛。」",
voice: Some("li/hime2_0147"),
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，有一点害羞呢。」",
voice: Some("li/onnanoko_0112"),
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: set_bg,
args: (
image: "white-2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从还有些润湿的头发上，传来了洗发剂的薄荷味。\n在这狭小的病房中弥漫开来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "坐在平时我所坐的椅子上的，是垃圾袋中冒出头来，表情稍微有些不满的她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...地上铺着三张报纸。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以及两枚小镜子组成的理发店...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: set_bg,
args: (
image: "black-2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "几天后。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "注意到已经是8月中旬的时候，今天她在这里，我也在这里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "哔哔，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，体温计给我。」",
voice: Some("li/hime2_0148"),
),
),
(
cmd: label,
args: (
name: "block_00035",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好。」",
voice: Some("li/onnanoko_0113"),
),
),
(
cmd: label,
args: (
name: "block_00036",
),
),
(
cmd: set_bg,
args: (
image: "byousitu2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我取出刚才放入口中的体温计后，将屏幕上的数字读出来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00037",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「几度？」",
voice: Some("li/onnanoko_0114"),
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「36.2度，嗯，这样的话没问题呢。」",
voice: Some("li/hime2_0149"),
),
),
(
cmd: label,
args: (
name: "block_00039",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，那么今天也在中庭吃冰激凌？」",
voice: Some("li/onnanoko_0115"),
),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，今天有其他的预定需要考虑喔。」",
voice: Some("li/hime2_0150"),
),
),
(
cmd: label,
args: (
name: "block_00041",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...其他的预定？」",
voice: Some("li/onnanoko_0116"),
),
),
(
cmd: label,
args: (
name: "block_00042",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「首先，在这之前先要呢。」",
voice: Some("li/hime2_0151"),
),
),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着我把带来的纸袋打开。\n今天的目的有一半，是这个。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，是什么?」",
voice: Some("li/onnanoko_0117"),
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「带了新衣服来给你喔。」",
voice: Some("li/hime2_0152"),
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，睡衣的话之前给过了...」",
voice: Some("li/onnanoko_0118"),
),
),
(
cmd: label,
args: (
name: "block_00047",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呵呵，可不是什么睡衣喔。」",
voice: Some("li/hime2_0153"),
),
),
(
cmd: label,
args: (
name: "block_00048",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我有些郑重其事地，从袋子里取出来拿了出来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00049",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "再怎么说也是花了这个月一大半的工资，绞尽脑汁挑了两个小时才选出来的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「锵～」",
voice: Some("li/hime2_0154"),
),
),
(
cmd: label,
args: (
name: "block_00051",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，连衣裙。」",
voice: Some("li/onnanoko_0119"),
),
),
(
cmd: label,
args: (
name: "block_00052",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「如何？喜欢吗？」",
voice: Some("li/hime2_0155"),
),
),
(
cmd: label,
args: (
name: "block_00053",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯嗯。」",
voice: Some("li/onnanoko_0120"),
),
),
(
cmd: label,
args: (
name: "block_00054",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她一脸高兴地，不知点了多少次头。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00055",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是，夏天感觉的纯白底色，印有黄色向日葵图案的连衣裙。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00056",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，快点换好衣服我们走吧。」",
voice: Some("li/hime2_0156"),
),
),
(
cmd: label,
args: (
name: "block_00057",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「走是指，去外面吗？」",
voice: Some("li/onnanoko_0121"),
),
),
(
cmd: label,
args: (
name: "block_00058",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，去教堂喔。」",
voice: Some("li/hime2_0157"),
),
),
(
cmd: label,
args: (
name: "block_00059",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着我帮她解开睡衣的纽扣。\n其实以前，她就说过想去教堂的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00060",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「其实，就这样穿着睡衣去也可以的。」",
voice: Some("li/hime2_0158"),
),
),
(
cmd: label,
args: (
name: "block_00061",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不过，机会难得嘛。」",
voice: Some("li/hime2_0159"),
),
),
(
cmd: label,
args: (
name: "block_00062",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，姐姐，谢谢。」",
