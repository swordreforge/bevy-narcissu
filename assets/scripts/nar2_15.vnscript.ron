),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "深夜。在黑暗的病房中一直咳嗽的她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "现在的我能做到的只有，温柔地，轻轻地拍她背后而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这之后的几天，因为几乎把食物全都剩了下来，\n她的身体已经肉眼可见的正在变得虚弱。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并且已经，很明显的在回避着我了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算我向她搭话也是好不容易才会回应一句，\n而她自己则已经完全不会主动向我搭话了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...在这时，她突然开了口。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，姐姐...」",
voice: Some("li/onnanoko_0137"),
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这个...还给你。」",
voice: Some("li/onnanoko_0138"),
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...十字架？」",
voice: Some("li/hime2_0178"),
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从睡衣的口袋里取出的十字架。\n不会错的，这是我之前给她的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「还有...希望你不要再来这里了。」",
voice: Some("li/onnanoko_0139"),
),
),
(
cmd: label,
args: (
name: "block_00161",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「为，为什么，突然说出这样的话？」",
voice: Some("li/hime2_0179"),
),
),
(
cmd: label,
args: (
name: "block_00162",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那是...」",
voice: Some("li/onnanoko_0140"),
),
),
(
cmd: label,
args: (
name: "block_00163",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...那是。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她不再说下去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
(
