),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...本来，生与死的解说也是教会的工作。\n我们陪护也有帮助的义务。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...而这里是7楼。\n是向已经度过生的人，安心说明他们即将迎接的死亡的地方。",
voice: None,
),
),
(
cmd: label,
args: (
