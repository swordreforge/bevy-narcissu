),
),
(
cmd: label,
args: (
name: "block_00197",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽说来到7楼这样的地方，因为病情恶化而死亡的人却很少。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "比起这个，像是自己绝食一样，只因为衰弱而死的人更多，这我是知道的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...恐怕，不是为了自己。",
