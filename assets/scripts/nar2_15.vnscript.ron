),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我的话就此止住了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在喉咙前把「死」这个字吞了回去。",
voice: None,
),
),
(
