),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「如果可以的话...能告诉姐姐吗？」",
voice: Some("li/hime2_0184"),
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「可，可是...」",
voice: Some("li/onnanoko_0143"),
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没问题喔，绝对保守住秘密的。」",
voice: Some("li/hime2_0185"),
),
),
(
cmd: label,
args: (
name: "block_00180",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「她，她说绝对不能和别人说的...」",
voice: Some("li/onnanoko_0144"),
),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呜，呜...」",
voice: Some("li/onnanoko_0145"),
),
),
(
cmd: label,
args: (
name: "block_00182",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...她终于还是哭了出来。明明到现在为止一次都没哭过的...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "规则。\n据我所知，是这7楼的病人流传下来的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也就是说，那是正步向死亡的当事者们「才有」的问题吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因此那或许是我...没有权利去询问的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...不管关系再怎么好，我也是阿洛伊斯。\n是不能成为可以和尼洛一起死亡的帕奇的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...到头来，也只不过是个只能为她送行的人...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呜，呜呜...」",
voice: Some("li/onnanoko_0150"),
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对不起，我不会再问了...」",
voice: Some("li/hime2_0186"),
),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我只能，在她的背后轻轻地拍着而已...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只希望她能够尽早停止哭泣，能够尽早笑起来，能够尽早...",
voice: None,
),
),
