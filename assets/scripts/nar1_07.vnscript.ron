),
),
(
cmd: label,
args: (
name: "block_00118",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她的病情恶化了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00119",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她将坐席放倒，躺在那里。\n我也一直将车停留在这里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00120",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "尽管已经吃下了药，但却没有什么效果，病情仍然不见好转。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00121",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...是啊，我们是来自７楼的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00122",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从原本的病情来看，她已经是第２次了，随时都有可能迎来这一天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00123",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐...你想回去了吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00124",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「.........」",
