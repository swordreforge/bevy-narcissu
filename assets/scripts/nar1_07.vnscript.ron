),
),
(
cmd: label,
args: (
name: "block_00057",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们来到了当初的目的地\n──能够看到水仙的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00058",
),
),
(
cmd: wait,
args: (
