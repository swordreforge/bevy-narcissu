args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: play_bgm,
args: (
id: "83",
volume: Some(0.78431374),
fade_ms: Some(500),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那耳喀索斯是一位被万人追求的美少年...」",
voice: Some("li/nv345"),
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「妖精艾歌也是他的追求者之一」",
voice: Some("li/nv346"),
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，艾歌只能重复与对方相同的话语...」",
voice: Some("li/nv347"),
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...相同的话语？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是的，所以...」",
voice: Some("li/nv348"),
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「假如那耳喀索斯不对自己说出『我爱你』的话...」",
voice: Some("li/nv349"),
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「艾歌就永远无法传达自己的爱意...」",
voice: Some("li/nv350"),
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她寂寞地、悲伤地继续说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她的视线如同过去那样，静静地遥望着远方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是...那是绝对不可能的」",
voice: Some("li/nv351"),
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「无论怎样幻想，怎样憧憬，艾歌的心愿绝对不可能会实现...」",
voice: Some("li/nv352"),
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「最后，她对那耳喀索斯施下了诅咒」",
voice: Some("li/nv353"),
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...就是那个有名的，爱上自己映在泉水中的倒影的诅咒吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那耳喀索斯不眠不休地凝视着自己的倒影...」",
voice: Some("li/nv354"),
