),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "本是漆黑一片的原野，被渐渐地涂成了白色与黄色。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00093",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们不由得走出车外，注视着这幅美景。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00094",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「太美了...」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00095",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...嗯」",
voice: Some("li/new_371"),
),
),
(
cmd: label,
args: (
name: "block_00096",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "浮现在眼前的，是数不清的水仙。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00097",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "夜露在朝日的照耀下，让白色的花丛更显得晶莹剔透。\n宛如一条铺向大海的巨大绒毯。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00098",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们望着这一切交谈着。\n连气息也化作了同样洁白的雾气。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00099",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...那一天，我们在无聊的电视画面中眺望着那些花朵。\n而今天，原本心中没有任何目标的我们则确确实实地站在了这里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00100",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: set_bg,
args: (
image: "narcissu_b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「......它们可以说是同一种类了吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00101",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯...即使严格地来说，也是同一种」",
voice: Some("li/nv336"),
),
),
(
cmd: label,
args: (
name: "block_00102",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是吗，太好了...」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00103",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我看不出种类的区别...\n那一天，电视中放映着的是完美绚丽的影像。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00104",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "与那相比，眼前的花朵们则显得零零散散。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00105",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...但是，它们确确实实地存在于这里。",
voice: None,
),
