args: (
image: "ato_b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "夜色渐渐消逝。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00090",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "旭日渐渐地将黑夜的深紫色染作了淡白色。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00091",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "无垠的白色花丛在晨光中起伏着...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00092",
),
),
