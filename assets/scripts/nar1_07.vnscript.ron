args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，干嘛不开灯呢？」",
voice: Some("li/nv324"),
),
),
(
cmd: label,
args: (
name: "block_00062",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哦，因为电池的电量不多了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00063",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，是呐...」",
voice: Some("li/nv325"),
),
),
(
cmd: label,
args: (
name: "block_00064",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "车内一片漆黑，引擎也被关闭了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00065",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只有仪表盘上那淡淡的荧光，映照出我们的面庞。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00066",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这既没有声响也没有灯光的狭窄车厢中，\n我们默默地等待着黎明的到来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00067",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那些衣物仍然堆放在后排的座位上。\n肥厚的牛仔裤和运动衫，以及粗陋的浴巾。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00068",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们从中捡起几件，当作棉被卷在身上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00069",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...你冷吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00070",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...嗯」",
voice: Some("li/new_371"),
),
),
(
cmd: label,
args: (
name: "block_00071",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那就再靠近一些吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00072",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唉...？」",
voice: Some("li/n328"),
),
),
(
cmd: label,
args: (
name: "block_00073",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「别在意，到这边来吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00074",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看到她在助手席上发抖，我指了指自己的膝盖。。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00075",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这样肯定会比较暖和的」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00076",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「.........」",
voice: Some("li/n329"),
),
),
(
cmd: label,
args: (
name: "block_00077",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不必了...我没事的」",
voice: Some("li/nv330"),
),
),
(
cmd: label,
args: (
name: "block_00078",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "尽管嘴上这样说，但她却仍然在打着哆嗦。\n呼出的白雾，说明她显然是在逞强。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00079",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...莫非，你是因为冷才希望我过去的吗？」",
voice: Some("li/nv331"),
),
),
(
cmd: label,
args: (
name: "block_00080",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯...哦，就算是那样吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00081",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「.........」",
voice: Some("li/n332"),
),
),
(
cmd: label,
args: (
name: "block_00082",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，好吧...」",
voice: Some("li/nv333"),
),
),
(
cmd: label,
args: (
name: "block_00083",
),
),
(
cmd: wait,
args: (
