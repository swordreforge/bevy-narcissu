),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...你想回去了吗？」",
voice: Some("li/nv341"),
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，有一点点...」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
