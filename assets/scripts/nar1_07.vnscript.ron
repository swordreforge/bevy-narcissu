),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她慢慢地挪了过来，犹犹豫豫地趴在了我的膝上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00084",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么样？\u{3000}暖和些了吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00085",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...嗯。」",
voice: Some("li/nv334"),
),
),
(
cmd: label,
args: (
name: "block_00086",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "挡风玻璃在寒气的作用下披上了一层白霜。\n白雾与夜色交织着，使我完全看不到外边的景色。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00087",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，黎明很快就会来了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00088",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那时，广阔的白色花丛一定会呈现在我们面前吧...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00089",
),
),
(
