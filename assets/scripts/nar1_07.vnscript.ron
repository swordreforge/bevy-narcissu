),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "尽管这里是观光地...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00059",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但或许因为这里是郊外，或者因为现在是夜晚，\n总之周围看不到任何人活动的踪影。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00060",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "夜色是如此地深沉。\n我们在漆黑的车内等待着黎明。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00061",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
