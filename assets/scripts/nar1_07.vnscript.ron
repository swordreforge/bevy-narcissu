),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "世界中充满了眼睛看不到的虚无，\n世界中充满了手指摸不到的幻影...",
voice: None,
),
),
(
cmd: label,
args: (
