args: (
channel: Some(5),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是７楼...还是家？」",
voice: Some("li/nv342"),
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我、我...」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "......不知道...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但我早有预料，她随时可能会迎来这一天。\n当然，我也随时可能变成这样。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "可是，仅仅在一旁看着，是很痛苦的事情。",
voice: None,
),
),
(
