),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "雨依然下个不停。\n从昏暗的夜空中不断落下。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "车窗对面，水仙的花朵在雨滴中闪烁着洁白的光辉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
