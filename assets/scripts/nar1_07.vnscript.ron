),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对了...」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我指了指玻璃对面的白色花朵。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「记得水仙...是叫做Narcissus吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...嗯，它的语源来自于希腊神话中的那耳喀索斯」",
voice: Some("li/nv343"),
),
),
(
cmd: label,
args: (
name: "block_00138",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...希腊神话中的那耳喀索斯？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我一直以为这是一个陌生的词汇。\n但经她提醒，我才想起自己也有所耳闻...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就是那个陷入自恋的那耳喀索斯吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，因为原本就是神话，所以有着各种各样不同的说法...」",
voice: Some("li/nv344"),
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她注视着我的脸，慢慢地解说下去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
