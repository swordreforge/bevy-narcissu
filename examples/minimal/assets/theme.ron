// 本文件镜像引擎内置默认值（VnTheme::default()）。
// 三层层叠覆盖模型：
//   Layer 1: VnTheme::default() 内置默认值
//   Layer 2: assets/theme.ron 全局主题配置
//   Layer 3: bsn!{} 组件级覆盖（per-spawn）
// 修改此文件即可自定义全局主题，当前值与引擎默认值完全一致。

VnTheme(
    dialogue: DialogueTheme(
        margin_bottom: 20.0,
        height: 180.0,
        background_color: (0.0, 0.0, 0.0, 0.7),
        text_color: (1.0, 1.0, 1.0, 1.0),
        speaker_color: (0.8, 0.8, 1.0, 1.0),
        speaker_box_width: 200.0,
        font_size: 28.0,
        speaker_font_size: 22.0,
        padding: (20.0, 20.0, 20.0, 20.0),
        text_speed: None,
        design: "default",
    ),
    choice: ChoiceTheme(
        max_visible: 6,
        item_height: 48.0,
        font_size: 24.0,
        padding: (12.0, 24.0, 12.0, 24.0),
    ),
    title: TitleTheme(
        title_font_size: 56.0,
        menu_font_size: 28.0,
    ),
    settings: SettingsTheme(
        font_size: 24.0,
        slider_width: 300.0,
    ),
    save_load: SaveLoadTheme(
        font_size: 24.0,
        thumbnail_width: 200.0,
        thumbnail_height: 112.0,
    ),
    backlog: BacklogTheme(
        font_size: 22.0,
        max_entries: 50,
    ),
    gallery: GalleryTheme(
        thumbnail_width: 240.0,
        thumbnail_height: 135.0,
        columns: 4,
    ),
    transitions: TransitionTheme(
        fade_duration: 1.0,
        fg_fade_duration: 0.5,
        cg_fade_duration: 1.0,
    ),
    fonts: FontTheme(
        default: "fonts/default.ttf",
        dialogue: None,
        title: None,
        mono: None,
    ),
    colors: ColorTheme(
        menu_bg: (0.05, 0.05, 0.1, 0.95),
        menu_text: (0.9, 0.9, 0.95, 1.0),
        button_normal: (0.15, 0.15, 0.25, 1.0),
        button_hover: (0.25, 0.25, 0.40, 1.0),
        button_press: (0.35, 0.35, 0.50, 1.0),
        choice_highlight: (0.3, 0.5, 0.8, 1.0),
    ),
)
