),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「如果现在……姬子看到我的话，会说些什么呢？」",
voice: Some("li/0snyuka_0160"),
),
),
(
cmd: label,
args: (
name: "block_00229",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是会因为我把她心爱的车借给了别人而生气呢……\n还是劝导我，让刚拿到驾照的人来驾驶太乱来呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00230",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还是会说，曾经那么靠不住的我……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00231",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "变成了有点任性，又爱多管闲事的人呢。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00232",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「会不会稍微表扬下我呢……」",
voice: Some("li/0snyuka_0161"),
),
),
(
cmd: label,
args: (
name: "block_00233",
),
),
