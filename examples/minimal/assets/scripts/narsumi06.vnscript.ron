),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，要去哪儿啊」",
voice: Some("li/0snsumi_0235"),
),
),
(
cmd: label,
args: (
name: "block_00263",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就在前面了」",
voice: Some("li/0snaka_0329"),
),
),
(
cmd: label,
args: (
name: "block_00264",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明从1F的正门出去，继续往外走着。我也不明不白的跟在她身后。",
voice: None,
),
),
(
