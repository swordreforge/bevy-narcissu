),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "开了一会儿，不知道是不是明终于适应驾驶了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00289",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还是说是我适应了这种驾驶方式呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00290",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「还是挺有意思的嘛，开车这事」",
voice: Some("li/0snaka_0338"),
),
),
(
cmd: label,
args: (
name: "block_00291",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知道是不是稍微有所余力了，明单手握着方向盘，这样说着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00292",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我也松开了全力握紧安全带的手，按住变得乱糟糟的刘海。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00293",
),
),
(
