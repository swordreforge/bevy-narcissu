args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好美的星空……」",
voice: Some("li/0snsumi_0398"),
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "讽刺的是，比起在家里，从这7F的高度看到的星空要清楚多了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……那是织女星，上面的是天津四 ，然后是牵牛星。有名的夏季大三角。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "西边的天空上，由北斗七星开始连接起来的春季大曲线。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "春季大三角也能勉强看到。大角星、五帝座一、角宿一……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是从什么时候开始的呢？能像这样轻松的找出这些星星……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: set_bg,
args: (
image: "w",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
