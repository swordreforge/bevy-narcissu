),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「顺便去看下那个孩子吧……」",
voice: Some("li/0snyuka_00143"),
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我一只手搭在方向盘上，一边自言自语到。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这里说的那孩子，指的是明。去往的方向，是明住院的医院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "最近好像一直在来往那个7F的样子。肯定是因为以前提到的那个认识的女孩吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看了下时间，已经是晚上11点了。这个时间的话，差不多是回来了的时间吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00192",
),
),
(
cmd: set_bg,
args: (
image: "2b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
