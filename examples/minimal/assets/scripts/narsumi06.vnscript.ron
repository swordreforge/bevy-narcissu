),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话说回来，还没到车站吗？」",
voice: Some("li/0snsumi_0240"),
),
),
(
cmd: label,
args: (
name: "block_00294",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从医院出发已经差不多10分钟了。\n就算步行最多也就15分钟而已，用的时间有点太长了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00295",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且路上也没见有堵车……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00296",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，这里，是哪里呢？」",
voice: Some("li/0snaka_0339"),
),
),
(
cmd: label,
args: (
name: "block_00297",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈？」",
voice: Some("li/0snsumi_0241"),
),
),
(
cmd: label,
args: (
name: "block_00298",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「其实，从刚才开始就是随便开的。啊哈哈哈」",
voice: Some("li/0snaka_0340"),
),
),
(
cmd: label,
args: (
name: "block_00299",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哇，干嘛笑着蒙混过去啊」",
voice: Some("li/0snsumi_0242"),
),
),
(
cmd: label,
args: (
name: "block_00300",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没办法啊，谁让这车连导航都没有」",
voice: Some("li/0snaka_0341"),
),
),
(
cmd: label,
args: (
name: "block_00301",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "根本不是这个问题。更何况，那种事在坐上车的时候就该知道了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00302",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛，没事的啦。一会就到了」",
voice: Some("li/0snaka_0342"),
),
),
(
cmd: label,
args: (
name: "block_00303",
),
),
