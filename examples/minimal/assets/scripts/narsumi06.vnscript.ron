),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不一会儿，就来到了停车场旁。在停在那里的一辆汽车前停下了脚步。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00266",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "红色的敞篷车。貌似是台双座车。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00267",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好了。就是这辆」",
voice: Some("li/0snaka_0330"),
),
),
(
cmd: label,
args: (
name: "block_00268",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后连门都没开，一下子就跳进了驾驶席然后对我招着手。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00269",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「来，坐吧」",
voice: Some("li/0snaka_0331"),
),
),
(
cmd: label,
args: (
name: "block_00270",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呃，当真？」",
voice: Some("li/0snsumi_0236"),
),
),
(
cmd: label,
args: (
name: "block_00271",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "随便从医院出去没问题吗？而且，这是谁的车？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00272",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没事啦，只是开开试试，也就开到车站附近而已」",
voice: Some("li/0snaka_0332"),
),
),
(
cmd: label,
args: (
name: "block_00273",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「欸，啊，嗯……」",
voice: Some("li/0snsumi_0237"),
),
),
(
cmd: label,
args: (
name: "block_00274",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以这样就没问题了？虽然对她所说的开开试试也有点在意。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00275",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是从这里到车站前，步行也就是10分钟的距离，如果很快能回来的话……",
