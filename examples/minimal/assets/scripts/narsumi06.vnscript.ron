),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/0snsumi_0008"),
),
),
(
cmd: label,
args: (
name: "block_00279",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "总感觉，语气非常的不安。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00280",
),
),
(
