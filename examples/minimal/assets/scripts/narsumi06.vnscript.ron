),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "其实，妈妈也不知道该如何对待我才好呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00092",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……如果我没有生病的话，从开始就不会变成这样了吧？",
voice: None,
),
),
(
