fade_ms: Some(500),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "早早的就吃过午饭，午间的体温检查也结束了，没什么事可做的午后的病房。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00235",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我和平时一样在病房里玩着游戏，明在旁边无聊地看着漫画。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00236",
),
),
(
cmd: set_bg,
args: (
image: "sin_b05",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
