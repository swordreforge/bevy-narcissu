),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "到了熄灯时间，又变成只有一人的病房。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
