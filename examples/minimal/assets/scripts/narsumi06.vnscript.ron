),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然并没有信这句鬼话……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00304",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "结果，花了3个小时才到了车站前。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00305",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也没做什么别的，就是在周围开来开去，然后就这么回医院了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00306",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然赶上了傍晚的体温检查，但按这个节奏，要是再走远点，就得到晚上了。",
voice: None,
),
),
(
cmd: label,
