args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哟，明。好久不见」",
voice: Some("li/0snyuka_0143"),
),
),
(
cmd: label,
args: (
name: "block_00193",
),
),
