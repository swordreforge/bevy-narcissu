args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我说菫，虽然我知道你玩游戏很强……」",
voice: Some("li/0snaka_0302"),
),
),
(
cmd: label,
args: (
name: "block_00172",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什么？」",
voice: Some("li/0snsumi_0225"),
),
),
(
cmd: label,
args: (
name: "block_00173",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但像这样一直玩游戏是不行的吧？」",
voice: Some("li/0snaka_0303"),
),
),
(
cmd: label,
args: (
name: "block_00174",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「明明之前还那么帅气地说什么“来当我的证人吧”」",
voice: Some("li/0snaka_0304"),
),
),
(
cmd: label,
args: (
name: "block_00175",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这种事不用说我也知道。但是想不到该做些什么才好。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00176",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「明觉得该怎么办才好？」",
voice: Some("li/0snsumi_0226"),
),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不是，别问我啊」",
voice: Some("li/0snaka_0305"),
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「要说的话我只是个看客而已吧？这可是你的人生」",
voice: Some("li/0snaka_0306"),
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然的确是这么回事的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00180",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前她也对我说过。自己死亡的舞台，应该由自己来决定。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是我……几乎没怎么出去过」",
voice: Some("li/0snsumi_0227"),
),
),
(
cmd: label,
args: (
name: "block_00182",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我和你也差不多」",
voice: Some("li/0snaka_0307"),
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算想到了什么，也缺乏做出判断的“经验”。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……不只是我，大概明也是如此。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "原本就没有什么经验的我们，该做的，想做的，能选的选项太少了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
