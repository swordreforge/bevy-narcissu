args: (
speaker: None,
text: "我平时都是开车来医院的。那边的停车场的话，暂时放在哪儿也没关系的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00226",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是这样的话，就暂时得坐电车上下班了，那也无妨。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00227",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "总之，明现在需要的，是和人的交流。也可以说是和其他人的“羁绊”。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00228",
),
),
(
cmd: set_bg,
args: (
image: "bg_net_0001c",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
