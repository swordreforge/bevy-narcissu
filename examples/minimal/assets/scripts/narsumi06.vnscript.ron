),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "敞篷车的引擎盖倒映着蔚蓝天空在奔驰着。因为没有顶棚的原因，身体吹着风很舒服。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00282",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于只坐过出租车的我来说，对这一切都感觉很新鲜很有趣，不过……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00283",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，总感觉摇摇晃晃的，有点犯恶心……」",
voice: Some("li/0snsumi_0238"),
),
),
(
cmd: label,
args: (
name: "block_00284",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「要求别那么高嘛，毕竟才拿的驾照」",
voice: Some("li/0snaka_0336"),
),
),
(
cmd: label,
args: (
name: "block_00285",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，顺便说一下，这也是第一次开车」",
voice: Some("li/0snaka_0337"),
),
),
(
cmd: label,
args: (
name: "block_00286",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是，是吗？注意安全啊……」",
voice: Some("li/0snsumi_0239"),
),
),
(
cmd: label,
args: (
name: "block_00287",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我紧紧抓住了安全带。虽然头发被风吹得乱七八糟，但还是先忍忍吧。",
