args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……那是不去学校之后，过了3年左右的冬季。在和白石小姐相遇前的一段时间……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: set_bg,
args: (
image: "ns_12b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「左边是南河三……右边是参宿四」",
voice: Some("li/0snsumi_0400"),
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「然后，最亮的是……天狼星」",
voice: Some("li/0snsumi_0401"),
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "冬季大三角。一边指着夜空，一边念到。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "几年前，大概查了下百科全书，不知道什么时候就记住了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "现在不只是冬季的星座，夏季的星座也知道了。\n抬头看向夜空的话，大概一瞬间就能找到吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「到了那一天，我能不能去到那上面呢……」",
voice: Some("li/0snsumi_0402"),
),
),
(
cmd: label,
args: (
name: "block_00161",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "死了就会变成星星。应该是小的时候这样听说过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00162",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，那是不可能的。我也不再是会相信这个的小孩了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00163",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然而……",
voice: None,
),
),
(
