args: (
speaker: None,
text: "下意识的叫住了妈妈。不知道为什么总感觉不能就这样让她回去了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00099",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么了？」",
voice: Some("li/0snhaha_0030"),
),
),
(
cmd: label,
args: (
name: "block_00100",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/c88mire_0030"),
),
),
(
cmd: label,
args: (
name: "block_00101",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "找不到要说的话，沉默了下来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00102",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我自己，到底想想说什么呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00103",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "自己也不清楚，最后终于说出口的是……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00104",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……对不起……」",
voice: Some("li/0snsumi_0194"),
),
),
(
cmd: label,
args: (
name: "block_00105",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/0snhaha_0024"),
),
),
(
cmd: label,
args: (
name: "block_00106",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听到这句话，这次换妈妈沉默了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00107",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "其实我也并不是想说的这种话的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00108",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是感觉非常愧疚，想着想要传达这份感情……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00109",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没事的。你不用介意啦」",
voice: Some("li/0snhaha_0025"),
),
),
(
cmd: label,
args: (
name: "block_00110",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "回答我的，还是如往常一样温柔稳重的声音。但是，那目光却显得非常寂寞。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00111",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，明天见……」",
voice: Some("li/0snhaha_0026"),
),
),
(
cmd: label,
args: (
name: "block_00112",
),
),
(
cmd: set_bg,
args: (
image: "2b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妈妈说完这句话，离开了病房。我大大地叹了口气，倒在了床上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00113",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我究竟想说什么呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00114",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "想要传达给妈妈什么呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00115",
),
),
(
cmd: set_bg,
args: (
image: "sin_b05b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不是有个很好妈妈嘛」",
voice: Some("li/0snaka_0273"),
),
),
(
cmd: label,
args: (
name: "block_00116",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「咦……」",
voice: Some("li/c88mire_0029"),
),
),
(
cmd: label,
args: (
name: "block_00117",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "循声望去，发现是不知道什么时候从便利店回来的明。\n看起来好像是看到了刚才发生的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00118",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你的家人，大家都这种感觉吗？」",
voice: Some("li/0snaka_0274"),
),
),
(
cmd: label,
args: (
name: "block_00119",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯。爸爸和哥哥也很温柔」",
voice: Some("li/0snsumi_0196"),
),
),
(
cmd: label,
args: (
name: "block_00120",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是吗，不错的家人呢……」",
voice: Some("li/0snaka_0275"),
),
),
(
cmd: label,
args: (
name: "block_00121",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于家人这个词，似乎有些感慨。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00122",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以啊，说“对不起”应该不太好的喔」",
voice: Some("li/0snaka_0276"),
),
),
(
cmd: label,
args: (
name: "block_00123",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「咦……？」",
voice: Some("li/0snsumi_0197"),
),
),
(
cmd: label,
args: (
name: "block_00124",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我想，这一定是病人不该说出口的话……」",
voice: Some("li/0snaka_0277"),
),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也许…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…是那样吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然愧疚的心情并没有变，这也是我切身的感受。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，对于听到这话的家人则完全相反。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说不定会变得有些无地自容吧。\n大概越是努力，就越是悲伤，越会感觉到自己的无力吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那该怎么说才好？」",
voice: Some("li/0snsumi_0198"),
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「很简单啦。“谢谢”……这就足够了」",
voice: Some("li/0snaka_0278"),
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛，我的住院履历可比你长。这是前辈的建议哦」",
voice: Some("li/0snaka_0279"),
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/0snsumi_0008"),
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我沉默着听完了明的建议。对那句话既没有肯定，也没有摇头否定。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……确实如她所说吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "比起说“对不起”要好太多了。说声“谢谢”，也算是对家人的回报了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然而，我却不觉得那是很“简单”的事情。至少对我来说，是说不出口的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00138",
),
),
(
