channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，是优花啊……」",
voice: Some("li/0snaka_0308"),
),
),
(
cmd: label,
args: (
name: "block_00194",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你最近好像经常去那边的7F呢」",
voice: Some("li/0snyuka_0144"),
),
),
(
cmd: label,
args: (
name: "block_00195",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，算是吧」",
voice: Some("li/0snaka_0309"),
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难道是交到朋友了？」",
voice: Some("li/0snyuka_0145"),
),
),
(
cmd: label,
args: (
name: "block_00197",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「很遗憾，并不是那样」",
voice: Some("li/0snaka_0310"),
),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯--，算了，也无所谓」",
voice: Some("li/0snyuka_0146"),
),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "事实上，的确没什么关系。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00200",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "直到现在都不怎么跟人说话的她，能和除我以外的人正常接触是最重要的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00201",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然对方是7F的居民就是了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00202",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "按照她以前的说法，时日无多的人是例外。也就是说这并违反她的规则。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00203",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我说优花，我有个问题想问你……」",
voice: Some("li/0snaka_0311"),
),
),
(
cmd: label,
args: (
name: "block_00204",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么啦？」",
voice: Some("li/0snyuka_00147"),
),
),
(
cmd: label,
args: (
name: "block_00205",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「要制造回忆的话，做些什么比较好？」",
voice: Some("li/0snaka_0312"),
),
),
(
cmd: label,
args: (
name: "block_00206",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……制造回忆？」",
voice: Some("li/0snyuka_00148"),
),
),
(
cmd: label,
args: (
name: "block_00207",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为感觉时间已经不多了嘛……」",
voice: Some("li/0snaka_0313"),
),
),
(
cmd: label,
args: (
name: "block_00208",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听到这里我察觉到了。把“时间不多了”和“制造回忆”两个单词联系起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00209",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "肯定是和之前那个7F的女孩有关的事吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00210",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明想要为了那个孩子做些什么，我只想到了这些。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00211",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛，总之，先去兜个风什么的」",
voice: Some("li/0snyuka_0147"),
),
),
(
cmd: label,
args: (
name: "block_00212",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「兜风……是要我来开车？」",
voice: Some("li/0snaka_0314"),
),
),
(
cmd: label,
args: (
name: "block_00213",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是啊。好不容易拿到驾照了，不好好利用多浪费呀」",
voice: Some("li/0snyuka_0148"),
),
),
(
cmd: label,
args: (
name: "block_00214",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，做不到的吧？从各种意义上对我来说难度都太大了啊」",
voice: Some("li/0snaka_0315"),
),
),
(
cmd: label,
args: (
name: "block_00215",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "嘛，就知道会被拒绝。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00216",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，这也许是很重要的一步。也可以说是个很大的契机。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00217",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "硬让她去考驾照，也只是不管是什么都好，想让她变得更积极些。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00218",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "最近，也听说她插手公司的公关部门了。虽然不知道是出于什么原因，但也不是坏事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00219",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「总之给你了，随便用吧」",
voice: Some("li/0snyuka_0149"),
),
),
(
cmd: label,
args: (
name: "block_00220",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，把我的车钥匙放在了桌子上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00221",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「等下，我真的，不会去开的哦」",
voice: Some("li/0snaka_0316"),
),
),
(
cmd: label,
args: (
name: "block_00222",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「无所谓啦。我去把车停到医院的停车场里」",
voice: Some("li/0snyuka_0150"),
),
),
(
cmd: label,
args: (
name: "block_00223",
),
),
