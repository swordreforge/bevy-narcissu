args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我说菫，我突然想到……」",
voice: Some("li/0snaka_0318"),
),
),
(
cmd: label,
args: (
name: "block_00237",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你老是玩在角色扮演类游戏呢」",
voice: Some("li/0snaka_0319"),
),
),
(
cmd: label,
args: (
name: "block_00238",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，的确那样吧」",
voice: Some("li/0snsumi_0228"),
),
),
(
cmd: label,
args: (
name: "block_00239",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难道说，你喜欢那种幻想风格的世界观吗？」",
voice: Some("li/0snaka_0320"),
),
),
(
cmd: label,
args: (
name: "block_00240",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是不是呢……」",
voice: Some("li/0snsumi_0229"),
),
),
(
cmd: label,
args: (
name: "block_00241",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "至今为止，也没太深入的思考过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00242",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说到底与其说是自己想要的游戏，基本上都是哥哥不要的游戏。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00243",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，的确我玩的最久的就是RPG游戏，自然是幻想世界占多数。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00244",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯。也许是喜欢的吧……」",
voice: Some("li/0snsumi_0230"),
),
),
(
cmd: label,
args: (
name: "block_00245",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，干脆去下那种地方吧」",
voice: Some("li/0snaka_0321"),
),
),
(
cmd: label,
args: (
name: "block_00246",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那种地方是？」",
voice: Some("li/0snsumi_0231"),
),
),
(
cmd: label,
args: (
name: "block_00247",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就是像角色扮演游戏里会出现的地方」",
voice: Some("li/0snaka_0322"),
),
),
(
cmd: label,
args: (
name: "block_00248",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「像是什么迷宫一样的洞穴啊，城堡啊之类的」",
voice: Some("li/0snaka_0323"),
),
),
(
cmd: label,
args: (
name: "block_00249",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明说着我多少搞不懂的话，独自情绪高昂起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00250",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "难道，是在说，现实中像那样的地方吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00251",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么样？说不定作为你死的地方正合适呢」",
voice: Some("li/0snaka_0324"),
),
),
(
cmd: label,
args: (
name: "block_00252",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不要，那么奇怪的地方」",
voice: Some("li/0snsumi_0232"),
),
),
(
cmd: label,
args: (
name: "block_00253",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「首先，像那样的地方，都不知道哪里有……」",
voice: Some("li/0snsumi_0233"),
),
),
(
cmd: label,
args: (
name: "block_00254",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那倒是，我也不……啊，对了……」",
voice: Some("li/0snaka_0325"),
),
),
(
cmd: label,
args: (
name: "block_00255",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知道为什么，明说到这里时看了下时间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00256",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「12点半吗……离下次体温检查还有4个小时呢」",
voice: Some("li/0snaka_0326"),
),
),
(
cmd: label,
args: (
name: "block_00257",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嗯？」",
voice: Some("li/0snsumi_0195"),
),
),
(
cmd: label,
args: (
name: "block_00258",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「很好。总之先开一下试试吧」",
voice: Some("li/0snaka_0327"),
),
),
(
cmd: label,
args: (
name: "block_00259",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈？」",
voice: Some("li/0snsumi_0234"),
),
),
(
cmd: label,
args: (
name: "block_00260",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好啦好啦，先跟我来吧」",
voice: Some("li/0snaka_0328"),
),
),
(
cmd: label,
args: (
name: "block_00261",
),
),
