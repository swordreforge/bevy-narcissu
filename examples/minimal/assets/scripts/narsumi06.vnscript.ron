),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一片昏暗之中，我呆呆地玩着游戏。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算通关了这游戏也没有什么意义。只是习惯性的。打发时间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「要尽孝道很简单……只要不让他们担心就好」",
voice: Some("li/0snsumi_0062"),
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那我就是大不孝之人吧。\n没有什么特殊原因，就一直在家里蹲的我就更为如此了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这样的我，说不出谢谢这种话……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不管怎么做都感觉很抱歉，很对不起。抑制住这股心情，用什么表情才能说出口呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: set_bg,
args: (
image: "2b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
