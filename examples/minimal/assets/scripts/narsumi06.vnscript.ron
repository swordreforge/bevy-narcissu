),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "接下来，直到傍晚的体温检查前，我都没什么事可做了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以还是玩着那个游戏。明还是在旁边呆望着我玩游戏。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就在差不多已经参观够了，该说些什么的时候。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00171",
),
),
(
