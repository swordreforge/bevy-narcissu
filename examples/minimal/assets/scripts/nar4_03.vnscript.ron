        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "日下被店里的气氛压倒？了，我带着她，来到平常的座位上坐下。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00008",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而在我的对面，一起进来的日下正紧张得惹人发笑。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00009",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "cafe2",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个……\u{3000}我有种非常强烈与周围气氛不符的感觉……」",
                voice: Some("li/n4yoko_0079"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00010",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「话说回来，这里面，全是一些不良分子吧？」",
                voice: Some("li/n4yoko_0080"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00011",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，客观的来看也是如此」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00012",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边回答着，我一边朝着周围看去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00013",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这个店，作为一处被称为不良分子的人们的徘徊场所也是很有名的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00014",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在那里，聚集着很多就算是往好的方面看，也相当不得了的家伙们。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00015",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然对我来说，和大部分人都是相识的关系，\n但是对日下来说，惊吓的感觉似乎要更强烈。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00016",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……这样下去的话，我也会变成不良的人的」",
                voice: Some("li/n4yoko_0081"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00017",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「虽然无所谓，但是“不良的人”从日语语法来说是不是说错了？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00018",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呜呜，有点想早点回家啊……」",
                voice: Some("li/n4yoko_0082"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00019",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然也很在意这是抱持着什么样的偏见，但一般来说大致也会那样认为的吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00020",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "话说回来，这家伙，似乎连普通的咖啡店都没有进去过的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00021",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，差不多，我也该告辞了」",
                voice: Some("li/n4yoko_0083"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00022",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂喂，为什么那么着急啊」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00023",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「必，必须早点回去，还有我的宠物金鱼在等着呐」",
                voice: Some("li/n4yoko_0084"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00024",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "刚这么说完，用手拿起咖啡杯。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00025",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「咕咕咕……」",
                voice: Some("li/n4yoko_0085"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00026",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，烫烫烫，而且苦」",
                voice: Some("li/n4yoko_0086"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00027",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呼……喝了这么多的咖啡，说不定今天都睡不着了」",
                voice: Some("li/n4yoko_0087"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00028",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "似乎眼角都泛起了些许泪花，真的是有趣的家伙啊。",
