            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，莳绘君也是这里的常客吧？」",
                voice: Some("li/n4yoko_0088"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00032",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，除了在家，一般就在这里吧」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00033",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「唔，果然莳绘君也是不良分子啊……」",
                voice: Some("li/n4yoko_0089"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00034",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然不太清楚，但明显地被误会了啊……\n嗯，从小流连在这样的店里被误会也是当然的吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00035",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我说啊，话说在前头，我是因为咖啡和料理都很美味才来这里的」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00036",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶……？」",
                voice: Some("li/n4yoko_0090"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00037",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「而且这里的店主也是在我小时候便认识了，\n从以前开始我就一直承蒙他的关爱」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00038",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那难道是说，是亲戚什么的人？」",
                voice: Some("li/n4yoko_0091"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00039",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，不，虽然也不是那样啦……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00040",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "嗯……怎么说好呢……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00041",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然稍微感觉有点麻烦，但也不喜欢一直被误解着，所以我做了简单的说明。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00042",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你看，我家的工作是那个对吧？\u{3000}所以在这个城市里有很多熟人哟」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00043",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这样啊……说起来也许是这样……」",
                voice: Some("li/n4yoko_0092"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00044",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就这个店来说，之前店主也曾将自己的爷爷托付给我们养老院，\n是以此为契机与我们家相识的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00045",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因当时的缘分，直到现在店主与我们一家关系都很好。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00046",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然除了这里之外，其他熟络的店家和人还有很多。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00047",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶嘿嘿，似乎有点安心了」",
                voice: Some("li/n4yoko_0093"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00048",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「安心是什么啊，安心」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00049",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「因，因为，我还以为莳绘君说不定是不良分子，吓了一跳」",
                voice: Some("li/n4yoko_0094"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00050",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这是什么偏见啊……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00051",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过也算了，奇怪的猜测也搞清楚了就好。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00052",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "话说回来，难道班级里的伙伴们躲避我的原因，也许是因为这个。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00053",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么接下来也是时候出去了吧？」",
                voice: None,
