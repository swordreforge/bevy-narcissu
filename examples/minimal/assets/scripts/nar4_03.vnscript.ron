            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00055",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样说着，日下再次喝下一口咖啡。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00056",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「烫，烫，而且苦啊……」",
                voice: Some("li/n4yoko_0096"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00057",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呜呜，今晚，睡不着怎么办啊……」",
                voice: Some("li/n4yoko_0097"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00058",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "真是没有学习能力的家伙。话说，是有多怕烫啊？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00059",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且因为区区咖啡就睡不着，这是小孩子吗……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00060",
            ),
