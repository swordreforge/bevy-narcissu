            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这里的海风好舒服啊」",
                voice: Some("li/n4yoko_0098"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00065",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "日下边说着边脱下鞋子，在波浪中漫步。她长长的头发，在海风中飘扬。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00066",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，小心一点啊。偶尔会有很大的海浪打来的」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00067",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真是的，没问题的啦，我有好好留意着啦」",
                voice: Some("li/n4yoko_0099"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00068",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然而这次，虽然用着稍稍有些执拗的表情来争论，但是那话语却让人难以轻信。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00069",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……从前几天开始观察这家伙，我搞清楚了几件事情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00070",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "与那外表不符的，是骨子里相当的笨拙，与其说是天真烂漫，不如说是孩子气。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00071",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽说最初还给人以稳重的，或者说不显眼的印象呢……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00072",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不，说是稳重，不如说是笨笨的感觉？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00073",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「总觉得……你在考虑什么奇怪的事情吧？」",
                voice: Some("li/n4yoko_0100"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00074",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不，没有啊……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00075",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "为什么，偏偏在这种无关紧要的地方特别敏锐。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00076",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是今天，稍微有点高兴……」",
                voice: Some("li/n4yoko_0101"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00077",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「怎么了？突然」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00078",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，你看，知道了好多，以前不知道的莳绘君的事情呢……」",
                voice: Some("li/n4yoko_0102"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00079",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「而且……想到说不定，只有我一个人知道的话，就稍微有些开心」",
                voice: Some("li/n4yoko_0103"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00080",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是啊……\u{3000}如果那样说的话，我也差不多哦」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00081",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶……」",
                voice: Some("li/n4yoko_0104"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00082",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「最初，相识的时候，还在想是位多么阴暗的家伙呢」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00083",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呜……这可有点，过分啊」",
                voice: Some("li/n4yoko_0105"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00084",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样说着，日下又对我露出往常像是生气一般，又像害羞一般的表情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00085",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……像这样说着话的时候，明明是很普通的呐。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00086",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "突然，回想起了前几天放学时候的事情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00087",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是，或许就像莳绘君说的那样」",
                voice: Some("li/n4yoko_0106"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00088",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我这个人，总是很怕生，不擅长与人交往……」",
                voice: Some("li/n4yoko_0107"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00089",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「现在可不是那样哦」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00090",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那，那是因为，周围没有人在……」",
                voice: Some("li/n4yoko_0108"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00091",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后在这时，对我露出了稍稍有些寂寞的表情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00092",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说起来虽然今天不是那个样子，但是前几天放学的时候的确是那样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00093",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "恐怕性格方面的原因也占一部分……总的来讲，她比较笨拙吧……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00094",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我自己也是，不怎么自来熟的类型，能够理解她的心情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00095",
            ),
