            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "五月温和的阳光照耀着，天空高远而清澈，日下害羞地低着头走路。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00215",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明明是自己发出邀请的，今天却也像往常一样没有走在身边，\n而是磨磨蹭蹭地跟在我后边。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00216",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "大概，到了上学的时候，就又变成另一回事了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00217",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "前几天放学后一起回家的时候，和去海边的时候明明都不是这副样子的……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00218",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……嘛，因为和放学时不同，早上上学的时候就更加如此。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00219",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是被看到一起上学，便会在班级里产生谣言，确实有些不好意思。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00220",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以和以前一样，最初日下还在旁边并排着走着，渐渐地却拉开了距离。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00221",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……虽说如此，这样一来特地前来迎接的意义也没有了。",
