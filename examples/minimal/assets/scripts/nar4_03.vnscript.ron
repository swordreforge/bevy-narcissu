            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "五月的晴空下，洒下热乎乎的阳气。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00173",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "与其说是温暖，不如说让人觉得夏天提前了。",
                voice: None,
            ),
        ),
