            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呼哇，有些困啊……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00175",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边打着哈欠，一边麻利的替换着衣服……因为昨天睡得迟，还有少许困意。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00176",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然这次，不是因为熬了不必要的夜。",
