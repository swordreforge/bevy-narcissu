            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……一次又一次地，重复着这样的事情……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00316",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "大约被岩浆烧了一百次，被食人鱼也咬了五十次……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00317",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知从什么时候，即使什么都不说，她也会待在我的身边了。\n保持在我周围一米的安全地带之内，成为了理所应当的事情。",
                voice: None,
            ),
