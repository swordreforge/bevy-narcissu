            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00112",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……不会笑话我吗？」",
                voice: Some("li/n4yoko_0114"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00113",
