        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "之后我们出了咖啡店。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00061",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "也没有特意去什么地方，我们就直接向着旁边的大海走去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00062",
            ),
