            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00212",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那，那个，我是来确认你有没有好好去上学的，真的，是真的哦，哈呼」",
                voice: Some("li/n4yoko_0134"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00213",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一口气说完。该说这家伙有趣呢，还是容易懂呢……",
