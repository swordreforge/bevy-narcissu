            args: (
                name: "block_00296",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「看，很简单吧？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00297",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……………」",
                voice: Some("li/n4yoko_0155"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00298",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么从今往后，就当这里以外全都是岩浆……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00299",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "243",
                transition: Some(fade(
