        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「大概」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00114",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真是的，你好好做个约定啊……」",
                voice: Some("li/n4yoko_0115"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00115",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「明白了明白了，不会笑话你的，说说看嘛」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00116",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "随后一番扭捏之后，慢慢地说出口。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00117",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个啊，想要成为医生呢……」",
                voice: Some("li/n4yoko_0116"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00118",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……………」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00119",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "并不是想要嘲笑她。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00120",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过，那是不可能的事情吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00121",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我记得你……成绩并不是那么好吧？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00122",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯。不如说比较差……」",
                voice: Some("li/n4yoko_0117"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00123",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么家里很有钱吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00124",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不。普通的工薪家庭」",
                voice: Some("li/n4yoko_0118"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00125",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂喂，这不是毫无希望吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00126",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为家里工作的原因，认识几个当医生的熟人，因此或多或少了解这个职业。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00127",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "听说那种职业，若非成绩优秀，家里也很富裕的话，是当不了的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00128",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且是女医生，我到现在都没见过，就连老爸大概也是如此吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00129",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐日下，虽然不会嘲笑你……但那是不可能的吧」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00130",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真是的，我知道啊……我也只是，不知怎么地随便想想罢了……」",
                voice: Some("li/n4yoko_0119"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00131",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「说起来，又是为什么偏偏想要做医生呢？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00132",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，那是，那是因为……」",
                voice: Some("li/n4yoko_0120"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00133",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……………」",
                voice: Some("li/n4yoko_0121"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00134",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……我自己，身体不怎么好……」",
                voice: Some("li/n4yoko_0122"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00135",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "nami3",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那样说着，稍微变得寂寞的日下。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00136",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……不知为何，我似乎也体会到了她的感受。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00137",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为家里工作的关系，至今为止无数次感受到自己的无力。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00138",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "每次有谁因为病症而倒下……又有谁离开了养老院……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00139",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就会想到如果这里有医生在的话。至少在精神上，应该会成为巨大的支撑吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00140",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……但是，每次都因为撞到了现实的南墙而放弃了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00141",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "呼～，我轻吐一口气。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00142",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，尽我所能的用积极的声音说道，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00143",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嘛，加油哟」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00144",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶……」",
                voice: Some("li/n4yoko_0123"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00145",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「说“办不到”很简单，可不做出行动的话任何事情都不会有起色的呀……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00146",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……莳绘君……」",
                voice: Some("li/n4yoko_0123_01"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00147",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为我的话，日下的眼泪在眼眶里咕噜咕噜打转。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00148",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "好像说了有些不符合身份的帅气的话，但这并不是谎言或者玩笑。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00149",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽不是很清楚，但如果扎扎实实地去学习去努力的话，可能性应该也不是零吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00150",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么那个……莳绘君也，不要逃学了一起来吧」",
                voice: Some("li/n4yoko_0124"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00151",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哈？\u{3000}和我没关系吧」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00152",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶～，但是，只有我自己的话有些……」",
                voice: Some("li/n4yoko_0125"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00153",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯——，就算你那样说也……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00154",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐，拜托了」",
                voice: Some("li/n4yoko_0126"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00155",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "边说着，边“呯”的双手合十。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00156",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但说到底，连我自己现在都只是不得已地、无可奈何地的在上学啊。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00157",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……不行吗？」",
                voice: Some("li/n4yoko_0127"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00158",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哎ー，明白了啦，明白了啦，别用那样的表情看着我啊」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00159",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真的吗」",
                voice: Some("li/n4yoko_0128"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00160",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，尽我所能，能去的时候就去啦」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00161",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呜，再逃课的话可不行哦，约好了啊」",
                voice: Some("li/n4yoko_0129"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00162",
            ),
