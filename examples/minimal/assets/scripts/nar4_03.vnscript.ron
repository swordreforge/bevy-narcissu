            args: (
                speaker: None,
                text: "「阿勒？\u{3000}哥哥要去学校了？」",
                voice: Some("li/np4imo_1014"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00178",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯……算是吧」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00179",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是，昨天值过夜班，没有睡觉吧？」",
                voice: Some("li/np4imo_1015"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00180",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，妹妹向我露出了稍显不可思议的表情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00181",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "嗯，说起来这也是理所当然的反应。",
                voice: None,
