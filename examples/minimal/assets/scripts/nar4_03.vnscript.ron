            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "太阳依旧高照，在温暖阳光的照射下，波浪间闪闪发光。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00063",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在那片沙滩之上，有她那欢快地跃动着的身姿。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00064",
            ),
        ),
        (
            cmd: play_bgm,
            args: (
                id: "66",
                volume: Some(0.78431374),
