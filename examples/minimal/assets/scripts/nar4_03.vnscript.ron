                channel: Some(4),
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "nami3",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从面前传来潮水的响声和海鸟的鸣叫声。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00096",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我们一起坐在沙滩上，眺望着大海。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00097",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是真好啊，莳绘君家里，做着很出色的工作……」",
                voice: Some("li/n4yoko_0109"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00098",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没到很出色的程度吧」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00099",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不会啊，如果我在莳绘君的立场的话……」",
                voice: Some("li/n4yoko_0110"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00100",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「果然觉得就算是休学，也要先优先家里的事情」",
                voice: Some("li/n4yoko_0111"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00101",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不是，我也没到那种觉悟啦……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00102",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……事实上也并不是那样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00103",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽有些说不出口，其实对我来说，也觉得这是很有意义的很出色的工作。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00104",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "父亲总会说一些很严厉的事情，但一定不只是那样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00105",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "能使养老院里的大家开心，那也很令人感到快乐。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00106",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，现在还在摸索阶段……\n和前几天，在电视上面看到的美国的专业设施比起来的话还远远不够……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00107",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "至少，比起将精力浪费在学校里的无聊课程和升学上面来说，\n这件事情对我来说更加有价值。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00108",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不过啊，日下的话，又有什么想做的工作呢？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00109",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我？」",
                voice: Some("li/n4yoko_0112"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00110",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是啊，你也有什么想要做的工作吧？」",
                voice: None,
