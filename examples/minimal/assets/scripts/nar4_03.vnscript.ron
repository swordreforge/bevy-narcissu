        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那一天……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00163",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我们交换了好几个约定。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00164",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "叫做协定也好，叫做规则也罢。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00165",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……彼此都是游离于班级之外的存在的我们俩。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00166",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "身体不是很好，经常休学的她。还有，因为家业的关系经常翘课的我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00167",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样的我们俩，做出了约定，如果有一方不来学校的时候，要互相分享笔记。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00168",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然于我而言，老实说学校也好，学习也罢，都无所谓。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00169",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，看着虽然笨拙却又拼命努力的她……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00170",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知为何，变得想要去支持她了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00171",
            ),
        ),
