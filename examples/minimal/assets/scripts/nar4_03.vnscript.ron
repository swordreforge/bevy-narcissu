        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "五月温和的阳光照耀着，天空高远而清澈。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00300",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "雨后潮湿的沥青路面散发出石灰的味道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00301",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "路面的水洼中倒映着蔚蓝色的天空，其中散发出的气味似乎让人不觉想起了夏天。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00302",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这通往学校的路上，与一如往常害羞的她一起走着……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00303",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个……谢谢你……」",
                voice: Some("li/n4yoko_0157"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00304",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "突然之间，小声嘟囔的她。我一声不响地，轻轻地敲了一下她的脑袋。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00305",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……我想我一定，是害羞了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00306",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "做着这些不合身份的事情，就连自己也察觉到了……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00307",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n4bg_007a",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这之后我们也并排进入了教室，而班里的同学们偷偷地看着我们的情况。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00308",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽不知为何将我当成了不良，却也一直没有特别嘲弄我……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00309",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "和往常一样，害羞地坐在教室角落的她。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00310",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对着这样的日下，我一次又一次地，说着岩浆啦食人鱼啦之类的……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00311",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且每次这样做的时候，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00312",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哇啊，痛，要被吃掉了」",
                voice: Some("li/n4yoko_0158"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00313",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样说着，配合着我的日下。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00314",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然班级里的人们对着这样的行为展露出了不可思议的表情……\n我却毫不在意地继续下去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00315",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "w",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
