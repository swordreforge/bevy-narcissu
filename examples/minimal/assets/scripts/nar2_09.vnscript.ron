            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…我记得你是，姬子的…」",
                voice: Some("li/setsumi_0161"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00006",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，她的妹妹千寻」",
                voice: Some("li/chihiro-0104"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00007",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一如往常的，娴静的言谈举止，温柔的说话方式。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00008",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "和姬子不同，她…千寻的话，\n即使告诉我她是陪护和天主教徒，我也不会感到惊讶。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00009",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她今天和平时在医院所见身着围裙的姿态不同，\n穿着白色的可爱连衣裙，给人一种「很相称」的感觉。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00010",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「难道说，现在正要去姬子那边吗？」",
                voice: Some("li/chihiro-0105"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00011",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…嗯，千寻也是吗？」",
                voice: Some("li/setsumi_0162"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00012",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不，我还有其他地方要先去一趟……」",
                voice: Some("li/chihiro-0106"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00013",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，对了…\u{3000}可以的话，濑津美也一起来吧？」",
                voice: Some("li/chihiro-0107"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00014",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，嗯」",
                voice: Some("li/setsumi_0163"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00015",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然不知道是什么事情，不过我还是跟在了千寻身后。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00016",
            ),
        ),
        (
            cmd: set_bg,
