            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "z42r",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…在炙热的天空下，两个人并肩行走着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00017",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "和姬子不一样，千寻很少说话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00018",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过不知为何，只要和她在一起，就会给人一种放心的感觉。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00019",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不久后，在距离医院前不远的地方，平常我没去过的十字路口的左转处…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00020",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知不觉，四周已是幽静的住宅区，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00021",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你看，在这拐弯就是了」",
                voice: Some("li/chihiro-0108"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00022",
            ),
