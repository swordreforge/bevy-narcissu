        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "钟声响彻着。\n在眼前出现了一座宏伟的教堂。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00023",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "早在以前，就听说了附近有座教堂，不过实际到这里拜访还是第一次。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00024",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「顺便一提，旁边白色的建筑物，就是我的家喔」",
                voice: Some("li/chihiro-0109"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00025",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着指向那个方向，坐落着给人感觉很恬静的美丽房屋。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00026",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "缠绕着常春藤的围墙，很有洋房的感觉。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00027",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…理所当然的，千寻家的话也就是说，这也是姬子的家吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00028",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，我被她催促着，走进了教堂里面。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00029",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "kyoukai2",
