            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "还有，从口袋拿出的东西，一开始以为是念珠，不过仔细一看却是十字架。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
