        (
            cmd: label,
            args: (
                name: "block_00040",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在电视上看到的，只是将双手手指合拢起来，像是参拜一样的，普通的合上双手而已。",
