            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "听到熟悉的声音我回过头去，那里是前几天见过面的她。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00005",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "miti2",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
