),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "11月清澈的天空。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "吹拂的风，也将要正式染上冬天的气息。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "中庭。\n我一如往常地正在给花坛浇水…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「今天也是个好天气啊……」",
voice: Some("li/n4obasan001"),
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有位女士向我搭话。\n是位偶尔在谈话室说过话的，面熟的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎，可以的话，能收下这个吗？」",
voice: Some("li/n4obasan002"),
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我看了一下，是一本诗集。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为她总是将这本书带在身边，\n想必是本她心爱的书。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，我没有收下它的理由。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……为什么……要给我？」",
voice: Some("li/n4setu_016"),
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为你看上去，是个喜欢读书的人……\n而且也没有其他能给的人了……」",
voice: Some("li/n4obasan003"),
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完，她用手指了指我手上拿着的地图和图鉴一类的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「毕竟，给其他人的话……\n收下了也会感觉很为难吧？」",
voice: Some("li/n4obasan004"),
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是啊…………会很为难呢」",
voice: Some("li/n4setu_017"),
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我对她的话表示同意，并收下了书。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在我接过书时，她那像是寂寞，又像是欣喜的……\n十分复杂的表情，给我留下了深刻的印象。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "花坛前，仍然日头高照。\n属于一段同为白手环佩戴者之间的对话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，我也差不多该走了」",
voice: Some("li/n4obasan005"),
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……嗯」",
voice: Some("li/new_086"),
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
