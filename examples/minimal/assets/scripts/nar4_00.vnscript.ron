args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在其他花都已枯萎，冷冷清清的花坛之中……\n有颗独自，青葱成长着的水仙。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明还没有到正式的花期，\n却已经开始绽放出星星点点的白花。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00035",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……曾经，和姬子小姐一起种下的这些花儿。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00036",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在那之后又绽开多少次了呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00037",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―水仙正式的花期是1月到３月。\n虽然能用种子栽培，但还是以鳞茎栽培为主。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还有……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00039",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……花语是爱自己。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "尽管迄今为止这些年，我一直能见到这些花的身姿……\n总觉得今年似乎有些困难了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00041",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是这些花会先绽放和凋零呢……\n还是，我会先死去呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00042",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "大概，会是在一个接近的时间点吧。\n我想离这个预测不会差太远。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，看着已经星星点点绽开的几朵花儿，能感觉到说不定花会更早。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在我还在漠然地思考那些事的时候。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
