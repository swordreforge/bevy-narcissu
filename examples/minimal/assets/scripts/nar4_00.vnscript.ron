channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「一定是从这两者中选其一吧」",
voice: Some("li/2n4yoko_0084"),
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "向来没有其他的选项。\n我也不知道哪一个是正确答案。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是想要悄然离去，\n还是期望留下某些证明……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我……选择了后者」",
voice: Some("li/2n4yoko_0085"),
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，仅此而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不，准确来说最开始是前者。\n但逐渐转变成了后者……",
voice: None,
),
),
(
