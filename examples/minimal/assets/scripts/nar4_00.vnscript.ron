),
),
(
cmd: label,
args: (
name: "block_00003",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「想要不被任何人察觉，\n不留下任何痕迹地，悄悄地离去……」",
voice: Some("li/2n4yoko_0082"),
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: set_bg,
args: (
