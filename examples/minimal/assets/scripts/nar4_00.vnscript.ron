),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……真是个有些奇怪的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00058",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一般来说，医院里的医生，不知是不是因为顾及我们的感受，\n总是对我们很客气……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00059",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知为何从这个人身上，却感受不到那样的氛围。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00060",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "话说，医院里的大人物，在这种地方无所事事真的好吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00061",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……你……很闲吗？」",
voice: Some("li/n4setu_021"),
),
),
(
cmd: label,
args: (
name: "block_00062",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不过，还是没有你们闲吧」",
voice: Some("li/4syuji_047"),
),
),
(
cmd: label,
args: (
name: "block_00063",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……………」",
voice: Some("li/setunp_1075"),
),
),
(
cmd: label,
args: (
name: "block_00064",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……听说病人的工作就是好好睡觉」",
voice: Some("li/n4setu_023"),
),
),
(
cmd: label,
args: (
name: "block_00065",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，这话没错」",
voice: Some("li/4syuji_048"),
),
),
(
cmd: label,
args: (
name: "block_00066",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然语气沉着，说话内容却直言不讳。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00067",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真是个怪人……你应该是医院里的大人物吧」",
voice: Some("li/n4setu_024"),
),
),
(
cmd: label,
args: (
name: "block_00068",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是啊，别看我这样其实很厉害哦」",
voice: Some("li/4syuji_049"),
),
),
(
cmd: label,
args: (
name: "block_00069",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「现在担任着医疗局长，以前也做过院长」",
voice: Some("li/4syuji_050"),
),
),
(
cmd: label,
args: (
name: "block_00070",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不是很清楚，\n但如果是院长的话应该是医院里最厉害的人了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00071",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么……这么厉害的医生，找我有什么事吗？」",
voice: Some("li/n4setu_025"),
),
),
(
cmd: label,
args: (
name: "block_00072",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，因为我对那个有些在意」",
voice: Some("li/4syuji_051"),
),
),
(
cmd: label,
args: (
name: "block_00073",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着他望着我手里拿着的那些书。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00074",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「地图、图鉴和诗集……\n明明这么年轻兴趣却很广泛呢？」",
voice: Some("li/4syuji_052"),
),
),
(
cmd: label,
args: (
name: "block_00075",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没什么。我不年轻，书也是从别人那里收下的」",
voice: Some("li/n4setu_026"),
),
),
(
cmd: label,
args: (
name: "block_00076",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……原来如此。收下的东西吗」",
voice: Some("li/4syuji_053"),
),
),
(
cmd: label,
args: (
name: "block_00077",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知为何，他又自顾自地认同了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00078",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "接着，又看着我手上的白手环说道，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00079",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话说回来，七楼还住得惯吧？」",
voice: Some("li/4syuji_054"),
),
),
(
cmd: label,
args: (
name: "block_00080",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……一般」",
voice: Some("li/n4setu_027"),
),
),
(
cmd: label,
args: (
name: "block_00081",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「一般啊……你真是相当严厉呢」",
voice: Some("li/4syuji_055"),
),
),
(
cmd: label,
args: (
name: "block_00082",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「顺便一问，规则还在流传着吗？」",
voice: Some("li/4syuji_056"),
),
),
(
cmd: label,
args: (
name: "block_00083",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「咦……」",
voice: Some("li/n4setu_028"),
),
),
(
cmd: label,
args: (
name: "block_00084",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……规则？为什么这个人会知道这些……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00085",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听说规则只会在七楼的人之间流传，\n姬子也这么说过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00086",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而现在自己来到七楼后，\n也认为这些说法是真的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00087",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎呀，别摆出那种架势。\n我并不是说要你告诉我那些……」",
voice: Some("li/4syuji_057"),
),
),
(
cmd: label,
args: (
name: "block_00088",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你……真是个奇怪的医生」",
voice: Some("li/n4setu_030"),
),
),
(
cmd: label,
args: (
name: "block_00089",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是啊……或许的确是这样呢……」",
voice: Some("li/4syuji_058"),
),
