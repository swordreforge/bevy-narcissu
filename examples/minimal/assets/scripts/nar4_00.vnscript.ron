args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……真是性急呢，已经在开花了吗」",
voice: Some("li/4syuji_042"),
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "回头看去，那是一位穿着白大褂的中年大叔。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00047",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "印象里有见过几次。\n记得好像是这个医院里一位地位很高的医生。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00048",
),
),
(
cmd: set_bg,
args: (
image: "sin_b06b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
