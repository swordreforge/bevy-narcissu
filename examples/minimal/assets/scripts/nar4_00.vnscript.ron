),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完这句话后，那位女士向家人身边走去。\n即使是同样戴着白手环的人，但这是她第三次临时出院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……恐怕，已经不会再次见面了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我把收下的书放到长椅上，再次拿起了喷水壶。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: play_se,
args: (
file: "mizuyari",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
