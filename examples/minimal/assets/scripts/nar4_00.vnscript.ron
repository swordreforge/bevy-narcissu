args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那些花……是你在照料吗？」",
voice: Some("li/4syuji_043"),
),
),
(
cmd: label,
args: (
name: "block_00049",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「并不……」",
voice: Some("li/setsumi_0026"),
),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「可我经常看见你呢」",
voice: Some("li/4syuji_044"),
),
),
(
cmd: label,
args: (
name: "block_00051",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "接着他来到我面前的长椅上，坐下说道，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00052",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「来吧，你也坐一会如何？」",
voice: Some("li/4syuji_045"),
),
),
(
cmd: label,
args: (
name: "block_00053",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…………」",
voice: Some("li/n4setu_019"),
),
),
(
cmd: label,
args: (
name: "block_00054",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「今天是个好天气，感觉很舒服啊」",
voice: Some("li/4syuji_046"),
),
),
(
cmd: label,
args: (
name: "block_00055",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……嗯，明白了」",
