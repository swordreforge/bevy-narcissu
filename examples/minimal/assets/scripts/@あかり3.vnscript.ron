        (
            cmd: label,
            args: (
                name: "block_00087",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就算是年轻男性，突然行踪不明，满2天就是极限了的样子。\n马上就会引起家人和朋友们的骚动。",
                voice: None,
            ),
        ),
