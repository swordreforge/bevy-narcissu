        (
            cmd: label,
            args: (
                name: "block_00086",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这个现代里，几乎不存在跟社会没有“联系”的人。\n尤其是在首都圈呀城市中之类就更是如此。",
                voice: None,
            ),
