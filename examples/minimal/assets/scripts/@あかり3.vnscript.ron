            args: (
                name: "block_00088",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "小孩呀女性的话1天就是极限。\n换做年纪大的人，这次就会变成是家里的子女开始着急。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00089",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……从什么时候开始这个社会，变得这么爱操心了？」",
