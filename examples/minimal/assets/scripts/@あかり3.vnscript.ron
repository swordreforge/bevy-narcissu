        (
            cmd: label,
            args: (
                name: "block_00211",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然而，从床上下来就会死掉。\n不仅这么是这么被告知的，事实上最初遇到的大叔也死了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00212",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那，现在只能等着有人来了？」",
                voice: None,
