(
cmd: dialogue,
args: (
speaker: None,
text: "从深夜开始就下个不停的雨，把路肩变成了污浊的小河。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00001",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "6月12日，中午。\n厚实的乌云上的日光很弱。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00002",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "梅雨季才刚刚开始。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00003",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好闷热……\n为什么要在像今天这样的天气里模拟考啊……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "厌恶着被汗水浸湿的牛仔裤的同时，在走惯的道路上走着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: set_bg,
args: (
image: "bg_a0002d",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "没过多久到达的是，七层的大楼。\n被爬山虎缠绕的氛围，与其说是古风倒不如说是破旧吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "处处可见细小的干燥龟裂。\n虽然不知道建成了多久，但也有相当的年头了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我在这破旧的建筑进出已经有1年了。\n这里是大学入学考试失败的人会来的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "它一般被人们叫作预备学校。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: set_bg,
args: (
image: "bg_a0001",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在我身旁等待电梯的是，是一群欢闹的高中生。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以应届生身份就读预备学校的学生们，\n和像我这样以浪人身份过来的人在气势上就不同。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "脚步的重量也不同，人们的看法也不同。\n他们是未成年。我马上就19岁了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前的同学已经开始选择自己的学科了，而我还没有进入大学。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「今年是最后一年了吧…… \n已经没有后路，必须要努力了……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然嘴上这么说，比起热情，失意已经占据了上风。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: play_se,
args: (
file: "elv2",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "被满电梯的高中生挤着，升向目标楼层。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "他们高兴地谈论着周末计划的声音，让我感到愈发地不爽。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "于是我向着屋顶走去。\n没有什么特别的原因。旷预备学校的课也不是第一次了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不喜欢跟在成群地走向教室的他们身后。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在洁白的走廊里行走也好，\n装着大玻璃的教室也好说不定也都不喜欢。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: set_bg,
args: (
image: "bg2060d",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: play_se,
args: (
file: "kaze13",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "“咻”的一阵强风，视野有一瞬变得全白。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "眼睛习惯后，看到的是伫立在小雨中的绿色围栏。\n貌似有两米以上的高度，显得很高。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是不去攀爬就翻越不了的障碍。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛，应该是为了防止自杀吧……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这种程度不用问都能想到。\n只是为了安全的话是不需要这么高的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这分隔生死的障壁的另一边，已经有人先到了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并不是安全的这一侧，而是属于死亡领域的围栏另一侧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一个人眼神空洞地站在那里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: set_bg,
args: (
image: "ev_a009c",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……难道……是想跳下去吗？我想不到其他理由。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我正犹豫着该如何开口搭话时，对方先开了口。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你也想死吗？」",
voice: Some("li/tpapa_0001"),
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不认识的大叔说到，看起来40岁左右。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看起来很高级的青色格子领带和下巴的胡子令人印象深刻。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂，你也是因为死亡的命运，来到这里的吗？」",
voice: Some("li/tpapa_0002"),
),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…命运？不知道他在说什么…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00035",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「大概不是，我还不想死……啊，\n不，我也不是很清楚……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00036",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如此回答道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00037",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我不知道这种情况下该怎么回答才好。\n我想恐怕这就是我真实的心情了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: set_bg,
args: (
image: "ev_a008b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「其实我也不想死……\n但好像已经到极限了」",
voice: Some("li/tpapa_0003"),
),
),
(
cmd: label,
args: (
name: "block_00039",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如他所说，他微微颤抖着的膝盖平静不下来。\n看起来内心非常焦躁的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是，语调却十分沉稳冷静，\n不像是现在想要寻死的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00041",
),
),
(
cmd: set_bg,
args: (
image: "ev_a009c",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，虽然会跳下去……\n但放心好了我不会死的。 因为我是不死身」",
voice: Some("li/tpapa_0004"),
),
),
(
cmd: label,
args: (
name: "block_00042",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈？ 不死身？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以说不会死的。正确来讲应该是不老不死吧」",
voice: Some("li/tpapa_0005"),
),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……说啥呢？\n这个不起眼的大叔是不死身？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "简直就像是把中二的话一本正经说出来的大叔。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「（……明明马上就要去死，有些不对劲……）」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00047",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还是说对死亡做出了觉悟的人，往往就是这样的吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00048",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不要紧，这样睡下去的话，很快的……」",
voice: Some("li/tpapa_0006"),
),
),
(
cmd: label,
args: (
name: "block_00049",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着松开了抓住围栏的手。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂、喂、等下、停下来啊」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00051",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "为了穿过围栏不禁提高了声音。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00052",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知道是不是真心想阻止他。\n还是条件反射。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00053",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当眼前有打算寻死的人，\n我想谁都会做出同样的反应。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00054",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对这样的我，大叔再次转过身来……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00055",
),
),
(
cmd: set_bg,
args: (
image: "ev_a008",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「如果什么时候你真的有了想死的想法……让给你也行」",
voice: Some("li/tpapa_0007"),
),
),
(
cmd: label,
args: (
name: "block_00056",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「让？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00057",
),
),
(
cmd: dialogue,
