),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……已经浮现出了几个疑问，\n不过首先想到的是，这家伙到底是什么人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00213",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果说没有什么目的的话，不会有人会来这种地方。\n何况这样的小女孩就更不会了。",
