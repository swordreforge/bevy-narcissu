        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为到了下午的休诊时间，门诊通道几乎看不到什么人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00114",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "有时候，会看到医生，带着像是实习医生的人经过这里。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00115",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "或是慌忙赶往急救中心的护士。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00116",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明明被限制进食了，却还去商店买东西吃的患者。\n看他手腕上的绿色手环，据说是表示消化系统问题的疾病。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00117",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这所有的画面，都是习以为常的医院场景。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00118",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，在那个商店门前…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00119",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我第一次，和那个人相遇了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00120",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "black-2",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，你…」",
                voice: Some("li/sabu_006"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00121",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯？」",
                voice: Some("li/setu_015"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00122",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "突然被一个开朗的声音叫住，我有些惊讶。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00123",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "回头一看，是个穿着睡衣，面生的姐姐。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00124",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然想着，是不是住院时曾认识过的哪位呢，但是我确实没有对这个面貌的记忆。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00125",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "a006",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…有什么事吗？」",
                voice: Some("li/setu_016"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00126",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，纽扣快要掉了喔…」",
                voice: Some("li/sabu_007"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00127",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她边说着边用手指向我的手提包。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00128",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然只是单纯的亲切也说不一定，不过被告知自己已经发觉的事情，\n我也有些不知道该如何回答。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00129",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…是啊…」",
                voice: Some("li/setu_017b"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00130",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「什么“是啊”啊？你就没有其他要说的吗？」",
                voice: Some("li/sabu_008"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00131",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……………」",
                voice: Some("li/setu_018b"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00132",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……谢谢……」",
                voice: Some("li/setu_019d"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00133",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我边说着边低下头。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00134",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我犹豫着，感觉果然还是不能说自己已经知道了。\n不过，似乎道谢也显得有些奇怪。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00135",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…没见过的姐姐。\n她那一头长长的黑发和那明亮的声音令人印象深刻。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00136",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看到她穿着的不是医院准备的拖鞋，\n就知道她大概不是来医院探病的人，而是就住在医院的人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00137",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…那纤细的手腕上，手环的颜色是白色的。这是我第一次看到，\n我所不知道意思的颜色。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00138",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，我帮你缝好吧？」",
                voice: Some("li/sabu_009"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00139",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「唉？」",
                voice: Some("li/setu_020c"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00140",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我可是，有带着针线盒的喔…」",
                voice: Some("li/sabu_010"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00141",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…可是……」",
                voice: Some("li/setu_021c"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00142",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我对于这突然的一句话感到不知所措。\n这，说的不光是纽扣的事情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00143",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这数年来，对于被大家消除存在的我来说，从未有过对方想与我进一步接触的事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00144",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「好啦好啦，来，跟我来吧。」",
                voice: Some("li/sabu_011"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00145",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……………」",
                voice: Some("li/setu_022"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00146",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没事的啦，又不是什么奇怪的地方。」",
                voice: Some("li/sabu_012b"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00147",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说完了这句话，姐姐就自顾自的转身开始走掉。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00148",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我保持着复杂的心情，跟在了后面。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00149",
            ),
        ),
