        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "姐姐默不作声，按下了最顶楼的按钮。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00151",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…７Ｆ？」",
                voice: Some("li/setu_023"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00152",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哎呀？难不成你知道？」",
                voice: Some("li/sabu_013"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00153",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…不…说不上知道的程度…」",
                voice: Some("li/setu_024"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00154",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "７Ｆ。\n也就是称作安宁病房的地方。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00155",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "详细的情况我并不知道，当然也根本就没去过。\n说到底，这里本身就听说禁止无关人员进入。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00156",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "前往那里也就表示着，这姐姐是7楼的人吧…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00157",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "byoin7_rouka",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "ele2",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不久后电梯到了。\n马上出现在眼前的是护士的值班室。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00158",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，打开门的同时，护士们一同往这边看来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00159",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，她是我认识的人」",
                voice: Some("li/sabu_014"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00160",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为这一句话，又继续着她们的工作。\n就再也没往我们这边瞧了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00161",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是，我觉得初次来到的这个地方…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00162",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "微妙的，有着独特而不可比拟的凝重氛围。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00163",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "danwa",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "姐姐带着我来到，像是谈话室的地方。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00164",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "很明显这里和我所住过的，3楼或是其他楼层不同。\n这里有着沙发和大屏幕的电视。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00165",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，马上帮你缝好哟…」",
                voice: Some("li/sabu_016"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00166",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样说着，姐姐接过我的手提包，开始熟练的缝起纽扣来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00167",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我也坐到沙发上环视这里。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00168",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "环顾四周，也感受不到什么人的气息，\n顶多就是偶尔看见老人和像是陪护的人经过而已。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00169",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对了，你…」",
                voice: Some("li/sabu_017"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00170",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是感冒了吗？或者是来探望别人的？」",
                voice: Some("li/sabu_018"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00171",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: Some("li/setu_025"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00172",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…现在…是正在接受治疗中…」",
                voice: Some("li/setu_026b"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00173",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然烦恼过该怎么说，不过还是老实的回答了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00174",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "也说出了之前几天刚出院，现在又在接受治疗的事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00175",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯~，看来你也很辛苦呢…」",
                voice: Some("li/sabu_019"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00176",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「顺便问下，你参加的是什么社团呢？」",
                voice: Some("li/sabu_020"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00177",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…社团？」",
                voice: Some("li/setu_027"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00178",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你看，现在不还是暑假吗？」",
                voice: Some("li/sabu_021"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00179",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边说着，一边指向我的校服。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00180",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「因为是住过院的人应该是文化部吧？\u{3000}难道是运动部的经理么？」",
                voice: Some("li/sabu_022"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00181",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不…什么都没做…」",
                voice: Some("li/setu_028"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00182",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呀？\u{3000}真是意外的回答呢。」",
                voice: Some("li/sabu_023"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00183",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…………………」",
                voice: Some("li/setu_029"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00184",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…难道…是因为讨厌睡衣？」",
                voice: Some("li/sabu_024"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00185",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这突如其来的敏锐问题，我真不知道该如何回答是好。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00186",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "也不能说是因为讨厌睡衣，感觉详细的原因，无法用语言来表达贴切。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00187",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，姐姐问的问题…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00188",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "大概，指的是那件事吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00189",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "并不是字面上是的那样,问的是我喜不喜欢睡衣。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00190",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「姐姐是…这里的病人？」",
                voice: Some("li/setu_031b"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00191",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，别看我这样，我也是7楼的居民喔」",
                voice: Some("li/sabu_026"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00192",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「简单来说的话，就是很快就会死的人呢」",
                voice: Some("li/sabu_027"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00193",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这种我原本只以为是传闻的事，直接，被7楼的病人干脆地说出来了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00194",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "能用这么开朗的声音说出死这个字的姐姐。\n至少我是没有办法能理解的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00195",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…这个人，到底在想些什么呢…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00196",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，如果可以的话下次再来玩吧」",
                voice: Some("li/sabu_028"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00197",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…我吗？」",
                voice: Some("li/setu_032c"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00198",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，没什么能做的事很无聊呢」",
                voice: Some("li/sabu_029"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00199",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「而且啊，这里探访时间到很晚也没什么问题的」",
                voice: Some("li/sabu_030"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00200",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后姐姐她，又告诉了我很多关于这7楼的事情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00201",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然一直以来都只知道些模糊的传闻，\n不过看来这里是等死的地方的说法似乎是真的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00202",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「虽然还有其他的规则，不过到这里就不能再说了」",
                voice: Some("li/sabu_031"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00203",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…为什么？」",
                voice: Some("li/setu_033"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00204",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这不是理所当然的吗」",
                voice: Some("li/sabu_032"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00205",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「因为你…不是这里的病人啊…」",
                voice: Some("li/sabu_033"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00206",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她这样喃喃着…露出了沉重的表情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00207",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这表情看起来不仅是寂寞，甚至也感到似乎是严肃的感觉。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00208",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…今天也穿着这身衣服，仍不死心地追寻着过往日常的我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00209",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "与这样的我不同，这个姐姐…不，这个7楼的病人，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00210",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她已经接受了所有现实，已经有所觉悟了吗…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00211",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「反正，下次来医院检查的时候就记得顺道来玩吧…」",
                voice: Some("li/sabu_034"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00212",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「看在我不管怎么样努力，最多也不会超过半年的份上」",
                voice: Some("li/sabu_035"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00213",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她这么说着向我告别，再一次朝我露出了她的笑容。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00214",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "black-2",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "黑色的长发和白色的塑料手环。\n愉悦似的说话方式给人留下了深刻的印象。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00215",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "互相之间，明明连名字都还不知道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00216",
            ),
        ),
        (
