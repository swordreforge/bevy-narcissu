        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，又经过了那个学校，在眼前就能看见医院的入口时…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00104",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…纽扣，要掉了呢…」",
                voice: Some("li/setu_014"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00105",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "手里拿着的小小的手提包。\n我注意到手提包带子的纽扣快掉了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00106",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然不知道是从什么时候开始掉的，不过都来到这了也不可能再回家去缝上。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00107",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "于是我把手提包抱在胸前，就这样走进医院。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00108",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "black-2",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…………",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00109",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "同样的医生，同样的对白，今天的检查也就这么结束了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00110",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "身体状况稳定的时候一周1次，要是一周3次的话就是短期住院的预兆了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00111",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…这一周的检查结束了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00112",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边想着那些事，我一边走向1楼的大门。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00113",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "a006",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
