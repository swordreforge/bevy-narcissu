        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…还没有问题」",
                voice: Some("li/setu_012"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00081",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不明缘故的这样自言自语着，从单杠上看见的景色。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00082",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "强烈的阳光把地面染成白色，地面因热气扭曲的光线而变的摇摆不定。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00083",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "时不时能听到的小孩们的笑闹声，以及强调自己是夏日主角的蝉鸣声。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00084",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "用已经承受不住身体而开始颤抖的手腕，我，感受着“现在”。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00085",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…为什么，会突然想到做这种事情呢…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00086",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "详细的原因连自己也不知道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00087",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如今，没有穿睡衣以外的衣服的时候，也没有需要穿睡衣以外的衣服的时候了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00088",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "大抵是因此而感到寂寞吧…又或是因为，想确认自己的体力是否还凑合…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00089",
            ),
        ),
        (
            cmd: set_bg,
            args: (
