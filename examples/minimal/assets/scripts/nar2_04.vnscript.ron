        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…好热……」",
                voice: Some("li/setu_011"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00097",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明明还没到中午，柏油马路便蹿起了热气。\n看来今天也会很热呢。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00098",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这种天气里，我像平常一样一个人前往医院。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00099",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为很近，所以穿着睡衣去也没什么大不了的，\n不过现在外出的时候我却常常穿着校服。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00100",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…这样看来，我果然还是在动摇着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00101",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样内心的动摇会持续到什么时候自己也不知道。\n可能某天会突然就放弃也说不一定吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00102",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只不过，三年的光景，足以改变一个人了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00103",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "a005",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
