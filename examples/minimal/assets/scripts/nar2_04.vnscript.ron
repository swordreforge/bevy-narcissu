            ),
        ),
        (
            cmd: play_bgm,
            args: (
                id: "102",
                volume: Some(0.78431374),
                fade_ms: Some(500),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "炙热的阳光和蝉鸣。\n看来今天也会很热呢。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00002",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从那天起，从初次住院至今，已经是第3年的夏天了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00003",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然我也并非一直都待在医院。\n而是每天过着往返自家和医院的日子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00004",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「大概是半年前吧…最后来看望我的人是…」",
                voice: Some("li/setu_003"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00005",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "穿着睡衣的时间也在慢慢增加…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00006",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就好像和这成反比一样，来探望我的人也慢慢变少。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00007",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一开始每天来看我的同学们。\n曾经，那些被称作朋友的存在。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00008",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "到了现在，已然变成了“认识的人”。\n在街上偶遇的时候，也只是打个两三句招呼就离开了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00009",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "再过段时间，就会变成“陌生人”，最后彻底消失在他们的记忆之中吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00010",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「看来，对于一般人来说…」",
                voice: Some("li/setu_004"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00011",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我并非是能让人感到愉快的存在吧…」",
                voice: Some("li/setu_005"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00012",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "即使只是和我见一面也会感到不舒服，\n脑海里想到我的事时，大概也是一样的感觉吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00013",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…所以，才会将我从他们的世界抹除的吧…」",
                voice: Some("li/setu_006"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00014",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但每到放学的时候，我还是会从窗户看看有没有人来探望。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00015",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我又等了半年之后，终于不再向外看了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00016",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而我也终于学会拉上窗帘了。\n我承认了这件事，也察觉了其中的理由。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00017",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「已经过了3年，我也应该知道了…」",
                voice: Some("li/setu_007"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00018",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "他们并不是忘记了我…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00019",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而是装作从一开始就当作不认识…当作从没见过我的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00020",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就当作“一开始就什么也没发生”一样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00021",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「看来他们也是…」",
                voice: Some("li/setu_008"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00022",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…想要闭上眼睛逃避的样子…」",
                voice: Some("li/setu_009"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00023",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "rain01",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "sora_ame01",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "反复进出了医院好几次之后，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00024",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "已经不会再有人来看我的，大概是被所有人从记忆中抹除的时候…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00025",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我的家也从久居的独院，搬到了公寓里。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00026",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "妈妈也会到附近的快餐店，开始早出夜归的打工生活。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00027",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我知道这代表着什么意思。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00028",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…住院费也不是开玩笑的事情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00029",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这是在医院每天住院的病人们，几乎每天都会谈论的话题。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00030",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我也知道了，其实他们比家人所以为的，更在意给家人增添负担的事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00031",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我们搬进的这个古旧又有些脏乱的木屋，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00032",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不仅狭小，而且距离父亲的单位通勤时间超过两小时。\n不过，到医院却只需步行3分钟。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00033",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "站在这又旧又窄的公寓前爸爸说着",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00034",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这里的空气真新鲜呢…」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00035",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "他这么说着笑了起来。\n妈妈也一同强颜欢笑着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00036",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "大概是因为我的身体的关系吧，我的房间装上了空调，当然在其它房间是看不到的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00037",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "出门打工的妈妈，常常给我带回说是卖剩下的可乐饼和炸土豆之类的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00038",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在狭小的房间中，跟我一起吃着。\n总是一副开心的样子对我笑着…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00039",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…这让我非常的…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00040",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…辛苦。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00041",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "black-2",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这种处处迁就我的感觉，实在是让我喘不过气来。\n比起感动，高兴，我的心中更多的是愧疚…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00042",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "“都是你的错”",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00043",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「或许…希望他们这样对我说也说不定吧…」",
                voice: Some("li/setu_010"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00044",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "真希望他们能够责备我，被这般温柔的对待真的让人很难受…\n而对于什么也做不到的自己，我也总是感到烦躁，甚至愤怒。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00045",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果，神明真的存在的话，希望他能让我赶快好起来。\n如果不行的话，那么让我立刻死去也好。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00046",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在那些，希望抹除我的存在的人中…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00047",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "与之相反的，强化我存在的父母。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00048",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…这让我更加痛苦。\n只恨就算被如此温柔的对待却不能有所报答的自己。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00049",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "世界上不计其数的称作“不幸”的其中一个，偶然地，降落在了我的身上…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00050",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "也许这个时候，我反而应该摆着笑容，开朗地生活下去也说不一定…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00051",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但最后我能做的，也不过只有把不喜欢吃的土豆默默地咽下肚而已…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00052",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "white-2",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
