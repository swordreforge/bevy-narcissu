            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "知了知了，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00053",
            ),
        ),
        (
            cmd: play_bgm,
            args: (
                id: "113",
                volume: Some(0.78431374),
                fade_ms: Some(500),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "炽热的阳光和蝉的低鸣。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00054",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当梅雨季节过去，完全入夏的时候，也不知道是第几次，我终于是又出院了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00055",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过，这并不代表着结束。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00056",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "出院这词同时也表示着，到下次入院为止，长时间不断地反复进出医院的生活的开始。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00057",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…在炎热的天空下，我穿着睡衣，出发前往步行只需要3分钟到达的医院。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00058",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对着正要陪我去的妈妈，“一个人没问题的啦”我这么告诉她。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00059",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我本想按照自己的方式为妈妈着想，\n不过看到妈妈因为这句话而难过的样子，我也很痛苦。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00060",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "a007",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不经意间，我的脚步停在了某个学校前面。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00061",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "大概是小学吧。\n因为已经到了暑假，所以几乎看不到人影。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00062",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…………………」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00063",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这个，感受不到任何人的气息的学校面前，\n不知道为什么我看向了那里，不由地停下了脚步。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00064",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "有时候，看到那些充满朝气的小孩子们来回跑动，\n我也会不自觉地将视线移向他们…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00065",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在炎热的天下，穿着长袖的睡衣真的很热。\n甚至觉得穿成这样的自己，和看着的校园实在很不协调。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00066",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "black-2",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…在那里逗留了一小段时间后，我又迈起了步伐。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00067",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过，目标却不是医院而是回家。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00068",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，一回到了自己的房间，就取出一直沉寂在衣柜里的校服。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00069",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…隔了3年再次穿上，几乎和新买的一样的水手服。\n以前，只穿了不到一周。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00070",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后对现在的我来说…这是唯一一件睡衣以外的衣服。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00071",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "z42r",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "sora01",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "再次走到炎热的天气下。\n同刚才一样，嘈杂的蝉鸣和流下的汗滴。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00072",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过，往来行走的人们，没有再次在我身上停下目光。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00073",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样的我，也成为了夏日小城风光的一部分，被当作日常的一部分而被「认同」了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00074",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，来到之前到达的校园，在眼前摆放着的，是小孩们玩耍的单杠。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00075",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我向那伸出手来，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00076",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…嗯…」",
                voice: Some("li/setu_022"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00077",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "把力量施加在手腕处，双脚使出全力往地上一蹬。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00078",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一瞬间感到了漂浮在宇宙中的体验…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00079",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "身体随着转了一圈。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00080",
            ),
        ),
        (
            cmd: set_bg,
