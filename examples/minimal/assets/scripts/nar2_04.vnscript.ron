            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我…应该同大家一样的…」",
                voice: Some("li/setu_013"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00090",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…和过着普通生活的大家一样，应该在“那一边”才对。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00091",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "像是在单杠上绕一圈这种微不足道的事，\n是不需要露出这么痛苦的表情来完成才对的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00092",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这么想着，虽然勉勉强强想摆出笑容…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00093",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但手腕却止不住地发抖，果然这件事…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00094",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对于我来说还是太难了…",
                voice: None,
            ),
        ),
        (
