            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "以为“这是很普通的事”。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00002",
            ),
        ),
        (
