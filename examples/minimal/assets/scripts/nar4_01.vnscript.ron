            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说完这句话后、父亲就走出了房间。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00183",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……不只是家人，还有本人的意志？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00184",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明明搞不好的话，就再也无法见面了啊……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00185",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然仍然让我难以理解，但不是父亲的话难以理解。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00186",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，并非所有人都是这样。表示有事的话无论何时都请联系自己的家属也有很多。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00187",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，特别是在老人与家属相隔很远的情况下，却听到过类似的要求……",
                voice: None,
            ),
