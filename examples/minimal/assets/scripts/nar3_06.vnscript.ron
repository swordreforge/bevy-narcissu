                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哥哥快看，长这么大了哦」",
                voice: Some("li/n3imo_0006"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00158",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "秋天的天空下，妹妹在麦穗前笑着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00159",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「一般，播了种也只能收获到双倍的种子，这块土地却能收获四倍哦」",
                voice: Some("li/n3imo_0007"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00160",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嘿……那样啊，真厉害」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00161",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，我想肯定是这土地肥沃」",
                voice: Some("li/n3imo_0008"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00162",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说真的详细的事情我并不懂。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00163",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是，县里的人对年轻的少女，用心的在田地工作的事显得有些不满。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00164",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知道为何我，在乡下地方的地位就如同名门般。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00165",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，她并不太在意旁人的目光，",
                voice: None,
