        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「（但是……这家伙……真的是那样的吗……）」",
                voice: Some("li/yohanp_1216"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00309",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "望着下着雪的天空，忽然那么想到。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00310",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "毫不留情地杀人的她，和现在天真无邪地吃着东西的她。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00311",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "真不知道那边才是她真正的一面。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00312",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，谁都会有过失。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00313",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这个世界上，“没办法的事”数也数不清。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00314",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……就算是愚者，一千件里面也会做对一件事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00315",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且，就算是贤者，在一万件事中也会做错一件……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00316",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "3020",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你……试着种过小麦吗……」",
                voice: Some("li/yohanp_1217"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00317",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……小麦？」",
                voice: Some("li/n3iri_0198"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00318",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯……」",
                voice: Some("li/yohanp_1218"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00319",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知不觉，竟然问了她这个问题。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00320",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是，你不是说不知道种植的方法？」",
                voice: Some("li/n3iri_0199"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00321",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: Some("li/yohanp_1219"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00322",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「也是啊……把刚才的话忘了吧」",
                voice: Some("li/yohanp_1220"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00323",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "的确如此，详细的种植方法并不知道。我知道的，只有杀人的方法而已。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00324",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "次日。冬天的天空少有的放晴了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00325",
            ),
        ),
