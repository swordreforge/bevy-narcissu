        (
            cmd: label,
            args: (
                name: "block_00189",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……请给予您的孩子救赎……」",
                voice: Some("li/npetcm37_017"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00190",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "含着眼泪，专心地重复着同一句话。向着不知在哪里的神，诉说着请求。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00191",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "拖着病重的身体，瘦削的手指颤抖着。那清澈的眼神，才正是虔诚的祈祷。",
                voice: None,
