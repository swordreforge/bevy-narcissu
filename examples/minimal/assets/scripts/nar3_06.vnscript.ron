            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，不要说丧气话啊，那样的话就算本来能救得了也变成救不了了啊」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00186",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……也对哦，得坚强点才行啊……」",
                voice: Some("li/npetcm37_016"),
