            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―几天后。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00278",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "离国境越来越近了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00279",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我们今天也依然在森林中行走。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00280",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "3020",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，公主跟往常一样吃着抢回来的面包。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00281",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "以前的话，是直接大口大口的吃，而现在，则是先拨开一小片，再一片片放进嘴里。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00282",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那一张一合忙碌的吃着面包的样子，看起来总觉得让人感到欣慰。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00283",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……怎么了？」",
                voice: Some("li/n3iri_0194"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00284",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不，没什么……」",
                voice: Some("li/yohanp_1212"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00285",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "恐怕她本人并没发觉，那忙碌地吃着东西的样子，就像天真无邪的孩子那样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00286",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……从那时起已经过了几天了，期间这家伙又袭击了几个归途兵了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00287",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，并没有全都杀掉。跟前几天一样只抢夺了行李，就放跑了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00288",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对于这种变化，我总觉得有点高兴。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00289",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "相反，从这家伙被追杀中的立场来考虑，这并不是可以放手不管在一边高兴的事态。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00290",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……恐怕追兵会在某个开阔的地方，等待着这家伙。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00291",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "敌国残留下来的王族幸存者，对于这个国家来说，只会感到碍眼。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00292",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "像之前那样，连佣兵都雇上，追杀了过来就是最好的证据。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00293",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且，就算穿过了国境，踏入了其他国家，也并不能说就有了美好的将来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00294",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……不管怎样，继续做杀人的勾当，迟早会凄惨的死去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00295",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然而我跟这家伙……除了杀人以外就不知道其他的生存方式了……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00296",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不停考虑着那样的事情，突然，这家伙细声嘟哝道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00297",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……我活下去真的好吗……」",
                voice: Some("li/n3iri_0195"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00298",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……怎么了，突然间？」",
                voice: Some("li/yohanp_1213"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00299",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐，我有活下去的权利么？」",
                voice: Some("li/n3iri_0196"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00300",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这个，是谁都有的啊」",
                voice: Some("li/yohanp_1214"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00301",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……已经杀人十年的人也有么？」",
                voice: Some("li/n3iri_0197"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00302",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「可能吧……我也差不多」",
                voice: Some("li/yohanp_1215"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00303",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "是啊。我跟这家伙都是杀人犯。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00304",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "除此以外什么都不是，也不知道其他活下去的方法。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00305",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "为了让我一个人活下去，数十条人命成为了我的粮食。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00306",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "反过来说，如果我们死了，那数十条人命就会生存下去……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00307",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……如果神真的存在的话，应该会为我们安排一条合适的末路吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00308",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "bg_0001b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
