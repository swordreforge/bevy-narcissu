            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……离国境只剩下几天的路程了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00099",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，就算走出了这条山脉，也肯定要通过某个平坦的地方。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00100",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在那样的地方，肯定有谁在伏击吧。",
