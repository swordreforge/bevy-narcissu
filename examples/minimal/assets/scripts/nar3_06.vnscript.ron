        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我想着该用什么语言来回答。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00227",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……应该否定，劝解，还是点头认同。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00228",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对着阳光开朗，对谁都那么温柔的妹妹……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00229",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知为何，喜欢做农活，奇特的，\n总是高兴地笑着的妹妹，对着她，我在寻找回答的语句。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00230",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对着那虔诚的信徒的妹妹……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00231",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……但是，我根本不可能找得到回答的话。所以只能沉默。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00232",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "bg_0010",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
