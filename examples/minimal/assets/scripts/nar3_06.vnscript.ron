            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边说着，妹妹开心得抱着麦穗，在那里转着圈。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00255",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后把抱着的麦穗，大力地洒向空中。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00256",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "w",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "sora01",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "麦穗被抛到清澈的秋天的天空……凭借风势，高高地飞舞。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00257",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "麦穗犹如雪一般落在我们的头上……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00258",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "麦穗盖在她的头上，妹妹天真地笑着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00259",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，别这样，你也不是孩子了啦」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00260",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「有什么关系呢，我很高兴啦」",
                voice: Some("li/n3imo_0024"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00261",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一向明朗的妹妹，收到这块土地感到格外开心吧显得比平时更加活泼。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00262",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯？ 说起来……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00263",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看着还在那里打转的妹妹，我突然发现一件事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00264",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "平时，垂下来的长长的头发，今天不知为何扎了起来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00265",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你的头发怎么了？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00266",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，哦，这是因为在干农活的时候不方便，所以才扎了起来」",
                voice: Some("li/n3imo_0025"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00267",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "na03_53",
