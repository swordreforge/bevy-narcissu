        ),
        (
            cmd: label,
            args: (
                name: "block_00049",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "跟往常一样，公主殿下遇到了不知哪里的回乡士兵。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00050",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "前天开始就已经完全没吃的了，不单是我，那家伙也很饿了吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00051",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「请别杀我……」",
                voice: Some("li/npetcm36_016"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00052",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对方在求饶。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00053",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "把背后的皮包放出来，犹如祈祷般合起双手，继续说着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00054",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这些都给你们了，所以求求你们……」",
                voice: Some("li/npetcm36_017"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00055",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "公主并没说话，只是默默看着对方。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00056",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "平常的话，已经是砍人的场面了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00057",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
