        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我从道旁的皮包里找到面包，一边吃一边说。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00065",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「少见啊，公主殿下，居然放过他了」",
                voice: Some("li/yohanp_1186"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00066",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……是啊」",
                voice: Some("li/n3iri_0192"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00067",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「想到了什么事情了吗？」",
                voice: Some("li/yohanp_1187"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00068",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没什么……并不是那样」",
                voice: Some("li/n3iri_0193"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00069",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边说着，一边抢过我吃着的面包，大口大口地吃着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00070",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知为何，那是有点愤怒有点复杂的……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00071",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且看起来有些害羞的脸。",
