        ),
        (
            cmd: label,
            args: (
                name: "block_00187",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边细声说着，一边从床上坐了起来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00188",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，慢慢合起双手，开始了祈祷。",
                voice: None,
