        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "静静的，山岳间染上了白色。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00074",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我们在篝火边一边暖身子一边等待破晓。为了抵御严寒，两人都裹在披风里。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00075",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就算在火堆旁边，嘴里依旧吐着白烟，雪也把头发稍稍染白了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00076",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在那里，那家伙一边拍着头上的雪，一边向天空望去说道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00077",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐，知道吗」",
                voice: Some("li/n3iri_0182"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00078",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……知道什么？」",
                voice: Some("li/yohanp_1188"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00079",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「黎明之前的天空，是最黑暗的……」",
                voice: Some("li/n3iri_0183"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00080",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「恩，以前听你说过」",
                voice: Some("li/yohanp_1189"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00081",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那现在……到哪儿了呢……」",
                voice: Some("li/n3iri_0184"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00082",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说完，她些许寂寞的凝视着夜空。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00083",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "下雪的天空，月亮和星星都藏了起来……像是被黑暗盖上了一层漆黑的帷幕。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00084",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，这家伙说的“哪儿”……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00085",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "并不是指到日出前的这段时间。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00086",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「离日出还有很长的时间呢……」",
                voice: Some("li/n3iri_0185"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00087",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「谁知道呢……」",
                voice: Some("li/yohanp_1190"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00088",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果离天明还很远的话，那就是说……还会有比现在更黑暗的时候吧……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00089",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "反过来说，如果现在是最黑暗的时候……那天明肯定很快就会到来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00090",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐，如果……我是说如果……」",
