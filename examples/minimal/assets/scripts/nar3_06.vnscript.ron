            cmd: label,
            args: (
                name: "block_00059",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶？」",
                voice: Some("li/npetcm36_018"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00060",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……我说了快点给我滚」",
                voice: Some("li/n3iri_0191"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00061",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是，是」",
                voice: Some("li/npetcm36_019"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00062",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对方一边回答，一边匆忙逃跑。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00063",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "到现在，已经不知道看过多少袭击的场面了，这家伙会放走人还是第1次看到。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00064",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "3099",
