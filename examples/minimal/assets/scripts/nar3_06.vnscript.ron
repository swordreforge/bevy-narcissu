            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，指了指那可爱的红色发夹。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00268",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "的确，干农活的时候，那头长发当然会不方便。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00269",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只不过，对于虽然性格天真无邪，\n看起来也跟岁数符合的妹妹来说，把头发扎起来显得有些更年幼……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00270",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「难道说，不合适吗？」",
                voice: Some("li/n3imo_0026"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00271",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没那回事」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00272",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……哥哥， 你不会想说我像小孩子吧？」",
                voice: Some("li/n3imo_0027"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00273",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不，很适合啊」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00274",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哈哈，那就好」",
                voice: Some("li/n3imo_0028"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00275",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，开心地笑了起来。把手里的麦穗，用力抛向天空……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00276",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "开心地笑着……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00277",
            ),
        ),
        (
