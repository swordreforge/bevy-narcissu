            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―2年后。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00233",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "秋。又是麦穗摇动的时候。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00234",
            ),
        ),
        (
            cmd: play_bgm,
            args: (
                id: "134",
                volume: Some(0.78431374),
                fade_ms: Some(500),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "妹妹今天也在家前的农地上快活地干着农活。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00235",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "na03_53",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「快看，快看，今年的收成也很多哦」",
                voice: Some("li/n3imo_0018"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00236",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "妹妹说着，跟往常一样笑了起来。在这收获的季节里，笑得更加开心。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00237",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是哥哥，给我真的可以吗？」",
                voice: Some("li/n3imo_0019"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00238",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，反正我没用」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00239",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「多谢啊，太高兴了」",
                voice: Some("li/n3imo_0020"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00240",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，又开始了收割麦子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00241",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那蹦蹦跳跳的举止，在孩提时代开始就没改变过。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00242",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……我把这块土地给了妹妹。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00243",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然以前是从教会里借来的土地，但前些天，从子爵那里直接受封了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00244",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知为何，由于上次的远征，我被看待为名誉骑士的样子。\n在这个偏僻的乡村，我也算是个小小的英雄。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00245",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说真的，全都是些连我自己都不知道的功绩，\n大概是主教……现在的大主教捏造出来的吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00246",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「（……算了，给我了就拿呗）」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00247",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样的话，即使我以后在某个战场上死掉了，妹妹也不会生活不下去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00248",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……而且，这就能让妹妹开心的话也是值得的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00249",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，不过，以后别说要我还给你哦」",
                voice: Some("li/n3imo_0021"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00250",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你说还，是指这块土地吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00251",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对哦，像这种可以收获四倍麦子的，土地可不多见啊」",
                voice: Some("li/n3imo_0022"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00252",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「别担心，这里永远都是你的」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00253",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「好高兴啊~，多谢你哥哥」",
                voice: Some("li/n3imo_0023"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00254",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
