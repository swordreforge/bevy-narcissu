        (
            cmd: label,
            args: (
                name: "block_00180",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从以前开始就多病的弟弟，随着年月推移，躺在床上的时间越来越多了。",
                voice: None,
