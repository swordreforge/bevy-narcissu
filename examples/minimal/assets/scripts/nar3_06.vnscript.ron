            cmd: label,
            args: (
                name: "block_00091",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「如果快要天亮了…… 你会怎么办？」",
                voice: Some("li/yohanp_1192"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00092",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: Some("li/n3iri_0186"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00093",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对这个问题，她保持着沉默，只是继续向天空望去……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00094",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……不知道」",
                voice: Some("li/n3iri_0187"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00095",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "嘟囔了一下，只回答了这一句。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00096",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「即使天亮了……我也只懂得杀人而已……」",
                voice: Some("li/n3iri_0188"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00097",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她有些寂寞般的轻声说道，之后又一次看向夜空……",
                voice: None,
