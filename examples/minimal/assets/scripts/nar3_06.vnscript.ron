        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―大约六年后。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00105",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我再次回到了这里。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00106",
            ),
        ),
        (
            cmd: play_bgm,
            args: (
                id: "88",
                volume: Some(0.78431374),
                fade_ms: Some(500),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "见到我的身姿和证书的主教，显得格外欢喜。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00107",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……听说，一开始的那场战斗，一转眼间就结束了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00108",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "使用“听说”这个暧昧的表达是因为我也并不清楚。单纯地认为只是初战结束了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00109",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "严格来说，连战斗的开始都没弄明白。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00110",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以我在自己的部队撤退后，仍跟着其他部队进入了战场。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00111",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "总是在哪里战斗着，不停的战斗着，因为我以为中途回去是不被允许的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00112",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我只是不清楚远征要到哪里，或是以什么形式结束而已。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00113",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……我……只是在远征中侥幸活了下来而已。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00114",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "bg_3102",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
