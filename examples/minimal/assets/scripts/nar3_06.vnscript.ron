            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，请收下……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00115",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，我把这六年搜刮来的银币的一半。交了上去。这是规定。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00116",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然而主教他，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00117",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你已经做得很好了，有很大功劳了」",
                voice: Some("li/npetcm36_026"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00118",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边称赞着，完全没打算收下银币。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00119",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……后来，我知道了。似乎依靠掠夺，积储了私产后便在中途逃跑的人有很多。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00120",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "老实说，我只是当时不知道而已。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00121",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因此，尽管最初的战斗结束了，\n我还是跟着别人进入其他战场，一回过神来，我已经活到最后了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00122",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是担心托付给教会的弟弟妹妹的安危，才没有中途违反约定。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00123",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……但是，看来那样做，对主教来说好像有很大的益处。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00124",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不但把我带回来的金银全都给了我。还给了我少许的土地和屋子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00125",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不仅如此，主教还向子爵打了招呼，任命我为正式的骑士。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00126",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "bg_3102",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……全部，都是因为成为杀人凶手而得到的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00127",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看来我的存在对主教来说，是为他提升名誉的便利道具而已……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00128",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，多亏了他，我才能再次领着弟弟妹妹，住进新家。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00129",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "bg_3103",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "六年不见的弟弟，因为体弱多病，很少出外行走……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00130",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "妹妹则变得充满朝气，可爱到几乎让我认不出来，成长为开朗而温柔的女孩子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00131",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是，因被教会收养了六年，两个人都成为更加虔诚的信徒。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00132",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那样的妹妹跟我再会时说的第一句话，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00133",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我每天都祈祷着，希望你能平安归来」",
                voice: Some("li/n3imo_0003"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00134",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是嘛，谢谢……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00135",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不对哦，应该感谢神才对」",
                voice: Some("li/n3imo_0004"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00136",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，妹妹对我露出天真无邪的笑脸。我也试着用笑容回应她。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00137",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「所以啊哥哥，不好好对神明做感谢的祈祷是不行的哦」",
                voice: Some("li/n3imo_0005"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00138",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，我知道了」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00139",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
