        (
            cmd: label,
            args: (
                name: "block_00181",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，从几天前开始便什么都吃不下，最终还是患上了攸关生死的病了。",
