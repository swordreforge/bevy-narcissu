channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像从前一样俯瞰着地图的姬子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00037",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对着进入病房的我，只是稍微瞥了一眼，视线马上又回到了地图。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……有趣吗？」",
voice: Some("li/setsumi_0284"),
),
),
(
cmd: label,
args: (
name: "block_00039",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你觉得呢？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……不。」",
voice: Some("li/setsumi_0030"),
),
),
(
cmd: label,
args: (
name: "block_00041",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样回答后，我也在旁边坐了下来，一同俯视着地图。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00042",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…还是，没办法觉得这行为会有趣……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这个地图，对姐姐来说又代表什么呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即使是看似已经完全看开的7楼病人，也还是，会对这个世界留有什么念想的吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: set_bg,
args: (
image: "tizu01",
transition: Some(fade(
duration: 0.8,
)),
),
),
