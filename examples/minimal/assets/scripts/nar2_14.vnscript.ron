channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "7楼。\n我对着已经认识的护士，轻轻地点下头打了声招呼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "走廊能看到，几位病人的身影。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "刚好是早晨体温检查结束的时候，大概正要和陪护一起去散步吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看着这些带着白色手环的人们，我不由得想起。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……7楼的病人，大概可以分成两种类型吧？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有些人像是看透一切似的，总是一副冷静的样子，\n而有些人则一直忙着做着这样那样的事情……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: set_bg,
args: (
image: "black-2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，没问题喔，我会扶着你的。」",
voice: Some("li/chihiro-0136"),
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "熟悉的声音传来，我回头一看，\n站在那边的。是正和坐着轮椅的老奶奶在一起的千寻。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……恐怕，那个老奶奶就是千寻所负责的人吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，我之后想散下步，可以再麻烦你吗……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「也是啊~等天色稍微转阴的时候，再去中庭吧。」",
voice: Some("li/chihiro-0137"),
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "千寻用着平稳的语气。\n对着老奶奶，露出了她一如既往的温柔表情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个千寻，可以再为我做那件事吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，可以的喔。」",
voice: Some("li/chihiro-0138"),
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "刚回答完，便静静地合上双手。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……不要让我们遭受承担不起的考验……」",
voice: Some("li/chihiro-0139"),
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就这样，千寻献上了祈祷。\n之后又继续说着其他的句段。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: set_bg,
args: (
image: "byoin7_rouka",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个……」",
voice: Some("li/setsumi_0281"),
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，濑津美……」",
voice: Some("li/chihiro-0129"),
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你总是，那样为人祈祷吗？」",
voice: Some("li/setsumi_0282"),
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，因为为了别人而祈祷是件不错的事情呢。」",
voice: Some("li/chihiro-0141"),
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "用着平常温柔的表情回答的千寻。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过那句话，我似乎有点在意。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…为了别人……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，我坦白的提出了疑问。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……为了自己不行吗？」",
voice: Some("li/setsumi_0283b"),
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，那个……」",
voice: Some("li/chihiro-0142"),
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "千寻一时间无言以对。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她没有继续回答我。\n平常温柔的表情也跟着消失了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "第一次看到千寻这样的表情……她也只是，一脸困扰地望向我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00035",
),
),
