args: (
file: "pera",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……要比喻的话，我们是死刑犯呢。」",
voice: Some("li/hime1_0611"),
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唉？」",
voice: Some("li/setsumi_0094"),
),
),
(
cmd: label,
args: (
name: "block_00047",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「虽然只是被宣告死亡……」",
voice: Some("li/hime1_0612"),
),
),
(
cmd: label,
args: (
name: "block_00048",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「却不曾知道，那一天何时会到来，只是被有限的时间追逐着。」",
voice: Some("li/hime1_0613"),
),
),
(
cmd: label,
args: (
name: "block_00049",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……死刑犯。\n要这样说的话，似乎确实是这样。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就像刚刚想的一样，在这7楼，有人似乎一直都在忙碌着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00051",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "倒不如说，正因为知道命不久矣，所以才更努力地在仅存的时间里活着的感觉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00052",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还是说，所谓的人……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00053",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "体会到死的意义后，才能第一次体会到「生」的意义么……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00054",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「保持冷静的人，是已经做好觉悟的人吧。」",
voice: Some("li/hime1_0614"),
),
),
(
cmd: label,
args: (
name: "block_00055",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「或者说是，装作已经做好觉悟的人吧。」",
voice: Some("li/hime1_0615"),
),
),
(
cmd: label,
args: (
name: "block_00056",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……姬子是？」",
