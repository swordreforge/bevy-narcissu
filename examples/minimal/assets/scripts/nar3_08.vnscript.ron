            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―2个月后。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00205",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "晚秋的凉风吹过，今天是个特别冷的日子。感觉快要到冬天了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00206",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "妹妹从那天开始，就卧床不起。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00207",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "烧伤并没什么大碍，却因此发起烧来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00208",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "身子一天天虚弱下去，跟亡故的弟弟十分相似。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00209",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……医生诊断说，最多大概还有一个月的寿命。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00210",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "相比妹妹的病情，教会似乎要把我推荐成为名誉骑士。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00211",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然这次也是我完全没记忆的事，但那似乎又在之前的远征立下了大功劳。",
                voice: None,
            ),
        ),
        (
