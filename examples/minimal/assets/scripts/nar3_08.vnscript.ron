        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "被那样问道，我立刻停住了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00228",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "以前因为妹妹还年幼才能蒙混过去，但现在她也不小了。何况她又是那么的聪明。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
