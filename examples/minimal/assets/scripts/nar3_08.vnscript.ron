        ),
        (
            cmd: label,
            args: (
                name: "block_00230",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "至少对相信“圣战”的人来说。",
