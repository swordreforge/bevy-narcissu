        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "以前称我为圣者的人死了。连向神祈祷的时间都没有，就这样简简单单的死掉了。",
