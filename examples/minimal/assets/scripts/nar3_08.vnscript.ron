            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "烧焦的田地中间，我看到妹妹一个人坐在那里。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00184",
            ),
        ),
        (
            cmd: wait,
            args: (
