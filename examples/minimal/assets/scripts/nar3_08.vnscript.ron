        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那是以前拜托收留修女的教会。恐怕她现在还在这里吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00275",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我背着妹妹，敲响了教会的大门，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00276",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "村里的祭司：「你是……以前的那位骑士」",
                voice: Some("li/npetcm38_023"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00277",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "概是认出了我，祭司端正地迎了上来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00278",
