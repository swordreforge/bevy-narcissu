        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，等了一小会儿，祭司退下后，那张令人怀念的脸出现在我们面前。",
