            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "☆妹：「啊……哥哥……」",
                voice: Some("li/n3imo_0042"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00185",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "妹妹虚弱地回答着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00186",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "恐怕并没有什么生命危险，只是有点轻微的烧伤。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00187",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "约翰：「难道……在做农活时被放火了？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00188",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "若是这样的话，我要把他们全部杀掉。\n本没必要跟伯爵商量，这样的匪徒，我要把他们赶尽杀绝。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00189",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，跟我想的相反，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00190",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "☆妹：「……不是的， 我只是在恳求着……希望他们停手而已」",
                voice: Some("li/n3imo_0043"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00191",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "约翰：「停手？ 即使如此他们还是没停手吧？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00192",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "☆妹：「……就是说，不是向他们，我拜托的是……」",
                voice: Some("li/n3imo_0044"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00193",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……不是向他们？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00194",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "妹妹到底想说什么呢？终于，我理解到了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00195",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……妹妹拜托的并不是放火的匪徒……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00196",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "是神。前头那样像祈祷一样的姿势也就能解释了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00197",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "☆妹：「……多亏如此，不用全部都被烧了」",
                voice: Some("li/n3imo_0045"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00198",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边说，一边用熏黑的脸，展开往常的开心笑脸。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00199",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "约翰：「（……即使祈祷，也不能把火扑灭的……）」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00200",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那并不是神的力量，不过是自然地烧尽了，火便熄灭了而已………",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00201",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我抱着烧伤的妹妹往家里走去。虽然没有性命危险，但还是要立刻治疗。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00202",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "总是在做农活时扎起头发的发夹，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00203",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在被烧焦了少许，看着不禁觉得很悲伤……",
                voice: None,
