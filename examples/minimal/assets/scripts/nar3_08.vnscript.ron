        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "约翰：「我找以前那位修女有点事……帮我叫她出来」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00279",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "村里的祭司：「好的，稍等一下……」",
