args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听到这句话后开始攀爬栅栏的明。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00346",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "随着金属网莎莎摇晃的声音，轻松地下到了这边来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00347",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……总之，这样就可以稍稍安心了些。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00348",
),
),
(
