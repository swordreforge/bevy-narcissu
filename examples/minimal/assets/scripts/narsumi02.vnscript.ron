),
(
cmd: dialogue,
args: (
speaker: None,
text: "「欸，是谁啊，怎么把车停在我的位置上」",
voice: Some("li/0snyuka_0001"),
),
),
(
cmd: label,
args: (
name: "block_00002",
),
),
(
cmd: set_bg,
args: (
image: "231",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "公司的地下停车场。离电梯最近的，靠墙的第2个车位。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00003",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "顺便一提现在的时间是早上9点58分。离班前会议还有2分钟的时候。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真是的，肯定是外来的客户吧。\n明明这里是的我的车位这点，已经是默认的潜规则了……」",
voice: Some("li/0snyuka_0002"),
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边抱怨着，一边将车停到了其他位置。那是辆红色的敞篷车。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "几年前，从朋友……不对，\n从“挚友”那里接受的，直到现在也非常小心的开着的古董级车。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，都过10点了……又要被批评了」",
voice: Some("li/0snyuka_0003"),
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: set_bg,
args: (
image: "2b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我挎上包，急急忙忙跑向了电梯。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "现在已经不是倒茶泡咖啡的角色了，要是迟到的话课长就会来烦我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: set_bg,
args: (
image: "ns_16",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「早上好，诶呀，对不起啦，今天有点堵车……」",
voice: Some("li/0snyuka_0004"),
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我精神满满的打了招呼，说着跟平时一样的借口。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对此，还以为又要被课长责备些什么……\n但那天有点不太一样。办公室里有个不认识的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「来的正好，正等着你呢昭岛」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并没有生气的样子，貌似正等着我的课长如此说到。顺便说下昭岛是我的姓氏。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: set_bg,
args: (
image: "bg_2020",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呃，课长，有什么事吗？」",
voice: Some("li/0snyuka_0005"),
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「其实是有点事要拜托……啊对了，先介绍一下这边这位，这位是总公司的河口常务」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「初次见面昭岛小姐，我是河口，请多关照」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「欸，啊，你好，这边才是要多多指教……」",
voice: Some("li/0snyuka_0006"),
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有点紧张地握住了他伸出来的手。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然身为营业员，也碰到过很多人了，\n但面对的是自己公司的，而且还是总公司的人，就另说了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，找我有什么事吗？如果和专利有关的话，\n我想还是找个比我业务经验更深的人好些……」",
voice: Some("li/0snyuka_0007"),
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「其实不是那种事，该怎么说才好呢……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有些难以开口似得的把话含糊过去的常务。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……难道说，又是那个吗？我倒是有过一次经验。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前的时候，被叫去所谓的洽谈，却一直让我扮演帮忙倒酒的角色。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也只能尽量边笑边做来着。真是的，当我是陪酒女吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然在那之后，因为我非常生气，课长就再也不敢提了，\n所以那是第一次也是最后一次。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，如果是和工作没什么关系的事的话，请容我拒绝……」",
voice: Some("li/0snyuka_0008"),
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，是很有关系的事。对本公司全体都会有影响的大事」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呼，是这样啊……」",
voice: Some("li/0snyuka_0009"),
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "哪里松了口气一样回答了的我。如果是那样重要的大事，就更不是我所能做到的了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「昭岛小姐，你以前为了去看望住院的朋友，经常去医院吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「欸……啊，没错」",
voice: Some("li/0snyuka_0010"),
),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "突然提到姬子的事吓了我一跳。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00035",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那应该早就适应了吧，同样都是年轻女性。脾性也好懂吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00036",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说到这里，向我递来了几份文件样的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00037",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛，就算是试试也行，能拜托你吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯……总之能先详细的说明一下吗？」",
voice: Some("li/0snyuka_0011"),
),
),
(
cmd: label,
args: (
name: "block_00039",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那请到这个会议室里谈吧……啊，昭岛小姐，我对你很期待哟」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: set_bg,
args: (
image: "2b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "把不知为何莫名干劲十足的科长撂在一边，我认真听取着说明。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00041",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不是很清楚那个流程，但似乎没有拒绝的选项。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00042",
),
),
(
