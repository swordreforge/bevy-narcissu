args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "回头望去，那里是依然穿着那身衣服的白石小姐。\n一直没看见她担心死了，现在终于松了一口气。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00405",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么啦，我可不是幽灵哦？被打扰了一下，没死成而已」",
voice: Some("li/0snaka_0106"),
),
),
(
cmd: label,
args: (
name: "block_00406",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后还是老样子，一脸淡然地说着死这个词。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00407",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不过嘛，反正活着也都是在睡觉，也没有什么太大差别就是了」",
voice: Some("li/0snaka_0107"),
),
),
(
cmd: label,
args: (
name: "block_00408",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以呢，今天是？」",
voice: Some("li/0snsumi_0060"),
),
),
(
cmd: label,
args: (
name: "block_00409",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「来打招呼的哟。我以后不会再来这里了」",
voice: Some("li/0snaka_0108"),
),
),
(
cmd: label,
args: (
name: "block_00410",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难不成，是因为要死了？」",
voice: Some("li/0snsumi_0061"),
),
),
(
cmd: label,
args: (
name: "block_00411",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不是。因为我找到了其他能去的地方，而且还欠了人情……」",
voice: Some("li/0snaka_0109"),
),
),
(
cmd: label,
args: (
name: "block_00412",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那再见了，宝矿力酱」",
