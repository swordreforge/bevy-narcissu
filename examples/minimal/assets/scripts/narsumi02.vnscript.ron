cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "站起来后，我发现她比小巧的我要高出许多。\n虽然听说才17岁，但长长的黑发让她看起来更显成熟。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00111",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以，你找我有什么事？」",
voice: Some("li/0snaka_0042"),
),
),
(
cmd: label,
args: (
name: "block_00112",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我先自我介绍一下。我叫昭岛优花……叫我优花就行，明小姐」",
voice: Some("li/0snyuka_0027"),
),
),
(
cmd: label,
args: (
name: "block_00113",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么优花，我也一样，叫我明就行」",
voice: Some("li/0snaka_0043"),
),
),
(
cmd: label,
args: (
name: "block_00114",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「明白了。请多关照，明」",
voice: Some("li/0snyuka_0028"),
),
),
(
cmd: label,
args: (
name: "block_00115",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着我伸出了想要握手的手。但，她只是瞥了一眼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00116",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "既没有改变倔强生硬的语气，看起来也没有放松警惕的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00117",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是比起别人……连大夫都不怎么说话都直接无视的样子，\n所以能现在这样说不定已经是很不得了了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00118",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「给你……优花，一点特别的待遇」",
voice: Some("li/0snaka_0044"),
),
),
(
cmd: label,
args: (
name: "block_00119",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真是荣幸，不过为什么呢？」",
voice: Some("li/0snyuka_0029"),
),
),
(
cmd: label,
args: (
name: "block_00120",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为看穿了我在装睡。大人的话，你还是第一个……」",
voice: Some("li/0snaka_0045"),
),
),
(
cmd: label,
args: (
name: "block_00121",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「大人？」",
voice: Some("li/0snyuka_0030"),
),
),
(
cmd: label,
args: (
name: "block_00122",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……没什么，别在意」",
voice: Some("li/0snaka_0046"),
),
),
(
cmd: label,
args: (
name: "block_00123",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "似乎有点寂寞似的，向窗户看去的明。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00124",
),
),
(
cmd: set_bg,
args: (
image: "2b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然我不清楚详细情况，但总感觉她的装睡，不是演技的如何。\n而是其他层面的问题。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以她的立场来考虑，应该很难有人对她说些失礼的话吧。大人就更不用说了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且对方还患了名为嗜睡症的，尚未完全明了的疾病。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "依靠这些条件装睡的吗？……不论怎样都没办法去指责她。就算已经看穿了也一样。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: set_bg,
args: (
image: "2bg_a0011",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么优花，有事是什么事啊？」",
voice: Some("li/0snaka_0047"),
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶？啊……其实我是被公司派过来的，希望你能在这些文件上签字来着」",
voice: Some("li/0snyuka_0031"),
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我一边说着，一边从包里拿出了好几份文件。\n因为她还未成年，估计都是委托书之类的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然像这种家族公司，\n只要她一成年肯定会成为大代表但在此之前她有指定董事会长的义务。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呼，真是没办法……虽然很讨厌这种麻烦事……」",
voice: Some("li/0snaka_0048"),
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「别这么说嘛，这可关系到你的未来啊」",
voice: Some("li/0snyuka_0032"),
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「无所谓了。因为我已经没有未来了」",
voice: Some("li/0snaka_0049"),
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈？」",
voice: Some("li/0snyuka_0033"),
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不过……既然优花那么想要的话，签名也不是不行。因为我欠了你一个人情嘛」",
voice: Some("li/0snaka_0050"),
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「人情？什么时候？」",
voice: Some("li/0snyuka_0034"),
),
),
(
cmd: label,
args: (
name: "block_00138",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为你看破了我的装睡啊。但你不会告诉别人的吧？」",
voice: Some("li/0snaka_0051"),
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「欸？啊，是吧……」",
voice: Some("li/0snyuka_0035"),
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "的确没有说出去的想法，不过说出去也没意义吧。这也不是什么被不被信任的问题。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「总之我不想跟任何人有什么人情上的往来」",
voice: Some("li/0snaka_0052"),
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「必须保持绝对平衡的零的状态」",
voice: Some("li/0snaka_0053"),
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，我虽然不是很懂，但也不用那么在意我的事……」",
voice: Some("li/0snyuka_0036"),
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不。那是我的义务」",
voice: Some("li/0snaka_0054"),
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "强硬的回答到。我话还没有说完。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对……既然选择了闭上眼的世界，那这就是义务……」",
voice: Some("li/0snaka_0055"),
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说到这里，开始在文件上签字的明。和刚才给人的感觉不一样了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
