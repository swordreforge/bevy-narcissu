(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我尽力装出比较“轻松”的神情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00226",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "尽量说的不是很严重。但这某种程度上，也是在赌一把。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00227",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "搞不好的话，会对我这样的态度而生气也说不定。\n甚至会进入冷淡的完全无视模式也说不定",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00228",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但我觉得，对付她这样就好。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00229",
),
),
(
cmd: set_bg,
args: (
image: "2bg_a0011",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
