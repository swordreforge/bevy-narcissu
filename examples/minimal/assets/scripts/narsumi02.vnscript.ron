),
),
(
cmd: label,
args: (
name: "block_00214",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「虽然不是很清楚详情，但现在的那个孩子，应该很抗拒和任何人扯上关系吧」",
