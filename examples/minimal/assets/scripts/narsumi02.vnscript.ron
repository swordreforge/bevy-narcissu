),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我行驶在清晨蒙蒙亮的首都高速上。看了下表，还没到5点。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00275",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "东方的天空黎明刚至，染上了一丝淡紫。因为时间还早，首都高速上车辆也很稀疏。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00276",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，起这么早不是为了去上班。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00277",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……因为，她昨晚说了不要来得太早……所以目的地是她所在的医院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00278",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「虽然具体的不清楚，但肯定有什么」",
voice: Some("li/0snyuka_0057"),
),
),
(
cmd: label,
args: (
name: "block_00279",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我有种直觉……或者说是预感之类的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00280",
),
),
