args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但总感觉有点不爽…………」",
voice: Some("li/0snyuka_00037"),
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "拿到签好字的文件时，她说的话依然残留在耳边。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "“这样我们就两清了，永别了，优花”",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "穿着粉红的睡衣，淡淡的……但是无所畏惧，干脆利落的说话身姿……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "让我想起了曾经的挚友姬子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说起来，姬子在一开始决定去7F的时候，也故意避开了周围的人……」",
voice: Some("li/0snyuka_00038"),
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "连这么亲近的我们，都完全拒之门外的程度。说不定她……明也是这样的情况吧？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，要说有什么很大的不同点的话，那就是她从一开始就没有亲近的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "连唯一作为亲人的父亲，也已离开了这个世界。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00161",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不懂她所说的“闭上眼的世界”是指什么，但至少她现在，不能说是在好好地活着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00162",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也感受不到对生活有什么留恋之类的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00163",
),
),
(
cmd: set_bg,
args: (
image: "2b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我就这样回去真的好吗……」",
voice: Some("li/0snyuka_00039"),
),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不禁如此小声念了一句。下一个十字路口左转就到公司了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "之后只需要把车停在地下车库的老位置，把包里的文件交给课长就行了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "脑中响起了“不要闯进麻烦事里”的警告。但是内心却好像并没有听进去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这种时候，如果是姬子的话，肯定不会假装没看见的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: set_bg,
args: (
image: "bg_2020",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「辛苦了，我回来了」",
voice: Some("li/0snyuka_00040"),
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我精神满满地打开办公室的门，马上就过来了的，课长。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「情况如何昭岛小姐？顺利搞定了吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00171",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，不过呢……有一份是已经拿到了，但另一份她好像不小心写错了……」",
voice: Some("li/0snyuka_00041"),
),
),
(
cmd: label,
args: (
name: "block_00172",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然是骗他的。包里另一份文件也还好好的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00173",
),
),
(
