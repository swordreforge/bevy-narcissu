args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她开朗地回答，我静静地听着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00252",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也就是说……像那样的人的话，就不会产生人情上的亏欠……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00253",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不如说是甚至不用去在意的意思吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00254",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知怎的，说到这里，我好像有点理解她为什么避讳现实，\n为什么想要选择闭上眼的世界了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00255",
),
),
(
