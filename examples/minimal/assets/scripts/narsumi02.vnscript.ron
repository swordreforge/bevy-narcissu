args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难道去公园也是因为这个原因吗？」",
voice: Some("li/0snyuka_0050"),
),
),
(
cmd: label,
args: (
name: "block_00256",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「算是吧。但那里的人们与其说是余命不多，倒不如说是已经死了……很微妙呢」",
voice: Some("li/0snaka_0073"),
),
),
(
cmd: label,
args: (
name: "block_00257",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……已经死了？」",
voice: Some("li/0snyuka_0051"),
),
),
(
cmd: label,
args: (
name: "block_00258",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「简单来讲，就是不怎么满足的人。其中也有活都没活过的孩子」",
voice: Some("li/0snaka_0074"),
),
),
(
cmd: label,
args: (
name: "block_00259",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这话我也不是很懂。偶尔，她就会说些我理解不了的话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00260",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，明，我差不多该回去了。反正明天还会来的」",
voice: Some("li/0snyuka_0052"),
),
),
(
cmd: label,
args: (
name: "block_00261",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯……啊，对了优花，明天……别来太早了」",
voice: Some("li/0snaka_0075"),
),
),
(
cmd: label,
args: (
name: "block_00262",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「可以倒是可以，是要去公园吗？」",
voice: Some("li/0snyuka_0053"),
),
),
(
cmd: label,
args: (
name: "block_00263",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/0snaka_0076"),
),
),
(
cmd: label,
args: (
name: "block_00264",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……怎么了？」",
voice: Some("li/0snyuka_0054"),
),
),
(
cmd: label,
args: (
name: "block_00265",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没事，没什么大不了的。那再见了」",
voice: Some("li/0snaka_0077"),
),
),
(
