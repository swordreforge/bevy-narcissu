),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完这些，急忙返回了电梯的明。好像有些生气，脚步变得很快。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00392",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这样就可以了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00393",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不知道以后会变成什么样，但应该触动到她内心了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00394",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在下一个路口，说不定就会走向正确的道路吧……",
voice: None,
),
),
