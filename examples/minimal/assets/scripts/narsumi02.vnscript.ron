args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我过来了。但这没意义吧？反正到了明天还是会翻到围栏那边」",
voice: Some("li/0snaka_0091"),
),
),
(
cmd: label,
args: (
name: "block_00349",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我知道的啦」",
voice: Some("li/0snyuka_0071"),
),
),
(
cmd: label,
args: (
name: "block_00350",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是吗。那要告诉我什么？这种时候可别想瞎编什么哦」",
voice: Some("li/0snaka_0092"),
),
),
(
cmd: label,
args: (
name: "block_00351",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「有个人想介绍给明……不，是一个地方」",
voice: Some("li/0snyuka_0072"),
),
),
(
cmd: label,
args: (
name: "block_00352",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「虽然有点意外，这就是那个好事吗？」",
voice: Some("li/0snaka_0093"),
),
),
(
cmd: label,
args: (
name: "block_00353",
),
),
(
