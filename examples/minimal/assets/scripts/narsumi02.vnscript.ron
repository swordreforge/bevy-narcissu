),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真是的，拿你没办法啊……那给我新文件吧」",
voice: Some("li/0snaka_0066"),
),
),
(
cmd: label,
args: (
name: "block_00230",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "回复的反应中带着“罢了罢了……”这样的苦笑感。\n但至少当下这个时点，应该成功回避了被做当路人无视了的情况。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00231",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……不过，下一步难度就有点高了。但是不拿下这里的话下次就很难来了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00232",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「咦，诶呀呀？文件跑哪儿去了……真奇怪啊」",
voice: Some("li/0snyuka_0044"),
),
),
(
cmd: label,
args: (
name: "block_00233",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么了？」",
voice: Some("li/0snaka_0067"),
),
),
(
cmd: label,
args: (
name: "block_00234",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「抱歉啦，明。好像忘记带文件了……」",
voice: Some("li/0snyuka_0045"),
),
),
(
cmd: label,
args: (
name: "block_00235",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈？」",
voice: Some("li/0snaka_0068"),
),
),
(
cmd: label,
args: (
name: "block_00236",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎，真是抱歉，我这人老是丢三落四的，在公司里也老是忘这忘那的」",
voice: Some("li/0snyuka_0046"),
),
),
(
cmd: label,
args: (
name: "block_00237",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/0snaka_0069"),
),
),
(
cmd: label,
args: (
name: "block_00238",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "沉默不语的她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00239",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "生气了吗？还是在怀疑我是撒谎？从她的表情上分辨不出来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00240",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但根据她之前的反应来看，感觉应该没问题吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00241",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说不定在我内心某处……把姬子的样子和她重叠在一起了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00242",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不久，她暂时闭上的嘴巴，缓缓地打开了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00243",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呼~我明白了。优花，下次可别再忘了好好带来哦」",
voice: Some("li/0snaka_0070"),
),
),
(
cmd: label,
args: (
name: "block_00244",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，谢谢，明」",
voice: Some("li/0snyuka_0047"),
),
),
(
cmd: label,
args: (
name: "block_00245",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "结果那天，直到熄灯时间为止，都一直和她在病房里度过了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00246",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然老是在发牢骚，但还是附和着坐在窄小的钢管椅子上的我说的话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00247",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话说回来，明，你是不想跟任何人说话吧？」",
voice: Some("li/0snyuka_0048"),
),
),
(
cmd: label,
args: (
name: "block_00248",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对的」",
voice: Some("li/0snaka_0071"),
),
),
(
cmd: label,
args: (
name: "block_00249",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是因为之前说的，不想有任何人情往来吗？」",
voice: Some("li/0snyuka_0049"),
),
),
(
cmd: label,
args: (
name: "block_00250",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「算是吧，但如果是会比我先死掉……余命不多的人的话，倒是不会那么介意」",
voice: Some("li/0snaka_0072"),
),
),
(
cmd: label,
args: (
name: "block_00251",
),
),
