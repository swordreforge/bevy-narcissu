name: "block_00078",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "打理得很整齐的漂亮长发，加上红润的皮肤，看起来一点都不像病人。\n不知道的人看了，肯定会当成只是睡着了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00079",
),
),
(
cmd: dialogue,
args: (
speaker: None,
