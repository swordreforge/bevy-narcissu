),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "打开了大铁门，一瞬间视界全白了一下。那里是正由黎明转向日出，红中带橙的天空。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00297",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "咻地一阵强风吹过，吹乱了我的长发。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00298",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "眼前的是，延伸出去的空无一物的混凝土地面，和将四周包围的高耸栅栏。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00299",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在那高高的围栏的“另一边”，看到了她的身影。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00300",
),
),
(
cmd: play_bgm,
args: (
id: "55",
volume: Some(0.78431374),
