(
cmd: dialogue,
args: (
speaker: None,
text: "她坐在副驾驶上，飞驰在首都高速上的Roadstar。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00355",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "沐浴在早晨清爽的阳光下，红色的引擎盖泛着光芒。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00356",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……这车，真不错啊」",
voice: Some("li/0snaka_0094"),
),
),
(
cmd: label,
args: (
name: "block_00357",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「又老又旧的破车而已啦。已经是20年前……不，比那更早的型号了」",
voice: Some("li/0snyuka_0074"),
),
),
(
cmd: label,
args: (
name: "block_00358",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不过很漂亮呢」",
voice: Some("li/0snaka_0095"),
),
),
(
cmd: label,
args: (
name: "block_00359",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就那样吧。毕竟是从挚友那里得来的，很珍惜它的」",
voice: Some("li/0snyuka_0075"),
),
),
(
cmd: label,
args: (
name: "block_00360",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正确的说，不是得来的，而是作为全勤奖的奖品拿到的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00361",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「明……有过什么挚友吗？」",
voice: Some("li/0snyuka_0076"),
),
),
(
cmd: label,
args: (
name: "block_00362",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯。有过……」",
voice: Some("li/0snaka_0096"),
),
),
(
cmd: label,
args: (
name: "block_00363",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是吗……我也有过哦」",
voice: Some("li/0snyuka_0077"),
),
),
(
cmd: label,
args: (
name: "block_00364",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不是有，而是有过。互相说的都是过去式。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00365",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……至少，她并不是从一开始就选择了闭上眼的世界。只是不知何时步入了歧途。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00366",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样的话，我想应该还有希望。",
voice: None,
),
),
(
