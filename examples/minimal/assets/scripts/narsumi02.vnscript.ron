),
),
(
cmd: set_bg,
args: (
image: "car_run2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呼，总觉得好麻烦啊……」",
voice: Some("li/0snyuka_0012"),
),
),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在十字路口，一边转着方向盘，一边这样嘟囔着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "目的地是市中心外围的某个大学医院。大概再走个5分钟就能到了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: set_bg,
args: (
image: "shanai02",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛，虽然不太明白……总之只要让那个孩子签名就行了吧」",
voice: Some("li/0snyuka_0013"),
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听完了全部说明的我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00047",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "简单来说就是，需要一个目前还在住院的一个女孩子的，法人关系签名的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00048",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且那孩子，是总公司集团代表的独生女。听说才17岁。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00049",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "前几天，我也听说过作为那孩子父亲的集团代表去世的新闻。\n大概是因为那个的关系所需要的手续吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「只听这些觉得还挺简单的……只要让小孩子签名就行」",
voice: Some("li/0snyuka_0014"),
),
),
(
cmd: label,
args: (
name: "block_00051",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是,那孩子从很早开始就住院了。今年已经第7年了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00052",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且那个病是Narcolepsy……似乎也被叫做嗜睡症。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00053",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然虽然说是嗜睡症，也不是一直都睡着的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00054",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是至今为止，就算是律师或亲人去她那里拜访的时候，一来就是睡着的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00055",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然偶尔有醒来的时候，但那时好像谁也不在。可以无视。",
