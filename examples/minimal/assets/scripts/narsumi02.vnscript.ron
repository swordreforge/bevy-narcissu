),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后寻找着去屋顶的紧急通道。当时几乎是条件反射式地那么做了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00294",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……听说，她的父亲好像就是从这里的屋顶跳楼自杀的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00295",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那么，去那里的可能性就是最高的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00296",
),
),
(
cmd: play_se,
args: (
file: "kaze4",
channel: Some(1),
