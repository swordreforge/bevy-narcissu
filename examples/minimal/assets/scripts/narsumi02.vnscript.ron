args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "回神过来，漫长的夏日白昼已完全变为了黑夜。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00268",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……现在，这样就行了……」",
voice: Some("li/0snyuka_0055"),
),
),
(
cmd: label,
args: (
name: "block_00269",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "又有了明天再去的借口。之后的事情就先别胡思乱想了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00270",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "现在最重要的是尽量不要让她孤身一人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00271",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但她那时说的，早上别过来，是什么意思呢……」",
voice: Some("li/0snyuka_0056"),
),
),
(
cmd: label,
args: (
name: "block_00272",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为她说话一直都很直接，很少见的说话这么不清不楚，让我有点在意。",
voice: None,
),
),
