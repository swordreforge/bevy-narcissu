),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……被发现了？\u{3000}难道从最开始就？」",
voice: Some("li/0snyuka_0060"),
),
),
(
cmd: label,
args: (
name: "block_00290",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不对，现在那种事情，已经无所谓了。重要的是这段文字。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00291",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果只是早上去公园的话，肯定不会留下这样的便签。\n这气氛简直像……要说永别了一样。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00292",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我离开了病房，走向走廊。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00293",
),
),
(
cmd: set_bg,
args: (
image: "2b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
