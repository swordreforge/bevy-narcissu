channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那里还是一样的成员，花坛婆婆和轻小说桑。\n相互都坐在自己固定的位置上，一个人度过时间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00398",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在此之中，只有她的固定位置是一张空椅子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00399",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「白石小姐，今天也没有来……」",
voice: Some("li/0snsumi_0059"),
),
),
(
cmd: label,
args: (
name: "block_00400",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我内心有些紧张。因为根据之前的对话，她是打算去死的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00401",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从那天起已经过去了差不多4天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00402",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果没在这里出现的话，就意味着她已经去世了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00403",
),
),
(
