),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我一边说着，一边把方向盘往右打。马上就要到高速的出口了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "副驾上的包里放着刚才她签了字的两份文件。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "之后只要把这个交给课长或者常务就结束了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
