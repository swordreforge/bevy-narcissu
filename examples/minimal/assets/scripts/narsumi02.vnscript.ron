),
),
(
cmd: label,
args: (
name: "block_00209",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然她并没和任何人说过，所以在查明这点之前，貌似还引起过很大的骚动。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00210",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「也是，人突然消失了院方肯定会吓一跳的吧。\n就算不会吓到，但如果是她的话……」",
voice: Some("li/0snyuka_0039"),
),
),
(
cmd: label,
args: (
name: "block_00211",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "呆呆地，边这样想着边等待着她回来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00212",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……总之，碰到她的话，就说是前几天的文件搞丢了吧。",
