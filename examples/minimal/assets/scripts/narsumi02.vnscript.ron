channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不一会，电梯门开了。护士台的护士们齐眼看向我们。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00377",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她们认出是我后，就没有再往这边看了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00378",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐优花，这里是什么病房？有好多上了年纪的人……」",
voice: Some("li/0snaka_0099"),
),
),
(
cmd: label,
args: (
name: "block_00379",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「临终关怀病房哦，你应该至少也听说过这个名字吧？」",
voice: Some("li/0snyuka_0081"),
),
),
(
cmd: label,
args: (
name: "block_00380",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，虽然不清楚具体的……所以呢，为什么来这？」",
voice: Some("li/0snaka_0100"),
),
),
(
cmd: label,
args: (
name: "block_00381",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这里的人都是你口中的那种特别的人。你应该不会顾忌了吧」",
voice: Some("li/0snyuka_0082"),
),
),
(
cmd: label,
args: (
name: "block_00382",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/0snaka_0101"),
),
),
(
cmd: label,
args: (
name: "block_00383",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听到这句话，向我投来了若有所思的表情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00384",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "根据她的理论，只要是比自己死得早，活不长的人，就不会存在什么人情的往来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00385",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……你以前不是说公园很微妙么？那里的人即便余命不长，也早就已经死了」",
voice: Some("li/0snyuka_0083"),
),
),
(
cmd: label,
args: (
name: "block_00386",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以呢？你想说这里的人们不一样吗？」",
voice: Some("li/0snaka_0102"),
),
),
(
cmd: label,
args: (
name: "block_00387",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「谁知道呢………只是有这种感觉而已。\n如果是你的话，说不定可以特别让你住进来吗，要不干脆试着做一下志愿者？」",
voice: Some("li/0snyuka_0084"),
),
),
(
cmd: label,
args: (
name: "block_00388",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不要。这么麻烦的事」",
voice: Some("li/0snaka_0103"),
),
),
(
cmd: label,
args: (
name: "block_00389",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是吗？我觉得你应该会感兴趣的说」",
voice: Some("li/0snyuka_0085"),
),
),
(
cmd: label,
args: (
name: "block_00390",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没有。一点都不想」",
voice: Some("li/0snaka_0104"),
),
),
(
cmd: label,
args: (
name: "block_00391",
),
),
(
