args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为还是早上，轻手轻脚地进了她的病房。\n因为一般来想，现在这个时间应该还在睡觉吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00283",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「咦……不在？去哪儿了……？」",
voice: Some("li/0snyuka_0059"),
),
),
(
cmd: label,
args: (
name: "block_00284",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "厕所和洗浴间里也没人影。说起来整个房间就不像是有人的感觉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00285",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "现在这个点，应该也不会有什么检查……是去之前提到的公园里散步了吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00286",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "自然而然地想着这些，当眼睛忽然瞟到床上时。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00287",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那里有一张便签。",
voice: None,
),
),
