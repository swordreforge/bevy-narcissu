channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……优花？怎么在这里？」",
voice: Some("li/0snaka_0078"),
),
),
(
cmd: label,
args: (
name: "block_00301",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是她说出的第一句话。看到我，露出了些许的惊讶的表情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00302",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我应该说过，不要早上过来的……」",
voice: Some("li/0snaka_0079"),
),
),
(
cmd: label,
args: (
name: "block_00303",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「明……你也很不擅长说谎呢」",
voice: Some("li/0snyuka_0061"),
),
),
(
cmd: label,
args: (
name: "block_00304",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/0snaka_0076"),
),
),
(
cmd: label,
args: (
name: "block_00305",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「也许吧。说不定真是那样……」",
voice: Some("li/0snaka_0080"),
),
),
(
cmd: label,
args: (
name: "block_00306",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "隔着围栏对话的我们。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00307",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，我处在安全的围栏这头。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00308",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这一边不论怎么蹦蹦跳跳都行。因为有围栏这道屏障保护着我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00309",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "可她在围栏另一头。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00310",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在那边，只要一松开手……就会失去平衡摔下去，是死亡的领域。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00311",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对了，优花你……是想要阻止我吗？」",
voice: Some("li/0snaka_0081"),
),
),
(
cmd: label,
args: (
name: "block_00312",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「可以的话」",
voice: Some("li/0snyuka_0062"),
),
),
(
cmd: label,
args: (
name: "block_00313",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……如果，做不到的话？」",
voice: Some("li/0snaka_0082"),
),
),
(
cmd: label,
args: (
name: "block_00314",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不知道……说不定会久违地哭出来吧」",
voice: Some("li/0snyuka_0063"),
),
),
(
cmd: label,
args: (
name: "block_00315",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这么大人了，你还会哭？」",
voice: Some("li/0snaka_0083"),
),
),
(
cmd: label,
args: (
name: "block_00316",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对，是啊。很羞耻的能别让我哭吗？」",
voice: Some("li/0snyuka_0064"),
),
),
(
cmd: label,
args: (
name: "block_00317",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "可以被当做玩笑的话语。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00318",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我想我一定是受不了这种紧张感再增加了。害怕一脸严肃地去说正经话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00319",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「优花，为了让你别误会我可先说好……我并不是想去死」",
voice: Some("li/0snaka_0084"),
),
),
(
cmd: label,
args: (
name: "block_00320",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那就停下来啊」",
voice: Some("li/0snyuka_0065"),
),
),
(
cmd: label,
args: (
name: "block_00321",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不是这个意思，而是我现在已经死了哦。自从选择了闭上眼的世界的那天开始」",
voice: Some("li/0snaka_0085"),
),
),
(
cmd: label,
args: (
name: "block_00322",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是以前也听到过的话。想去那里的人，就不能和任何人有人情往来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00323",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说是将自己的存在，从开始之时就消除干净便是义务。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00324",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但她也应该察觉到了吧?这其中的矛盾。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00325",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对已经可称之为死了的公园里的人们也就罢了，但一边说着对我已经两清了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00326",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "现在却这样跟我对话……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00327",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……好。总之尽力而为吧。在这么想着的时候，\n真害怕她会突然说出“永别了”之类的话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00328",
),
),
(
cmd: play_se,
args: (
file: "kaze4",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「明，我有个建议……能听一听我唯一的请求吗？」",
voice: Some("li/0snyuka_0066"),
),
),
(
cmd: label,
args: (
name: "block_00329",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不要。不想欠你什么，也不想你欠我什么」",
voice: Some("li/0snaka_0086"),
),
),
(
cmd: label,
args: (
name: "block_00330",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我知道的。所以相对的，我告诉你一件好事，\n这样就相互抵消了，没问题了吧？」",
voice: Some("li/0snyuka_0067"),
),
),
(
cmd: label,
args: (
name: "block_00331",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/0snaka_0087"),
),
),
(
cmd: label,
args: (
name: "block_00332",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对我的建议她稍微考虑了一下。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00333",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……重点的是她对这件事在意到了什么程度。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00334",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，我想她自己约定过的事，就不会去违背的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00335",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「优花，那个好事是什么啊？」",
voice: Some("li/0snaka_0088"),
),
),
(
cmd: label,
args: (
name: "block_00336",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「要是提前说了就不能当作交易筹码了。现在就决定吧」",
voice: Some("li/0snyuka_0068"),
),
),
(
cmd: label,
args: (
name: "block_00337",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……反正什么时候说都一样」",
voice: Some("li/0snaka_0089"),
),
),
(
cmd: label,
args: (
name: "block_00338",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不。现在的话，还可以做出选择。自己决定吧」",
voice: Some("li/0snyuka_0069"),
),
),
(
cmd: label,
args: (
name: "block_00339",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我用强硬的语气说到。至今为止她是怎么活着的，我不知道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00340",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，现在这一幕，肯定是非常关键的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00341",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就这样死掉，还是活下去……是左右她今后人生的，巨大转折点。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00342",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果这步走错的话，就再也回不了头了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00343",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我明白了。优花，说说你的请求吧」",
voice: Some("li/0snaka_0090"),
),
),
(
cmd: label,
args: (
name: "block_00344",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，到这边来。这就是请求」",
voice: Some("li/0snyuka_0070"),
),
),
(
cmd: label,
args: (
name: "block_00345",
),
),
(
