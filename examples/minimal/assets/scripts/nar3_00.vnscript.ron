),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难道……我一直要生活在这里吗？」",
voice: Some("li/n3kiri_0030"),
),
),
(
cmd: label,
args: (
name: "block_00066",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，公主有一个很重要的使命噢」",
voice: Some("li/npetcw4_002"),
),
),
(
cmd: label,
args: (
name: "block_00067",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……使命？」",
voice: Some("li/n3kiri_0031"),
),
),
(
cmd: label,
args: (
name: "block_00068",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是的，您尊贵的身体便是为了这使命而生，\n而我们大家则是来守护你完成使命的」",
voice: Some("li/npetcw4_003"),
),
),
(
cmd: label,
args: (
name: "block_00069",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边说着，一边换新的床单。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00070",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当时街道上，好像在流行着恐怖的黑死病。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00071",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「公主 时机到了的话，你就会嫁到邻国去噢」",
voice: Some("li/npetcw4_004"),
),
),
(
cmd: label,
args: (
name: "block_00072",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我要被嫁出去？ 那是什么时候呢？」",
voice: Some("li/n3kiri_0032"),
),
),
(
cmd: label,
args: (
name: "block_00073",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「恩……这个我就不清楚了……」",
voice: Some("li/npetcw4_005"),
),
),
(
cmd: label,
args: (
name: "block_00074",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是……在那天到来之前，公主如果病倒的话，我们就会被追究责任的」",
voice: Some("li/npetcw4_006"),
),
),
(
cmd: label,
args: (
name: "block_00075",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完那些话，侍女就从房间里出去了。然后跟平时一样从外面把门锁上。",
voice: None,
),
),
(
cmd: label,
args: (
