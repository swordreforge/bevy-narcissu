args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我到这个岁数以前，一直都只是在小小的房子里生活。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，人们都叫我伊丽丝公主，也没有受到粗鲁地对待过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00047",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "每天都能在豪华的浴室沐浴，也会给我自己喜欢的衣服，食物等任何事物。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00048",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是，房子的钥匙却在门外。不允许我自由地离开这个房间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00049",
),
),
(
cmd: set_bg,
args: (
image: "na03_033",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……没有自由，什么都没有的生活着。就像个被囚禁的人吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这个狭小的房子，就是我生活的全部世界。\n从小小的窗口所能看到的世界也是我全部的世界。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00051",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然能看到，却是镜花水月。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00052",
),
),
(
cmd: dialogue,
args: (
speaker: None,
