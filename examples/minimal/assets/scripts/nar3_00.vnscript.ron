args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "再过不久天空将雪花飘飘，所有的景物都会在一瞬间就被披上了银白色吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……每当开始下雪的时候，我总会想起一些往事……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……我的名字叫佩内洛普」",
voice: Some("li/n3iri_0020"),
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: set_bg,
args: (
image: "3tui_03",
transition: Some(fade(
