(
cmd: label,
args: (
name: "block_00111",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "想到这里，我也想回去，但看来是不行了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00112",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为，有几辆马车和几个并不相识的人，朝着我走来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00113",
),
),
(
