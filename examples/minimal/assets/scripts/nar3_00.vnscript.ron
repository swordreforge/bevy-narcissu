channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我们等候多时了，伊丽丝小姐」",
voice: Some("li/n3zijo_0001"),
),
),
(
cmd: label,
args: (
name: "block_00114",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是个可爱的年轻女性。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00115",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从服装上看，就像平时在房间的侍女一样。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00116",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，和可爱的声音礼貌的言辞相反的，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00117",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "眼神却是冰冷的。也并未对我行礼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00118",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "另外，还有很多连马也不下，在远处沉默地围观着这边的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00119",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「请先把公主的证明拿出来吧」",
voice: Some("li/n3zijo_0002"),
),
),
(
cmd: label,
args: (
name: "block_00120",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，好……」",
voice: Some("li/n3kiri_0038"),
),
),
(
cmd: label,
args: (
name: "block_00121",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边回答，一边把挂着的吊坠交给她。这可是，作为公主身份的证明。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00122",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是四岁生日时收到以后，就被告知要不离身的带着的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00123",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「确认完毕……然后请将身上的所有东西都交给我，衣服请脱掉」",
voice: Some("li/n3zijo_0003"),
),
),
(
cmd: label,
args: (
name: "block_00124",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……全部？ 在这里？」",
voice: Some("li/n3kiri_0039"),
),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对，全部」",
voice: Some("li/n3zijo_0004"),
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像是侍女的人用冷淡的语气回答我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
