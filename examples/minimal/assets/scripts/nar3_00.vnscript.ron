args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她沉默着，向着树林里走去，同时也招手叫我跟在她后面。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "………………",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在那里，裙子和内衣和手镯，身上全部的东西都被脱了下来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "雪飘下来，寒冷的风吹打着赤裸的身体。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "陌生的地方，陌生的人面前，比起寒冷和害羞，更是不安得想哭。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「现在，请把这个穿在身上」",
voice: Some("li/n3zijo_0005"),
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是看一眼就知道是很高级的新裙子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在不安和寒冷中，我照她说的把衣服穿在身上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这就是，这个国家的衣服？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "莫非是……我的国家的所有东西，一个都不可以带进去吗………",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「接下来，最后请把这个收好」",
voice: Some("li/n3zijo_0006"),
),
),
(
cmd: label,
args: (
name: "block_00138",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……吊坠？」",
voice: Some("li/n3kiri_0040"),
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这个不是我刚才给她的吊坠。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我那个只是贝壳加工而成的普通吊坠，而这个则是用宝石做成的浮雕项链。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我从未拥有过这样贵重的物品。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我惶恐地把那个项链戴在头上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「和你非常般配噢，伊丽丝公主」",
voice: Some("li/n3zijo_0007"),
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "侍女说完就笑了起来。来到这里，第一次被叫公主。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "与此同时，远处围着的人也，一起行了礼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……看来这个国家，这个才是身份的证明吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不久，侍女把我带到马车那边。在她的催促中坐上了马车。",
