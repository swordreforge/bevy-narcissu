),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「“……所有的生命，都有其光辉的时刻”」",
voice: Some("li/n3iri_0018b"),
),
),
(
cmd: label,
args: (
name: "block_00003",
),
),
(
