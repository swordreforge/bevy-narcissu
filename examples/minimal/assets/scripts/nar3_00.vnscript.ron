),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……小小的伊丽丝想过了……」",
voice: Some("li/n3kiri_0033"),
),
),
(
cmd: label,
args: (
name: "block_00083",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「人……只有被谁『需要』， 才能称之为人……」",
