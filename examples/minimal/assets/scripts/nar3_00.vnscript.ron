),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……还是这样，直到明天，谁也不会来。当然，我也出不去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00077",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "曾经想要出去而一直的哭，但是一次都没能成功过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00078",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这种事情来来回回地过了好几年，我终于知道是不会有结果的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00079",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，没有目送离开的侍女。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00080",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而是和平常一样，从窗口望向天空。",
voice: None,
),
),
