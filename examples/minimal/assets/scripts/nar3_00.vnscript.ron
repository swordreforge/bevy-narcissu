),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……年幼的伊丽丝想到了……」",
voice: Some("li/n3kiri_0033"),
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在祖国阿利娜出生长大的伊丽丝已经消失了。从今以后，要变成这个国家的伊丽丝。",
