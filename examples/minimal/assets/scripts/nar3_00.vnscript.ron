),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―季节是初冬",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "才刚入11月，纯白的雪花就从空中飘散下来，那是非常寒冷的一天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "嘎塌嘎塌地在山路上前进的马车。从出生到现在，这是她第一次被带出城堡。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在摇晃的马车里，快冻僵的她望向窗外。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然这些景色都是她第一次看到，但是她并未感觉到新鲜，快乐。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "第一次看见的风景……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
