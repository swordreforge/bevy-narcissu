channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……很久以前，某个地方有个小女孩……」",
voice: Some("li/n3iri_0022"),
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不能说得上是过得很幸福的小女孩。生逢乱世。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……她名字叫伊丽丝」",
voice: Some("li/n3iri_0023"),
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "现在说来应该是十多年以前的事情了……严格来说已经忘记究竟是多少年了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是啊。故事，到底要从哪里说起呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……刚出生的时候，悲伤哭泣的时候，第一次杀人的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "每个人的人生都会有的转折点。她的人生也有过好多转折点。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那恐怕是……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……第一次从城堡里出来的时候开始的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "距今大约十年前，刚好八岁生日那天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她被嫁到了邻国。听起来像是虚假的，这却是真实的故事 。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
