(
cmd: dialogue,
args: (
speaker: None,
text: "「……我的名字叫伊丽丝」",
voice: Some("li/n3kiri_0026"),
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正式的名字叫伊丽丝·卡蒙伊斯·阿利娜。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00039",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "卡蒙伊斯，卡蒙伊斯是外祖父的姓阿利娜是祖父的姓。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听说是在阿利娜的小国里出生，而我好像是排行第二位的公主。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00041",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说成“好像”，有点像是说别人的事一样，\n我不记得父母有没有直接告诉过我，这也是没办法的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00042",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不仅如此，我连好好与父母交谈过的记忆都没有。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "甚至连他们的容貌都记不起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不,不仅仅是父母。从懂事开始，我就是自己一个人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
