),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那个时候……不经意间，看到了刚刚换衣服的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
