channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "尤其是喜欢冬天的夜空。我曾一直清晰地眺望着那冬日的星座。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00054",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "向着突然变紧张的空气，吐出白色的气息。\n闪闪发光的星星。无事可做。也没有会做的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00055",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这里的生活只教会了我一件事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00056",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……黎明前的天空是最黑暗的」",
voice: Some("li/n3kiri_0028"),
),
),
(
cmd: label,
args: (
name: "block_00057",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在东方的天空吐出鱼肚白之前……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00058",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "发现整个天空就像被拉上了一层漆黑的帷幕。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00059",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就像是黑夜在洞悉了自己已经被白天追得走投无路后，\n做出了最后抵抗般，一切都变得黑暗无光。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00060",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这些就是我八年来的全部生活。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00061",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，就算是这样的我，好像也是有目的的」",
voice: Some("li/n3kiri_0029"),
),
),
(
cmd: label,
args: (
name: "block_00062",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也可以说是存在的理由。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00063",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "自懂事之前，就一直被别人这样教导。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00064",
),
),
