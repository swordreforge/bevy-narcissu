channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果那样的话，如今眼前所看到的景色，充满光辉也是理所当然的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即使被冰冷的北风吹得四处摆动，它的生命依旧那么顽强。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这并不会永恒。这光辉，最终也会褪去色彩。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这就是这个世界的真理。任何人，任何事物，都绝对逃避不了的真理。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "春生，夏长，秋实……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……然后冬天又将来临。那是个，让人感到冰冷的终结的季节。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就像为漫长的生命画上句号般，只能忍耐的黑夜就要开始了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: set_bg,
args: (
image: "sora012",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
