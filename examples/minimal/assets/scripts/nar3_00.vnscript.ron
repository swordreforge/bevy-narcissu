),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只不过，一旦有那些物品会被如此处置的预感下，看到这场景……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在燃烧的火焰中，之前的吊坠也被随随便便地投了进去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……到刚刚为止，那还是我公主身份的证明……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……懂事开始就一直带在身上的，我作为“我”的证明……",
