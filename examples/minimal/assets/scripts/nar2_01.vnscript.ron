channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…嗯」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00051",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "老婆婆大致说明完了后。\n感觉气色变得比刚刚好点了。",
voice: Some("li/setsumi_0005"),
),
),
(
cmd: label,
args: (
name: "block_00052",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯……对你这般年轻的孩子，实在让人难以启齿…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00053",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但毕竟也是规则，再难也要告诉你」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00054",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着这些，老婆婆走出谈话室。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00055",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "离开的时候，「再有新人来的时候，就由你来告诉他这些事吧。」 \n老婆婆又带上这么一句。",
voice: None,
),
),
(
