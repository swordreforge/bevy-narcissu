),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，确认是我后便转回了视线。\n好像什么都没看见一样，继续她们的工作。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…高高的天花板，仅能拉开15厘米的窗户。\n纯白、明亮又冰冷的地方。",
voice: None,
),
),
(
