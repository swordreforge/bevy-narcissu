),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "花瓶种植的迷你向日葵，感觉，\n像是在夏天一样盆栽种植着的非洲菊，也正鲜艳地开着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…这些都是曾经看过的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「再次来到这里…已经隔了多少年呢…」",
