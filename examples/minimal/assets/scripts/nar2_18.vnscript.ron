            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一天也差不多就这样过去了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00007",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为是这种时间，也因为前日的天气，其他登山者的身影，几乎看不到了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00008",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「等到黎明后，就在这里说出来。」",
                voice: Some("li/hime1_0516"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00009",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样说着，走到了岩石的边端。",
