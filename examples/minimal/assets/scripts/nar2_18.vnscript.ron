            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00010",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "俯瞰悬崖，黑暗得看不见任何东西，这个谷底，也到了不知道到底有多深的程度。",
                voice: None,
            ),
