        (
            cmd: label,
            args: (
                name: "block_00019",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过，明明应该持有很多的疑问......\n不知为何，却很难把那些问题用言语来表达。",
                voice: None,
            ),
        ),
        (
