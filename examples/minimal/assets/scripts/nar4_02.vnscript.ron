        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一天中慢慢进入了日暮时分。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00163",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "吃完晚饭，家里的工作也已经告一段落的时候……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
