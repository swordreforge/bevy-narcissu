        (
            cmd: label,
            args: (
                name: "block_00296",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，就在那个红绿灯的前面……\n有一栋、叫莳绘之家的养老院，你知道吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00297",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，果然是那里啊。因为是个挺少见的名字，我就想会不会……」",
                voice: Some("li/n4yoko_0050"),
