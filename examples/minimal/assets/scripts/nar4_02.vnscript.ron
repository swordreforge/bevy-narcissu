        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―次日。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00341",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "窗外的天空，今天也格外地晴朗。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00342",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "与其说那是蓝色，不如说是变得洁白与淡薄的，看上去仿佛水色的春季天空。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00343",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呼啊……睡了个好觉……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00344",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n4bg_003a",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: play_bgm,
            args: (
                id: "81",
                volume: Some(0.78431374),
                fade_ms: Some(500),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我大大地伸了个懒腰，然后麻利地穿好校服。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00345",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "温暖的阳光从窗外照射进来，带着的的确确春天的气息，令人心情舒畅。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00346",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「果然，还是有点困呐……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00347",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "马上会有新人入住，昨天为此准备到了很晚。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00348",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因此我几乎没怎么睡，下意识地就想要翘掉今天的课……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00349",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但一想到那家伙……想到日下就又犹豫了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00350",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「毕竟昨天才刚说好的……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00351",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "换平常的话我肯定是翘了，虽然觉得麻烦但还是穿好了校服。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00352",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n4bg_004a",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "接着，打着哈欠走出了房门，在那里看到了父亲忙乱的身影。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00353",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……发生什么事了？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00354",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "记得新的住户，应该是明天才到……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00355",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐，难道新人今天要来吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00356",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，本来定的是明天，但提前到今天了」",
                voice: Some("li/np4papa_1019"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00357",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「提前到今天……大概什么时候？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00358",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「谁知道呢，可能中午以前就会到吧？」",
                voice: Some("li/np4papa_1020"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00359",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "父亲的回答略显轻松，实际上这也是经常发生的事情。入住的日期，其实非常含糊。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00360",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "提前一天变更已经算是温柔的了，严重的时候甚至有一周以上的时间变动。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00361",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……真没办法。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00362",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我一边小声嘀咕着，一边脱掉了刚穿上的校服。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00363",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，慢着博史……你是又打算来帮忙吗？」",
                voice: Some("li/np4papa_1021"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00364",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是现在缺人手吧？\u{3000}房顶的修补也才弄到一半」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00365",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「确实是帮大忙了……但学校那边打算怎么办？」",
                voice: Some("li/np4papa_1022"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00366",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "某种意义上来说，这是身为父亲的正常反应，而我用和往常一样的语气回应到。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00367",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没事没事，总之我先去把漏雨的地方补一下吧」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00368",
            ),
