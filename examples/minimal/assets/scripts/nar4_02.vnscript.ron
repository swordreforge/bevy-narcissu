        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，其实因为感觉太麻烦本来打算翘掉的」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00257",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真是的，这样不行啦……每天都要好好来上学……」",
                voice: Some("li/n4yoko_0038"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00258",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说完，她露出一副有些困惑又略带羞涩的表情。",
                voice: None,
