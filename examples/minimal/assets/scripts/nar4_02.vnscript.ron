            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "沉闷的课程结束了，总算到了放学的时候。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00023",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "教室里转眼间变得喧闹起来，到处都能听到同学们交谈的声音。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00024",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，也会有几个人来和我打招呼。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00025",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「莳绘同学，有空的话，和我们一起出去玩吧？」",
                voice: Some("li/etcm1_1001"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00026",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯～虽然无所谓……不过今天有点麻烦还是算了」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00027",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这样啊。那打扰了，莳绘学长」",
                voice: Some("li/etcm1_1002"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00028",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说完，他夸张地朝我点了一下头，便和其他几个同学一起走出了教室。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00029",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "基本上和我说话时，多数人会对我用敬语。\n名字后面会加上『同学』两字。有时也会叫我学长。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00030",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "的确，我经常会被人说，虽然年龄不大但挺干练而且挺老成，\n但被这么对待还是有点过分了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00031",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……唉，他们也有他们的顾虑吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00032",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "他们不能刚见面就不用敬语，更何况我不知为何还被他们当成了不良少年……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00033",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不管怎么说，我在这个班里是孤身一人。这种程度的自觉还是有的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00034",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "本来我对学校这种地方，就抱着消极的心态，到现在，这种感觉更加高涨了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00035",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……干脆还是，别来上学了吧？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00036",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不经意间，把这种牢骚话都说了出来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00037",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "总觉得明明只是留级而已，却奇怪地被像不良一样来看待实在让人不爽。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00038",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "再次被这种想法驱使着，正打算一个人离开教室的时候。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00039",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
