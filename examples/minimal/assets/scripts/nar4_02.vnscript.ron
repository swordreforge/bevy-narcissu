            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "走过人行横道时，日下好几次转身向我挥手道别，我也一样朝她轻轻挥了挥手。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00338",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……不过，真是个不同寻常的人啊。竟然会对这么朴素的工作抱有兴趣。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00339",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果这工作更有趣一些的话我多少还能理解……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00340",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "sora012b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
