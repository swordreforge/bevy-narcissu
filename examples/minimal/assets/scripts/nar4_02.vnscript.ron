            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「有什么事吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00043",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那，那个……………莳绘君现在，也准备回家吗？」",
                voice: Some("li/n4yoko_0004"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00044",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯？……是这样，没错」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00045",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我敷衍地回答道，并观察着对方。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00046",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……我们班，有这个人吗？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00047",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然第一反应觉得可能是隔壁班的人，但姓名牌上写着１－Ａ。是和我同班的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00048",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明明距新学期开学已经过去一个多月了，却没有注意过她……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00049",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且，对方好像还知道我的名字，果然应该是同一个班的吧？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00050",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「之，之前有一次……在游泳池……」",
