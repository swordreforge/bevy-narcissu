            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哈啊哈啊、呼……」",
                voice: Some("li/n4yoko_0060"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00398",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "嗯？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00399",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n4ime_002b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: play_bgm,
            args: (
                id: "105",
                volume: Some(0.78431374),
                fade_ms: Some(500),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「早，早上好，莳绘君……」",
                voice: Some("li/n4yoko_0061"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00400",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，你这是……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00401",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我回过头，看见的是穿着白色夏装的日下。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00402",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我下意识地看了眼手表，现在才刚过早上10点。刚好是上午第二节课的途中。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00403",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真是的，明明都说了，不准翘课的」",
                voice: Some("li/n4yoko_0062"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00404",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这么说你……不对，日下也翘课了吧，现在应该还是上课时间哦？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00405",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，啊哈哈哈哈……」",
                voice: Some("li/n4yoko_0063"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00406",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，别笑着装傻啊……\u{3000}难道说，你从早上就没去吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00407",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「才，才不是呢，我去到学校，\u{3000}发现莳绘君好像没有来……所以才……」",
                voice: Some("li/n4yoko_0064"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00408",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呵，这么说来连衣服都换了，简直是完美的翘课模式啊」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00409",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呜……嘛，嘛～，你就当做是这样吧，诶嘿嘿嘿……」",
                voice: Some("li/n4yoko_0065"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00410",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "日下再次害羞地笑着想要蒙混过关。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00411",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过算了，看她这个样子，应该也不是因为身体原因而请假了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00412",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，我也来帮忙吧？」",
                voice: Some("li/n4yoko_0066"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00413",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「帮忙是指刷油漆吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00414",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，看你好像刷得挺开心的……我也想要试试看」",
                voice: Some("li/n4yoko_0067"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00415",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不行不行，这个很难弄的，而且你会把衣服弄脏的」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00416",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，这样……真可惜啊」",
                voice: Some("li/n4yoko_0068"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00417",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "………………",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00418",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00419",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在那之后，日下没有做什么别的事情，只是在一旁看着我刷着油漆。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00420",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "有时，会被油漆味熏到而露出有趣的表情，\n但即便如此她也没有离开，而是在旁边一直盯着看。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00421",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……本来刷油漆之类的也不是什么稀奇的事情，\n她却咯咯笑着……真是个，与众不同的家伙啊。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00422",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "终于，把招牌和围墙差不多都刷上了油漆的时候……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00423",
            ),
        ),
