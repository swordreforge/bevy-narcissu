        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我说博史，你下周有什么安排吗？」",
                voice: Some("li/np4mama_1001"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00165",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，做菜的事情，应该是轮到博美了吧」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00166",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那洗衣服就是我和你了」",
                voice: Some("li/np4mama_1002"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00167",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在由电视厅改成的谈话室里，我接着又和妈妈商量了明天的安排。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00168",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "没错。在这个莳绘之家，打从一开始就没有雇员。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00169",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这里所有的工作，都由整个家庭来分担进行。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00170",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因此，如果用一句话解释这份工作的话……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00171",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "依靠整个家族来运营的，附带伙食的租赁公寓房东。并且，只接受高龄人士。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00172",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "话虽如此，因为这种被称为养老院的设施本身还很少，什么都还处于摸索的状态。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00173",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "也许，其他地方也和我们差不多。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00174",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后我们莳绘之家，以前有10间住房，现在又增建了6间新的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00175",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "按一个房间3人来算，需要做的事情实在是很多。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00176",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对了妈妈，有新住户要来吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00177",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「大概，这周会有一个人来，详细的去问爸爸吧」",
                voice: Some("li/np4mama_1003"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00178",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我知道了，因为203号房空出来了啊…」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00179",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在这栋公寓，共有16间房间。其中一间由我们家人自用，另两间作为公共区域。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00180",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "剩下的13间房用于出租供人居住。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00181",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那妈妈去做早饭的事前准备了，你就早点睡吧」",
                voice: Some("li/np4mama_1004"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00182",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n4bg_003c",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
