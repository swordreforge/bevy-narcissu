            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00300",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，慢着。\u{3000}你的家，应该不在这边吧？」",
                voice: None,
