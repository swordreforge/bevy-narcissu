        (
            cmd: label,
            args: (
                name: "block_00216",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然还不知道她的名字，但这应该是她的姓吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00217",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "妹妹评价她太老实，也不难明白。那弱不禁风的样子，还有略带忧郁的感觉。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00218",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且……她留级的原因也和我不同。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00219",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "难道说，那种性格也在学校里遭受了……不对，可能只是没有融入到班级里吧……",
