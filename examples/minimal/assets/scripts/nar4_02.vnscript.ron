        (
            cmd: label,
            args: (
                name: "block_00056",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "原本以为，班里一定不会有认识的人，没想到竟和去年的同班同学分到了一起。",
