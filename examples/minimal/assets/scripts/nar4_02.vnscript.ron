            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "走在走廊上，听到了下课的铃声。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00229",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在刚好是第二节课下课的时间，瞄准的就是这段课间的空闲时间趁机混进教室。",
                voice: None,
            ),
