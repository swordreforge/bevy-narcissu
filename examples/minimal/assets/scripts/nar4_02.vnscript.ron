        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「今天，我看到了哦，真有你的老哥」",
                voice: Some("li/np4imo_1005"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00196",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你在说啥啊？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00197",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「别害羞嘛，你们看起来气氛不是挺好嘛？」",
                voice: Some("li/np4imo_1006"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00198",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「博美……我说你啊……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00199",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊——，想敷衍过去也没用的哦，我可是亲眼看见的」",
                voice: Some("li/np4imo_1007"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00200",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "莫名兴奋起来的妹妹。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00201",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然不是很清楚，但是应该是指今天我和那个女生一起回家的事吧？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00202",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嘛，老哥你会迷上她也没办法。\u{3000}毕竟日下同学，那么可爱嘛」",
                voice: Some("li/np4imo_1008"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00203",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……日下？\u{3000}这样啊，那个女生叫日下啊」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00204",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「又来了又来了，还想装作不认识」",
                voice: Some("li/np4imo_1009"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00205",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不过啊，那个女生，稍微有点老实过头了呢。 \n应该和哥哥你不太合得来吧？」",
                voice: Some("li/np4imo_1010"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00206",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我说你，是不是太啰嗦了……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00207",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哇，好过分啊，明明我是在关心哥哥你」",
                voice: Some("li/np4imo_1011"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00208",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「多管闲事，你才要改一改你那奇怪的打扮吧」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00209",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真是的，才不怪呢，是你太过时了啦」",
                voice: Some("li/np4imo_1012"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00210",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「好好我知道了，你赶紧去睡吧。\u{3000}明天的早饭，轮到你做哦」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00211",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「好吧，那么，晚安ー」",
                voice: Some("li/np4imo_1013"),
            ),
