                name: "block_00003",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "和预想的一样，我留级了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00004",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "嗯，毕竟翘了有一半的课，这也是理所当然的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00005",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n4bg_005a",
