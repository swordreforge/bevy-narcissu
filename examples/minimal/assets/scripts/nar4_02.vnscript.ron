        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为我的进入，教室有一瞬间变得极为安静。课余间喧闹的闲聊，有片刻的暂停。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00232",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，立刻又变得热闹起来，但那氛围的变化就算是我也能察觉到。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00233",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「早上好，莳绘同学」",
                voice: Some("li/etcm1_1003"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00234",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，啊，早啊」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00235",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "同学们带着明显的胆怯向我打招呼。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00236",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我随口打招呼回应他后，向着自己的座位走去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00237",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后发现班里的某个人，正坐在我的座位上，和其他人开心地闲聊着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00238",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "似乎是对桌上摊开的书的内容正聊得起劲，似乎连我已经来了都没有注意到。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00239",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……嘛，毕竟都这个时间点了，一定是以为我今天也不会来了吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00240",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我并没有生气，用平静的语气对他说道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00241",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个……你坐的，是我的位置……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00242",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……啥？」",
                voice: Some("li/etcm1_1004"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00243",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「额，啊啊，对不起，\u{3000}我，我马上就把这收好」",
                voice: Some("li/etcm1_10042"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00244",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "同班同学一边说着，一边不断对我低头道歉。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00245",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……啊，不是，总觉得和预想的有点不太一样？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00246",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "至少，我是把他们当同班同学来看的，但对方似乎并没有这样看待我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00247",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从某种意义上来说，与其说是顾虑我的感受，不如说更像是在害怕着我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00248",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……明明只是，留级了而已，到底把我想成什么了啊。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00249",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不良什么的，明明我并不是那种人，不知为什么周围的人却总是那么随便地认为。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00250",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这使我对学校的厌恶又加深了一层……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00251",
