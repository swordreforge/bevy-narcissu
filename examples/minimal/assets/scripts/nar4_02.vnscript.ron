            cmd: label,
            args: (
                name: "block_00254",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "还是和之前一样，稍微有点靠不住的感觉，扭捏着走到了我桌前。",
                voice: None,
            ),
        ),
        (
            cmd: label,
