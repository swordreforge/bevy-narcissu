            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "老实说，我根本没想毕业。就算毕业了也不觉得会有什么改变。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00013",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我是真心觉得和那些老人相处会更好，不仅仅是因为它是家业。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00014",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "要学的事情也还很多，单纯能让他们感到高兴的话我也会感觉开心。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00015",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，老爸在这件事上唠叨了很多，所以我也没办法。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00016",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且，连家里的爷爷奶奶们也对我说，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00017",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只有学校必须要去",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00018",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "被这么一说，我态度也软了下来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00019",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知为何，虽然我对大人们的话总是很不耐烦，但对老人们的话却很是认同。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00020",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在朋友里面，也有讨厌继承家业的，但我自己倒是没有过那种想法。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
