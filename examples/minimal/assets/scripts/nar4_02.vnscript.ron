        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "抬头就能见到清澈的天空。温暖的阳光，让人感受到春天。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00159",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这样的氛围中，我们好像终于成为了朋友。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00160",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "第一次触碰到的那只手……既娇小又柔软，",
                voice: None,
            ),
        ),
        (
