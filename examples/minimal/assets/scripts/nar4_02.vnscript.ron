        (
            cmd: label,
            args: (
                name: "block_00108",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过，作为从小时候起就经常泡在那里的我，并没有朝那方面考虑过。",
                voice: None,
