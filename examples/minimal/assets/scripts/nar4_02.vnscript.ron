        (
            cmd: label,
            args: (
                name: "block_00301",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶嘿嘿，因为想看一下莳绘家什么样的嘛」",
                voice: Some("li/n4yoko_0051"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00302",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嘛，那倒是可以……\u{3000}不过这里真没什么有趣的东西哦」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00303",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不仅如此，这里不是老爷爷就是老奶奶，真是个奇怪的家伙。",
                voice: None,
            ),
