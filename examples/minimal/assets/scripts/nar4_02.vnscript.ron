        ),
        (
            cmd: label,
            args: (
                name: "block_00107",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "的确，比起那种爵士乐咖啡馆，\n我经常去的那家店，就是所谓的不良少年们的聚集地……",
                voice: None,
            ),
