        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "接着，我立刻换上了工作服向房顶走去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00369",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "sora012b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "春天明媚的阳光洒在身上……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00370",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "准确的说，房顶因为光线反射强烈而变得很热。明明才5月汗已经开始往外冒了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00371",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就这样，我拿着铁桶和夹板刷开始加固屋顶。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00372",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "目的是改善漏雨情况。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00373",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "平常的中小雨还没事，但遇到台风或者大暴雨的时候，\n院里的屋顶有些地方就会开始漏雨。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00374",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "原本，这栋楼房并没有建的很大……\n但随着不断地扩建，三楼部分的问题变得有些严重。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00375",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因此我在铁皮加固过的地方，又涂了一层煤焦油来加固。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00376",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然气味有些刺鼻，但这最直截了当的方法。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00377",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呼，差不多就这样了吧……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00378",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我轻轻地吐了口气，大大的伸了个懒腰。这之后，就靠这阳光把它晒干吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00379",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我拿起整套工具，爬下了屋顶。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00380",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n4bg_002a",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，接下来……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00381",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我大致张望着环视了一下院子。需要修理的地方可以说是数不胜数。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00382",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "并不是我在辩解，从中选择最迫切需要使用的地方凑合着进行修理与补强，\n是我一直以来的做法。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00383",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……说起来养老院入口的地方好像有些掉漆了……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00384",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然对外观上的事，父亲和母亲都不怎么关心，但招牌生锈着实有些丢人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00385",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以这次，我提着用于防锈的涂料向公寓入口处走去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00386",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n4bg_001a",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哇，好浓的油漆味……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00387",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我拿着毛刷，吧嗒吧嗒地为招牌和周围涂上油漆。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00388",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "事实上在以前，在门口招牌涂料曾经脱落的时候，刚有新的住户过来……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00389",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那时，因为看不清招牌上的文字，结果在附近迷了路。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00390",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……的确乍一看和普通的公寓没什么区别……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00391",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "第一次来的人，有可能一不注意就走过了，而且这里也有很多住户以外的人来访。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00392",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在我匆忙地刷油漆时，忽然间又想起了学校的事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00393",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然并不是想翘课的事，而是那家伙。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00394",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「唉，第二天就食言，真是有点对不起日下……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00395",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而不去学校对我来说是家常便饭，倒没有什么好在意的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00396",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我一边思考着这些，一边继续刷着油漆，然后……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00397",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
