            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "和妈妈告别以后，我回到了自己的房间。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00183",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "之后就听听广播什么的然后睡觉吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00184",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然没什么别的安排，即使知道这样不对，我也完全没劲头去做学校布置的作业。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00185",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……嘛，因为初中属于义务教育，退学是没法做到的……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00186",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，如果本人不去学校的话，实际上和退学也没什么两样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00187",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "即使现在我也只是不情不愿地去上学……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00188",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "最重要的是，父母辛勤工作的样子我从小时候起就看在眼里。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00189",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因此，我真心期望可以尽快将全部精力都投入到养老院的工作上。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00190",
            ),
        ),
