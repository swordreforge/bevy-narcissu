        (
            cmd: label,
            args: (
                name: "block_00055",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "比起这个，她所说的『去年也是同班』。这句话，让我大致掌握了状况。",
