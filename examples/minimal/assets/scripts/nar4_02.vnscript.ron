        ),
        (
            cmd: label,
            args: (
                name: "block_00309",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「怎么，有熟人吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00310",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，嗯，在医院里有见过几次」",
                voice: Some("li/n4yoko_0054"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00311",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为找到了熟人，她轻轻地挥手致意，老奶奶也同样向日下挥了挥手作为回应。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00312",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "没记错的话应该是住在205号房。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00313",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐，莳绘君，一直在这里帮忙做事吧？」",
                voice: Some("li/n4yoko_0055"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00314",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是啊。别看这样其实挺不容易的哦」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00315",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嘿～，比如说呢比如说呢？」",
                voice: Some("li/n4yoko_0056"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00316",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "日下眼睛闪闪发亮，兴致勃勃地看着我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00317",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过，还真是个独特的家伙。一般人对养老院的工作根本提不起兴趣的吧……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00318",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我一边这样想着，一边开始了简单的说明。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00319",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "………",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00320",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……………",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00321",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我大致讲解了一番。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00322",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "重点是告诉她，这是一份比公寓管理人更辛苦的工作。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00323",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不同之处在于，住户都是高龄人士，需要提供伙食，和家人分开独自一人住到这里。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00324",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "光是这几点不同，就让工作量大大的增加了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00325",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "况且不止说到的这类具体工作……\n反过来说，日常之中的鸡毛蒜皮的小事也都属于工作范畴。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00326",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，不知为何日下这家伙……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00327",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对这些无关紧要的事情，很高兴地不断点着头。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00328",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n4bg_002a",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「好了，现在满意了吧。你也赶紧回家去吧」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00329",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶，这么快？\u{3000}我明明才刚来……」",
                voice: Some("li/n4yoko_0057"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00330",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「和刚刚说的一样，我现在要去给家里帮忙了」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00331",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「好吧，我知道了啦」",
                voice: Some("li/n4yoko_0058"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00332",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "日下似乎心有不甘地回答到。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00333",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然不知道这些事儿有哪里吸引她，但我也不能，一直陪着她消磨时间。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00334",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，日下。明天见」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00335",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，嗯，莳绘君也是，绝对不能翘课哦」",
                voice: Some("li/n4yoko_0059"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00336",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「好好，我知道了」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00337",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
