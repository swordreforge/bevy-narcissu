        ),
        (
            cmd: label,
            args: (
                name: "block_00104",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「假如，你所亲近的人，身体慢慢渐渐虚弱的时候...」",
