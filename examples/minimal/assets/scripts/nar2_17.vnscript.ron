        ),
        (
            cmd: label,
            args: (
                name: "block_00093",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「...因为是你才想成为朋友的吧。」",
                voice: Some("li/hime1_0467"),
