        (
            cmd: label,
            args: (
                name: "block_00206",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「虽然以前要我不要去找了，但我觉得应该好好见一面啊」",
                voice: Some("li/np4imo_1114"),
            ),
        ),
        (
            cmd: label,
            args: (
