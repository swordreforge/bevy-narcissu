            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "７月。性急的知了的声音响起，梅雨期过了的天空。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00016",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么莳绘，明天见」",
                voice: Some("li/etcm1_1006"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00017",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，那就这样」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00018",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "和几个熟人打过招呼后，走出了大学。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00019",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……那之后过了三个月。也到了习惯了大学，适应了这里生活的时候。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00020",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一切都恰如其分地顺利进行着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00021",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一开始各方面觉得令人惊讶的东京生活，现在我也觉得已经习惯了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00022",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是，我心中的担忧也日益增长了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00023",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……今天那家伙，来了吗……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00024",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "边想着那些事，我给家里打了电话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00025",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "denwa_callr",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "嘟噜噜噜噜……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00026",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "tell_on",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你好，是莳绘家……」",
                voice: Some("li/np4imo_1097e"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00027",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「博美吗……是我呀，是博史」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00028",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，哥哥」",
                voice: Some("li/np4imo_1098e"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00029",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "听筒那边是妹妹。这几天，我同每天一样这样打电话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00030",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「然后呢，怎么样了？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00031",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「唔。今天也没有来呢……」",
                voice: Some("li/np4imo_1099e"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00032",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这样啊……那家伙，怎么了啊……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00033",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这里说的那家伙，当然是日下。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00034",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我刚刚到东京的时候，她偶尔还会在家里露脸……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00035",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这一个星期里，变得完全没人影了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00036",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，没有来自她那儿的联络，那家伙家里的电话也打不通。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00037",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「唔……之后，虽然也去过阳子的家里……」",
                voice: Some("li/np4imo_1100e"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00038",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……家里？然后怎么样？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00039",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯。谁都没在。不仅是阳子，叔叔和阿姨也……」",
                voice: Some("li/np4imo_1101e"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00040",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……难道说……住院了吗？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00041",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "是非常可能的事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00042",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从去年夏天开始，学校也常常请假，\n最重要的是，那家伙本来就不是那么身强体壮的人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00043",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果是住院的话，那家伙家里的电话联系不上也能想通。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00044",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「明白了，周末我也回去」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00045",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "kurodenwa_tin",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "结束和妹妹的通话，我变得越来越担心了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00046",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……尽管如此也联系一下啊……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00047",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明明本来就在意之前在车站分别的时候的事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00048",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对。在这个时刻，我还没想到那么严重。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00049",
