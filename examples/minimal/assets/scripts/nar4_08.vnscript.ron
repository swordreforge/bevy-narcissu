        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不管怎样，对于当初没能好好挽留的我……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00215",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对于没能说出我爱你的我，还有无视她的意愿去见面的权力吗……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00216",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，到底是不是像现在这样不见面为好，我也不知道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00217",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是一次又一次重复着同样的自问自答，直到现在。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00218",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "终于，在我不停地思考着这件事情时，",
                voice: None,
            ),
        ),
