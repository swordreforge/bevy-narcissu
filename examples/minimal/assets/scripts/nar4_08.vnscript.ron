        (
            cmd: label,
            args: (
                name: "block_00208",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着说着妹妹话语中便带起了哭腔，我无言以对。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00209",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……的确，我想正如妹妹所说。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00210",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然我也想，但这样做真的好吗……？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00211",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这个想法从以前开始就没有改变。我也没有一天不想和她见面。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00212",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这几年里，说不定哪天她会突然到来也曾做过这样的梦。",
                voice: None,
