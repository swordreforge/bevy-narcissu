            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "今天回到房间，我又翻开那本笔记本。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00177",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然并不是每天都能写日记，但现在偶尔还是会记上一笔。这也是曾经的规定。",
                voice: None,
