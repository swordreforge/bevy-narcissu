        ),
        (
            cmd: label,
            args: (
                name: "block_00178",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「现在，她在哪里，在做什么呢……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00179",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从以前开始身体就很弱。也知道她性格怕生。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00180",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "是在什么地方遇到困难了吗……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00181",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……到现在，我终于才明白。以医生为目标，\n在成为医生后的现在才能明白的一些事情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00182",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "曾经在养老院体会到的无力感，一直希望能做些什么的孩提时代。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00183",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，即便如此，我也不是为了养老院才当上医生的吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00184",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一开始，是为了成为那家伙的梦想而被拜托成为了医生……那也是刚开始的1年。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00185",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "经过2年、3年的岁月，渐渐明白了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00186",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一定，是因为和她的“联系”。和到现在还在继续写的日记一样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00187",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果把这些弄丢了，那家伙就好像会从我心中消失……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00188",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不是从其他人，而是从我心中消失的那种害怕。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00189",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……就好像，否定那家伙的存在本身的事，对我来说也许无法做到……",
                voice: None,
