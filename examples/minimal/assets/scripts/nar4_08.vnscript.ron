            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "培训的地方是同一所大学的附属医院。就那样自动进级了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00170",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然我自己也不是很清楚，但这……就是所谓的精英路线吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00171",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，也是受到了教授的帮助，并不是因为成绩出类拔萃。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00172",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是，不管经过如何，现在站在了能实际与患者接触的立场上。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00173",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……勉勉强强，这也算是医师里的小字辈了吧。",
