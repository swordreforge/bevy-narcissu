            cmd: label,
            args: (
                name: "block_00201",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这样啊。果然到现在，还在意着阳子的事情呢」",
                voice: Some("li/np4imo_1112"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00202",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我微微点头，停住手中的笔。虽说被别人看见了，但也并不会觉得害羞或是难为情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00203",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然并不是每天都写，但这样偶尔写写日记的事情妹妹也知道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00204",
            ),
        ),
        (
            cmd: set_bg,
            args: (
