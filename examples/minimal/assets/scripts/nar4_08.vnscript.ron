        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「人，从出生的瞬间开始，就是不平等的…………」",
                voice: Some("li/2n4yoko_0094"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00002",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "碰巧，我身体似乎很虚弱。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00003",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "有能够克服那种状况的人，也有没法克服的人。并不是谁的错。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00004",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但最大的问题……并不是我自身」",
                voice: Some("li/2n4yoko_0095"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00005",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「一定是，将我围绕起来的，身边的人吧」",
                voice: Some("li/2n4yoko_0096"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00006",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……重担。负担。并不像说起来这么简单。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00007",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「假如真的有神明的话，希望现在马上治好我……」",
                voice: Some("li/2n4yoko_0097"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00008",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果没办法做到的话，希望能杀了我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00009",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是，神哪个都没有选……」",
                voice: Some("li/2n4yoko_0098"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00010",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以，只能自己抉择。选项只有两个。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00011",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而对他，我能说的话……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00012",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……谢谢……」",
                voice: Some("li/2n4yoko_0099"),
            ),
        ),
