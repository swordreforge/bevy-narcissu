        (
            cmd: label,
            args: (
                name: "block_00174",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "成为了曾经在心中多次描绘的存在。成为了那家伙希望的样子……",
                voice: None,
