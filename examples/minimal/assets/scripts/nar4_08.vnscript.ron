            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "来访的是妹妹博美。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00194",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在，妹妹为了实现自己的梦想，在东京一家有名的美容院工作。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00195",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以，经常会像这样来我的住处看我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00196",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然彼此都很关心家里的事情，但现在还只是半吊子。\n我打算等到能独当一面的时候再回老家。",
                voice: None,
            ),
