        (
            cmd: label,
            args: (
                name: "block_00167",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "最初，我曾考虑过马上回故乡，但到现在还是留在了东京。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00168",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然并不是义务，但在大学的推荐下，我决定接受临床培训。",
                voice: None,
