            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呜，嘤嘤嘤，呜……」",
                voice: Some("li/np4imo_1115"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00220",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……博美？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00221",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "妹妹突然哭起来。从以前起就以开朗为长处一般的妹妹，第一次看到她那样哭泣。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00222",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「可、可是那本日记……\u{3000}只、只有哥哥一个人在写了不是吗……」",
                voice: Some("li/np4imo_1116"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00223",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「事、事实上，明明是交换日记……」",
                voice: Some("li/np4imo_1117"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00224",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00225",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……全都如妹妹所说。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00226",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "最开始的几页有那家伙的字迹……那之后，一直都是我一个人接着在写。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00227",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "简直就像是一种毫无成果的行为，妹妹哭泣的声音中带着几分寂寞。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00228",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是啊……\u{3000}也许是该好好见一面呢……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00229",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我轻轻拍打着她还在抽泣着的后背。不管有什么样的理由，不见面就不会开始。",
                voice: None,
