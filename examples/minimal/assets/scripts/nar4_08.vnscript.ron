        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶，那本是……」",
                voice: Some("li/np4imo_1111"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00200",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着她指向那本日记。我正好在写着。",
                voice: None,
