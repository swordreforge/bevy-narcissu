args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―几天后。早上开始下着的雨，不知何时变成了雪的日子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00314",
),
),
(
cmd: play_bgm,
args: (
id: "121",
volume: Some(0.78431374),
fade_ms: Some(500),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我一边注意着湿滑的路面，一边去往老地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00315",
),
),
