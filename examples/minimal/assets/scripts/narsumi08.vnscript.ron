),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "红色敞篷车再次出发。在还是蒙蒙亮的天色下，沿着笔直的道路前进着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "坐在副驾驶的菫，看着地图什么话也没有说。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00161",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "至今为止，虽然自认为已经与她接触很久了，但这样认真的表情还是第一次看到。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00162",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一会儿就看到了风穴洞入口的招牌。把车停在空荡荡的停车场，我们走了过去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00163",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看了下时间，凌晨4点半。理所当然的周围空无一人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后她翻过一个像是入口的小栅栏，接着向前走去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
