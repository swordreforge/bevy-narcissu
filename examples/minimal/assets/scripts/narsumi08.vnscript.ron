args: (
name: "block_00101",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在那里，一个路边立着的另外一个牌子映入了眼帘。\n上面写着想要阻止自杀者的一段话。",
voice: None,
),
),
(
