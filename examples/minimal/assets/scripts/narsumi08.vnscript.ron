),
),
(
cmd: label,
args: (
name: "block_00353",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "回头看去，是位不认识的身材娇小的女孩。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00354",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "手腕上戴着的塑料手环是绿色的。穿着粉红色的睡衣，留着长发，有点像菫。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00355",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「把这个，给她看看……」",
voice: Some("li/0snsetu_0049"),
),
),
(
cmd: label,
args: (
name: "block_00356",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着递到我手里的，是几束白色的花朵。感觉在哪看到过但不知道是什么花。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00357",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「只要……把这个给她看就行了？」",
voice: Some("li/0snaka_0443"),
),
),
(
cmd: label,
args: (
name: "block_00358",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯。因为告诉过她来得及……」",
voice: Some("li/0snsetu_0050"),
),
),
(
cmd: label,
args: (
