),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……一直都是这个样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知道什么时候起，连招呼都不打了。回过神来，我在班上已经被完全孤立了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后变得经常不去上学了。相对的，只有玩游戏的时间增加了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: set_bg,
args: (
image: "ns_11b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
