args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是那样继续玩游戏的我……\n什么也没能做到，什么也没留下，持续迷茫了10年的结果……",
voice: None,
),
),
(
