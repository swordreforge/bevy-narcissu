),
),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边看着地图，一边为她导着航。\n到了这里，只要不拐进什么奇怪的小路就没问题了吧。",
voice: None,
),
),
(
