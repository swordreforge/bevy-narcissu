),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……因为很麻烦。因为和人打交道特别烦人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这都只是借口……」",
voice: Some("li/0snsumi_0323"),
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "其实自己也知道。只是因为自己太内向而无法与人交流。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "比起跟谁处好关系，更多的只是在害怕万一被人冷漠对待而已……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
