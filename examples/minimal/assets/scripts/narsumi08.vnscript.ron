channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么样？还好吗？」",
voice: Some("li/0snaka_04232"),
),
),
(
cmd: label,
args: (
name: "block_00275",
),
),
(
