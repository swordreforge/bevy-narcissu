args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "东方天空终于开始泛白的时候。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们从树海回到了道路上，再次坐回了车内。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
