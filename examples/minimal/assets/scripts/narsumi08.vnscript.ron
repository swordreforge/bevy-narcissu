),
(
cmd: dialogue,
args: (
speaker: None,
text: "突然，说了这样的话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00053",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「其实，我也是有很多遗憾的……」",
