args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "静静的关上门，离开了病房。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00311",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "没错。这也是为了我能去闭上眼的世界所必须的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00312",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有着把所有的人情消除，变成什么也没有的状态……\n从一开始就将我的存在消除这样的义务……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00313",
),
),
(
cmd: set_bg,
args: (
image: "sora012",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
