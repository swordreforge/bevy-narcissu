args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……试一下吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00330",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我把那个小孩子玩的玩具手杖拿在手里，大大地挥了一下。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00331",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「去吧，heal，快起来吧，heal」",
voice: Some("li/0snaka_0436"),
),
),
(
cmd: label,
args: (
name: "block_00332",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「天赐祝福，医济，赶紧起来……这个笨女人……」",
voice: Some("li/0snaka_0437"),
),
),
(
cmd: label,
args: (
name: "block_00333",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不是牧师，也不是僧侣，也不是白魔导士，\n但我模仿着笨女人，咏唱着这样的魔法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00334",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……连作为赌上一生的高等级牧师的她都没有效果，我也明知道没有用……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00335",
),
),
(
cmd: dialogue,
args: (
speaker: None,
