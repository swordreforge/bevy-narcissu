channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―2周后。季节从晚秋变成了初冬。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00295",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一年的日历翻到了最后一页，街道上已经性急地传出圣诞歌的时候。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00296",
),
),
(
cmd: play_se,
args: (
file: "03_door_knock_02b",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "咚咚",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00297",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我进来啦……」",
voice: Some("li/0snaka_0429"),
),
),
(
cmd: label,
args: (
name: "block_00298",
),
),
(
cmd: set_bg,
args: (
image: "ns_33c",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
