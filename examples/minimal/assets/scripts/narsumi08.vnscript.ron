),
),
(
cmd: label,
args: (
name: "block_00374",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有听说过。虽然不知道具体长什么样，原来就是这花啊。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00375",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，那孩子为什么要把这花给菫呢？",
voice: None,
),
),
(
