),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这样的深夜，我们一边热闹地聊着天，一边欢笑着行驶着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00047",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……如果被不知情的路人看到我们现在的样子……",
voice: None,
),
),
(
