channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "前进了没多久，出现了一个空了个洞的岩壁。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
