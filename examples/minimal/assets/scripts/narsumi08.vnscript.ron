),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "之后又行驶了一会儿，明在一个比较空旷的地方把车停了下来。\n看了下时间，已经过了深夜1点了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00056",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "为了等到天亮继续出发，我们决定今晚就在这里过夜。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00057",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边吃着之前在便利店买来的饭团，一边在昏暗的车里度过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00058",
),
),
