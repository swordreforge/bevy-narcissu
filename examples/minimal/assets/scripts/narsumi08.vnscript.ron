channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我忽然抬头看去，看到的是夏季的星空。\n在没有顶棚的这辆车里，只要抬头就能看到满天的繁星。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00059",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正好西边的天空中出现了夏季大三角那美丽的身影，\n远处，格外明亮的天狼星也清晰可见。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00060",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "两人都单手拿着饭团，眺望着这样的星空。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00061",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我说，明……」",
voice: Some("li/0snsumi_0310"),
),
),
(
cmd: label,
args: (
name: "block_00062",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我死了之后，会变成什么样？」",
voice: Some("li/0snsumi_0311"),
),
),
(
cmd: label,
args: (
name: "block_00063",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「谁知道，大概会变成星星吧」",
voice: Some("li/0snaka_0393"),
),
),
(
cmd: label,
args: (
name: "block_00064",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……真的吗？」",
voice: Some("li/0snsumi_0312"),
),
),
(
cmd: label,
args: (
name: "block_00065",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「如果天堂更好的话，去那边也行」",
