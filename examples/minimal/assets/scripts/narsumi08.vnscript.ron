),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后在进入病房前，向阿姨询问了下情况。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00316",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「今天也还是一直在睡」",
voice: Some("li/0snhaha_0056"),
),
),
(
cmd: label,
args: (
name: "block_00317",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我明白了」",
voice: Some("li/0snaka_0422"),
),
),
(
cmd: label,
args: (
name: "block_00318",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "轻轻点了点头之后进入了她的病房。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00319",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然事前也多少听到了，每天清醒的时间已经越来越短了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00320",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我进来了……」",
voice: Some("li/0snaka_0429"),
),
),
(
cmd: label,
args: (
name: "block_00321",
),
),
(
cmd: set_bg,
args: (
image: "ns_33c",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
