args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我想去那个叫风穴洞的地方……」",
voice: Some("li/0snsumi_0332"),
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「欸……」",
voice: Some("li/0snaka_0407"),
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她打开地图，指着地图上离这里不远的一个点。如此说到。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这里不是目的地的吗……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
