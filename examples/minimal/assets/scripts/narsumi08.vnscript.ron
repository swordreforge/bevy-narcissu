args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她毫不犹豫地进入了漆黑的洞穴。我也踌躇了一下才为能了跟上她而进去了。",
voice: None,
),
),
(
