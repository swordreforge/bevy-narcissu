args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "病房里是静静睡着的菫。我尽量不发出太大的声音，悄悄地坐到了折椅上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00299",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「之前的那个网上学园啊，貌似很成功呢」",
voice: Some("li/0snaka_0430"),
),
),
(
cmd: label,
args: (
name: "block_00300",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「当然了，问题还是堆积成山，但是这次……」",
voice: Some("li/0snaka_0431"),
),
),
(
cmd: label,
args: (
name: "block_00301",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后将今天发生的事情，就像是自言自语一样地报告了一下。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00302",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "为什么要这样做，我自己也不知道。这样的行为有什么意义，我也不知道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00303",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……明明，我已经选择了闭上眼的世界了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00304",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "为什么现在还是像这样来到她的身边呢？偶尔，我会对自己如此问到。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00305",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明都规定了对任何人都不产生人情往来的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00306",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不对。对她，还欠了很大一笔账。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00307",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是为了还清这笔账，作为证人而来这里的。\n一直要见证到她离开人世的那天，证人的任务才算结束。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00308",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只有这样，才能还清这笔账……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00309",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，我还会再来的……」",
voice: Some("li/0snaka_0432"),
),
),
(
cmd: label,
args: (
name: "block_00310",
),
),
