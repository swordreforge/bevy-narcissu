),
),
(
cmd: label,
args: (
name: "block_00003",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "期中考试已经结束。为了从下周开始的游泳课，关注着学校泳装的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「早上好」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "早上。从教室响到了走廊里的声音。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我有点怕生的，打开教室门走了进去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
