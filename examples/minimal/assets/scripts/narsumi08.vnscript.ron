channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们从路旁踏入了树海。避开陡峭的坡面，往平坦的地方前进着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00113",
),
),
(
cmd: set_bg,
args: (
image: "bg_ju04",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "眼前是一望无际的树木。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00114",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "感觉就像是原始森林一样，完全不是人该来的地方，四周不见尽头。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00115",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为还有些昏暗，又起了点雾，视线很差。手电筒微弱的光芒，\n并没有起到太大的作用。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00116",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "毫不夸张的说，只是从路边往里走了3分钟左右，就已经找不到来时的路了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00117",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「菫，多注意点脚下比较好哦……」",
voice: Some("li/0snaka_0402"),
),
),
(
cmd: label,
args: (
name: "block_00118",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，嗯」",
voice: Some("li/0snsumi_0327"),
),
),
(
cmd: label,
args: (
name: "block_00119",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我偶尔会向走在前面的她搭话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00120",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不能忘了。不论她现在看起来多么有精神，也是7F的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00121",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不能因为现在看起来精神，就安下心来。更别说这里，是最接近死的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00122",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在变成自杀圣地之前……就连健全的，不想死的人都死掉过的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00123",
),
),
(
cmd: set_bg,
args: (
image: "2b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈——呼——……」",
voice: Some("li/0snsumi_0328"),
),
),
(
cmd: label,
args: (
name: "block_00124",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是有点喘不上气了吧，菫看起来有点痛苦。\n看了下时间，已经在树林里连续走了差不多20分钟了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "周围只有看起来差不多的树木。我也只能勉强分清进来的方向。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "倒不是因为日出前的昏暗而很难分清方向。\n恐怕就算太阳升起来了也不会有太大差别。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……到这附近已经是极限了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: set_bg,
args: (
image: "bg_ju04b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「菫，快停下来」",
voice: Some("li/0snaka_0403"),
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "做出这样判断后，我发出了制止的声音。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「姑且，给笨女人一个忠告……」",
voice: Some("li/0snaka_0404"),
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「在这里迷路的话，就回不去了」",
voice: Some("li/0snaka_0405"),
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这不是夸大其词。已经不能叫做迷路了，而是遇难了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈——我，我知道了……」",
voice: Some("li/0snsumi_0329"),
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "菫终于停了下来，调整着呼吸。她一边直直地看着昏暗的树林，一边回答到。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这里就是她想要的地方吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "既不是家里，也不是7F的地方。而且是最接近死亡，随时都能去死的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不对，不是能去死…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00138",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…是死掉的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "何况身为重病人的她，假如万一病情突然恶化的话，就谁都无计可施了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……如果到了这里，她还要继续前进的话……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "到那时候，我该阻止她吗？因为继续往前走和死是一个意思。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还是说，既然选择了当“证人”，就有着从始至终见证她的义务呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不一会儿……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: set_bg,
args: (
image: "2b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「谢谢。已经可以了……」",
voice: Some("li/0snsumi_0330"),
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "随着这番话，菫回过了头来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我只是想看看这里是个什么样的地方……」",
voice: Some("li/0snsumi_0331"),
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是吗……」",
voice: Some("li/0snaka_0406"),
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "放心地抚了抚胸口。对我来说，也并不想眼睁睁的看人死掉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "哪怕是选择了闭上眼的世界的我，那种事情也是一次就够了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
