),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「还以为是谁，原来是明啊……」",
voice: Some("li/0snsumi_0367"),
),
),
(
cmd: label,
args: (
name: "block_00276",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "菫用有些虚弱的声音，透过氧气罩回答到",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00277",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什么啊，这种好像很不满的语气」",
voice: Some("li/0snaka_0424"),
),
),
(
cmd: label,
args: (
name: "block_00278",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为你每天都来的嘛……」",
voice: Some("li/0snsumi_0368"),
),
),
(
cmd: label,
args: (
name: "block_00279",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为我也是病人嘛。很闲的」",
voice: Some("li/0snaka_0425"),
),
),
(
cmd: label,
args: (
name: "block_00280",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「明明是装病……」",
voice: Some("li/0snsumi_0369"),
),
),
(
cmd: label,
args: (
name: "block_00281",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "菫有些出言不逊地回答到。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00282",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但意识并不是一直都是像这样清醒的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00283",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还没有使用那么强力的点滴，现在基本是一半一半的。\n早上还很清醒，但到了晚上就意识蒙眬了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00284",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且似乎今后意识会变得更加微弱。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00285",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "几乎一整天都是睡着的，就算偶尔起来，也不是清醒的状态，\n据说能像“嗯”这样回答的就已经算好的了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00286",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "回过神来，状态越来越符合，7F的居民……这个称呼了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00287",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话说回来，你打算在这里来往到什么时候？」",
voice: Some("li/0snsumi_0370"),
),
),
(
cmd: label,
args: (
name: "block_00288",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那当然是到你死咯」",
voice: Some("li/0snaka_0426"),
),
),
(
cmd: label,
args: (
name: "block_00289",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对。既然成为了证人，这也是我的义务。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00290",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就算来我这……我也没什么能给你的哦」",
voice: Some("li/0snsumi_0371"),
),
),
(
cmd: label,
args: (
name: "block_00291",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什么吗？还打算给我全勤奖的吗？」",
voice: Some("li/0snaka_0427"),
),
),
(
cmd: label,
args: (
name: "block_00292",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「如果魔法手杖可以的话，就拿走吧……」",
voice: Some("li/0snsumi_0372"),
),
),
(
cmd: label,
args: (
name: "block_00293",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不要，那玩意又没效果。再说了，本来就是我给你的东西」",
voice: Some("li/0snaka_0428"),
),
),
(
cmd: label,
args: (
name: "block_00294",
),
),
(
