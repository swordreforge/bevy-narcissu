),
),
(
cmd: label,
args: (
name: "block_00342",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不知道是什么时候起来的，但是被看到羞耻的样子了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00343",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，比起生气和害羞，更多的是对隔了好久终于能说上话这件事而感到高兴……",
voice: None,
),
),
(
