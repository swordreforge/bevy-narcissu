),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在几乎没有什么车辆的道路上，\n向东行驶着的红色敞篷车。用炫目的车灯照亮了漆黑的柏油路。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "夏季已经结束但仍然闷热的夜晚。在这没有顶棚的车里，吹着晚风十分舒服。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00041",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，接下来是左转吧？」",
