),
),
(
cmd: label,
args: (
name: "block_00347",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯。那个，不是对我自己施的……而是施给你的」",
voice: Some("li/0snsumi_0378"),
),
),
(
cmd: label,
args: (
name: "block_00348",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……施给我的？会有什么效果啊？」",
voice: Some("li/0snaka_0442"),
),
),
(
cmd: label,
args: (
name: "block_00349",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「谁知道呢，还没知道到那种地步……」",
