),
),
(
cmd: label,
args: (
name: "block_00067",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "2人抬头看着星空，如此说到。看了下车内的时钟，已经是深夜2点了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00068",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "和妈妈已经联系过一次了。白天从家庭餐厅出来的时候借用了下明的手机。",
