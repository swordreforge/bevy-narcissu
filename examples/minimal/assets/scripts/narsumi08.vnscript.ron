),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "马上注意到了我手里的花瓶，如此问到。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00368",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「一个不认识的女孩说让我给你的」",
voice: Some("li/0snaka_0445"),
),
),
(
cmd: label,
args: (
name: "block_00369",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说什么来得及之类的……你的熟人吗？」",
voice: Some("li/0snaka_0446"),
),
),
(
cmd: label,
args: (
name: "block_00370",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，借给我地图的那个孩子……」",
