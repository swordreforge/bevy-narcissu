),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「之前说的魔法……那个，好像是我搞错了」",
voice: Some("li/0snsumi_0377"),
),
),
(
cmd: label,
args: (
name: "block_00346",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「搞错了？」",
