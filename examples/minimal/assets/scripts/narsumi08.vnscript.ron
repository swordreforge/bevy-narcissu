args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "病房里躺着今天也静静睡着的，她的身影。距离上一次对话，已经过去整整2天了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00322",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘿咻……」",
voice: Some("li/0snaka_0433"),
),
),
(
cmd: label,
args: (
name: "block_00323",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "和平时一样坐在旁边的折椅上。直到刚才她的家人还坐着的吧。还留有温度。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00324",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「菫……你差不多，真的要不妙了啊……」",
voice: Some("li/0snaka_0434"),
),
),
(
cmd: label,
args: (
name: "block_00325",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这样下去的话，好像连一个月都撑不下去了」",
voice: Some("li/0snaka_0435"),
),
),
(
cmd: label,
args: (
name: "block_00326",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我对睡着的她这样说着。也没有期待她能够回答。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00327",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "此时，魔法手杖忽然映入了眼帘。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00328",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "之前在富士山兜风时就中意上了的样子，直到现在，她还把它装饰在床边。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00329",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
