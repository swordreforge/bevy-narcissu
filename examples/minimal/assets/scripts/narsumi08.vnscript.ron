args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以玩起了游戏。游戏既不会背叛，也不会冷漠。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "高等级的无敌牧师宝矿力酱，和忠实支援着我的白石小姐都在。",
voice: None,
),
),
(
