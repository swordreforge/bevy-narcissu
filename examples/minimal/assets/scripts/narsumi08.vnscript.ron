),
),
(
cmd: label,
args: (
name: "block_00100",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "道路周围也没有特别设置栅栏，\n好像只要想去的话，从哪里都可以进入青木原树海。",
voice: None,
),
),
(
