),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "启动引擎，抓稳了方向盘。之后只需要原路返回就行了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不走错路的话，大概中午就能回到东京都内了吧。\n虽然发生了很多事，但应该能把她安全的送回家中。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正当我这样想着的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: set_bg,
args: (
image: "2b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
