        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "『假如想逃走的话，不要到Ａ车站去，而要到Ｂ车站去』",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00058",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "『什么也不要吃。这是最快的方法。\n同时也是减少家人负担的最佳方法』",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00059",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…全部，都是这类自己要面对的沉重话题。",
