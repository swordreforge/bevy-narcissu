        ),
        (
            cmd: label,
            args: (
                name: "block_00044",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，她继续解释说。",
