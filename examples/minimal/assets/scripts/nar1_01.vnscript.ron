        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果真的想逃的话明明随时都可以逃掉，\n但却依然留在这7楼的她。",
