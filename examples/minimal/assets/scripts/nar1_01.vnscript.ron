        (
            cmd: label,
            args: (
                name: "block_00049",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "也许在家里，又或者是在７楼。\n一定会在其中一处迎来死亡，没有谁能够逃脱这种命运。",
                voice: None,
            ),
        ),
        (
            cmd: label,
