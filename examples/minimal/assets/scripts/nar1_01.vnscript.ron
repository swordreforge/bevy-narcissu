        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我的目的地，不是Ａ车站，而是之前被告知的，较远的Ｂ车站。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00132",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我，并不是想逃出去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00133",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…７楼或是在家里…至今为止还没有人逃过在这之间死去的命运…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00134",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这是我之前听到的说法。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00135",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "并且，那个叫濑津美的女孩，似乎也多次去过Ｂ车站。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00136",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以，尽管不知道为什么，我忽然想去看一看那个地方。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00137",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「反正，也不会有监视员什么的跟着我吧…」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00138",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "尽管心里这样想着，但我们毕竟是７楼的居民。\n与其他的住院者多少有点区别。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00139",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我怀着…各种各样的猜测，走在晨光下那通往车站的道路上。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00140",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "侧视着急匆匆地赶路去上班或上学的人们，\n我慢悠悠地迈着步子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00141",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "w",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "２５分钟后，我终于来到了车站前。\n换算一下，走了相当于公交车大约４站路的路程。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00142",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…到处都是人啊」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00143",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这是我看到Ｂ车站后的第一感觉。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00144",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为穿在身上的睡衣，有些引人注目…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00145",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，只要在这里买一张列车票，\n我就可以毫无困难地，去到任何地方去了吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00146",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "尽管不明白她为什么不让我去Ａ车站，而是劝我来Ｂ车站。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00147",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，如果真的想逃出去的话，应该是轻而易举的事吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00148",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她应该也曾经来过很多次这里，\n那么，为何她至今还留在７楼呢…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00149",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "清晨的车站。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00150",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "望着那些来去匆匆的人们，\n我的心头，不禁生出了这个疑问。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00151",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "sora_yoru01",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这天夜里。熄灯时间过后。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00152",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对漫画书厌倦了，又没能入睡的我，\n一个人在医院里闲逛着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00153",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一般来说，在熄灯后闲逛的话，一定会被护士唠叨，\n但我们这些７楼居民在这一点上比较自由。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00154",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，熄灯之后的，一片漆黑的谈话室。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00155",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这里，我找到了她。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00156",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "danwa_yoru",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「唷，今天在看外边的风景吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00157",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…是的」",
                voice: Some("li/nv044"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00158",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在昏暗的房间里。尽管她回应了我。\n但依然在凝望着窗外。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00159",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "于是我立即，向她说起了今天的事情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00160",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对了…今天早上，我到车站去了哦」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00161",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「按照你的建议，到Ｂ车站去了」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00162",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是吗…」",
                voice: Some("li/nv079"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00163",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，她的语气还是与平时没什么两样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00164",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为以前她也去过几次，我本以为她会些不一样的反应…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00165",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这么说来，她之所以至今还留在这里，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00166",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "是因为，从一开始就没有逃出去的打算吗？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00167",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…我很快，就可以回去了…」",
                voice: Some("li/nv047"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00168",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「什么？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00169",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "突然开口的她。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00170",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "似乎就像是看透我心中疑问一般的回答。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00171",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…不过，再下一次就是第３次了…」",
                voice: Some("li/nv048b"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00172",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…也许再也见不到你了」",
                voice: Some("li/nv048_1c"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00173",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯…啊，这样吗…」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00174",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她所说的可以回去了，指的恐怕就是暂时出院吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00175",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这７楼中，\n出院入院的轮回，最多只有３次。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00176",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "特别是和老年人不同，考虑到病情的发展速度，\n像我们这样的年轻人病情恶化的速度更快。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00177",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以，她才会说或许不会再见面了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00178",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐，你会选择哪一边？」",
                voice: Some("li/nv049"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00179",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…选择什么？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00180",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…会选择在哪一边死去」",
                voice: Some("li/nv049_1b"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00181",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…………」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
