channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你怎么？\u{3000}在这种地方？」",
voice: Some("li/setsumi_0057"),
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「在等你喔，因为有想请你帮忙的事」",
voice: Some("li/hime1_0067"),
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完这句话，姬子就开始走了起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…到底是准备去哪里呢？看来不是大门，而是想去后门的样子…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "尽管不知道是什么事情，我还是跟在后面，",
voice: None,
),
),
(
