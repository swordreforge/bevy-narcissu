),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "来到的地方是医院的中庭。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在小型喷水池的四周，是时钟台和几个花坛。是我在住院时，也来过好几次的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…这里怎么了？」",
voice: Some("li/setsumi_0058"),
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，往那边看」",
voice: Some("li/hime1_0069"),
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: set_bg,
args: (
image: "black-2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "姬子的手指向的是花园的一角。\n大约有3个平方的样子吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，四周都种植着青草和鲜花，那一块区域却什么都没有种上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: set_bg,
args: (
image: "nakaniwa",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就是这样…锵！」",
voice: Some("li/hime1_0070"),
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这是什么？」",
voice: Some("li/setsumi_0059"),
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「球根喔，球根。\n现在我正打算种在这里呢」",
voice: Some("li/hime1_0071"),
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "姬子很是得意的，从手中拿着的塑胶袋中，把球根取出来拿给我看。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "数了一下，大约100株吧？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "的确两个人一起种的话，1小时大概就可以完成，不过我所在意的地方是。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…擅自种起来没问题吗？」",
voice: Some("li/setsumi_0060"),
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯？\u{3000}因为这块区域是冬天才用的地方啊」",
voice: Some("li/hime1_0072"),
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…我所询问的是，“擅自”的那部分」",
voice: Some("li/setsumi_0061"),
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没问题的，不会被骂的啦」",
voice: Some("li/hime1_0073"),
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样的回答是不能作是回答的，不过是冬天用的，\n也就表示说这花是冬天盛开的意思吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，正因如此，我也能理解要现在就种植的缘由了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，就算是这样说，和是否能随便在医院的花坛随意种植也联系不起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…还是说，7楼的病人，即使做出这样的事也都会被允许呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00035",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，我们开始吧，挖出大约１０厘米后把球根埋进去」",
voice: Some("li/hime1_0074"),
),
),
(
cmd: label,
args: (
name: "block_00036",
),
),
(
cmd: set_bg,
args: (
image: "black-2",
transition: Some(fade(
duration: 0.8,
)),
),
),
