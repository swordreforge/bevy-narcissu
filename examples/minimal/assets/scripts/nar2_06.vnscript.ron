),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个…这是什么花？」",
voice: Some("li/setsumi_0062"),
),
),
(
cmd: label,
args: (
name: "block_00049",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「水仙喔，知道吗？」",
voice: Some("li/hime1_0076"),
),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嗯，名字的话…」",
voice: Some("li/setsumi_0063"),
),
),
(
cmd: label,
args: (
name: "block_00051",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说是这样，也只记得花是白色的而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00052",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "开花的画面也只在电视和书里见过，像这样触摸到球根还是第一次。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00053",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，这个很少见喔，在这时节」",
voice: Some("li/hime1_0077"),
),
),
(
cmd: label,
args: (
name: "block_00054",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…这样吗？」",
voice: Some("li/setsumi_0064b"),
),
),
(
cmd: label,
args: (
name: "block_00055",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，本来应该是在夏天结束后才会有的」",
voice: Some("li/hime1_0078"),
),
),
(
cmd: label,
args: (
name: "block_00056",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后姬子告诉我各种各样的关于水仙的知识。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00057",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "学名是Ｎａｒｃｉｓｓｕｓ，属于石蒜科。\n以球根为主的水仙从开始种植，到开花所需时间长达数年。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00058",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说是在隆冬花坛的寂寥的时节，水仙那一枝独放的姿态，让人感觉凛然之美。",
voice: None,
),
),
(
cmd: label,
args: (
