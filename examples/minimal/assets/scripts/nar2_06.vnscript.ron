args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样说着，从放球根的袋子里，把搞园艺用的小铲子递给了我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00037",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…我最近身体状况还好，所以也没什么关系…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，姬子在这么热的天气里，这样做没问题吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00039",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我不由得开始担心起来，不过姬子本人，非常有干劲地在花坛里种植起球根来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "喳库喳库喳库喳库喳库喳库喳库喳库，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00041",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/setsumi_0127"),
),
),
(
cmd: label,
args: (
name: "block_00042",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "喳库喳库喳库喳库喳库喳库喳库，喳库喳库喳库喳库喳库喳库喳库喳库喳库，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…难不成，搞园艺也是她的爱好？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样想着，她的动作倒实在有够麻利。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对对，就是这种感觉，轻轻地把土埋上」",
voice: Some("li/hime1_0075"),
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嗯…」",
voice: Some("li/setsumi_0419"),
),
),
(
