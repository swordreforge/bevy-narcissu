),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明还只是上午，就已经有了仲夏的感觉。\n看来今天似乎也会很热的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00003",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这样的天气下，我和平常一样，前往步行3分钟就可以到达的医院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "手里拿着和平常一样的手提包。\n白底上印着黄色的向日葵。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "直到昨日都一成不变的夏天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不同的只有，手提包放着的，妈妈用心为我准备的便当而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
