),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "终于，季节变成了夏天……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00229",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶，哇，小猫逃跑了」",
voice: Some("li/n4yoko_0332"),
),
),
(
cmd: label,
args: (
name: "block_00230",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那里那里，在阳子背后」",
voice: Some("li/np4imo_1058"),
),
),
(
cmd: label,
args: (
name: "block_00231",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎～，哪里哪里？」",
voice: Some("li/n4yoko_0333"),
),
),
(
cmd: label,
args: (
name: "block_00232",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_002a",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
