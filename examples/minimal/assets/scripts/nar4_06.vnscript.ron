channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "除此之外，一到有事时日下……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00250",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「到外面去冲澡心情会很愉快哦」",
voice: Some("li/n4yoko_0337"),
),
),
(
cmd: label,
args: (
name: "block_00251",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这么提议着，在夏天特别热的日子里，在院子里铺设儿童游泳池。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00252",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为今天是大扫除，请大家也来帮忙——」",
voice: Some("li/n4yoko_0338"),
),
),
(
cmd: label,
args: (
name: "block_00253",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像这样，始终都在积极地活动着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00254",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这些几乎都获得了养老院老爷爷和老奶奶们的好评。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00255",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，每次我们的笔记本都填满了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00256",
),
),
(
cmd: set_bg,
args: (
image: "n4ime_005b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
