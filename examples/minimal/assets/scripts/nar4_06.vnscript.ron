),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶，哇，我说啊，不要当着面读呀」",
voice: Some("li/n4yoko_0289"),
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这内容也和以前一样没变呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
