args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "终于到了夜晚，当养老院的工作也都结束的时候，我像往常一样送她走夜路。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00367",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么样日下……普通的交往很难吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00368",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……嗯。抱歉，刚才说了自大的话」",
voice: Some("li/n4yoko_0360"),
),
),
(
cmd: label,
args: (
name: "block_00369",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没什么好道歉的哦。即便我，也只是习惯了那种场合而已」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00370",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹妹以前甚至有哭过的时候。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00371",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……时常有人到来，有人离去……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00372",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "连就好像按顺序等待着一样的，这个地方……也绝不是排队的顺序。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00373",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以不要和他们许下约定……不要有关联……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00374",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你知道的吧？\u{3000}那个规则？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00375",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……嗯……」",
voice: Some("li/n4yoko_0360_1"),
),
),
(
cmd: label,
args: (
name: "block_00376",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然我也觉得很凄凉，但没有其他办法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00377",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果借老爸的话说，从一开始对于生者和死者……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00378",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "离去的人和被留下的人就互不相容。彼此之间就如同矛盾的存在。",
voice: None,
),
),
(
