channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好了，下一个就轮到爷爷了哦」",
voice: Some("li/np4imo_1053"),
),
),
(
cmd: label,
args: (
name: "block_00212",
),
),
(
