args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是日下，对于房间里的扶手，我觉得还是稍微再考虑一下比较好」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「为什么？\u{3000}肯定是有比较好哦」",
voice: Some("li/n4yoko_0290"),
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯——，我虽然也不是坚决反对……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但在房间里面，好像还是尽可能凭自己的力量去运动比较好」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶～，这样吗？\u{3000}那就只在走廊里怎么样？」",
voice: Some("li/n4yoko_0291"),
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像这样，我们也经常谈论养老院的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "称为养老院的设施本身就还很少。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "恐怕其他地方也正在以摸索的状态运营着，我们也经历过很多失败的尝试。",
