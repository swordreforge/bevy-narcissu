args: (
speaker: None,
text: "「诶？」",
voice: Some("li/n4yoko_0324"),
),
),
(
cmd: label,
args: (
name: "block_00173",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「虽然怎么样都好，你肚脐露出来了哦」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00174",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶，哇，你，你为什么在这里」",
voice: Some("li/n4yoko_0325"),
),
),
(
cmd: label,
args: (
name: "block_00175",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不是，我是被阿姨硬逼着，留在了房间」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00176",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唔……那别突然就出现啊，很丢人呢……」",
voice: Some("li/n4yoko_0326"),
),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下脸变得红彤彤的，对我申诉着抗议。那种样子让人也觉得异常可爱。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话说你看，这是今天讲课的笔记」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶，啊……嗯，谢谢」",
voice: Some("li/n4yoko_0327"),
),
),
(
cmd: label,
args: (
name: "block_00180",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后我也边翻开笔记本，边口头讲述着今天上课的内容。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果遇到哪个人请假的时候，就要像这样辅导学业是规则。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00182",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶，对了，我想起来了」",
voice: Some("li/n4yoko_0315"),
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什么？\u{3000}忘了什么东西了吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个嘛，今天的日记，可以帮我加上笔记吗？」",
voice: Some("li/n4yoko_0316"),
),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这里说到的笔记，就是那本阳子备忘录。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不只是在日下自己写日记的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "每当她想起什么的时候，即使轮到我记日记也经常会像这样向我提出自己的主意。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: set_bg,
args: (
image: "n4ime_005",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，准备写什么好呢？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯——，在中庭里造个花坛」",
voice: Some("li/n4yoko_0317"),
),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……花坛？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "觉得并不是坏主意。煞风景的那个地方只是晾晒着洗过的衣服。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00192",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是啊，我们到现在，连养老院的事都忙不开，\n照顾花坛什么的做不到吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00193",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，不只是我们，让养老院的人们也来做吧？」",
voice: Some("li/n4yoko_0318"),
),
),
(
cmd: label,
args: (
name: "block_00194",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……让养老院的人也来做？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00195",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是，我不曾考虑过的想法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "至少我和老爸，从来都只把来养老院居住的人当做客人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00197",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "觉得他们不过是时常到来又时常离去的存在。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_011a",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你看，花儿看着便会让人心平气和，\n如果还能将花儿培育起来，总觉得……」",
voice: Some("li/n4yoko_0319"),
),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……会对未来充满期待？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00200",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嗯，就是这样」",
voice: Some("li/n4yoko_0320"),
),
),
(
cmd: label,
args: (
name: "block_00201",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「原来如此……也许不错呢」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00202",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "表面上这么评价道，但我内心稍微有点惊讶。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00203",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然日下她有点难以表述，我觉得对于那些人们来说，对未来充满期待……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00204",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "应该能重拾对将来的期望，也就是说，找到生存的意义。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00205",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
