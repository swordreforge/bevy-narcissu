channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个……打扰了」",
voice: Some("li/etcw1_1013"),
),
),
(
cmd: label,
args: (
name: "block_00348",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听到句话回头看，是一位年轻的女性。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00349",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "应该不到三十岁吧？\u{3000}感觉是个很冷静的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00350",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_001a",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「请问这里是，莳绘之家对吗？」",
voice: Some("li/etcw1_1014"),
),
),
(
cmd: label,
args: (
name: "block_00351",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，是的，今天和谁会面吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00352",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "大概是住在养老院里的谁的家人……这种情况大概是来找祖父或者祖母的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00353",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，家属的话，我去帮您叫人吧？」",
voice: Some("li/n4yoko_0357"),
),
),
(
cmd: label,
args: (
name: "block_00354",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，我是今天开始要入住这里的西川」",
voice: Some("li/etcw1_1015"),
),
),
(
cmd: label,
args: (
name: "block_00355",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶……」",
voice: Some("li/n4yoko_0358"),
),
),
(
cmd: label,
args: (
name: "block_00356",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一听到这句话，日下表情变得很僵硬。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00357",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "同样的，我也一瞬间惊呆了。因为还年轻，无论如何也看不出是要进入那个房间的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00358",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即使这样，我也不慌不忙，用冷静的语气回复。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00359",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么西川小姐，请让我介绍一下这里的设施，请进」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00360",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好的，请多关照」",
voice: Some("li/etcw1_1016"),
),
),
(
cmd: label,
args: (
name: "block_00361",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「日下，请帮忙给西川小姐拿一下行李」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00362",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嗯，嗯……」",
voice: Some("li/n4yoko_0359"),
),
),
(
cmd: label,
args: (
name: "block_00363",
),
),
(
