file: "sanpatu",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哇，博美，剪头发很拿手嘛」",
voice: Some("li/n4yoko_0329"),
),
),
(
cmd: label,
args: (
name: "block_00213",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我虽然不擅长做饭和洗衣服，这个可是很擅长哦」",
voice: Some("li/np4imo_1054"),
),
),
(
cmd: label,
args: (
name: "block_00214",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……学习什么的也不擅长吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00215",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂，哥哥，真多嘴」",
voice: Some("li/np4imo_1055"),
),
),
(
cmd: label,
args: (
name: "block_00216",
),
),
(
cmd: play_se,
args: (
file: "sanpatu",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "咔嚓咔嚓一边剪着养老院里老人们的头发，俩人一边聊天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00217",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「其实啊……我，梦想当个美容师」",
voice: Some("li/np4imo_1056"),
),
),
(
cmd: label,
args: (
name: "block_00218",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶，真的吗？」",
voice: Some("li/n4yoko_0330"),
),
),
(
cmd: label,
args: (
name: "block_00219",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就这样，这里就交给阳子了，和哥哥两个人要加油哦」",
voice: Some("li/np4imo_1057"),
),
),
(
cmd: label,
args: (
name: "block_00220",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊哈哈……嗯」",
voice: Some("li/n4yoko_0331"),
),
),
(
cmd: label,
args: (
name: "block_00221",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "居然肯定了，这家伙。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00222",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，却不知道有几分认真……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00223",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "假设目标是成为医生的日下，今后也继续在这里帮忙的话，\n没有比这更令人安心的事情了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00224",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算没有医疗设备，光是有具备资格和知识的人在这里就会有很大的不同。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00225",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……当然，这和日下是否是医生没有关系。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00226",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我想日下一定，在喜欢着我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00227",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且我也，喜欢着日下……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00228",
),
),
