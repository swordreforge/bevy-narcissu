(
cmd: dialogue,
args: (
speaker: None,
text: "然后，吃完晚饭，今天我们也开始一起学习。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00064",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「莳绘君真是，那里，又弄错了哦」",
voice: Some("li/n4yoko_0298"),
),
),
(
cmd: label,
args: (
name: "block_00065",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我不擅长英语啊」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00066",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话虽如此，历史不也不擅长吗」",
voice: Some("li/n4yoko_0299"),
),
),
(
cmd: label,
args: (
name: "block_00067",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你的话，数学也完全不擅长吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00068",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶，诶诶，嘛……啊哈哈哈……」",
voice: Some("li/n4yoko_0300"),
),
),
(
cmd: label,
args: (
name: "block_00069",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像这样，我们并排一起学习。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00070",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我也和以前一样，对学校啊学习啊都怎样都无所谓，但是陪伴着日下是目前的情况。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00071",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "到现在日下好像仍以成为医生为目标。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00072",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……话虽如此，也不知道这家伙认真到了什么程度……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00073",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，说着说着，已经到这个时间了……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00074",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "已经过了晚上八点了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00075",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然是常有的事，但如果弄得太晚了，她家的阿姨也会担心的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00076",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那我送你吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00077",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶～，还没关系哦，我还想帮忙做早上的准备」",
voice: Some("li/n4yoko_0301"),
),
),
(
cmd: label,
args: (
name: "block_00078",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不行。快，早点准备回去吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00079",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好——，知道了」",
voice: Some("li/n4yoko_0302"),
),
),
(
cmd: label,
args: (
name: "block_00080",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下十分不情愿地回答道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00081",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然很感激她一直以来帮家里的忙，但有些事情也得有个限度……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00082",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一不留神，甚至比起在自己家里的时间，在我们家的时间反而长一些呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00083",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "嘛，即使她家的阿姨也没有特别在意，甚至倒不如说是一副明朗而又喜悦的表情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00084",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，如果太晚了还是会觉得不好意思。",
voice: None,
),
),
(
