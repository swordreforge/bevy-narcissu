channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―阳子备忘录。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00257",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "每次，想到并尝试的事情……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00258",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "会有因为得到好评而把感想填满日记的时候，也会有将失败和反省填满日记的时候。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00259",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知不觉，由我们两个人开始记录的交换日记，\n也渐渐变成了记录这个莳绘之家的日志了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00260",
),
),
(
cmd: set_bg,
args: (
image: "b",
