args: (
name: "block_00380",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，欢迎回来」",
voice: Some("li/np4imo_1059"),
),
),
(
cmd: label,
args: (
name: "block_00381",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我回来了……呃，嗯？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00382",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看见桌子上，正摊开着几本像是笔记和教科书一类的东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00383",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……真稀罕呐，博美这家伙居然在学习。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00384",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难道开始补习了吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00385",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊哈哈，并不，不是那种事哦……」",
voice: Some("li/np4imo_1060"),
),
),
(
cmd: label,
args: (
name: "block_00386",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹妹不知为何有点害羞。仔细一看，刚刚认为是教科书的东西，也看起来像什么杂志。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00387",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你看，我呢，因为想要成为美容师」",
voice: Some("li/np4imo_1061"),
),
),
(
cmd: label,
args: (
name: "block_00388",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，这么说来，以前也说过呢……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00389",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「高中毕业以后，想升入专科学校」",
voice: Some("li/np4imo_1062"),
),
),
(
cmd: label,
args: (
name: "block_00390",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这样啊，要努力哦。哥哥也会为你加油的」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00391",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，谢谢」",
voice: Some("li/np4imo_1063"),
),
),
(
cmd: label,
args: (
name: "block_00392",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我也知道那意味着什么。即便现在养老院仍是人手不足。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00393",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，如果是抱着自己的梦想去努力的话，至少我不会反对。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00394",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不管怎样我是大哥，也想让妹妹能照自己的爱好去发展。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00395",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这么说的话，哥哥要怎么做呢？」",
voice: Some("li/np4imo_1064"),
),
),
(
cmd: label,
args: (
name: "block_00396",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……什么怎么做？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00397",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就是，未来志愿的事。\n因为明年就是高中二年级的学生了，也差不多该决定了」",
voice: Some("li/np4imo_1065"),
),
),
(
cmd: label,
args: (
name: "block_00398",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然确实如她所说……但我还完全没有考虑过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00399",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "即使是现在，也是因为和日下的交往才打算一起升学的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00400",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是我们明年，也将升入高二了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00401",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽说时间还充裕，也差不多是开始考虑去向的时候了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00402",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_009c",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这样说来，阳子准备升入大学对吧？」",
voice: Some("li/np4imo_1066"),
),
),
(
cmd: label,
args: (
name: "block_00403",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，虽然不知道认真到什么地步，但也似乎正以成为医生为目标呢」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00404",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯——，那哥哥也一起升学如何」",
voice: Some("li/np4imo_1067"),
),
),
(
cmd: label,
args: (
name: "block_00405",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00406",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为到现在为止一直都在一起嘛，是这么打算的吧？」",
voice: Some("li/np4imo_1068"),
),
),
(
cmd: label,
args: (
name: "block_00407",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，这个……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00408",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "老实说，我至今，还没考虑到妹妹讲得那么深。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00409",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然和那家伙像理所当然一样，一起生活着……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00410",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「或者说，有其他什么目标吗？」",
voice: Some("li/np4imo_1069"),
),
),
(
cmd: label,
args: (
name: "block_00411",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……目标？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00412",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯。也可以称之为梦想」",
voice: Some("li/np4imo_1070"),
),
),
(
cmd: label,
args: (
name: "block_00413",
),
),
(
