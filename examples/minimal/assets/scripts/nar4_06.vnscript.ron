(
cmd: dialogue,
args: (
speaker: None,
text: "不久太阳也落山了，天空中能开始看到星星闪亮的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00054",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听到了俩人喊着晚饭准备好了的声音。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00055",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我开动了——」",
voice: Some("li/n4yoko_0296"),
),
),
(
cmd: label,
args: (
name: "block_00056",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，日下理所当然般地和我们一同吃晚饭。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00057",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "现在连同自己和妹妹一种式样的碗和筷子都有了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00058",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，好次，昂子酱做的饭好次」",
voice: Some("li/np4imo_1047"),
),
),
(
cmd: label,
args: (
name: "block_00059",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「似这样吗？」",
voice: Some("li/n4yoko_0297"),
),
),
(
cmd: label,
args: (
name: "block_00060",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂，你们俩不要边吃边讲话」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00061",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「吼的——」",
voice: Some("li/np4imo_1048"),
),
),
(
cmd: label,
args: (
name: "block_00062",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像这样的情景也已经完全见惯了。",
voice: None,
),
),
(
