args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，比起那个，做做明天的准备之类的吧……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00267",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂博史，有点话跟你说」",
voice: Some("li/np4papa_1049"),
),
),
(
cmd: label,
args: (
name: "block_00268",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯？\u{3000}怎么了老爸？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00269",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "老爸非常罕见地用认真的表情叫我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00270",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「其实刚才接到了医院的联系……又要有新的人来了」",
voice: Some("li/np4papa_1050"),
),
),
(
cmd: label,
args: (
name: "block_00271",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「从医院来的……是住那个１０７号房间吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00272",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，这次病情似乎比往常的要更加不稳定呢」",
voice: Some("li/np4papa_1051"),
),
),
(
cmd: label,
args: (
name: "block_00273",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……不稳定吗。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00274",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "入住那里的人，全都是从医院介绍来的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00275",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那边补充道比往常更不稳定的话，情况应该相当严重吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00276",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这次，你先暂时跟在一边看看。其他的事情我们来做」",
voice: Some("li/np4papa_1052"),
),
),
(
cmd: label,
args: (
name: "block_00277",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「知道了……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00278",
),
),
(
