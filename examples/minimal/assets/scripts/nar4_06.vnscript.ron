),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于日下时不时提出的那些意见，很多时候我真心地感到佩服。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00206",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也许她是在如此认真地， 为这个养老院里的人们着想吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00207",
),
),
