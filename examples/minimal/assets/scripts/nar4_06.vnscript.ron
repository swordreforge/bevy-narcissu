channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如今，即便不再提及人行横道的岩浆，日下也会靠近我的旁边了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这些正逐渐成为理所当然的自然光景，今后也不觉得会有改变。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，仅有一件事和以往有所不同。",
voice: None,
),
),
(
