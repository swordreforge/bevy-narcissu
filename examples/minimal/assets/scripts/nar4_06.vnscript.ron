channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "第二天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00285",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_001a",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我在养老院的门口，等待着那个人的到来。\n所谓那个人，当然就是要入住１０７号房间的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00286",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊咧？\u{3000}怎么了莳绘君？\u{3000}在这种地方」",
voice: Some("li/n4yoko_0340"),
),
),
(
cmd: label,
args: (
name: "block_00287",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「日下啊……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00288",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "与往常一样，日下一大早就来了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00289",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "和你没有关系……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00290",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我欲言又止。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00291",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「今天，有新人要来……在等着迎接他」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00292",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶～，那也准备一下甜甜圈来招待他吧」",
voice: Some("li/n4yoko_0341"),
),
),
(
cmd: label,
args: (
name: "block_00293",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……不，没有那个必要」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00294",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「为什么？」",
voice: Some("li/n4yoko_0342"),
),
),
(
cmd: label,
args: (
name: "block_00295",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00296",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……这么说来，以前也有这样的事吧？」",
voice: Some("li/n4yoko_0343"),
),
),
(
cmd: label,
args: (
name: "block_00297",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下从不可思议的表情，转变为莫名奇妙的表情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00298",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我为了让她也明白，开始慢慢地说明。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00299",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前决定了不做相互隐瞒的事，也没有能够一直隐瞒下去的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00300",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这次来的人，是预定要进入１０７号房间的」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00301",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶，就是那间，一个人的房间吧？」",
voice: Some("li/n4yoko_0344"),
),
),
(
cmd: label,
args: (
name: "block_00302",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，其实那个房间，是临时出院的人专用的」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00303",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「临时出院？」",
voice: Some("li/n4yoko_0345"),
),
),
(
cmd: label,
args: (
name: "block_00304",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就是让正在医院住院的人，暂时性的回去」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00305",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶～，我还不知道。这里曾住着那样的人」",
voice: Some("li/n4yoko_0346"),
),
),
(
cmd: label,
args: (
name: "block_00306",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这种事情不知道是当然的」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00307",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为并不会一直都住在这里，\n而且即使是暂时的进来，也不会介绍给他人」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00308",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「为什么？」",
voice: Some("li/n4yoko_0347"),
),
),
(
cmd: label,
args: (
name: "block_00309",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00310",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于她的发问，我无话可说了。应该如何来说明呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00311",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并不是不能说明，而是不知道该如何告诉她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00312",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "终于，我决定如实告诉她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00313",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为他们长的一个月，短的三天，又会回到医院了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00314",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「而且，这样往复两三次以后……渐渐的就不再来了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00315",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，不来了，是什么意思？」",
voice: Some("li/n4yoko_0348"),
),
),
(
cmd: label,
args: (
name: "block_00316",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……大概，恐怕是在某个地方去世了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00317",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「某个地方……这种，好像与己无关的说法……」",
voice: Some("li/n4yoko_0349"),
),
),
(
cmd: label,
args: (
name: "block_00318",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这也没办法吧。\u{3000}因为我们，除此之外，想要知道也没办法啊」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00319",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这里并不是医疗设施。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00320",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "病人去医院，高龄的老人来这里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00321",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就像健康的人不用去医院一样，各自的归处已经决定。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00322",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并且，养老院的１０７号房间，是处于界线的场所。\n住在那里的人，也意味着是生活在界线上的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00323",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这是这里的……不，也是医院的规则。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00324",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以那个房间的人，会尽可能的，不想让其与外人接触」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00325",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……………………」",
voice: Some("li/n4yoko_0350"),
),
),
(
cmd: label,
args: (
name: "block_00326",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对于知道会死的人，应该谁都不会想去扯上关系吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00327",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这么说，就是装作没看见的样子？」",
voice: Some("li/n4yoko_0351"),
),
),
(
cmd: label,
args: (
name: "block_00328",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下的语气罕见地变得很严肃。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00329",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「视而不见吗……这么理解也对」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00330",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是啊日下，请好好想想。\n这里是住满了上了年纪的老人的养老院你能理解吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00331",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶……」",
voice: Some("li/n4yoko_0352"),
),
),
(
cmd: label,
args: (
name: "block_00332",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是啊。对象是，就算什么都不做对死亡的认知也很强烈的人们。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00333",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这样的年纪，有什么老毛病也不奇怪，像１０７号室那样的人就更加如此。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00334",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「并非因为是年纪大了所以大家都不怕死。\n而是尽可能地，想把死亡置于意识之外哦」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00335",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「年纪一大……能看到死的命数的人就更是如此了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00336",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以，就尽量不让其他人见到是吗？」",
voice: Some("li/n4yoko_0353"),
),
),
(
cmd: label,
args: (
name: "block_00337",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，我觉得这也是工作范围之内的事」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00338",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "至少我，是这样理解这里的……养老院的意义的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00339",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……但是，我还是觉得不太对……」",
voice: Some("li/n4yoko_0354"),
),
),
(
cmd: label,
args: (
name: "block_00340",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛。虽然我也会这么想的，但没有其他办法」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00341",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「而且，对一个已经能预见死亡的人，也不知道怎么交流比较好」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00342",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，虽然不是很清楚……我觉得像平常一样就可以了」",
voice: Some("li/n4yoko_0355"),
),
),
(
cmd: label,
args: (
name: "block_00343",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「平常一样？……要是能做到那个就不用费劲了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00344",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这么说是什么意思？」",
voice: Some("li/n4yoko_0356"),
),
),
(
cmd: label,
args: (
name: "block_00345",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什么意思，就是字面意思……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00346",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当我，在准备说完那句话的后续之前……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00347",
),
),
(
