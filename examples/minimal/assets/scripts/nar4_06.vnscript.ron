),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在那之后日下也对我提出了各种各样的建议。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00208",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，去帮他们理发怎么样？」",
voice: Some("li/n4yoko_0328"),
),
),
(
cmd: label,
args: (
name: "block_00209",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "边说着，边试着模仿理发师的动作。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00210",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且不知为何这个提案，妹妹博美也很感兴趣。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00211",
),
),
