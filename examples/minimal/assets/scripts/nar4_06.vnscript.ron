channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "目标……梦想。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00414",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹妹博美有将来的目标。虽然不知道认真到什么程度，但那个日下都有。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00415",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而对我来说，却想不出什么特别的目标。\n只是单纯地，觉得如果现在的日子继续下去也很好。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00416",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，对于未来的光景……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00417",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "想到这个最先浮现在脑海里的是日下的脸……",
voice: None,
),
),
