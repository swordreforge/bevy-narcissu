args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像这样，两个人正追着在中庭里跑来跑去的猫。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00233",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "注视着这个场景的我，手里抱着一只小秋田犬。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00234",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈呼，终于抓到小猫了」",
voice: Some("li/n4yoko_0334"),
),
),
(
cmd: label,
args: (
name: "block_00235",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，在习惯之前，最好就养在房间吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00236",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，那就和狗狗小屋一样起，也做个猫猫小屋吧？」",
voice: Some("li/n4yoko_0335"),
),
),
(
cmd: label,
args: (
name: "block_00237",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着日下抱起小猫朝我笑了笑。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00238",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这里养个猫和狗吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00239",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "刚听到这个提案的时候，我觉得她是不是在犯傻。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00240",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然我和妹妹都喜欢动物，到现在也想养。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00241",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……不过，谁来照顾它们呢？我们就连照看养老院都筋疲力竭了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00242",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，日下面对我的疑问……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00243",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没事儿，大家都来饲养哦」",
voice: Some("li/n4yoko_0336"),
),
),
(
cmd: label,
args: (
name: "block_00244",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "边往花坛里插上开好的花，边说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00245",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明想着“的确……”却心里有点不踏实，但实际养了动物之后，\n受到了养老院的人们的极大好评。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00246",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为大家都很疼爱它们，不留神就会发生饲料喂太多了，\n甚至结果有猫吃坏了肚子的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00247",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知不觉虽然没有谁说出口，饲料员也出现了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00248",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也正逐渐成为这个养老院的偶像般的存在。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00249",
),
),
(
cmd: set_bg,
args: (
image: "sora02",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
