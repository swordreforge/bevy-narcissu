args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不久，到了暑假即将结束的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00261",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听到的蝉鸣声，也从夏日清蝉变成了秋日寒蝉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00262",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，明天见～」",
voice: Some("li/n4yoko_0339"),
),
),
(
cmd: label,
args: (
name: "block_00263",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，晚安」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00264",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像往常一样送到家门口后，我和日下在玄关前告别。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00265",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "回想起来，那家伙在暑假期间，几乎每天，都来我家了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00266",
),
),
