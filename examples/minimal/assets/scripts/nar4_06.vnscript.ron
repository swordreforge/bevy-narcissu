),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "春天温和的阳光中，我们并肩走过道路两旁有樱花树的拱门。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "今天是从高中的开学典礼回来的时候。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "自从第一次见面以来，将近三年过去了，日下如今也依然陪在我身边。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……最终，我像配合她一样，升到了高中。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，这个……今天轮到莳绘君写了哦」",
voice: Some("li/n4yoko_0288"),
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「知道了啦」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，和她交换日记的规则如今依然维持不变。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前是用英语笔记本，现在换成了专用笔记本，已经写到第5本了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "老实说，因为我们几乎一直待在一起，就算记下今天发生的事情，似乎也没啥意义。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯——什么什么……昨晚很冷所以吃了汤豆腐」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为很好吃，所以一口气吃了两碗……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
