),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这个１０７号房间，不知道是出于什么样的原委而诞生的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00279",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只知道，它从我儿时起就已经存在，进入这里的都是通过医院的介绍。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00280",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "几乎都是，需要长期住院的人因姑且作为临时出院处理而暂居此处。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00281",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有些连亲人也没有，或者家人住在很远的地方……听说都是那样的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00282",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不知道从什么时候开始和医院有了那样的动向……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00283",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "医院一定是在站着医院的立场上考虑过之后，才会如此的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00284",
),
),
