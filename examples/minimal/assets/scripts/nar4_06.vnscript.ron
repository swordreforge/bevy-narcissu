channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后我们两个人就和西川小姐一起，介绍养老院的内部。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00364",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "电视厅、餐厅、然后是那个房间……大致介绍了一下。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00365",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这期间，日下一直保持着沉默……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00366",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
