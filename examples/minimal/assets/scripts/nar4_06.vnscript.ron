),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―阳子备忘录。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "“２０３号房间的爷爷，腰似乎不太好，所以在房间里加上扶手怎么样？”",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "“总觉得电视厅有椅子会比较好。对于年长的人，感觉长时间坐在榻榻米上会很累”",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……那是在日记下面的空白处，会写下的几行笔记。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知何时，日下开始写养老院的详尽的记录和感想……有时候也有建议。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是从什么时候开始的，我也记不起了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那不仅包含了物质上的建议，连精神方面的关怀也包含在了其中。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: set_bg,
args: (
image: "n4ev_003b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
