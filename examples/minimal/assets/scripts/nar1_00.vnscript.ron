channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "好不容易等到诊察结束了的样子，接下来却是胸透和血液检查。是被迫去检查的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，经过漫长的时间，静静的等待者……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00047",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知不觉，当我读完等候室的三本JUMP，向第四本伸手时，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00048",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就这样办理完了我的住院手续。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00049",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一直放在胸口的口袋里的，那张崭新的驾照。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看来暂时不会有使用到它的机会了。",
voice: None,
),
),
(
