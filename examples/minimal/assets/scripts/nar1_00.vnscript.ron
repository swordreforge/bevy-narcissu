),
(
cmd: dialogue,
args: (
speaker: None,
text: "咣当咣当、",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "刚好到了午后时间，车内尤其冷清。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这空旷冷清的车厢内，从考场出来的我开始了归途。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "左手握着刚刚收到的交规课本，胸前的口袋里揣着崭新的驾照。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我现在也算是有驾照的人了…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00035",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "认真地嘟哝着，却也并没有什么感慨。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00036",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我不是很想要开车。也并非有着什么其他的目的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00037",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是周围有很多人都去了驾校，而且他们经常劝我也去考一张驾照。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
