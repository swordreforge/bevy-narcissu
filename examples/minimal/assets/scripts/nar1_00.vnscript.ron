),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "新年过后，我再次回到了医院里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00082",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知为何，我并没有像以往那样被送到４楼，\n而是被带到了像谈话室一样的房间中。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00083",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，爸爸和医生反复地交谈着，\n我夹在他们中间只是一直在听着，听着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00084",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这就是所谓的 病危通知 吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00085",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "他们拐弯抹角地说了一大堆，归结起来就是。\n我似乎快要死了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00086",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是吗…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00087",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，我只简短地回答了一句。也没能想到其他可以说的话了。\n直到走出谈话室为止，我也只说了这一句话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00088",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听到我的回答，医生拿起圆珠笔开始写着什么。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00089",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "大概是转入关怀病房的手续吧。他始终是一副事务性的态度。\n父亲的态度也与他相仿。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00090",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…人的死，原来这么简单啊…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00091",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这是我发自内心的感想。",
voice: None,
),
),
(
cmd: label,
args: (
