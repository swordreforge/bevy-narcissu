args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在雨雪交加的天气，我回到了久违的家中。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00070",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不知道为什么，家人全都聚在一块。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00071",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明平时很少和我说话的父母，总觉得有点不自然地，笑着迎接我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00072",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "平日里没少和我拌嘴的妹妹，也做好了我最爱吃的奶油炖菜和炸虾排。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00073",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "大家一起围坐在被炉边。抢着为我剥橘子皮。\n那异乎寻常的照顾。留给了我很深的印象。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00074",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这时…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00075",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我隐约察觉到了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00076",
),
),
(
