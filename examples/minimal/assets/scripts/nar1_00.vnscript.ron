),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "隆冬时节。当街头巷尾的圣诞气氛终于消散殆尽的时候，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00067",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "大概是因为到了年末了吧，我被允许回家了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00068",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然这也只是暂时的。即便如此我还是感到了一丝喜悦。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00069",
),
),
(
