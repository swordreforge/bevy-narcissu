            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嘿咻。」",
                voice: Some("li/hime1_0325"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00156",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，用毛巾擦拭着湿透的脚，在我旁边坐了下来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00157",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…那么，又到了高潮的地方了呢…」",
                voice: Some("li/hime1_0326"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00158",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "和说的话相反，她用着很平稳的语气。\n面对着从刚刚开始就默默不语的我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00159",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「可以喔，有很多吧？想问清楚的事。」",
                voice: Some("li/hime1_0327"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00160",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…嗯。」",
                voice: Some("li/setsumi_0246"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00161",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "umi12b",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "轻轻点头后，我慢慢地开口了。\n从以前开始就有很多事情想问姬子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00162",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「听到会死的时候…有哭吗？」",
                voice: Some("li/setsumi_0247"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00163",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，有点吧…」",
                voice: Some("li/hime1_0328"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00164",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，有怨恨过为什么偏偏是自己吗？」",
                voice: Some("li/setsumi_0248"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00165",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「唔，这个问题有些难回答啊…」",
                voice: Some("li/hime1_0329"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00166",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那我反过来问你吧。」",
                voice: Some("li/hime1_0330"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00167",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…要…怨恨谁呢？」",
                voice: Some("li/hime1_0331"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00168",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「唉？」",
                voice: Some("li/setsumi_0249"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00169",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…我不知道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00170",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "没料想到她会这样反问我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00171",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「怎么说呢…如果神明真的存在的话，大概是有怨恨过的吧。」",
                voice: Some("li/hime1_0332"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00172",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…明明是＂原＂天主教徒，却不相信神的存在吗？」",
                voice: Some("li/setsumi_0250"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00173",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不，相信着喔，就算是＂原＂天主教徒也会相信的啦。」",
                voice: Some("li/hime1_0333"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00174",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「恐怕神明是存在的吧…」",
                voice: Some("li/hime1_0334b"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00175",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不过啊，看来很忙呢，那个叫神明的。」",
                voice: Some("li/hime1_0335b"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00176",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「还是说…只是，他毫不在意这些呢…」",
                voice: Some("li/hime1_0336b"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00177",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "umi12b",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "姬子好像自言自语似的继续说着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00178",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她被月光所映照着的那张脸庞，看起来有点寂寞，像是看透了什么一样。",
                voice: None,
