        ),
        (
            cmd: label,
            args: (
                name: "block_00180",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你，有听过佛兰德斯的狗吗？」",
                voice: Some("li/hime1_0338"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00181",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…佛兰德斯的狗？」",
                voice: Some("li/setsumi_0251"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00182",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，因为很有名所以应该知道吧。」",
                voice: Some("li/hime1_0339"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00183",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，知道一点…」",
                voice: Some("li/setsumi_0252"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00184",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对于突然出现的词汇，我点了点头回答着。\n似乎小的时候有在动画重播里看过。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00185",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "记得是，失去家人的，小孩尼洛和他的狗帕奇的故事吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00186",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「尼洛，帕奇和阿洛伊斯…」",
                voice: Some("li/hime1_0340"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00187",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…你想成为谁？或是说，你不想成为谁？」",
                voice: Some("li/hime1_0341"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00188",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…结局最后死去的尼洛和帕奇。",
                voice: None,
            ),
        ),
