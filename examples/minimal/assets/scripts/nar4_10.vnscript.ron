),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―几天后。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "再次回到金泽后，突然，被事务局长叫去了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "到底是什么事呢，我来到那里，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: set_bg,
args: (
image: "234",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "事务局长：「恭喜啊莳绘君」",
voice: Some("li/etcm2_1024"),
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "事务局长：「之前那个项目来联系了，说希望你也能来哦」",
voice: Some("li/etcm2_1025"),
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶……真的吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "事务局长：「而且，意思是希望在你的主导下行动」",
voice: Some("li/etcm2_1026"),
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我来主导……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不由自主地复述出来，还一时间无法相信。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还以为最多会当个观察员之类的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "事务局长：「哎呀，这个年纪就当首席领导，不愧是东京的精英呢」",
voice: Some("li/etcm2_1027"),
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不……和精英没关系哦」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "考虑到临终关怀本身还是在摸索状态下开始的……\n也可能会出现这种有挑战性的人事任命的情况。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00161",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也包含了那位医疗部长和教授的一番决心吧。也许还有作为先驱者的智慧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00162",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是这全都是她的笔记……那本阳子备忘录的功劳。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00163",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
