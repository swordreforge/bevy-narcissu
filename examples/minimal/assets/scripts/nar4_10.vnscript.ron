),
),
(
cmd: label,
args: (
name: "block_00176",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "面对这句疑问，我重重地点头。不是其他人，必须是日下。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……而且如果是她的话，一定能理解的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果是，曾经像每天那样为养老院的事热心地考虑……\n持续不断地写下无数本阳子备忘录的她的话……",
voice: None,
),
),
