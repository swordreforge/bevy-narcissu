),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "接下来要安排的，是片什么都没有的宽敞空间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00222",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从诊室的位置关系考虑，等候室……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00223",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不，这种场合下，应该是被称为谈话室的地方吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00224",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这里，你怎么想？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00225",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这里的谈话室，大概需要电视……」",
voice: Some("li/n4yoko_0504"),
),
),
(
cmd: label,
args: (
name: "block_00226",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊。在养老院也是聚集人最多的地方呢」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00227",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「也要多放些桌子和椅子比较好」",
voice: Some("li/n4yoko_0505"),
),
),
(
cmd: label,
args: (
name: "block_00228",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这大概会成为与亲人相聚的地方，她补充道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00229",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "确实以收容晚期患者为前提的话，需要尽可能多的椅子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00230",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也有可能，匆忙赶来的亲人会需要在这里过夜。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00231",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果是远方的亲戚和朋友的话便更是如此。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00232",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……因为，这也与以前养老院的情况类似，\n因为我和日下有过痛苦的回忆，更加觉得必要。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00233",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「有其他注意到的地方的话，请全都说出来」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00234",
),
),
