),
),
(
cmd: label,
args: (
name: "block_00251",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……当然，在美国的论文里也提出了此举的效果，我和医疗部长也都知道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00252",
),
),
(
cmd: dialogue,
args: (
speaker: None,
