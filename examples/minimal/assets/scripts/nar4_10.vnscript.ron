),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你来了啊，莳绘君」",
voice: Some("li/etcm2_1028"),
),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「久疏问候了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "跑到面前的是前些天的医疗部长。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00192",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「现在门诊和普通病房已经开始运作了，\n那个临终关怀院，会在此后不久诞生」",
voice: Some("li/etcm2_1029"),
),
),
(
cmd: label,
args: (
name: "block_00193",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我……不，我们该做什么比较好呢？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00194",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「全部。还请把它当作一张白纸」",
voice: Some("li/etcm2_1030"),
),
),
(
cmd: label,
args: (
name: "block_00195",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「目前决定的，仅仅是使用最上层的７楼整个楼层」",
voice: Some("li/etcm2_1031"),
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……这么大的医院的一整个楼层……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00197",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "远远比我想象中大。我以为最多也就是一间四个床位的病房。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果是这样的规模，毫无疑问会是国内最大的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，并不是小小的私人医院，作为综合医院考虑的话……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00200",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这里，也是国内最初的举措吧。能看出这次他们也是认真的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00201",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「总之，不管有什么事都请提出意见」",
voice: Some("li/etcm2_1032"),
),
),
(
cmd: label,
args: (
name: "block_00202",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「明白了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00203",
),
),
