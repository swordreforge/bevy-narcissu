),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算，改变是自然的安排……就算，总有一天会消失是世界的真理……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……也想，留下什么证明。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "或许，这只是我一个人的自私，但是那样也没关系。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下，对我来说无可替代的人，曾经存在过……我想留下那样的证明。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00047",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "转瞬而逝的时间里，这重复着诞生、消亡的世界上……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00048",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……想留下确实存在过的证明……",
voice: None,
),
),
(
