),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这里房间的具体分配还没决定……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00255",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不管怎么说，考虑到这一层楼全部要用来做临终关怀院，\n不让无关人员进入会比较好吧？",
