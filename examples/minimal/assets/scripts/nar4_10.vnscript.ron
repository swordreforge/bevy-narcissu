voice: None,
),
),
(
cmd: label,
args: (
name: "block_00210",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这里的地板还是临时瓷砖，墙壁也是油漆前的状态。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00211",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，日下……你怎么想的？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00212",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，我指向还停留在混凝土浇筑完后的内墙。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00213",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「虽然马上打算进入内部装修……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00214",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我可能更喜欢白色的墙壁和天花板。」",
voice: Some("li/n4yoko_0501"),
),
),
(
cmd: label,
args: (
name: "block_00215",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「可是那样不会煞风景吗？完全就是在医院的感觉……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00216",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，太华丽的话就不安心了……」",
voice: Some("li/n4yoko_0502"),
),
),
(
cmd: label,
args: (
name: "block_00217",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「相应的，有很多绘画和花做装饰会比较好……」",
voice: Some("li/n4yoko_0503"),
),
),
(
cmd: label,
args: (
name: "block_00218",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「原来如此……知道了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00219",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我回应着，记在笔记上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00220",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，无论多么细小的事情都会向她过问。",
voice: None,
),
),
(
