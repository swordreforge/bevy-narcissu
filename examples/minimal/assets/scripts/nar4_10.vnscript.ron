args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这里，也稍微有点改变了呢……」",
voice: Some("li/n4yoko_0486"),
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是啊……已经变了呢……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "两个人感慨地细语，眺望着海。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "远远的海面上，可以能看到从前没有的护堤水泥四脚砌块。\n再往前是延伸到远处的防波堤。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这片沙滩只有这一部分，勉勉强强地，和那一天一样未曾改变保留了下来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "未来有一天，这里也会变成填海造出的地吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "此刻，眼前展现的，这美丽又怀念的景色，又会变成别的东西了吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是，改变是自然的安排。曾经存在的东西，会坏掉，会改变，总有一天会消失。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "任何人、任何事物，也许都无法逃离，也无法避免……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「偶尔啊……会忽然想到」",
voice: Some("li/n4yoko_0487"),
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "沉默地望着大海的日下，断断续续地开口说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就算是这样的我，是否也有诞生在这个世界的价值呢」",
voice: Some("li/n4yoko_0488"),
),
),
(
cmd: label,
args: (
name: "block_00035",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂……不要突然说凄凉的话哦」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00036",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不。可我现在觉得是有的哦」",
voice: Some("li/n4yoko_0489"),
),
),
(
cmd: label,
args: (
name: "block_00037",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为只要莳绘君成为了，这样出色的医生就足够了」",
voice: Some("li/n4yoko_0490b"),
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……日下……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00039",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「现在的我，可能已经连炸甜甜圈这种事，都做不到了……」",
voice: Some("li/n4yoko_0491"),
),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……如果，还有什么可以做的事的话请告诉我哦」",
voice: Some("li/n4yoko_0492"),
),
),
(
cmd: label,
args: (
name: "block_00041",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，又朝我露出往常的笑容。在这怀念的地方，她露出怀念的表情，说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00042",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……在这个，我们之间的第一个规则诞生的地方……如那一天一般，对我笑着……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
