args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我立刻，奔往她的身旁。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只有我是办不到的，这正是我们两人，从还是孩子的时候就开始考虑的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
(
cmd: set_bg,
args: (
image: "n4ev_008",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「日下……\u{3000}这次，我将要协助成立临终关怀院（Hospice）了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: set_bg,
args: (
image: "n4ev_0082",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
