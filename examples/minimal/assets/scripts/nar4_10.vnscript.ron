args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "绿色跑车迎风奔驰。沐浴初夏的阳光，在国道上笔直地前进着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00003",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「很凉爽，很舒服吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，而且车很酷呢」",
voice: Some("li/n4yoko_0482"),
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不时地，我朝坐在旁边座席的她搭话。目的地，是以前经常去的那片海边。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为从金泽这里出发，要花几个小时，于是我向同事借了车。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……从那以后，我考虑了很多。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于这家伙，我能做些什么吗？什么都行，有什么可以给她带来快乐吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "剩下的半年能做些什么呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果……我是万能的神明的话，现在立刻就让她好起来。\n如果……我是万能的医生的话，现在立刻就让她好起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……然后，对更广阔的未来许下约定。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但我哪个都不是……但是，是超越那些的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，即使这样我也竭尽全力了……已没有其他能做到的事了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
