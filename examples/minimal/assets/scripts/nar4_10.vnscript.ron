args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就如同那一天一样，日下站在岸边。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "吹着海风，让长发随风飘动……每当浪潮拍岸就会露出一副开心的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，莳绘君不一起来吗？」",
voice: Some("li/n4yoko_0484"),
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说什么啊，再摔一跤我可不管哦」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真是的，又说那么失礼的话」",
voice: Some("li/n4yoko_0485"),
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: play_se,
args: (
file: "anami2",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "太阳当空。面前传来波涛的声音，传来潮水的气味。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……像这样两个人再次来这里，到底隔了多少年呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那个时候我们几乎每天都会经过海边，然后并排坐着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: set_bg,
args: (
image: "umibe",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
