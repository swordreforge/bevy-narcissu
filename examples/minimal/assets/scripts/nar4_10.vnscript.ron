args: (
speaker: None,
text: "就这样，我们一点一滴地构筑起基础平台。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00236",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "其他关于医院就餐和普通一样，基本上吃什么都能自由选择。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00237",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还有探视时间也是，希望这里２４小时都没问题。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00238",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，日下不知道医疗中的专业知识。作为新手医生的我也没强多少。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00239",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是，因为这里并不是以医疗为主要目的，也是一处精神关怀的场所……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00240",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以那种……理想的”等候室”为目标的话，我们能做的事也能有一大堆。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00241",
),
),
