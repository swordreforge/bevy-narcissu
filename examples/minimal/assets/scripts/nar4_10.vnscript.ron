args: (
name: "block_00246",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「宠物吗……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00247",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看来日下除了有建花坛的想法，还提出了养宠物的方案。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00248",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "确实养老院也放养了宠物，也得到了养老院的人们的好评……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00249",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，那个想法可能有点困难。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00250",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不管怎么说，这里是医疗设施。不仅要注意细菌传播，还必须经常清洁。",
