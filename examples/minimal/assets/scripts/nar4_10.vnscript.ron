),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，单从施工中的停车场来看，应该还处在正式营业之前吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……不仅是临终关怀院，从今开始也会作为医院开设吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边想着，我推着日下的轮椅朝里面走去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
