args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……Hospice？」",
voice: Some("li/n4yoko_0496"),
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，也被称为终末期护理……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我解释道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……那，既是医院，同时又不是医院。当然也不是像养老院那样的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有医疗设施，但同时又不是以治愈和延长寿命为优先……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00171",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那意味着，比起死亡的事，重点考虑的是……在去世之前如何活着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00172",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这个，难道说是……\u{3000}以前我们说过的……」",
voice: Some("li/n4yoko_0497"),
),
),
(
cmd: label,
args: (
name: "block_00173",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对。\u{3000}与我们以前，在养老院讨论过的东西类似」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00174",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「虽说如此，还处在摸索的阶段……希望得到你的协助」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00175",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……我？\u{3000}我的？」",
