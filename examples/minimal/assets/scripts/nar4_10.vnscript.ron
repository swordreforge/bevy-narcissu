),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……国内最初的，最大的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00204",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不仅如此，了解有关终末期医疗的人还很少。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00205",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算是医生，能清楚理解的人也不多，至于普通人则完全一无所知。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00206",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……因为如此，在这里形成的模式，会有极大的可能成为今后临终关怀制度的标准。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00207",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "和以前在养老院的时候一样，正因为还是摸索阶段才更加如此。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00208",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我理解了从现在开始要做的事情的重要性。",
voice: None,
),
),
(
