args: (
speaker: None,
text: "―自己也是想要成为开设临终关怀服务的工作者―",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00109",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我单刀直入地表达了想要做临终关怀工作者的意愿，\n对方既不是特别生气，也不是过于吃惊的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00110",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不愧是，希望尽早致力于终末期医疗的人们才有的事情。\n即便对于像我这样的年轻人，他们也郑重地回应了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00111",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「老实说，作为我们，也只能从现在开始摸索」",
voice: Some("li/etcm2_1016"),
),
),
(
cmd: label,
args: (
name: "block_00112",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "教授：「虽然我知道你成绩很优秀……」",
voice: Some("li/etcm2_1017"),
),
),
(
cmd: label,
args: (
name: "block_00113",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "教授：「只有这次打算给欧美国家的有经验者的人，\n和国内经验丰富的医师团体来组织。」",
voice: Some("li/etcm2_1018"),
),
),
(
cmd: label,
args: (
name: "block_00114",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这应该是最合适的考虑。如果我站在医疗部长或教授的立场的话，也会讲同样的话吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00115",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不管怎样，现在不仅是患者连医生这边，能理解关于临终关怀的人都很少。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00116",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「关于那个对于患者的提案，我们再积极探讨吧」",
voice: Some("li/etcm2_1019"),
),
),
(
cmd: label,
args: (
name: "block_00117",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，新手医生是不行的。正因为是摸索，交给更有实际成果的人更合适」",
voice: Some("li/etcm2_1020"),
),
),
(
cmd: label,
args: (
name: "block_00118",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……两个人的主张是正确的。虽然能够理解，但不能就此退缩。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00119",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「确实，我作为医生是新手……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00120",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，一定也有很多能帮上忙的事」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00121",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对。从记事起就到了养老院，这段经历一定不会没有用的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00122",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……曾经，在那个不是医院也不是家，而被叫做等候室的地方，\n如果是一直照看着那里的我和那个家伙的话……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00123",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还是新手医生，却感到有很多和曾经从事家业时经验重叠的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00124",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然如此……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "教授：「确实，你老家是经营养老院的吧……」",
voice: Some("li/etcm2_1021"),
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "教授：「终末期护理是医疗行为……这方面和民间看护是不一样的」",
voice: Some("li/etcm2_1022"),
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，教授断然否定了我那样的想法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从父亲那儿反复听过的，养老院不是实施医疗行为的场所的观点，在此刻也被重复着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我确实认同养老院并不是医院。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，终末期医疗也并不能等同于医院吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正是因为曾经在养老院体会过的无力感，才会更想让它成长为力量……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "为了留下那家伙的证明，我觉得这是最好的机会……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么至少……请看一下这个」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: set_bg,
args: (
image: "n4ime_005c",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，我把那本笔记本……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "把她一直写了好几年的，阳子备忘录递了过去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这里，应该会有很多值得学习的内容」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00138",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "教授：「……这个，是什么？」",
voice: Some("li/etcm2_1023"),
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是我……不，两个人一直在写的日志」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完，我离开了那里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_0054",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边轻声叹气，回到走廊。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "时隔几年来到附属医院，人满为患的门诊接待处给人留下了深刻的印象。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是的。从一开始就知道根本不行，但还是前来应募工作人员了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算有从记事开始在养老院的工作经验，客观来讲，我还是一位新手医生。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，就算我们不能参加的话……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但至少，哪怕是一点点，能将她的日记有效利用起来的话，那就满足了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
