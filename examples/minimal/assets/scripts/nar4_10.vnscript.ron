args: (
name: "block_00242",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "除了在里边有一处小小的教会礼拜堂，这里其余什么都没有。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00243",
),
),
(
cmd: dialogue,
args: (
speaker: None,
