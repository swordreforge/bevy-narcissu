args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……燃烧的教会。沾满鲜血，所有人都在这里被屠杀。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00438",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "最后放火离开的时候，我身边只剩下十多名士兵残存下来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00439",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且基本没有可以正常行动的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00440",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "基本都是受了伤的，能否平安回国还是未知数。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00441",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「（……但是，这次的目的应该已经达成了）」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00442",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "按指示，教会里面的人全部杀掉了。\n虽然不想这么做，但守护里面那些人的骑士们也一并杀掉了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00443",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "………不，并不是全部。有一个人是例外的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00444",
),
),
(
cmd: set_bg,
args: (
image: "3014b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「做得好约翰， 祖国的大主教肯定会很高兴吧」",
voice: Some("li/npetcm37_045"),
),
),
(
cmd: label,
args: (
name: "block_00445",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边说着，辅祭笑着迎接我的时候。\n跟满身是血的我不同，他那干干净净的僧衣给我留下很深的印象。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00446",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是……我们的伤亡也很大了……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00447",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「别在意，这次最大的功劳还是你的。教会肯定会把你推荐为名誉骑士的」",
voice: Some("li/npetcm37_046"),
),
),
(
cmd: label,
args: (
name: "block_00448",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，拍了拍我的肩膀，少有的露出白色牙齿，爽快地笑了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00449",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "想想看都知道，像我这种人一般根本不可能当得到名誉骑士。\n这也对大主教来说是有利可图的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00450",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……嗯？ 说起来，约翰，这位修女是谁？」",
voice: Some("li/npetcm37_047"),
),
),
(
cmd: label,
args: (
name: "block_00451",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "辅祭发现了这个唯一的例外。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00452",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她从刚才开始，一直就站在我旁边藏着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00453",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难道你……没杀死还带了回来？」",
voice: Some("li/npetcm37_048"),
),
),
(
cmd: label,
args: (
name: "block_00454",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，因为没必要杀死她……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00455",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说什么蠢话，我是叫你全部杀死的，快点杀了她」",
voice: Some("li/npetcm37_049"),
