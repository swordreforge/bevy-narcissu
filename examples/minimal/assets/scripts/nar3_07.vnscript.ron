),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "城市里四处飘起黑烟，一路充满了追杀者和逃亡者的呐喊声音。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00281",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "恐怕，逃进教会的人会有很多。入口在外面被挂上了门闩。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00282",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……是想把人都关在里面放火烧吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00283",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算知道，我也只能眼睁睁的看而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00284",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「请别介意，你们的目的地在别处」",
voice: Some("li/npetcm37_035"),
),
),
(
cmd: label,
args: (
name: "block_00285",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "辅祭向我们发出指示。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00286",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "辅祭指挥着我们，在这里我们也不与主力部队合流，而是继续单独行动。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00287",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "终于，在继续前进了一阵，来到了郊外的时候，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00288",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
