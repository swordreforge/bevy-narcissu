args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……已经十年没有回去了吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00202",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "屋子到现在应该还留着吧。虽然不是很大，但却是用石头建造的牢固的屋子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00203",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那田虽然荒废了，到现在应该还肥沃吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00204",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且……到现在也还应该是归那家伙所有吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00205",
),
),
