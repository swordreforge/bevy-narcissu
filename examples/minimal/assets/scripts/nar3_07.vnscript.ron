),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―数日后。街道已经完全变成了废墟。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00324",
),
),
(
cmd: set_bg,
args: (
image: "bg_3109",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "会动的人只有士兵。此外就都是尸体和老鼠了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00325",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……看来这次可以安全的快些回去了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00326",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "已经不会像之前一样，因为无知，跟着其他军队进军了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00327",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，助理祭司再次向我们发出指令。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00328",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「约翰，还有一个人需要处理的」",
voice: Some("li/npetcm37_038"),
),
),
(
cmd: label,
args: (
name: "block_00329",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好的……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00330",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "反正反对也没意义。心想着快点解决掉这里的事快点回国。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00331",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
