),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在教会前，这次要远征的我们正受着众人的祈祷。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00259",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "为了给我们送行，人们从这个地方领地的各处汇聚过来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00260",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「骑士大人，要保重啊……」",
voice: Some("li/n3imo_0038"),
),
),
(
cmd: label,
args: (
name: "block_00261",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹妹那样说着，跑到我的跟前。交叉双手，面向我奉献祈祷。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00262",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对那样的妹妹，我感到非常寂寞，禁不住说。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00263",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，佩妮洛皮…… 别用那种对外人的语气说话了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00264",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶，但是……」",
voice: Some("li/n3imo_0039"),
),
),
(
cmd: label,
args: (
name: "block_00265",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「行了啦，像往常一样束起头发笑给我看看」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00266",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说真的，能不能活着回来还不知道。也许，这次说不定是最后一次见得到她了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00267",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算有看不见的力量保护着，庇佑着，那也只是至今为止的事，今后就不一定了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00268",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我很清楚地明白，他是反复无常的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00269",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「看，已经快出发了……快点」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00270",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，是的，我知道了」",
voice: Some("li/n3imo_0040"),
),
),
(
cmd: label,
args: (
name: "block_00271",
),
),
(
