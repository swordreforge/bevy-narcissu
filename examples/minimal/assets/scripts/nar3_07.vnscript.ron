),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「约翰，把那间房子的主人杀掉」",
voice: Some("li/npetcm37_036"),
),
),
(
cmd: label,
args: (
name: "block_00289",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「遵命……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00290",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我对辅祭的指示没发出任何异议。就算问其袭击这里的理由，也没有意义。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00291",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以我将志愿民兵配置在屋子四周，带领着这次募集起来的『骑士们』冲进屋里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00292",
),
),
(
