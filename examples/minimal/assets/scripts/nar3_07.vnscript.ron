),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我指挥队伍，迅速集合。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00361",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "骑士和志愿兵里的三十人有马，我决定用骑兵冲进去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00362",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "剩下的50人左右，用长弓做掩护，还有围着教会不让里面的人逃跑。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00363",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算对方只有十人左右，但保护要人的话，是高手的可能性很高。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00364",
),
),
(
cmd: set_bg,
args: (
image: "w",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
