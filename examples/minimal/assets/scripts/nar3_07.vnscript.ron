),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像是不想再被追问似的，线从我这里移开了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这家伙肯定也已经感觉到。流血时的痛楚……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……公主殿下，听过这样的话吗？」",
voice: Some("li/yohanp_1256"),
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「愚者千虑，必有一得……智者千虑，必有一失」",
