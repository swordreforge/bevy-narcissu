(
cmd: dialogue,
args: (
speaker: None,
text: "那天晚上。我们又在火堆前，一起取暖。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "燃烧的火堆前，相互说着话。",
voice: None,
),
),
(
