args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在教会正门门口。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00365",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我指挥骑兵先暂时停在那里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00366",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "可以的话，我并不想跟正规军正面交锋。\n让对方看见骑兵的数量，希望他们可以乖乖投降。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00367",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这边的伤亡也是个问题，此外刚才的命令，只是杀死里面的人，并不包括外面的士兵。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00368",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……别看我这样，我也并不想进行无意义的争斗和杀戮。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00369",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是知道了我的想法吧，教会里一个士兵慢慢走了出来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00370",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从盔甲看来也并不是杂兵。没错，肯定是一个正规骑士。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00371",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后从这个慢慢走近的男子口中响起洪亮的声音。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00372",
),
),
(
cmd: set_bg,
args: (
image: "bg_3104",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
