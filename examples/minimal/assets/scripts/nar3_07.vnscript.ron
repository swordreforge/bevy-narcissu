args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―数日后。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00253",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我正准备赶往遥远的地方。去的依旧是和这里的领地没什么关联的国家的土地。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00254",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "之后，通过大主教，分配给我的部下，有十人的骑士和100名志愿民兵。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00255",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然我不认为那些骑士们全都是真正的骑士。\n就像我以前那样，自称是骑士的人也应该不少。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00256",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明白那样子还给予援助的，就只有这个会心计的大主教了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00257",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "证据就是这一次，有一位直接指挥的辅祭同行。",
voice: None,
),
),
(
cmd: label,
args: (
