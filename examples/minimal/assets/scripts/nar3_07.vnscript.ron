args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么样约翰，把他杀死了吗？」",
voice: Some("li/npetcm37_037"),
),
),
(
cmd: label,
args: (
name: "block_00320",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，确确实实」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00321",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我回答着稍微有点兴奋的辅祭。我不知道详细的内情，也不想去问。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00322",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "恐怕，杀了刚才的屋主，会有什么好处。当然是对于大主教而言。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00323",
),
),
(
