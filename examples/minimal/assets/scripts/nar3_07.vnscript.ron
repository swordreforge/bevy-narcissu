),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……喂，还活着吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00407",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对刚才已经快死的骑士叫道。因为他一个人，这边损失了6名骑兵。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00408",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你……为什么要做这种愚蠢的自杀式袭击？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00409",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "笨重的「……那当然是，不这样做的话……根本打不赢骑兵吧……」",
voice: Some("li/npetcm38_019"),
),
),
(
cmd: label,
args: (
name: "block_00410",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00411",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "笨重的「……还是说，约翰，你想说我很卑鄙……？」",
voice: Some("li/npetcm38_020"),
),
),
(
cmd: label,
args: (
name: "block_00412",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不……也不是……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00413",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "笨重的「……哼哼，想死上的话，就很简单……」",
voice: Some("li/npetcm38_021"),
),
),
(
cmd: label,
args: (
name: "block_00414",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完最后的话，这位无名的骑士死了。眼睛依然睁着，不知为何一点灰暗都感觉不到。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00415",
),
),
