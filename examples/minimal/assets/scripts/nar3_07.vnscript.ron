),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "………………",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00416",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "接着的情况，只能用惨烈形容。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00417",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "仅仅十名步兵，牺牲了我们大多数的士兵。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00418",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一开始70多名的志愿兵，只剩下寥寥数人，自称为骑士的人，全部都战死了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00419",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "终于知道了有目的有意志，又忠诚的真正的骑士是多么强大了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00420",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……然后，我们终于走进了教会，那里的几个人的装束明显不是一般市民。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00421",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
