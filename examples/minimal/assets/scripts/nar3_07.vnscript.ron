args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你，你就是指挥官吧，请放……」",
voice: Some("li/npetcm38_022"),
),
),
(
cmd: label,
args: (
name: "block_00422",
),
),
(
cmd: play_se,
args: (
file: "kiru01_1",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "没让他把话说完。在这里的人，无论是谁都得一并杀掉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00423",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "接着，把刀锋转向裹着红衣的人。恐怕和我们一样是正教徒吧，不过也没关系。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00424",
),
),
(
cmd: play_se,
args: (
file: "kiru02",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……之后就是，抓到什么杀什么。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00425",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "将全部的活人变为尸体。让全部会动弹的人再也不会动弹。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00426",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不久，最后准备放火的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00427",
),
),
