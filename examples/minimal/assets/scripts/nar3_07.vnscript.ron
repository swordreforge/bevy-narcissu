),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完，那骑士慢慢走过来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00383",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我高高举起右手，把手掌往内一转。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00384",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这是对弓兵发出，瞄准对手，架弓待命的指示。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00385",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……看来总算可以避免无谓的争斗。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00386",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我的内心松了一口气，不知为何那个骑士还是拿着剑步步靠近。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00387",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「想投降的话……先放下剑」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00388",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "笨重的「啊，那也是」",
voice: Some("li/npetcm38_017"),
),
),
(
cmd: label,
args: (
name: "block_00389",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然嘴上这样回答，但骑士并没有把剑扔开的打算，继续一步步靠近。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00390",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我用带着一点不安和焦躁的声音吼道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00391",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「别再靠近了，我说了把剑扔掉」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00392",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "笨重的「……那是不可能的……因为已经粘在了手里」",
voice: Some("li/npetcm38_018"),
),
),
(
cmd: label,
args: (
name: "block_00393",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什！……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00394",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，我正打算向弓箭手发出发射的命令……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00395",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这时，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00396",
),
),
(
cmd: play_se,
args: (
file: "kiru02",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呜哇」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00397",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "突然坐骑倒下了，那个势头把我丢了出去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00398",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "直至摔倒在地面前的那一瞬间，我看到像我一样，在空中飞舞的人的身姿。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00399",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……开始，我并不知道发生了什么事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00400",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "何况那些被重重的摔到地面上，连呼吸都停止了的人就更不知道了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00401",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后……当我总算重新站起来的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00402",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "眼前看到只有那个濒死的骑士一人。他身上插满了箭矢。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00403",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在附近，是几匹倒在地上仍然大闹着的马，和发出呻吟声的五个士兵。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00404",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……看来并不是我们，而是马的前蹄被砍了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00405",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只能说，那舍身的自杀式攻击是愚蠢的行为。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00406",
),
),
(
