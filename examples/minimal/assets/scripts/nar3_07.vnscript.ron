),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "笨重的「……你就是指挥官吧……名字叫什么？」",
voice: Some("li/npetcm38_013"),
),
),
(
cmd: label,
args: (
name: "block_00373",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「约翰……你的名字又是什么？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00374",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "笨重的「不是什么可以自报的大名……」",
voice: Some("li/npetcm38_014"),
),
),
(
cmd: label,
args: (
name: "block_00375",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，跟我正面对峙着。看起来就是个壮硕粗野的骑士。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00376",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「听好了，你们已经被包围了。但是，你们这些士兵投降的话还有一条活路」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00377",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "笨重的「……只有士兵吗？」",
voice: Some("li/npetcm38_015"),
),
),
(
cmd: label,
args: (
name: "block_00378",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，除此以外全部要杀掉。如果士兵不投降的话，连士兵也一起杀掉」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00379",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我诚实地回答道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00380",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从经验上知道，这种情况下搞暗算也没什么好结果。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00381",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "笨重的「我知道，约翰，投降吧」",
voice: Some("li/npetcm38_016"),
),
),
(
cmd: label,
args: (
name: "block_00382",
),
),
(
