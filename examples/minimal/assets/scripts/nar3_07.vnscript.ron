args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「愿主赐予这人以慈悲之心……」",
voice: Some("li/npetcw2_011"),
),
),
(
cmd: label,
args: (
name: "block_00433",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "祈祷着的修女。对着染满了鲜血的祭坛……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00434",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那眼睛没有丝毫浑浊，是澄清明亮的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00435",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那真挚的身影……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00436",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……跟妹妹的样子重合了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00437",
),
),
(
