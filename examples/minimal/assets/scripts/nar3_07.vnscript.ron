channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，勉勉强强地系好头发后转过身来面对着我，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00272",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「出门小心，约翰哥哥……」",
voice: Some("li/n3imo_0041"),
),
),
(
cmd: label,
args: (
name: "block_00273",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着试着露出了笑容。虽然有少许僵硬，但那确实是平时的妹妹的笑容……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00274",
),
),
(
