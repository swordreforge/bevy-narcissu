),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―从那时起的四年后。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00212",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "国家再一次发起远征了。这么正式的远征，已经时隔几年了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00213",
),
),
(
cmd: set_bg,
args: (
image: "bg_0001",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
