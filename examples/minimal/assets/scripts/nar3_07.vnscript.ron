),
),
(
cmd: play_bgm,
args: (
id: "88",
volume: Some(0.78431374),
fade_ms: Some(500),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然之前的远征之后，我并不是完全无所作为。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00214",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "领土边界的小冲突我也参加过好几次，这也是正式受封的骑士的义务。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00215",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……虽然，并没立下什么特别大的功，不知道为什么，我的名声却如日中天。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00216",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "毫无疑问，是大主教捏造的吧。尽是些我没做过的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00217",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "作为资助者的他来说，为了把自己的名声提高，像我这样的人似乎相当好利用。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00218",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "为此，关于这次远征，不单只教会，连子爵都出面邀请。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00219",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……很难拒绝……但是可以的话真不想参加」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00220",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "由于以前远征的经历，我变得非常沉重。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00221",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我仍认为那只是打着圣战之名的，单纯的虐杀。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00222",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且以前是为了生存，逼不得已，但现在不同。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00223",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "生活富裕，没有生存的烦恼。那样的话，至少我是不会想去的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00224",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "话虽如此，站在我的立场上考虑的话能拒绝吗……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00225",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而使我不再纠结的，并不是他人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00226",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是我妹妹。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00227",
),
),
(
cmd: set_bg,
args: (
image: "3022",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哥哥，恭喜你」",
voice: Some("li/n3imo_0029"),
),
),
(
cmd: label,
args: (
name: "block_00228",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹妹刚看见我的身影，就从田里跑过来叫道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00229",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我听说了，你又要去远征了是吧」",
voice: Some("li/n3imo_0030"),
),
),
(
cmd: label,
args: (
name: "block_00230",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶，啊……算是吧……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00231",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我暧昧地回答着。恐怕是从镇里或教会那里打听到的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00232",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哥哥肯定， 又能大显身手了，我很期待……」",
voice: Some("li/n3imo_0031"),
),
),
(
cmd: label,
args: (
name: "block_00233",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，对不起」",
voice: Some("li/n3imo_0032"),
),
),
(
cmd: label,
args: (
name: "block_00234",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「？？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00235",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我刚在想她到底怎么了，妹妹把那个发夹拿下来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00236",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后把长发垂直放下来，拍了拍附着在衣服上的麦穗，整理了下上衣的领子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00237",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「在骑士大人面前，小女子失礼了」",
voice: Some("li/n3imo_0033"),
),
),
(
cmd: label,
args: (
name: "block_00238",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完，头深深地低下作成行礼的姿势。\n在那里的，已经不是开开心心干着农活的妹妹了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00239",
),
),
(
cmd: set_bg,
args: (
image: "3022",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「您是我们信徒的荣誉。我们期待着您活跃的表现」",
voice: Some("li/n3imo_0034"),
),
),
(
cmd: label,
args: (
name: "block_00240",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00241",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……我，该如何回答才好呢。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00242",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像以前无法回答一样，我再一次没有找到回答的言辞。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00243",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以我并没有正面回答，反过来向妹妹问我所担心的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00244",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「如果……我死了，你会怎么做？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00245",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……死？ 教会所推荐的名誉骑士的您？」",
voice: Some("li/n3imo_0035"),
),
),
(
cmd: label,
args: (
name: "block_00246",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，战斗就是那样……我随时都有可能被杀」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00247",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没事的。骑士大人有神明的庇护的」",
voice: Some("li/n3imo_0036"),
),
),
(
cmd: label,
args: (
name: "block_00248",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "干脆的断言了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00249",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难道是……被那看不见的力量，保护着，我才一直生存至今？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00250",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就是这样」",
voice: Some("li/n3imo_0037"),
),
),
(
cmd: label,
args: (
name: "block_00251",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "没有丝毫犹豫地回答。也没有丝毫浑浊的，清纯透彻的眼神……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00252",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
