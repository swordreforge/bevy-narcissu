),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完她带着寂寞的表情低下头。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00182",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看着这家伙寂寞的表情，我也莫名其妙悲伤起来……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "情不自禁的说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「如果种植一颗小麦的话，能有多少收成，你知道吗？」",
voice: Some("li/yohanp_1264"),
),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……干嘛突然说这些？」",
voice: Some("li/n3iri_0221"),
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "突然被问到的公主殿下不可思议地抬起头。但是我，还是继续说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「其实，小麦只能收获到一倍的种子而已」",
