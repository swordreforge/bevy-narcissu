),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……喂，问你个问题行吗？」",
voice: Some("li/n3iri_0226"),
),
),
(
cmd: label,
args: (
name: "block_00206",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「只能问一个」",
voice: Some("li/yohanp_1272"),
),
),
(
cmd: label,
args: (
name: "block_00207",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「为什么你…… 总是流露着悲伤的表情？」",
voice: Some("li/n3iri_0227"),
),
),
(
cmd: label,
args: (
name: "block_00208",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……………………」",
voice: Some("li/yohanp_1273"),
),
),
(
cmd: label,
args: (
name: "block_00209",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那是因为……",
voice: Some("li/yohanp_1274"),
),
),
(
cmd: label,
args: (
name: "block_00210",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "生存在这悲伤的世界吧……」",
voice: None,
),
),
(
