),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只要逃出国境应该就不会追来了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这只是说短时间内，长久的将来就难说了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你，逃出这国家后有什么打算？」",
