args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "撞门而入，肆意地闯进屋子。屋内顿时响起了娇滴滴的悲鸣声。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00293",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们毫不理会，直接向屋子里面闯去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00294",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在途中有抵抗者便一刀致命。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00295",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……不久，在屋子深处的一个房间里，看见了一个像是屋子主人的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00296",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「看来，你就是主人了……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00297",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「求求，你，请放过我，钱也好，宝石也好，统统给你」",
voice: Some("li/npetcm38_008"),
),
),
(
cmd: label,
args: (
name: "block_00298",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边说着，主人把小箱子里的银币拿到我们面前。\n那些金钱多到让其他骑士不由得停下下手来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00299",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有人开始和周围的人使眼色，也有人偷偷小声说话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00300",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……真丢人，这就是我的部下啊」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00301",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那样的嘟哝的同时，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00302",
),
),
(
cmd: play_se,
args: (
file: "kiru01_1",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊~」",
voice: Some("li/npetcm38_009"),
),
),
(
cmd: label,
args: (
name: "block_00303",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我从屋主的背后斜肩一刀砍了过去。毫不犹豫，毫不留情的一刀。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00304",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，拿起屋主手中那个装银币的箱子，就这样丢在房间的地上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00305",
),
),
