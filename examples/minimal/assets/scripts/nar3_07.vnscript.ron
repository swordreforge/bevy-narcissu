args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…………",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00332",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "遵从辅祭的指示，走了整整三天后，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00333",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们来到的，是某个偏僻的小镇。\n似乎还没有受到战争的侵袭，房子几乎都是完好无损的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00334",
),
),
(
cmd: set_bg,
args: (
image: "bg_3104",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，指着那高大的教会，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00335",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「请把这里面的人，全部杀掉」",
voice: Some("li/npetcm37_039"),
),
),
(
cmd: label,
args: (
name: "block_00336",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……全部？ 但这不是正教会吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00337",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「约翰……他们全部都是坏人」",
voice: Some("li/npetcm37_040"),
),
),
(
cmd: label,
args: (
name: "block_00338",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……………………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00339",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "没有多说。辅祭的眼睛是灰暗的，并不明亮。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00340",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "肯定，跟好坏并没有关系。只是因为妨碍到他的利益，所以想排除异己而已吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00341",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我当然没打算因此去反对他。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00342",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且我想也没有反对的资格。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00343",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是辅祭，这里有少数的正规士兵把守着。粗略看来有十人或更多」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00344",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……那又怎么样？」",
voice: Some("li/npetcm37_041"),
),
),
(
cmd: label,
args: (
name: "block_00345",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没什么，对志愿民兵来说，我们这面也会有很大的伤亡」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00346",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且那些自称为骑士的家伙，从之前的战斗中看来，也不觉得他们能成为多少战力。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00347",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我考虑着理所当然的事，而辅祭对这样的我说道，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00348",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「约翰……你认为我们是为了什么而养你们的」",
voice: Some("li/npetcm37_042"),
),
),
(
cmd: label,
args: (
name: "block_00349",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "辅祭冷淡地说着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00350",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并没有听错。的确是，说“养”我们。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00351",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这里面的是残存的王族，红衣主教也应该会在，请把他们全部杀掉」",
voice: Some("li/npetcm37_043"),
),
),
(
cmd: label,
args: (
name: "block_00352",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00353",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「别担心，神会保护你们的」",
voice: Some("li/npetcm37_044"),
),
),
(
cmd: label,
args: (
name: "block_00354",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着露出了淡淡的笑容。令人厌恶的笑容。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00355",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好吧……反正也不能违抗命令」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00356",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……为什么，辅祭会知道？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00357",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那么重要的人，逃进这么小的教会里。\n就算是本部队伍里的人，都应该是不知道的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00358",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我对知道这件事而发出命令的辅祭感到害怕。我们这次远征的目的肯定就是为了这个。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00359",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "他们果然是想，趁着这战乱的让我们把异己者杀掉……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00360",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
