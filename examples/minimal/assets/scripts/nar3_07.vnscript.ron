),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「一倍？……就这些？」",
voice: Some("li/n3iri_0222"),
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「恩，那么用心地种植，结果就只收获到这些」",
voice: Some("li/yohanp_1266"),
),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我继续得意地说着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而我说的那些话，不知怎的这家伙听得津津有味。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00192",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，根据种植的地方不一样，可以有3倍或者4倍的收获噢」",
voice: Some("li/yohanp_1267"),
),
),
(
cmd: label,
args: (
name: "block_00193",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那是指肥沃的土地的意思吗？」",
voice: Some("li/n3iri_0223"),
),
),
(
cmd: label,
args: (
name: "block_00194",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，也不全是」",
voice: Some("li/yohanp_1268"),
),
),
(
cmd: label,
args: (
name: "block_00195",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「即使是在不适合种植小麦的地区，那样的好地方，还是能随处找到的」",
voice: Some("li/yohanp_1269"),
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哦……」",
voice: Some("li/n3iri_0224"),
),
),
(
cmd: label,
args: (
name: "block_00197",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，那家伙用钦佩的眼光看着我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是，你 不是说不知道怎么种植小麦的吗？」",
voice: Some("li/n3iri_0225"),
),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「恩，详细的就不知道了……只是，适合种植的地方的话……」",
voice: Some("li/yohanp_1270"),
),
),
(
cmd: label,
args: (
name: "block_00200",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……至少，心里有底。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00201",
),
),
(
