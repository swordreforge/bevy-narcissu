),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊……」",
voice: Some("li/npetcw2_010"),
),
),
(
cmd: label,
args: (
name: "block_00428",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我发现了一位年轻的修女。躲在圣坛下面。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00429",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我无言的拿起剑走了过去。并没有什么要说的。接下来只要把剑挥下去就好了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00430",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，面对着滴血的长剑，她似乎对自己的命运已经有所觉悟。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00431",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "慢慢地，合上双手……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00432",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
