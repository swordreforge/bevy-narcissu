),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……那里，比预想中还要残酷。虽然以前也是，但这次更加严重。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00280",
),
),
