),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "―数周时间后。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00275",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们总算到达了里昂的会合地点。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00276",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "跟以前一样，全都是那些眼睛灰暗的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00277",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只不过，跟前一次不同，并不是加入本部队伍，而是另外执行其他任务。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00278",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……虽然并不明白其中的目的，但我们遵从着同行的辅祭的指示，向着贝济耶前进。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00279",
),
),
(
cmd: set_bg,
args: (
image: "b",
transition: Some(fade(
duration: 0.8,
)),
),
),
