channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "伴随的响亮的金属声音，钱币散落满地。在被屋主的血沾湿的地板上散开来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00306",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你们，在干什么？ 这种东西，杀死对方再拿不就好了么」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00307",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是，是的，约翰队长」",
voice: Some("li/npetcm38_010"),
),
),
(
cmd: label,
args: (
name: "block_00308",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "骑士们，弯着腰，捡着散落一地的钱币。那种姿势，我不由得感到很悲哀。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00309",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不久，准备在屋里放火的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00310",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你，你们这些人，肯定……会遭报应的……」",
voice: Some("li/npetcm38_011"),
),
),
(
cmd: label,
args: (
name: "block_00311",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什么啊……你还活着啊？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00312",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一看，奄奄一息的屋主抓住我的脚在诅咒我们。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00313",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对着这位屋主，我继续说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00314",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不好意思，我不信神」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00315",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你，你们…… 并不是什么骑士，只是……」",
voice: Some("li/npetcm38_012"),
),
),
(
cmd: label,
args: (
name: "block_00316",
),
),
(
cmd: play_se,
args: (
file: "kiru01_1",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没错……我们只是……杀人犯而已」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00317",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我对已经不会动的屋主说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00318",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在离开屋子时，我们把值钱的东西全部收集好，把会动的人全部杀掉后……\n放火离开了那屋子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00319",
),
),
