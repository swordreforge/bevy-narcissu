),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶，优花小姐？」",
voice: Some("li/makinp_1133_1"),
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着跑过来的是莳绘小姐。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么回事，在这种地方？」",
voice: Some("li/makinp_1133_2"),
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，稍微想见见他」",
voice: Some("li/yukanp_1232"),
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「比起这个莳绘，我正好想去屋顶，把钥匙借给我吧」",
voice: Some("li/yukanp_1233"),
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……去屋顶，不会是要带着他吧……」",
voice: Some("li/makinp_1134"),
),
),
(
cmd: label,
args: (
name: "block_00171",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，就去一下下」",
voice: Some("li/yukanp_1234"),
),
),
(
cmd: label,
args: (
name: "block_00172",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/makinp_1135"),
),
),
(
cmd: label,
args: (
name: "block_00173",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "莳绘小姐就这样陷入沉思。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00174",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我既不知道他们二人是怎么样的关系，也不知道优花小姐有没有这样做的权限。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00175",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，等待片刻之后……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00176",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呼，我知道了……今天风很大，请小心啊」",
voice: Some("li/makinp_1136"),
),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「谢谢，那就这样」",
voice: Some("li/yukanp_1235"),
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
