),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并没有那种不情愿的感觉，优花小姐飞快地往前走去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00162",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然，我也知道有住院患者不能去屋顶的规定。\n以前对护士提出的时候，因为这个规定所以被拒绝了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00163",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……到底怎样才能去屋顶呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我不经意间想着这件事，就在刚到电梯前面的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
(
