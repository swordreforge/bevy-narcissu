args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "淡薄的天空，高高的围栏。许多洗过的床单，在强风中摇曳。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……屋顶。本来这里，不是病人能来的场所。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊——，这里真是个让人心情愉快的地方呢～」",
voice: Some("li/yukanp_1236"),
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「优花小姐，以前来过这里吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯～，来过几次呢。因为我以前每天都会来这里探望」",
voice: Some("li/yukanp_1237"),
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "和７楼的天花板差不多高的围栏前面，让人想到初夏的强烈的日光。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "春天温暖的阳光、和屋顶上吹拂的强风。她长长的整齐的直发飘动着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，然后怎么做？」",
voice: Some("li/yukanp_1238"),
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊、不、不做什么……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00192",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈？什么啊你，没劲了啊。明明已经按你说的，把你带到屋顶了啊」",
voice: Some("li/yukanp_1239"),
),
),
(
cmd: label,
args: (
name: "block_00193",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对不起，我真的只是想来一下而已……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00194",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呼……但是，嘛，算了。这种天气的日子，待在屋顶上也不坏」",
voice: Some("li/yukanp_1240"),
),
),
(
cmd: label,
args: (
name: "block_00195",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "边这么说着，从包里拿出一听罐装咖啡，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: play_se,
args: (
file: "z0021",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "轻轻地拉开拉环的声音响起。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00197",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「咕咕咕……呼」",
voice: Some("li/yuka-0031"),
),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就好像泡完澡一样一手插着腰开始喝，又递给我一罐。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "用手接过冷藏过的罐装咖啡，我终于问了一直很在意的问题。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00200",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「比起那个，优花小姐……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00201",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什么？」",
voice: Some("li/yukanp_1241"),
),
),
(
cmd: label,
args: (
name: "block_00202",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「为什么，\u{3000}为什么要为我做这些事？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00203",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唔，说起来是个有点长的故事呢……」",
voice: Some("li/yukanp_1242"),
),
),
(
cmd: label,
args: (
name: "block_00204",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「曾经，那孩子陪伴着我的好朋友，做了她想尽情做的事……」",
voice: Some("li/yukanp_1243"),
),
),
(
cmd: label,
args: (
name: "block_00205",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……那孩子说的是，濑津美吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00206",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯……然后你，陪伴了那孩子……」",
voice: Some("li/yukanp_1244"),
),
),
(
cmd: label,
args: (
name: "block_00207",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以说这次轮到我，陪你做你想做的事了」",
voice: Some("li/yukanp_1245"),
),
),
(
cmd: label,
args: (
name: "block_00208",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这么嘟囔着，表情看上去有几分寂寞。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00209",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她的话，虽然我不能理解……但我总觉得能明白她想表达的意思。",
voice: None,
),
),
(
