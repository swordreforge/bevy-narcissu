),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不久眼睛习惯了之后，面前是，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: set_bg,
args: (
