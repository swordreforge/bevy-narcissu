args: (
file: "isu2b",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呼……」",
voice: Some("li/yuka-0077"),
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话说我很惊讶啊，没想到那时候和濑津美在一起」",
voice: Some("li/yukanp_1222"),
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，这个自称优花的人耸了耸肩。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00138",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那个时候，我也不知道她是什么样的人……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "大概因为是莳绘的朋友，对这个医院也很了解吧？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么优花小姐，今天有什么事……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，我觉得你也快差不多了吧」",
voice: Some("li/yukanp_1223"),
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她看着我床旁边的点滴说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶、啊啊、是这样……预定这周末会更换注射的点滴……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么……\u{3000}是不是想要任性的说点什么呢？」",
voice: Some("li/yukanp_1224"),
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……………………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「会听你讲的哦，反正是最后一次」",
voice: Some("li/yukanp_1225"),
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是……为什么是你？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯——，真是个难回答的问题呢」",
voice: Some("li/yukanp_1226"),
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛，非要说的话，是因为”缘”吧」",
voice: Some("li/yukanp_1227"),
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……缘？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，感觉这次，轮到我了呢……」",
voice: Some("li/yukanp_1228"),
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "缘……然后，轮到我。这些话的意思，我不懂。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "恐怕，她也有她自己的想法吧，我也看不透她的想法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "于是，面对那张寂寞的脸，我把想说的都说出了口。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那……我想去屋顶……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「屋顶？」",
voice: Some("li/yukanp_1229"),
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，是的」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「可以倒是可以，如果你是想跳下去的话，\n以你的体力应该是翻不过围栏的吧？」",
voice: Some("li/yukanp_1230"),
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，并不是打算那样哦……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呼——，嘛，好吧。\u{3000}这种程度的话小事一桩，跟我来吧」",
voice: Some("li/yukanp_1231"),
),
),
(
cmd: label,
args: (
name: "block_00161",
),
),
(
