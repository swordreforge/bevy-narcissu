),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你是……那个时候的……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「优花呀，还记得吗？」",
voice: Some("li/yukanp_1221"),
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶、诶诶……之前和莳绘小姐一起在高速上……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "突然，出现在面前的女性。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她是以前和濑津美一起，在高速服务区遇到的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
