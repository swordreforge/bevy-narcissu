),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我跟在优花后面，停在了走廊的尽头。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "准确来说，是在上安全楼梯之前，面前是一直以来都关着的，巨大的铁门。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00180",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……虽然以前从没见过它开着的状态，大概这里就是屋顶的入口吧……",
voice: None,
),
),
(
