),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……这里，是禁烟的吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00214",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不要说那么严肃的事啦」",
