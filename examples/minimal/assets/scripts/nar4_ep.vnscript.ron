(
cmd: dialogue,
args: (
speaker: None,
text: "优花小姐露出稍微有点任性的表情，对着我闭上一只眼睛。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00216",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，终于点着了火，吐出一大口烟。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00217",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……虽然感觉外表看起来和我差不多大年纪，\n但时而流露出的悲伤神情让人会觉得确实是一位成熟的女性。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00218",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "总觉得……和以前，那个护理员很像……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00219",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "感觉萦绕着，和那个我传递给她规则的人，以及濑津美相似的氛围。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00220",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我一边漠然地思考着这些，一边望着优花小姐……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00221",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "忽然，我说道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00222",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐优花小姐……可以给我一根吗……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00223",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不行哦，因为你是病人啊」",
voice: Some("li/yukanp_1248"),
),
),
(
cmd: label,
args: (
name: "block_00224",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话说，现在的状况还想要抽烟，你到底烟瘾多重啊」",
voice: Some("li/yukanp_1249"),
),
),
(
cmd: label,
args: (
name: "block_00225",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，我没抽过烟……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00226",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶……？」",
voice: Some("li/yuka-0084_1"),
),
),
(
cmd: label,
args: (
name: "block_00227",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……或者说……这种任性的事，不行吗？」",
voice: None,
),
),
(
