),
),
(
cmd: label,
args: (
name: "block_00293",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "除此之外，我不知道该如何作答。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00294",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，面对着这无法形容的痛苦，不由想随便找些其他话题来继续。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00295",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对，对了...」",
voice: Some("li/hime2_0070"),
),
),
(
cmd: label,
args: (
name: "block_00296",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，那个，去餐厅吧。」",
voice: Some("li/hime2_0071"),
),
),
(
cmd: label,
args: (
name: "block_00297",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唉？可是刚刚，才吃过早餐的喔。」",
voice: Some("li/onnanoko_0052"),
),
),
(
cmd: label,
args: (
name: "block_00298",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没关系没关系啦，我再请你吃冰激凌喔。」",
voice: Some("li/hime2_0072"),
),
),
(
cmd: label,
args: (
name: "block_00299",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我再次推着她的后背，前往平常去的医院餐厅。",
