),
),
(
cmd: label,
args: (
name: "block_00301",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "本来应该是扮演帕奇，但我们却没办法和她们一起死去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00302",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以我是，尼洛最好的朋友阿洛伊斯。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00303",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...不过，抱着隐瞒的话，真的能称作是朋友吗？",
