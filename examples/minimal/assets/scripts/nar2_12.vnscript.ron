args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，不管是谁，我都没办法去反驳。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00281",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样的谎话...",
