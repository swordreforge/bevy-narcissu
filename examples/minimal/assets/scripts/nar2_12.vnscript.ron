),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好热...」",
voice: Some("li/hime2_0031"),
),
),
(
cmd: label,
args: (
name: "block_00122",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一大早蝉就开始卯足了劲地鸣叫，看来今天也会很热的样子。",
voice: None,
),
),
(
