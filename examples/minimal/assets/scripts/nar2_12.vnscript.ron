),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喜欢非洲菊么？」",
voice: Some("li/hime2_0065"),
),
),
(
cmd: label,
args: (
name: "block_00258",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，不过我更喜欢白色的那个」",
voice: Some("li/onnanoko_0042"),
),
),
(
cmd: label,
args: (
name: "block_00259",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样说着，她向另一个花瓶的...白色百合指去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00260",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一般来说探病用的花束香味会特别的浓厚，而这些花瓶，也并不是我们准备的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00261",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，可以很容易的想到送花的人是谁。\n能够送出这种东西的人，不会太多。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00262",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这是教会的人装饰的。」",
voice: Some("li/onnanoko_0043"),
),
),
(
cmd: label,
args: (
name: "block_00263",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，看来已经来过了呢」",
voice: Some("li/hime2_0066"),
),
),
(
cmd: label,
args: (
name: "block_00264",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，他们说还会再来的。」",
voice: Some("li/onnanoko_0044"),
),
),
(
cmd: label,
args: (
name: "block_00265",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "闻着百合的气味高兴的回答着的她。\n恐怕来探病的是神父或是修女吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00266",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "考虑到她现在的状况，教会，会这么做也不奇怪。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00267",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...对于不是信徒的人也无差别地用着慈悲精神对待。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00268",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "某种意义上来说，也像是这里的作风。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00269",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过对于她来说...大概是不明白这些的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00270",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算父母是天主教徒，而她本身，还是未接受过洗礼的身体。\n而且幼小无知。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00271",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，说起来...」",
voice: Some("li/onnanoko_0045"),
),
),
(
cmd: label,
args: (
name: "block_00272",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「关于爸爸妈妈的事...」",
voice: Some("li/onnanoko_0046"),
),
),
(
cmd: label,
args: (
name: "block_00273",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "突然说到父母的话题，我惊讶了一下。\n这是最令我不安的问题。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00274",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「他们啊，好像说是去了很远的地方旅行去了。」",
voice: Some("li/onnanoko_0047"),
),
),
(
cmd: label,
args: (
name: "block_00275",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唉？」",
voice: Some("li/hime2_0067"),
),
),
(
cmd: label,
args: (
name: "block_00276",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以，有一段时间不能来探望我了。」",
voice: Some("li/onnanoko_0048"),
),
),
(
cmd: label,
args: (
name: "block_00277",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...是谁这样告诉她的？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00278",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一瞬间，我把想问的话咽了下去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00279",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "大概是医生或者护士吧...？或许，也可能是神父或修女。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00280",
),
),
