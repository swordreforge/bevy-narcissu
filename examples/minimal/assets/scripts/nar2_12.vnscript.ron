),
),
(
cmd: label,
args: (
name: "block_00291",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，到时候姐姐也一起吃吧？」",
voice: Some("li/onnanoko_0051"),
),
),
(
cmd: label,
args: (
name: "block_00292",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，真期待呢...」",
