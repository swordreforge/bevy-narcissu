),
),
(
cmd: label,
args: (
name: "block_00251",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "本来，对于她来说这种用来探望的花是不存在的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00252",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为无家可归，没有人会带着花来的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00253",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，在这里的医院...特别是这里的7楼，每天都会从别人那里收到花束。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00254",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后护士和我们陪护，就把收到的花分配到这楼的各个房间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00255",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果这样花还是不够的话，就从花坛中择选一些来搭配。\n这也是我们工作的一部分。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00256",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算是，完全没有人来探望的病人，\n我们也会为他“做出”一直都有花的样子，这就是我们这的实际情况。",
voice: None,
),
),
(
