),
),
(
cmd: label,
args: (
name: "block_00313",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "或许是理所当然，这里并没有与她年龄相仿的人。\n这里的7楼，几乎都是上了年纪的老人。",
voice: None,
),
),
(
