args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "今天并不是平常去的7楼，而是5楼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00048",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "和还未见过的尼洛打招呼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00049",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这里所说的「尼洛」，是我们陪护和护士间的暗语。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从7楼的病人，小孩，无家可归这些词汇中联想到的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00051",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "恐怕，是从“佛兰德斯的狗”里命名的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00052",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "感觉实在是很失礼的命名方式，不过到现在，我也不知道事情的真假。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00053",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在我来到这里之前似乎就已经这么定下来了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00054",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「只是...这应该不是怀有恶意的称呼吧。」",
voice: Some("li/hime2_0011"),
),
),
(
cmd: label,
args: (
name: "block_00055",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "要说为什么的话，是因为每当知道尼洛要来的时候，\n就会有很多自愿负责尼洛的医生和护士以及陪护。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00056",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这种情况，是因为这里是，以无私奉献为宗旨的天主教医院吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00057",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，在这当中负责尼洛的陪护，被人半尊敬半捉弄的，称作阿洛伊斯。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00058",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...其实，帕奇那边，感觉更合适吧...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00059",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不过我们，没办法陪他们一起死去。」",
voice: Some("li/hime2_0012"),
),
),
(
cmd: label,
args: (
name: "block_00060",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，才会以最好的挚友阿洛伊斯称呼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00061",
),
),
(
cmd: set_bg,
args: (
image: "white-2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
