),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「早。」",
voice: Some("li/hime2_0032"),
),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...早。」",
voice: Some("li/onnanoko_0017"),
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "同昨日一样，她轻轻地仰起身子说着早安。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然，稍微变得亲近了些，不过，她还是一直一副客气的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「早上的体温检查已经结束了？」",
voice: Some("li/hime2_0033_1"),
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，36.5度...」",
voice: Some("li/onnanoko_0018"),
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这样啊，安心了呢。」",
voice: Some("li/hime2_0034"),
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完我把早餐的餐盘收拾好。然后，到下午之前就没有什么需要做的事情了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "本来，陪护的工作就不是很多。\n负责治疗行动的部分的也是医院和护士的工作。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就只有查查体温的程度，还有就是帮助她周围的日常所需等。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...不过反过来说，帮助日常所需是没有”上限”的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正因为这样，不是医师和护士，而是陪护被给予了阿洛伊斯的称呼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，到餐厅去吧？」",
voice: Some("li/hime2_0035"),
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯？可是，刚刚才吃过的...」",
voice: Some("li/onnanoko_0019"),
),
),
(
cmd: label,
args: (
name: "block_00138",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「吃冰激凌喔，冰激凌，毕竟这么热呢。」",
voice: Some("li/hime2_0036"),
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「可是...」",
voice: Some("li/onnanoko_0020"),
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她用着很复杂的表情看向我。\n应该不光光只是客气，还想着什么其他的事情吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没问题啦，姐姐请客的。」",
voice: Some("li/hime2_0037"),
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "于是我，像是推着她一样走向餐厅。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: set_bg,
args: (
image: "black-2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为还是上午，还没什么人的样子。\n在这里，我们并排着坐到椅子上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: set_bg,
args: (
image: "shokudou",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，想吃什么都可以说啦。」",
voice: Some("li/hime2_0038"),
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，可是...」",
voice: Some("li/onnanoko_0021"),
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我～说～过～，不用客气的。」",
voice: Some("li/hime2_0039"),
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我这么说着，把餐厅的菜单递给她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...............」",
voice: Some("li/onnanoko_0022"),
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，香草口味...」",
voice: Some("li/onnanoko_0023"),
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好，香草口味的明白了。我要吃什么才好呢～」",
voice: Some("li/hime2_0040"),
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呃，冰激凌只有一种口味呢。」",
voice: Some("li/hime2_0041"),
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，好像是这样...」",
voice: Some("li/onnanoko_0024"),
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈哈，这样的话就没有选择的余地呢。」",
voice: Some("li/hime2_0042"),
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，我这就去买喔。」",
voice: Some("li/hime2_0043"),
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: set_bg,
args: (
image: "black-2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我把她留在座位上，前往柜台。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "瞟向四周，和这个小女孩同龄的小孩，都在和妈妈爸爸一起享用着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "理所当然的，像她这种年纪，一个人在医院的餐厅坐着总感觉怪怪的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...不过，她的父母已然不在。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当然她是不知道的，我们也没让她知道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: set_bg,
args: (
image: "shokudou",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「给，久等了～」",
voice: Some("li/hime2_0044"),
),
),
(
cmd: label,
args: (
name: "block_00161",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哇，冰激凌好多。」",
voice: Some("li/onnanoko_0026"),
),
),
(
cmd: label,
args: (
name: "block_00162",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，因为比想象中的还小，感觉只吃一个也太少了。」",
voice: Some("li/hime2_0045"),
),
),
(
cmd: label,
args: (
name: "block_00163",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「也就是说，我们每人要吃两个喔。」",
voice: Some("li/hime2_0046"),
),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...............」",
voice: Some("li/onnanoko_0027"),
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么了？难不成是讨厌冰激凌。」",
voice: Some("li/hime2_0047"),
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，不是的，不是这样的...」",
voice: Some("li/onnanoko_0028"),
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...假如，被妈妈看到的话会生气的吧。」",
voice: Some("li/onnanoko_0029"),
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「妈妈总是说不能吃冰激凌的...」",
voice: Some("li/onnanoko_0030"),
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她这样说着，寂寞地低下了头。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没，没问题啦，因为是和姐姐在一起啊。」",
voice: Some("li/hime2_0048"),
),
),
(
cmd: label,
args: (
name: "block_00171",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...真的？」",
voice: Some("li/onnanoko_0031"),
),
),
(
cmd: label,
args: (
name: "block_00172",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，医生和护士也不会生气的。」",
voice: Some("li/hime2_0049"),
),
),
(
cmd: label,
args: (
name: "block_00173",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，我明白了。」",
voice: Some("li/onnanoko_0032"),
),
),
(
cmd: label,
args: (
name: "block_00174",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "于是这次，她终于开心地拿起了小勺子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00175",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然或许是理所当然的，她可能从没来这里吃过一次吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00176",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...可是，像是这种年纪的小孩，不可能会讨厌冰激凌和巧克力的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我想着这样的事，正看着她慢慢享用的时候...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她却只是吃了几口后，便停下手来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...怎么了？」",
voice: Some("li/hime2_0050"),
),
),
(
cmd: label,
args: (
name: "block_00180",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说起来，妈妈...」",
voice: Some("li/onnanoko_0033"),
),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「最近呢，几乎都没有来看我。」",
voice: Some("li/onnanoko_0034"),
),
),
(
cmd: label,
args: (
name: "block_00182",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...............」",
voice: Some("li/hime2_0051"),
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「以前明明每天都来的...」",
voice: Some("li/onnanoko_0035"),
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...这......」",
voice: Some("li/hime2_0052"),
),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "除此之外我什么也回答不了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: set_bg,
args: (
image: "black-2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这孩子也没理由会知道，至少，我没办法告诉她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "你的父母已经走了。之后，你要一个人孤独地前往7楼去...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...我怎么可能说得出这样的话来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然，这实在很悲哀，但我也清楚的知道这是常有的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只留下病人，家人就这样消失。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "理由各种各样。经济上的，心理上的...",
voice: None,
),
),
(
cmd: label,
