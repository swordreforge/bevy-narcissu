),
),
(
cmd: label,
args: (
name: "block_00282",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "单纯地说谎是不行的，是错误的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00283",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我们都不是这种话就可以应付的小孩了。\n虽然不知道是谁告诉她的，但他的心情大概是一样的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00284",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于这种行为，如果要站在道德高点，\n去责备他们，说这不过是应付场面的伪善的话...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00285",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "希望能告诉直接与她接触的我们，有何其他解决的方法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00286",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果这种行为，被称作恶的话...那我们全部，也都是恶人吗。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00287",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...隐瞒事实的我也是同罪吗。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00288",
),
),
(
