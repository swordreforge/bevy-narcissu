args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...怎么了？姐姐？」",
voice: Some("li/onnanoko_0009"),
),
),
(
cmd: label,
args: (
name: "block_00097",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，哈哈，对不起。」",
voice: Some("li/hime2_0023"),
),
),
(
cmd: label,
args: (
name: "block_00098",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "陪护是什么？对于这问题我一时没办法总结出来，于是稍微沉默了一小会。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00099",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是呢...那个，像是朋友吧。」",
voice: Some("li/hime2_0024"),
),
),
(
cmd: label,
args: (
name: "block_00100",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...姐姐是？我的朋友？」",
voice: Some("li/onnanoko_0010"),
),
),
(
cmd: label,
args: (
name: "block_00101",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，所以，有什么事都可以跟我说，不用客气喔。」",
voice: Some("li/hime2_0025"),
),
),
(
cmd: label,
args: (
name: "block_00102",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我立刻，将她已经吃完的餐盘收拾好。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00103",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，抱歉...」",
voice: Some("li/onnanoko_0011"),
),
),
(
cmd: label,
args: (
name: "block_00104",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没什么没什么，朋友就不用客气啦。」",
voice: Some("li/hime2_0026"),
),
),
(
cmd: label,
args: (
name: "block_00105",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，嗯...」",
voice: Some("li/onnanoko_0012"),
),
),
(
cmd: label,
args: (
name: "block_00106",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对着似乎还在客气的女孩子，我继续说着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00107",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「而且啊，我很高兴呢。」",
voice: Some("li/hime2_0027"),
),
),
(
cmd: label,
args: (
name: "block_00108",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...为什么？」",
voice: Some("li/onnanoko_0013"),
),
),
(
cmd: label,
args: (
name: "block_00109",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「其实呢，从以前开始就想要个年龄差距很大的朋友。」",
voice: Some("li/hime2_0028"),
),
),
(
cmd: label,
args: (
name: "block_00110",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...............」",
voice: Some("li/onnanoko_0014"),
),
),
(
cmd: label,
args: (
name: "block_00111",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我也...一直想要有一个姐姐。」",
voice: Some("li/onnanoko_0015"),
),
),
(
cmd: label,
args: (
name: "block_00112",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶呀？那么就这样决定了喔。」",
voice: Some("li/hime2_0029"),
),
),
(
cmd: label,
args: (
name: "block_00113",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完，我把手伸了过去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00114",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「在这之后也请多多指教呢。」",
voice: Some("li/hime2_0030"),
),
),
(
cmd: label,
args: (
name: "block_00115",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，我这也是...」",
