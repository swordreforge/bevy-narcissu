args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「而我呢，也是想要扮演阿洛伊斯的人之一...」",
voice: Some("li/hime2_0013"),
),
),
(
cmd: label,
args: (
name: "block_00062",
),
),
