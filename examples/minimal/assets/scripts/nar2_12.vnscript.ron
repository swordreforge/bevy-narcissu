args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「早。」",
voice: Some("li/hime2_0014"),
),
),
(
cmd: label,
args: (
name: "block_00064",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嗯...早...」",
voice: Some("li/onnanoko_0001"),
),
),
(
cmd: label,
args: (
name: "block_00065",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "仰起身子，往这边看来的女孩子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00066",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "膝盖上，放着刚吃完的午餐餐盘，大概是刚吃过午餐吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00067",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那柔顺的头发让人印象深刻。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00068",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，真乖呢，全部都吃完了喔。」",
voice: Some("li/hime2_0015"),
),
),
(
cmd: label,
args: (
name: "block_00069",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯...」",
voice: Some("li/onnanoko_0002"),
),
),
(
cmd: label,
args: (
name: "block_00070",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...虽然我很讨厌花椰菜的。」",
voice: Some("li/onnanoko_0003"),
),
),
(
cmd: label,
args: (
name: "block_00071",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，姐姐你是...？」",
voice: Some("li/onnanoko_0004"),
),
),
(
cmd: label,
args: (
name: "block_00072",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，还没自我介绍呢。」",
voice: Some("li/hime2_0016"),
),
),
(
cmd: label,
args: (
name: "block_00073",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我是这次，负责照顾你的陪护喔。」",
voice: Some("li/hime2_0019"),
),
),
(
cmd: label,
args: (
name: "block_00074",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完，拿出了证明书给她看。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00075",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然对这种年纪的小孩，这样做也没什么意义，\n不过给对方看下证明，也是这里的规定。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00076",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，之后就请多多指教了喔。」",
voice: Some("li/hime2_0020"),
),
),
(
cmd: label,
args: (
name: "block_00077",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嗯...我也是...」",
voice: Some("li/onnanoko_0006"),
),
),
(
cmd: label,
args: (
name: "block_00078",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽说是应了我一声，但还是一脸懵懂的看着我",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00079",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「...不过，陪护的是什么？」",
voice: Some("li/onnanoko_0007"),
),
),
(
cmd: label,
args: (
name: "block_00080",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯？」",
voice: Some("li/hime2_0021"),
),
),
(
cmd: label,
args: (
name: "block_00081",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "意料之外的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00082",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然知道她大概还有很多事情不了解，不过没想到会连这也不知道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00083",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「和医生啊，护士啊不同吗？」",
voice: Some("li/onnanoko_0008"),
),
),
(
cmd: label,
args: (
name: "block_00084",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这...」",
voice: Some("li/hime2_0022"),
),
),
(
cmd: label,
args: (
name: "block_00085",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...这问题该怎么回答好呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00086",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "照顾你日常所需的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00087",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "普通的话这样回答也没关系吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00088",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，在这之后她要前往的是7楼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00089",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后我，是她的陪护。\n对于尼洛来说就是阿洛伊斯。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00090",
),
),
(
cmd: set_bg,
args: (
image: "black-2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "本来，在未被通知之前是不能住进7楼的。\n也就意味着，对您的治疗行动已经结束。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00091",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说直接一点的话，就是宣告您的死亡。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00092",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是在接受了这些说明，并且同意了这种方案，才可以住进去的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00093",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，普通的医院的话，安宁病房是几乎不会收留小孩子的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00094",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...不过，尼洛不同。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00095",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这个医院也不普通，更不用说她出自天主教徒家庭。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00096",
),
),
(
cmd: set_bg,
args: (
image: "byousitu2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
