),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「早安。」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00219",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，今天也很热呢。」",
voice: Some("li/hime2_0058"),
),
),
(
cmd: label,
args: (
name: "block_00220",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "和亲近的护士朋友，互相道着早安。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00221",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「如何？已经习惯这里了？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00222",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，原本，5楼也是单人间。」",
voice: Some("li/hime2_0059"),
),
),
(
cmd: label,
args: (
name: "block_00223",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她所指的「这里」是7楼的事情。\n习惯了吗？所问的，也不是我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00224",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难不成，晚上也一直在一起？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00225",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，差不多，睡在医院的病床上也已经习惯了...」",
voice: Some("li/hime2_0060"),
),
),
(
cmd: label,
args: (
name: "block_00226",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「果然没有监护人，各种事情都很辛苦呢...」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00227",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于这句话我暧昧地点了头。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00228",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "顺便一提，她所指的没有监护人...",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00229",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并不是指行踪不明音信全无之类的，而是指已经不存在于这个世界了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00230",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "关于死因，护士长虽然没有告诉我，但有听说不是因为事故，也不是因病而死。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00231",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...剩下的死因只剩下一个。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00232",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，也就不再追问下去了，互相之间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00233",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这是即使在现在，对于我们天主教徒来说也是重罪，是禁忌之一。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00234",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，要是有什么事情就和我说吧。」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00235",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，谢谢。」",
