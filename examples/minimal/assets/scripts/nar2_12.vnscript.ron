),
),
(
cmd: label,
args: (
name: "block_00238",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，今天看起来不错。」",
voice: Some("li/onnanoko_0040"),
),
),
(
cmd: label,
args: (
name: "block_00239",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她如往常一样，从床上轻轻地仰起上半身，往这边看过来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00240",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而我，则坐在了旁边的椅子上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00241",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，就维持着这种状态，几乎一整天都和她一起度过了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00242",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从窗口进来的眩目阳光，照耀着她的侧脸，有时候，也会说些无所谓的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00243",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "...这就是平常我们的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00244",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「今天也是，漂亮的花朵呢...」",
voice: Some("li/hime2_0063"),
),
),
(
cmd: label,
args: (
name: "block_00245",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在窗边装饰着，几个小小的花瓶。在那里也，映照出鲜艳的白色与黄色。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00246",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个呢，是护士姐姐装饰的。」",
voice: Some("li/onnanoko_0041"),
),
),
(
cmd: label,
args: (
name: "block_00247",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这样，真是不错呢。」",
voice: Some("li/hime2_0064"),
),
),
(
cmd: label,
args: (
name: "block_00248",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边回答着一边往黄色的非洲菊花瓶里浇上水。看她这个样子，似乎很高兴。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00249",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "乍看之下，是很平常的病房情景。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00250",
),
),
