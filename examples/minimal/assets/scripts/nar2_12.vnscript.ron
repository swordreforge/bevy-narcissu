),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，妈妈怎么不快点回来呢。」",
voice: Some("li/onnanoko_0049"),
),
),
(
cmd: label,
args: (
name: "block_00289",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「每次呢，妈妈都带着做好的布丁过来呢。」",
voice: Some("li/onnanoko_0050"),
),
),
(
cmd: label,
args: (
name: "block_00290",
),
),
(
cmd: dialogue,
args: (
speaker: None,
