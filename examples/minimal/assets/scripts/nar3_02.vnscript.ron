            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……不久，一直在旁边看的他的卫兵，向对方的随从说。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00084",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这样的话，请您退回吧」",
                voice: Some("li/n3hei_0067"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00085",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真不敢相信，居然被这种小孩子打败了……」",
                voice: Some("li/npetcm35_015"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00086",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那样的话，不如下次换你来挑战？」",
                voice: Some("li/n3hei_0068"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00087",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不，我只是个随从，不想用剑指向小女孩」",
                voice: Some("li/npetcm35_016"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00088",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说完，那个随从就离开了这里。",
