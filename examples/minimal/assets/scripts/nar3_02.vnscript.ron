            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00003",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，我在接受的内容并没到可以称为“指导”的程度。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00004",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "本来就是完全没有经验，直到前几天为止，就连剑都没拿过。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00005",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，连最起码的剑法都不会使用的话，就别想在这里继续活下去，我被这样告知。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00006",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
