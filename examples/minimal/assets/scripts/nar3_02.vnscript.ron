        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「公主殿下，抱歉了，受死吧……」",
                voice: Some("li/npetcm36_001"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00069",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边说着，对方轻率地靠近，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00070",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「！？」",
                voice: Some("li/npetcm36_002"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00071",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对方突然感到脚下的异常，滑倒了……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00072",
            ),
        ),
