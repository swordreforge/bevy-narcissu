            args: (
                speaker: None,
                text: "「尸体会马上被焚烧或掩埋」",
                voice: Some("li/n3hei_0070"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00100",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后卫兵加了句，“在被发现前就会被处理掉”。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00101",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在不仅仅是地板上的松脂和润滑剂，这边的刀刃上，也涂抹了毒液。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00102",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那个是就算只轻轻划破皮肤，也可以让对方麻痹迟钝的毒。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00103",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然这是卑鄙的手法，但一个不满十岁的孩子要想活下去，已经没有其他方法了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00104",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……这已经是第4个人了？」",
                voice: Some("li/n3kiri_0124"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00105",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯， 在这场战争结束之前，还会不断有人来吧……」",
                voice: Some("li/n3hei_0071"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00106",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从杀了第一个来这里的人到现在，已经过了6个月。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00107",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "反过来说，为了我能多活这半年，死的人数，也有四人了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00108",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "死了的四条人命，和我多苟延残喘半年。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00109",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "比起来，我并不知道孰轻孰重。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00110",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……只是，听说，这场战争好像还要打很长的时间。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00111",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我并不认为我能过几年这种生活。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00112",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "也不认为可以活到几年后。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00113",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，把这个涂上」",
                voice: Some("li/n3hei_0072"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00114",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这是什么？」",
                voice: Some("li/n3kiri_0125"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00115",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是泥，有治疗跌打损伤和扭伤部位降温的功效」",
                voice: Some("li/n3hei_0073"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00116",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，从皮口袋取出了泥。应该是，刚才我的脚撞到墙被他看到了吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00117",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……确实这种日子我觉得不会长久。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00118",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，像这样有老师的帮助，实际上我已经多活了半年了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00119",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……那么，虽然只有一点点可能性，或许……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00120",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "偶然，会考虑那样的事，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00121",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "3010b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我说你啊……」",
                voice: Some("li/n3hei_0074"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00122",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不要因为叫了我老师……就轻易地相信我」",
                voice: Some("li/n3hei_0075"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00123",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「欸……」",
                voice: Some("li/n3kiri_0127"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00124",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不对，不止是我，不要相信任何人」",
                voice: Some("li/n3hei_0076"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00125",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……连老师也？」",
                voice: Some("li/n3kiri_0128"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00126",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，没有例外」",
                voice: Some("li/n3hei_0077"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00127",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，面上露出了有点寂寞的面容，继续说着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00128",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我的任务， 只是让你别死而已」",
                voice: Some("li/n3hei_0078"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00129",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: Some("li/n3kiri_0129"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00130",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「当我没能保护好你的时候，我也会被杀死」",
                voice: Some("li/n3hei_0079"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00131",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「原来……是这样……」",
                voice: Some("li/n3kiri_0130"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00132",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边点头，一边很小声地嘟哝着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00133",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……我，再一次，对自己说着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00134",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "老师的目的并不是帮助我。只不过是为了自己罢了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00135",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "………………",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00136",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "bg_0011",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那之后的数个月后。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00137",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "跨过秋冬，已经是春天过了快一半的时候了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00138",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "今天在这个地方，也有某人和我对峙的身影。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00139",
            ),
        ),
        (
            cmd: play_bgm,
            args: (
                id: "88",
                volume: Some(0.78431374),
                fade_ms: Some(500),
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "na03_05",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "像平时来这里的人一样，浮现出了冷笑。同样也并不知道名字。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00140",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "牢房的前方，老师和，另一个那个某人的随从在看着这边。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00141",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……从那天开始，已经扼杀了十个人的性命了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00142",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "心想，已经死了那么多人了，\n应该会流出什么奇怪的传言，然后谁都不敢来了吧。不过事情却没什么改变。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00143",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看起来每2~3个月就会有一个人来的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00144",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一开始大多数是衣冠端正的骑士般的人居多，现在似乎那种人渐渐减少了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00145",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "最近，像是战败后丢盔弃甲的人来得却很多。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00146",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "即使那样，对手的性质并没有改变。\n他们只是数字而已。不管是谁，都必须全部杀掉。不杀死他们我就会被杀。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00147",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……干脆让谁都不能进来这牢房不就好了？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00148",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然我向老师说了不知多少次，但那似乎是办不到的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00149",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然我不懂国家啊，\n政治这些事，但似乎如果他们想来这里的话，这里就必须允许进入才行。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00150",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且，我并不是怀疑老师所说的话，但是骑士这类人真是奇怪。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00151",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明知那单挑决胜可以说是场闹剧，却绝对没人会反对这个条件。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00152",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我并不知道是形式上还是自尊心上的问题……\n似乎他们不能把手无寸铁的……而且是小女孩的人当对手。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00153",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，骑士里也有些人并不介意那样的事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00154",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，以前被我打倒的人……开始说话时，都会让我拿上剑。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00155",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……就算这是场闹剧，但他们一定也有着自己的想法吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00156",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「（……还是说，我又被什么其他的东西利用着呢……）」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00157",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "是因为这种杂念充满着我的内心吧……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00158",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
