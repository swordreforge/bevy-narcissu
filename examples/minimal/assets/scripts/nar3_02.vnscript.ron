                file: "kiru02",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我向他的脸上刺了过去。因为他身体露出来的其他部位很少。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00074",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哇~」",
                voice: Some("li/npetcm36_003"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00075",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "转眼间，传出了浑浊的声音，脸上流着血，蹲在那里的年轻的见习骑士。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00076",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为事发突然，他用手捂着面，蹲在地板上，已是完全失去了防备的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00077",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……这全部都像老师的预想一样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00078",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我按着教导的那样，站在他背后，对着毫无防备的脖子挥出剑。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00079",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00080",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯……」",
                voice: Some("li/n3kiri_0121"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00081",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "kiru01_1",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一用力，把剑向正下方压下去。\n与此同时，那不能说是黑色也不能说是红色的血液猛喷出来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00082",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在石制地板上形成那黑色水潭的人，只是手脚稍微动了动，就立刻沉默了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
