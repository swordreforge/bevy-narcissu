        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，我说过，剑不能离手吧……」",
                voice: Some("li/n3hei_0053"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00009",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，嗯……对不起」",
                voice: Some("li/n3kiri_0109"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00010",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不必道歉， 要是战斗中的话就是死，仅此而已」",
                voice: Some("li/n3hei_0054"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00011",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: Some("li/n3kiri_0110"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00012",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不想死的话就绝对不要放开剑。你就当手和剑粘在一起了」",
                voice: Some("li/n3hei_0055"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00013",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，我知道了……」",
                voice: Some("li/n3kiri_0111"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00014",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我再次拿着剑站起来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00015",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "na03_06",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "他说，像以前一样对方是一个人来的话，他就可以对来者出手。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00016",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只要在我跟对方对峙的时候，他从背后偷袭就行了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00017",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "重要的是，只要杀死了就不会留下证据。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00018",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "再怎么说，一个大人被像我这样的小姑娘杀死，是很难公开说出来的事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00019",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，如果对方不是一个人来的话，就另当别论了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00020",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为卫兵不好出手，只能别无选择的由我把对方打倒。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00021",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "3011c",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「虽然听起来很愚蠢，但他们也算是有自尊的……」",
                voice: Some("li/n3hei_0056"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00022",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「如果一个小女孩对他们做出一对一的挑战，他们是不得不接受的」",
                voice: Some("li/n3hei_0057"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00023",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且，那简直就像是场闹剧，是伪善……卫兵接着说道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00024",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "的确如卫兵所说。即使我拿起剑来战斗也没任何意义。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00025",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但事实上，多亏了这种闹剧，我才看到了一丝生路。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00026",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，如果失败的话，就意味着死。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00027",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但反过来说，只要把对方打败，就意味着可以活下去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00028",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「为了今后，我教你这里的常识。赌上自己的性命，就跟死了一样」",
                voice: Some("li/n3hei_0058"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00029",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: Some("li/n3kiri_0112"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00030",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「因此，自己的命要靠自己来保护……」",
                voice: Some("li/n3hei_0059"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00031",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后便开始在石制地板上涂抹着什么东西。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00032",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，这个位置要好好的记住」",
                voice: Some("li/n3hei_0060"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00033",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……那是？」",
                voice: Some("li/n3kiri_0113"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00034",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这里涂了熬干了的松脂。旁边涂抹的是反方向滑的润滑油」",
                voice: Some("li/n3hei_0061"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00035",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「为什么要这样做？」",
                voice: Some("li/n3kiri_0114"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00036",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不管是什么对手， 在什么都不知道的情况下靠近你的话绝对都会滑倒」",
                voice: Some("li/n3hei_0062"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00037",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你就趁这个间隙向头刺去。脸也可以。反正是要给他致命的一击」",
                voice: Some("li/n3hei_0063"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00038",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "卫兵一边说着，一边做了个突刺的姿势给我看。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00039",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "3011c",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: Some("li/n3kiri_0115"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00040",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……想说这很卑鄙吗？」",
                voice: Some("li/n3hei_0064"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00041",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不，不是的……」",
                voice: Some("li/n3kiri_0116"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00042",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为要是普通去战斗的话，根本没有胜算。这点我也知道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00043",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过，要是搞错位置的话，反而会自己滑倒变得处于劣势。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00044",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对于连公平的战斗都没胜算的我来说，再加上陷入劣势的话就等同于死了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00045",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你，想生存下去吧？」",
                voice: Some("li/n3hei_0065"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00046",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……嗯」",
                voice: Some("li/n3kiri_0117"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00047",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么就拼死给我把位置记好了。没有其它什么方法让你活下去了」",
