        ),
        (
            cmd: label,
            args: (
                name: "block_00054",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "漫长的冬天结束了……春天到来，继而到来是，炎热的夏天。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00055",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知不觉来到这里已经6个月了，看来战争还在继续着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00056",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "今天在这里，我正和不知名的谁在对峙着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00057",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "na03_05",
                transition: Some(fade(
                    duration: 0.8,
                )),
