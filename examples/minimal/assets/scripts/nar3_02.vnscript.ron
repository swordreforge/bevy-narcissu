            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "与离开的随从交错，进来了几个下人，把那个不知名的骑士的尸体抬走了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00090",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……这也是司空见惯的场景了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00091",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "恐怕，那位骑士会被说成是病死之类的吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00092",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果像老师曾说过的那样，无论是现在还是以后，绝对不会闹出大骚动的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00093",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不久，下人离开了，这里又变成只有我和老师两个人。",
                voice: None,
