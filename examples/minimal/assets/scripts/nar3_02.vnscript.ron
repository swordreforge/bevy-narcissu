            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这时，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00073",
            ),
        ),
        (
            cmd: play_se,
