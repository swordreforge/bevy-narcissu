            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对方冷笑着，步步逼近。看服饰，恐怕是个年轻的见习骑士。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00058",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从牢房外面，看着我们两人的，是那个卫兵和像是骑士的随从的人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00059",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "像这种有带随从的时候，就只有我自己打倒他了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00060",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，和我对峙着的这个人，即使是给了我一把剑，也没有一点害怕的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00061",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且全身包裹着护甲像骑士一样的，只是没有戴头盔。让我看到他的脸。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00062",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "似乎是觉得对我这样的小女孩，没有那个必要吧……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00063",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "露出面容也说不定，是对过去的公主最低限度的礼仪。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00064",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是，和一脸从容慢慢靠近我的骑士相反，我却站在原地一动不动。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00065",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "老师告诉我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00066",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "要尽量摆出弱小的姿势，胆怯的表情等对方过来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00067",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "恐怕是为了让对方轻敌吧，不过就算没下指示，我也自然而然也会流露出来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00068",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
