            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「好痛……」",
                voice: Some("li/n3kiri_0108"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00007",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "沉重的剑和不习惯的皮手套。单单只是把剑拿起我就几乎要用尽全力。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00008",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "3011c",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
