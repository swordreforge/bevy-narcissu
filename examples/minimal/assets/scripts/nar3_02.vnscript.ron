            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐，老师……」",
                voice: Some("li/n3kiri_0122"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00095",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我对卫兵说。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00096",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知什么时候开始，我称呼他为老师。当然只是在没有其他人的时候。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00097",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不会从尸体上发现下毒的痕迹吗？」",
