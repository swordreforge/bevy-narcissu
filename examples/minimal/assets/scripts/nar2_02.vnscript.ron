),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呜，昨天才刚洗好的…」",
voice: Some("li/chihiro-0007"),
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是是，真是抱歉呢…」",
voice: Some("li/himeko-0006"),
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像往常一样对着满身油污的姐姐抱怨着的妹妹。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以及星期日在玄关前的无聊对话，一切都是琐碎的日常光景。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: play_se,
args: (
file: "kane02d",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，比起这个，再不快一点的话弥撒会迟到哦」",
voice: Some("li/chihiro-0008"),
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎呀，已经都这个时间了呢…」",
voice: Some("li/himeko-0007"),
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就是就是，快一点换衣服去教堂吧…」",
voice: Some("li/chihiro-0009"),
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯…果然还是不去了」",
voice: Some("li/himeko-0008"),
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶？又不去了？」",
voice: Some("li/chihiro-0010"),
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这样不行的，因为姐姐平常都没去…」",
