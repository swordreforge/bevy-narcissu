),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这么说的话，难不成…」",
voice: Some("li/yuka-0037"),
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「从刚刚到现在，只是看心情随便开的？」",
