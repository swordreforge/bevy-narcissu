args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「可是啊，姬子…」",
voice: Some("li/yuka-0041"),
),
),
(
cmd: label,
args: (
name: "block_00176",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什么？」",
voice: Some("li/himeko-0072"),
),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没有导航系统的话至少也拜托把地图带着吧」",
voice: Some("li/yuka-0042"),
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，不过我喜欢这种随意开车的感觉…」",
voice: Some("li/himeko-0073"),
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，至少不要再穿成这样啊」",
voice: Some("li/yuka-0043"),
),
),
(
cmd: label,
args: (
name: "block_00180",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯～为什么？我明明很喜欢工作服的…」",
voice: Some("li/himeko-0074"),
),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不行，因为在旁边的我会觉得很丢脸」",
voice: Some("li/yuka-0044"),
),
),
(
cmd: label,
args: (
name: "block_00182",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「切，明明很实用的…」",
voice: Some("li/himeko-0075"),
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…比起实用性，应该先优先考虑美观吧。」",
voice: Some("li/yuka-0045"),
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
(
cmd: play_se,
args: (
file: "anami2",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "两个人一边聊着一边吃着便利商店的便当。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "随着海风吹拂而摇动的松林和高耸的海枣树。\n有时候海鸥也会靠过来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，尽管是如此引人入胜的场景…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "该怎么说呢，在风景如画的沙滩上铺着的报纸，\n和穿着褶边洋装的优花身边，穿着工作服的我，这一幕实在非常滑稽。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「要不，下周也来吧？」",
voice: Some("li/himeko-0076"),
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「才不要」",
voice: Some("li/yuka-0046"),
),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哇，拒绝得好快」",
voice: Some("li/himeko-0077"),
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「毕竟，你不觉得有点悲惨么，每周每周两个女生像笨蛋一样来着闲晃」",
voice: Some("li/yuka-0047"),
),
),
(
cmd: label,
args: (
name: "block_00192",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为这是双人乘坐的啊…」",
voice: Some("li/himeko-0078"),
),
),
(
cmd: label,
args: (
name: "block_00193",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不是因为这个问题吧」",
voice: Some("li/yuka-0048"),
),
),
(
cmd: label,
args: (
name: "block_00194",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没事啦没事啦，你寂寞我也寂寞啦…」",
voice: Some("li/himeko-0079"),
),
),
(
cmd: label,
args: (
name: "block_00195",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呜…」",
voice: Some("li/yuka-0049"),
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…虽然很不甘心不过却没办法反驳」",
voice: Some("li/yuka-0050"),
),
),
(
