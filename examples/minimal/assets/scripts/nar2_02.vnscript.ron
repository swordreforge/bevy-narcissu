),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，其实呢，是这样…」",
voice: Some("li/himeko-0068"),
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我只是在随便开啦，碰巧到了这边而已…」",
