),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真是笨蛋呢，千寻…」",
voice: Some("li/himeko-0009"),
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「正因为是难得的星期日所以才要翘掉的啊」",
