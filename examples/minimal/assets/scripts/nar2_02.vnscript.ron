args: (
speaker: None,
text: "出游这种事，本应当是自己准备便当的，\n但这对于只擅长做水煮蛋的我们来说实在要求过高。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00174",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，至少也应该带个野餐布来的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00175",
),
),
(
cmd: set_bg,
args: (
image: "umibe",
transition: Some(fade(
duration: 0.8,
)),
),
),
