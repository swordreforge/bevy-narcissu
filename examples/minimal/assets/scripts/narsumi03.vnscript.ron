args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……之后母亲跟两边病房中的病人、护士还有护工们都打了招呼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这所有人都声音和蔼的安稳氛围中，偷偷看我的人们都……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "“这么年轻真是可怜啊……”",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有这微妙的感觉。虽然没说出声，但那个眼神，在这么说。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，明天还会再来的，我们就先回去了哦」",
voice: Some("li/0snhaha_0014"),
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "伴随着温和的笑容，在不知何处有些生硬的氛围中，母亲离开了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在离开的时候，",
