),
),
(
cmd: label,
args: (
name: "block_00544",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你想让我做什么？想要我变成什么样子？」",
voice: Some("li/0snaka_0150"),
),
),
(
cmd: label,
args: (
name: "block_00545",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，那是……」",
