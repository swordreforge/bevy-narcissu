args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不过啊，这下子你就可以去任何地方了」",
voice: Some("li/0snyuka_0098"),
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哪都不去。也没有车」",
voice: Some("li/0snaka_0123"),
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那就买啊，就那种很酷很帅的，反正你是有钱人」",
voice: Some("li/0snyuka_0099"),
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没兴趣」",
voice: Some("li/0snaka_0124"),
),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对。并没什么想要去哪里的想法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还也只是优花一直在耳边念叨，我才勉强去考的驾照……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00192",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "既然选择了闭眼的世界……对于“这边”的事我什么也不打算去做。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00193",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我所选择的，不是这个世界……",
voice: None,
),
),
(
