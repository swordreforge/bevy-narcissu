args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "总共有12册的厚重的书。打开了其中写着《地球·宇宙》的那本。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00216",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是我小学入学的时候，从哥哥那里拿到的旧书。直到现在我都从没翻开看过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00217",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "书中记载的，是配以美丽照片和插画所共同解说的大量星座和星星。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00218",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在昏暗的房间中，来回对照那一页的天体照片和窗外的景色的我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00219",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "仿佛开了灯的话，星星就会消失了一样，就这么保持着黑暗……",
voice: None,
),
),
