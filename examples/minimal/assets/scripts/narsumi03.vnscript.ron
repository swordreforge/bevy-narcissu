text: "「欸……」",
voice: Some("li/0snyuka_0110"),
),
),
(
cmd: label,
args: (
name: "block_00460",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我，哪里都没有变哦」",
voice: Some("li/0snaka_0132"),
),
),
(
cmd: label,
args: (
name: "block_00461",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就好像是看穿了我现在的想法一样的发言。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00462",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我啊……只是不跟任何人有什么人情借贷而已」",
voice: Some("li/0snaka_0133"),
),
),
(
cmd: label,
args: (
name: "block_00463",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "又是一如既往的，这句台词。已经不知道听了有多少次了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00464",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像这样不肯接纳任何人的态度，从开始认识到现在，都一以贯之。没有动摇过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00465",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但她应该也已经发现其中的矛盾了吧？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00466",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边说着不跟任何人交流，现在却还是在跟我对话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00467",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边说着什么也不想做，却玩着堆成山的游戏，还拿了驾照，也会去7F。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00468",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……所以我要说的话也不会变。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00469",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这种程度就哑口无言的话，早就没法和她一起相处这么多年了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00470",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好嘞。那就久违的去一次吧？」",
voice: Some("li/0snyuka_0111"),
),
),
(
cmd: label,
args: (
name: "block_00471",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不用了。话说你倒是自己去啊」",
voice: Some("li/0snaka_0134"),
),
),
(
cmd: label,
args: (
name: "block_00472",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好啦好啦，别那么说嘛。我会载你去的」",
voice: Some("li/0snyuka_0112"),
),
),
(
cmd: label,
args: (
name: "block_00473",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着，我单方面的把她赶出了房间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00474",
),
),
