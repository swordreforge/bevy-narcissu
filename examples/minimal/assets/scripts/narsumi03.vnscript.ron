),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哇，等下，别拉我的手」",
voice: Some("li/0snaka_0135"),
),
),
(
cmd: label,
args: (
name: "block_00475",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，干脆，让明来开车试试看？」",
voice: Some("li/0snyuka_0113"),
),
),
(
cmd: label,
args: (
name: "block_00476",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不要。话说别对只是有证的人说些不可能的话啊」",
voice: Some("li/0snaka_0136"),
),
),
(
cmd: label,
args: (
name: "block_00477",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「开车什么的很简单的啦，习惯了就好了」",
voice: Some("li/0snyuka_00114"),
),
),
(
cmd: label,
args: (
name: "block_00478",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我拉着还在不停抱怨的明的手，强行把她带了出去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00479",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不这样的话她是不会动的，经过这么几年的交往下来，我早已搞清楚了。",
voice: None,
),
),
