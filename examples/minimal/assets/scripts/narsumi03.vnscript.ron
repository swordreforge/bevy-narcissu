voice: None,
),
),
(
cmd: label,
args: (
name: "block_00514",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「再待一会儿嘛，好不容易才来一趟」",
voice: Some("li/0snyuka_0119"),
),
),
(
cmd: label,
args: (
name: "block_00515",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不要啦。这么压抑的地方，只会觉得无聊」",
voice: Some("li/0snaka_0140"),
),
),
(
cmd: label,
args: (
name: "block_00516",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好了啦。那就去下食堂吧。你还没去过吧」",
voice: Some("li/0snyuka_00120"),
),
),
(
cmd: label,
args: (
name: "block_00517",
),
),
