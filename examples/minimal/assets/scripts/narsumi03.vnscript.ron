),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这里还是那么令人郁闷呢……」",
voice: Some("li/0snaka_0138"),
),
),
(
cmd: label,
args: (
name: "block_00488",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后重重地坐到了大沙发上，开始用电视遥控器不停变换起电视频道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00489",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算有7F的人正在看着电视也毫不在意。而7F的人似乎也没有什么不满。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00490",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "大概是因为对她的行为已经习惯了吧，只是盯着不紧不慢换着台的电视频道而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00491",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……基本上，明每次到这里来也不是什么都不做的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00492",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也没有谁跟她特别脸熟，会跟她说说话。\n就只是坐在谈话室的椅子上，呆呆地望着电视机。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00493",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但似乎偶尔也会去观察这里的人们。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00494",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对于头脑很好的她来说，肯定仅凭此就能感觉到些什么了吧。",
voice: None,
),
),
(
