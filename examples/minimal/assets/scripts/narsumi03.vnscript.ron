args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不一会儿，我被带到了走廊尽头的房间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哇，非常好看的房间呢」",
voice: Some("li/0snhaha_0013"),
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "发出如此感叹，向我作出微笑的母亲。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "之后根据护士的说明，似乎这里采用的窗户很大，而且设计上可以保证很好的采光。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "窗户很宽阔，让人感到一切都很干净漂亮。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "床一定也是接近全新的吧。纯白的床单在耀眼的日光下十分晃眼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: set_bg,
args: (
image: "2b",
transition: Some(fade(
