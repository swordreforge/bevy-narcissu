),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「又在浇水吗？」",
voice: Some("li/0snsumi_0075"),
),
),
(
cmd: label,
args: (
name: "block_00302",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯。早上和傍晚的两次……」",
voice: Some("li/0snsetu_0008"),
),
),
(
cmd: label,
args: (
name: "block_00303",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对才刚冒出芽，冷冷清清的花坛浇着水。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00304",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "感觉跟其他区域盛开的鲜艳的夏秋花朵相比起来，只有那一片显得十分寂寥。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00305",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那……是什么花？」",
voice: Some("li/0snsumi_0076"),
),
),
(
cmd: label,
args: (
name: "block_00306",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "没什么特别的意思。只是顺口问了一下。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00307",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然而她却愣了一下……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00308",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「narcissus……是水仙」",
voice: Some("li/0snsetu_0009"),
),
),
(
cmd: label,
args: (
name: "block_00309",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "简短地回应道。依旧看着花坛，并没有看向我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00310",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……水仙。有听过这个名字。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00311",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但知道得不详细。只是记得是一种白色的花的程度。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00312",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话说回来，你决定了吗？」",
voice: Some("li/0snsetu_0010"),
),
),
(
cmd: label,
args: (
name: "block_00313",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什么事？」",
voice: Some("li/0snsumi_0077"),
),
),
(
cmd: label,
args: (
name: "block_00314",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「家里或者7F……在哪里死的事情」",
voice: Some("li/0snsetu_0011"),
),
),
(
cmd: label,
args: (
name: "block_00315",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看着我手腕上戴着的白色塑料手环说到。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00316",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "才在刚才听说了规则，正好在思考这件事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00317",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没什么，哪边都行……」",
voice: Some("li/0snsumi_0078"),
),
),
(
cmd: label,
args: (
name: "block_00318",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「为什么？」",
voice: Some("li/0snsetu_0012"),
),
),
(
cmd: label,
args: (
name: "block_00319",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呃？就算你问我……」",
voice: Some("li/0snsumi_0079"),
),
),
(
cmd: label,
args: (
name: "block_00320",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我真的觉得那边都无所谓，并没有去想更复杂的了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00321",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，在哪边死？我觉得这个和我自身的意愿没什么关系吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00322",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说到底也就只是随着病情的发展，等到了时间就会有的结果。\n硬要说的话无非是看“运气”而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00323",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我不想在家里……但是，也不想在7F……」",
voice: Some("li/0snsetu_0013"),
),
),
(
cmd: label,
args: (
name: "block_00324",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，要怎么办？」",
voice: Some("li/0snsumi_0080"),
),
),
(
cmd: label,
args: (
name: "block_00325",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「还没有想过……」",
voice: Some("li/0snsetu_0014"),
),
),
(
cmd: label,
args: (
name: "block_00326",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听起来有些落寞的答案。我在意到了她说的那个“还没”。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00327",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也就是说，已经做好某天会去7F的觉悟了吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00328",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……而我却直到现在，对此还是没有什么真实感……",
voice: None,
),
),
(
