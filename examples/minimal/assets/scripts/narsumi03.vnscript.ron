),
),
(
cmd: label,
args: (
name: "block_00552",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "把我这样的人当成挚友的姬子一样……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00553",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……不知道。",
voice: None,
),
),
(
