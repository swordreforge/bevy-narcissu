),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……朋友…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00164",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…我觉得应该不是。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00165",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "至少，我没有那种想法。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那把她赶走不就好了，我却没那么做。老实说，我自己也不知为何。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「对了，考试怎么样了？」",
voice: Some("li/0snyuka_0091"),
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「拿到了……」",
voice: Some("li/0snaka_0117"),
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哇，很厉害嘛。笔试也是一次就通过」",
voice: Some("li/0snyuka_0092"),
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这里说的拿到指的是驾照。是我毫无兴趣的玩意。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00171",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是因为优花一直在唠叨，勉为其难去驾校学了下，终于把驾驶证拿到手了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00172",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说不定，你很有开车的才能嘞？」",
voice: Some("li/0snyuka_0093"),
),
),
(
cmd: label,
args: (
name: "block_00173",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说啥呢？莫名其妙的」",
voice: Some("li/0snaka_0118"),
),
),
(
cmd: label,
args: (
name: "block_00174",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「毕竟你科二都一把就过，科三也是一把就通过的吧？\n这不就代表你有开车的才能嘛？」",
voice: Some("li/0snyuka_0094"),
),
),
(
cmd: label,
args: (
name: "block_00175",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没有啦。真是的，一把一把的烦死了」",
voice: Some("li/0snaka_0119"),
),
),
(
cmd: label,
args: (
name: "block_00176",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎，赶紧把驾驶证给我看看吧」",
voice: Some("li/0snyuka_0095"),
),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不要」",
voice: Some("li/0snaka_0120"),
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「让我看看嘛。别那么小气啦」",
voice: Some("li/0snyuka_0096"),
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说着站起身，向我靠了过来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00180",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "别看优花这样，还挺缠人的。回想起来最开始相遇的时候也是很不客气。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呼-真拿你没办法……」",
voice: Some("li/0snaka_0121"),
),
),
(
cmd: label,
args: (
name: "block_00182",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不太情愿，但是我还是放弃了。然后拿出崭新的驾驶证，递到她手上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: set_bg,
args: (
image: "2b",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
