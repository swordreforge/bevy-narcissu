),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不久眼前出现了一条宽阔的大道。路过的行人纷纷对着穿着睡衣的我侧目。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00074",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但也没有特别在意，直接就走过去了。因为旁边就是医院吧。",
