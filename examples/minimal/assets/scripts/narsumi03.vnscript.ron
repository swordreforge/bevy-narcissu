),
),
(
cmd: label,
args: (
name: "block_00532",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "直直的盯着我的她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00533",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那敏锐的洞察力，毫不动摇的视线，都让我想起了姬子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00534",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以我老实回答到。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00535",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「大概……是吧」",
voice: Some("li/0snyuka_0124"),
),
),
(
cmd: label,
args: (
name: "block_00536",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「肯定是把你和她重叠了吧……」",
voice: Some("li/0snyuka_0125"),
),
),
(
cmd: label,
args: (
name: "block_00537",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「果然。我就知道」",
voice: Some("li/0snaka_0145"),
),
),
(
cmd: label,
args: (
name: "block_00538",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「还有，我是说大概……那个人已经去世了吧？」",
voice: Some("li/0snaka_0146"),
),
),
(
cmd: label,
args: (
name: "block_00539",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说的没错」",
voice: Some("li/0snyuka_00126"),
),
),
(
cmd: label,
args: (
name: "block_00540",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「而且我和那人的面貌也比较相似吧？」",
voice: Some("li/0snaka_0147"),
),
),
(
cmd: label,
args: (
name: "block_00541",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「至少是可以让你重叠上去的相似」",
voice: Some("li/0snaka_0148"),
),
),
(
cmd: label,
args: (
name: "block_00542",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，这也无法否定」",
voice: Some("li/0snyuka_0126"),
),
),
(
cmd: label,
args: (
name: "block_00543",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，我就直说了……」",
