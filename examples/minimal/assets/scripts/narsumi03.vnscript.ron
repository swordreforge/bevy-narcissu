(
cmd: dialogue,
args: (
speaker: None,
text: "上面记载了各种各样的事情。说实话，意义不明的留言也有很多。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00279",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "比如一开始像是要写遗书，结果慢慢变成对某人道歉的话语……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00280",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不一会儿，我的目光停留在了写在最后的一句话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00281",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……可以交朋友吗？」",
voice: Some("li/0snsumi_0074"),
),
),
(
cmd: label,
args: (
name: "block_00282",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是什么意思呢？明明之前还写着不行的？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00283",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "思考了一会儿后，我注意到了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00284",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这是不同的人写的东西。也就是说，这大概是由好几个人写下的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00285",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一开始还以为只是些情报和建议，但又不止这些的感觉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00286",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "倒不如说，大概是类似讯息之类的东西……",
voice: None,
),
),
(
