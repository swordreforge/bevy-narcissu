),
),
(
cmd: label,
args: (
name: "block_00523",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……回想起来，和姬子来这里时也是这样的感觉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00524",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在4F住院的时候，乘着医生不注意，总是到这里来吃冰淇淋。我也总是陪着她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00525",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后2人都被骂。每到那时千寻酱就会说着“算了算了”的来解围。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00526",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那之后，已经过去多少年了呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00527",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "呆呆这么想着的时候，明停下了手上飞舞的勺子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00528",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我说优花……能提一个问题吗？」",
voice: Some("li/0snaka_0143"),
),
),
(
cmd: label,
args: (
name: "block_00529",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……怎么了？」",
voice: Some("li/0snyuka_0122"),
),
),
(
cmd: label,
args: (
name: "block_00530",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你不会……把我和某人重叠在一起了吧？」",
voice: Some("li/0snaka_0144"),
),
),
(
cmd: label,
args: (
name: "block_00531",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
