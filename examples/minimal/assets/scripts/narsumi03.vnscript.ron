),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，在对向而坐的餐桌上，放上了4盘冰淇淋。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00519",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这是……冰淇淋？」",
voice: Some("li/0snaka_0141"),
),
),
(
cmd: label,
args: (
name: "block_00520",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「菜单上也只有香草味的，量还这么少……」",
