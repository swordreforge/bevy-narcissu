),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说起来优花小姐…….」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00496",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "熟人的护士小声的在耳边说着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00497",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「前几天，这里又来新人了。你知道吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00498",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什么样的人？」",
voice: Some("li/0snyuka_0116"),
),
),
(
cmd: label,
args: (
name: "block_00499",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是个还很年轻的女孩」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00500",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这还真是挺少见的。基本上这里都是些上了年纪的老年人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00501",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「身材娇小，头发很长……感觉看起来很是可爱」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00502",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……身材娇小又很可爱？」",
voice: Some("li/0snyuka_00117"),
),
),
(
cmd: label,
args: (
name: "block_00503",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这个形容，好像想到了某个符合这些的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00504",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在很早以前，曾经说一次话的女孩。姬子十分关心的一个孩子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00505",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "记得那孩子的名字是……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00506",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难道是……叫濑津美的女孩？」",
voice: Some("li/0snyuka_0117"),
),
),
(
cmd: label,
args: (
name: "block_00507",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不是，不叫这个名字」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00508",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是吗……那就还好……」",
voice: Some("li/0snyuka_0118"),
),
),
(
cmd: label,
args: (
name: "block_00509",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "按照姬子所说的，只是觉得那孩子似乎也是病人。\n就算真是病人，也并不一定就是这个医院的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00510",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "何况从那时起也已经过去5年多了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00511",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果那时就已经病得很重了的话，已经离世了的可能性也很高。",
voice: None,
),
),
