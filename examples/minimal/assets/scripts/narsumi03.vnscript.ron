),
),
(
cmd: label,
args: (
name: "block_00521",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边抱怨着，一边一口一口吃着的明。虽然是打算一人2个的，但似乎还不够她吃的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00522",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我呆呆地望着,她那不停地挥舞着勺子的身影。",
