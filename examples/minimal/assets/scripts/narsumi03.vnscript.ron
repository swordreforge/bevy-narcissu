),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你好，好久不见」",
voice: Some("li/0snyuka_0114"),
),
),
(
cmd: label,
args: (
name: "block_00482",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "到了7F。我对着护士站轻轻点头打了下招呼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00483",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你好，优花小姐……今天明小姐也一起来了呢」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00484",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，因为她最近好像都没怎么来。就一起带过来了」",
voice: Some("li/0snyuka_0115"),
),
),
(
cmd: label,
args: (
name: "block_00485",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「真是，多管闲事……」",
voice: Some("li/0snaka_0137"),
),
),
(
cmd: label,
args: (
name: "block_00486",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "丢下这句台词的同时，明独自快步走向了谈话室。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00487",
),
),
