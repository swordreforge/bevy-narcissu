),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「噗噗噗，这张有趣的脸是什么鬼？太紧张啦」",
voice: Some("li/0snyuka_0097"),
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「吵死了，快还给我」",
voice: Some("li/0snaka_0122"),
),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以说我才不想给她看驾驶证……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: set_bg,
args: (
image: "bg_a0012",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
