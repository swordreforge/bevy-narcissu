channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并没有什么目的。只是…不想待在病房…待在7F而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00289",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "——7F或者家中。只会死在其中之一，无人例外。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00290",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "刚刚在读的规则上是这么写的。大概就是那样吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00291",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以我，不知道怎么说，就是不想待在这两个地方。我想肯定没什么别的深意。",
voice: None,
),
),
(
cmd: label,
args: (
