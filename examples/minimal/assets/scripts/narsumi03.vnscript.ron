args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在夕阳映照的天空之下，还是老样子，似乎在给花坛浇着水。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00296",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "和早上见到她的时候一样，独自一人提着花洒浇着水。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00297",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……虽然这个女孩肯定也是住院患者，但真的可以这样随便给花坛浇水吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00298",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不禁又冒出了和早晨一样的疑问。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00299",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，在我准备就这样视而不见的时候……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00300",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "“可以交朋友吗”刚刚读到过的规则，忽然浮现在了脑中。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00301",
),
),
(
