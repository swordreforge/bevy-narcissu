        (
            cmd: label,
            args: (
                name: "block_00283",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "站在那里的是，穿着围裙的日下。不知为何理所当然似的在厨房里做着饭。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00284",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哎呀，早上了，我只是来接你的而已……」",
                voice: Some("li/n4yoko_0192"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00285",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那你为什么会在我家的厨房里面做饭啊？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00286",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，被小妹拜托了嘛……啊哈哈哈哈」",
                voice: Some("li/n4yoko_0193"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00287",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "可恶，博美这家伙。因为自己做太麻烦了所以强行推给日下。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00288",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看来，她刚刚暗自偷笑就是因为这个……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00289",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，说起来莳绘君，你喜欢哪种呢？」",
                voice: Some("li/n4yoko_0194"),
