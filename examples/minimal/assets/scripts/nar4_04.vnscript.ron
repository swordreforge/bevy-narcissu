        (
            cmd: label,
            args: (
                name: "block_00057",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一如往常的晚饭后，到了定期巡视的时间。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00058",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不……不要紧吧？老爷爷」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00059",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "是之前的那个人。晚饭后，我在走廊发现了蹲着的他。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00060",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我马上叫人过来，请您先躺好」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00061",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不，不用了……我没事，这点程度……」",
                voice: Some("li/etcm3_1010"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00062",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然那样回答了，可是他的脸色明显不是平常那样。\n况且也听说他有老毛病，也有发病的可能性。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00063",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我为了立刻叫到救护车，在电话的拨盘上拨下了119……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00064",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没事了……已经平息下来了……请不要叫来救护车……」",
                voice: Some("li/etcm3_1011"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00065",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「可是……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00066",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不，真的已经没事了……」",
                voice: Some("li/etcm3_1012"),
