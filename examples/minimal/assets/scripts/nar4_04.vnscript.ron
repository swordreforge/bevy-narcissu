                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "被夕阳染红的海岸上，强烈的海风拂面而来，摇曳着远处的松林。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00182",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "像是被日下推着一样，来到了一如既往的海边 。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00183",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这里……不管什么时候来都很漂亮呢……」",
                voice: Some("li/n4yoko_0172"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00184",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "向着沉默不语的我，咕哝了一句。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00185",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，做了个深呼吸，把气“呼——”地吐出来……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00186",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我，日下阳子，14岁，血型是B型」",
                voice: Some("li/n4yoko_0173"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00187",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「兴趣是看电视节目和收集邮票」",
                voice: Some("li/n4yoko_0174"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00188",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "突然，开始了一段这样的演讲。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00189",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哈？\u{3000}突然间怎么了？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00190",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，她像是无视了我那样的质问，继续说着自己的事情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00191",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，昨天的晚饭是凉拌豆腐和烫菠菜，\n咖喱鱼干非常好吃所以添了两碗」",
                voice: Some("li/n4yoko_0175"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00192",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那之后，泡澡泡得太久了，头晕了……」",
                voice: Some("li/n4yoko_0176"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00193",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不知不觉就在更衣室面前光着身子坐了很久，\n被妈妈发现然后被骂了……」",
                voice: Some("li/n4yoko_0177"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00194",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从那开始直到睡觉的期间发生了什么，泛着害羞的神情在一直讲述着……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00195",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不，是一直说给我听。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00196",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呼呼～」",
                voice: Some("li/n4yoko_0178"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00197",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不久后她就全部讲完了，然后又做了一个深呼吸，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00198",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……就这些」",
                voice: Some("li/n4yoko_0179"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00199",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「就这些什么的，从刚刚开始是在模仿什么吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00200",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这就是我全部的话……所以，我想让莳绘君也来说一说……」",
                voice: Some("li/n4yoko_0180"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00201",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……………」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00202",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不由得无话可说了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00203",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从刚刚开始，我就在想这是什么呢……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00204",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，今天我很寂寞呢……当你说和我没有关系的时候 ……」",
                voice: Some("li/n4yoko_0181"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00205",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……虽然不知道为什么，但感觉好像自己被一个人丢下了……」",
                voice: Some("li/n4yoko_0182"),
            ),
        ),
        (
            cmd: label,
