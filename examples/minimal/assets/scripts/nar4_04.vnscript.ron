        ),
        (
            cmd: label,
            args: (
                name: "block_00067",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这么说着，老爷爷摇摇晃晃地站起来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00068",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我只考虑了一瞬应该怎么做才好，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00069",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……明白了」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00070",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然很不得已，只能对老爷爷这样回答道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00071",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "根据这里的规定，如果本人回答没问题的话，尽可能不要叫救护车。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00072",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那么接下来，就要向家人取得联系……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00073",
            ),
        ),
        (
            cmd: set_bg,
            args: (
