            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然老爷爷一直说着不要紧，老爸和救护人员都不理睬他。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00109",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，当他被担架抬走的时候……和我四目相对了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00110",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那个时候，明明说了会恨我的，然而，却只是向我露出了寂寞的神情。",
