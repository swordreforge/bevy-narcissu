        (
            cmd: label,
            args: (
                name: "block_00088",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "他一边那么说一边瞪着我，再一次缩进了走廊，脸色也明显不好。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00089",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……我到底该怎么做才好呢……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00090",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对于老爷爷的家人，不让她知晓的话会被记恨。\n但是，对于老爷爷本人，也告知我们让家人知晓的话便会恨我们。",
