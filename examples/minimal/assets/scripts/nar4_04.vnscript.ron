        ),
        (
            cmd: label,
            args: (
                name: "block_00114",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "某种意义上来说，这是最佳答案。至少对我们来说，并没有其他选项。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00115",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……无论是那个老爷爷，还是他的家人，互相都不想让对方担心吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00116",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "正因为明白这一点，所以处在他们两者之间的我们的立场才会很艰难。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00117",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "优先哪一方的意思什么的，我难以办到……但却不能做出选择……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00118",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "面对正发着呆，考虑着这些事的我，父亲说道，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00119",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，博史，你可不要搞错啊」",
                voice: Some("li/np4papa_1033"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00120",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「虽然听上去很冷淡，但这里并不是医疗设施」",
                voice: Some("li/np4papa_1034"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00121",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那种事我还是知道的……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00122",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽说如此，这里也不是公寓或者居民楼那样的出租行业。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00123",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「如果，没有叫救护车，也没有联系家里人……\n万一发生了意外的时候怎么办？」",
                voice: Some("li/np4papa_1035"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00124",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「就算他的死亡是大限已至，你觉得他的家人能接受么？」",
                voice: Some("li/np4papa_1036"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00125",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不，感觉那很难……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00126",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "是啊。就算满足了本人，家人也不会接受吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00127",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果是在医院去世的话，也许可以死心……但如果是在这样的地方去世的话……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00128",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「所以我们的工作就是……不要让家人留下“遗憾”」",
                voice: Some("li/np4papa_1037"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00129",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……只是家人？\u{3000}那本人呢？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00130",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「要实现两边的愿望是不可能的……这从一开始就是矛盾的」",
                voice: Some("li/np4papa_1038"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00131",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说完这句话，父亲走出了房间。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00132",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "被一个人留下来的我，考虑了各种各样的事情。\n与其说是在动脑筋思考，倒不如说是在整理那些不成熟的想法。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00133",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……离去的人，牵挂着留下的人。被留下的人，牵挂着离去的人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00134",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "两者互不相容。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00135",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果说，这就是人类的本质的话……那是多么温情又脆弱啊……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00136",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n4bg_001c",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这个地方……每个月，都会有人搬来。然后就好像交替一样，会有人离去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00137",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……常常有人到来，也有人离去……无穷无尽。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00138",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就像是等候室一样的这个地方，就算自认为变得再怎么亲密，\n我们自己也不过是个旁观者……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00139",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "也可以说这是个极限，考虑到这个问题的致命性的部分的时候，就会觉得无比凄凉……",
                voice: None,
            ),
        ),
