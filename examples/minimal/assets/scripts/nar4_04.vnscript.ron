            cmd: label,
            args: (
                name: "block_00241",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……不干，那太羞耻了」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00242",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「欸～，拜托了嘛，呐？\u{3000}这个在隔壁班也很流行的哦」",
                voice: Some("li/n4yoko_0187"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00243",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我才不管。别人是别人，我们是我们」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00244",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真是的，说了像妈妈一样的话」",
                voice: Some("li/n4yoko_0188"),
