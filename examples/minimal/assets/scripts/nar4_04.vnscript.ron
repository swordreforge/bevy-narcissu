        ),
        (
            cmd: label,
            args: (
                name: "block_00246",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，如同无视我的想法一样，她从书包里拿出了一本笔记本……",
