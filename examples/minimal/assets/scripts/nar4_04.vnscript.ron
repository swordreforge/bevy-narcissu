        ),
        (
            cmd: label,
            args: (
                name: "block_00074",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是的……因为我被这样嘱咐了」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00075",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "叫救护车这件事，如果本人否定的话作罢也没关系。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00076",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过，向家人联络是另一码事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00077",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看了一眼时钟，现在才晚上九点，这个时间的话应该不会添麻烦。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00078",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "并不是从家人那边接到了不要联络的指示，\n不如说，对于这位老爷爷我们被家人叮嘱过。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00079",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以，我不能视而不见。他家人确实说过不联络她的话便会怨恨我们。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00080",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是对于这样的我来说……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00081",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……家里，也请不要联络」",
