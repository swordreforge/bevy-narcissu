            args: (
                name: "block_00230",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "或许是对之前那寂寞的身影感到抱歉……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00231",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "或许是单纯的想要还她人情……",
