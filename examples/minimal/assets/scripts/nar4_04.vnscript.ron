        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「早……早上好，莳绘君……」",
                voice: Some("li/n4yoko_0159"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00143",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯？\u{3000}啊啊，早上好……」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00144",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "日下和往常一样到养老院来迎接我。我们也理所当然一样肩并着肩，向学校走去。",
                voice: None,
