        ),
        (
            cmd: label,
            args: (
                name: "block_00250",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，日下很开心地对我笑了起来。真是的，单方面决定什么啊。",
