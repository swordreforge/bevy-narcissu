            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00228",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我一边回答一边点头。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00229",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……为什么，会对她说出这种话呢？",
