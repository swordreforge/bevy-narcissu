            cmd: label,
            args: (
                name: "block_00149",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是，总感觉很在意……」",
                voice: Some("li/n4yoko_0161"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00150",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，些许寂寞的表情之后，突然停下了脚步……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00151",
