        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "抛下这句话，她离开了疗养院。临别的时候，又瞪了我一次。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00053",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然偶尔也会有人说类似的话，但被叮嘱到这份儿上还是头一次。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00054",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且，如果碰到说这类话的家属的情况……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00055",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那么当事人的反应……也大致能够预料到了。",
                voice: None,
            ),
