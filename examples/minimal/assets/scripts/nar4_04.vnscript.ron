        (
            cmd: label,
            args: (
                name: "block_00238",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「交？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00239",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……来写交换日记怎么样……」",
                voice: Some("li/n4yoko_0186"),
