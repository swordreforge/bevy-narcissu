        (
            cmd: label,
            args: (
                name: "block_00294",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，日下煞有介事地挺起胸膛。话说，那种程度的话我也会做啊。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00295",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "想到这里，觉得拜托她做普通的烤法不够有趣。这个时候就应该来一个奇怪点的吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00296",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看起来日下这家伙很起劲，意外地本人也乐在其中呢……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00297",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么 请给我来份scrambled egg（注：西式黄油煎蛋）」",
