            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "大街上走着其他学生，大家都显得很愉快，当中……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00146",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "今天的我，却没法像往常一样展现出开朗的一面。",
                voice: None,
            ),
        ),
        (
