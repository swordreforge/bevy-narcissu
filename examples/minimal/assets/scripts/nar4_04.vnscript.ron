        ),
        (
            cmd: label,
            args: (
                name: "block_00245",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "即使不是那样，养老院的工作也很忙。更何况，那种日记什么的，我再也写不了了。",
                voice: None,
