            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "国道的一侧，有一个家庭餐厅。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00070",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我一边开车，一边指着那里说道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00071",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你看，我们一直都在吃便利店的东西吧？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00072",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我当然不太喜欢便利店的食物。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00073",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但考虑到财政问题，那个时候也没有别的选择了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00074",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但现在，我们的手里多少有了点钱。\n所以我这样提议道",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00075",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐，就去吃一次餐厅的东西吧」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00076",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…我吃便利店的东西就行了…」",
                voice: Some("li/n218"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00077",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，她微微地低下了头。\n似乎是在注视着自己的衣服。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00078",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "啊…我这才想起来，她身上还穿着那套宽大的衣服…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00079",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「好吧，那咱们就先到那里去吧？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00080",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…那里？」",
                voice: Some("li/n219"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00081",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「就在那边，有一家洋装店」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00082",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那是一家在国道边随处可见的，\n贩卖牛仔服和休闲装一类衣物的量贩店。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00083",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「像这种店里的衣服，\u{3000}一般都不会太贵的」",
                voice: None,
            ),
        ),
