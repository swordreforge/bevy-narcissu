            args: (
                name: "block_00065",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我按照她的指示改变车道，扭转了方向盘。",
                voice: None,
