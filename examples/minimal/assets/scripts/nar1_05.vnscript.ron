            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "尽管最初不太明白车辆间互相亮起尾灯与转向灯的意义，\n但习惯这些以后，高速公路上的驾驶便变得有趣了起来。",
                voice: None,
