            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "景色在窗外流动着。\n在陌生的热闹市区中，我们径直向北驶去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00067",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就这样，在不知不觉中，喧闹的景色渐渐宁静了下来…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
