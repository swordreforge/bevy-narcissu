        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "它们终究只不过是憧憬而已，无论是比基尼泳装，还是翡翠色的大海…",
                voice: None,
            ),
        ),
