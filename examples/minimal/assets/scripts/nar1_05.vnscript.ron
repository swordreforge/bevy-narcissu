        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "冬日的晴空下，银色的酷派反射着阳光不断前行。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00056",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "离开了四处都是陡坡与急转弯的箱根后，\n现在的路况已经变得十分平坦了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00057",
            ),
        ),
        (
            cmd: wait,
            args: (
