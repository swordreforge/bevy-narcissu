            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐，这里是什么地方啊？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00058",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是爱知县，很快就会进入名古屋市区了…」",
                voice: Some("li/n215"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00059",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "考虑到金钱的问题，我们没有使用高速公路。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00060",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果只凭我一个人的话，肯定会辨不清东南西北的。\n但现在，有她在为我指路。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00061",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她的指示可能比导航系统更精确。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00062",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "尽管我不知道她为什么会了解这些，\n但我相信她所指的路是正确的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00063",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「从下一个路口…进入２２号公路」",
                voice: Some("li/n216"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00064",
            ),
