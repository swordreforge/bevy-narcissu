        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊？\u{3000}狼？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00180",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她忽然开口说起了听不懂的话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00181",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是…驴却可以活９年」",
                voice: Some("li/n245"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00182",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你在说什么啊？…什么狼3年驴9年的？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00183",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…听说…驴之所以会活得更久」",
                voice: Some("li/n246"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00184",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是因为人们需要它…」",
                voice: Some("li/n247"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00185",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她寂寞地注视着窗外，静静地说道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00186",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这就是她…为了让自己接受一切，\n为了让自己放弃一切…\u{3000}而编织出来的理由吗…",
                voice: None,
            ),
        ),
        (
