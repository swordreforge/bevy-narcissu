        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "寒冬的天空渐渐昏暗下来。\n我们在２１号公路上笔直地行驶着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00188",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "白色的结晶，星星点点地飘舞在昏暗的天空中。\n片刻后，便化成纷纷扬扬的雪花。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00189",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…怎么了？」",
                voice: Some("li/n248"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00190",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「开始下雪了呐…」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00191",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "很快，道路的两边已经积起了一层白雪。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00192",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "naname_yuki",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知不觉间，我们进入了积雪地带。\n四周都被染成了一片银白。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00193",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…或许有些不妙。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00194",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "刚才检查了一下，这辆车的轮胎似乎不是防滑式的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00195",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "万一前方的雪下得更大的话，我们或许会遇到麻烦。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00196",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐，这一带是多雪地带吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00197",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「欸…」",
                voice: Some("li/n249"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00198",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「万一前边的雪下得更大的话，会很麻烦的」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00199",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……………」",
                voice: Some("li/n250"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00200",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "即使路面没有积雪，也很可能会有冰冻。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00201",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样想来，或许应该按照驾校教材上的知识，给轮胎装上防滑链才行。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00202",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「怎么样，你知道吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00203",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这前边…是关原」",
                voice: Some("li/n251"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00204",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这个你刚才已经说过了，\u{3000}我是想知道那里会经常下雪吗。」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00205",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…不知道…」",
                voice: Some("li/n060"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00206",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知为何，她有些寂寞地答道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00207",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从她的样子我似乎感到了一丝违和感。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00208",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她对道路如此熟悉，之前对这辆车更加熟悉…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00209",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "比起这些来，气候的事情应该更就不在话下才对。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00210",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「明白了，我小心一点开」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00211",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…嗯」",
                voice: Some("li/n253"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00212",
            ),
        ),
        (
            cmd: wait,
