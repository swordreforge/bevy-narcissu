            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐，你觉得医院那边现在会是怎样一幅情景呢…」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00139",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "白色的塑料手环仍旧卷在我的手腕上。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00140",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我看着这记载了姓名和血型的医院标识低声说道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00141",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是不是已经闹翻天了呢？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00142",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…大概吧」",
                voice: Some("li/n234"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00143",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是啊…」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00144",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "父母、朋友、以及医院的医生们…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00145",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "尽管他们只会出于义务而为我担心，\n但我还是感到有些过意不去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00146",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "抱歉了…父亲、大家…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00147",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "都怪我太任性了…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00148",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "car_byoin_chusyajo_yoru",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐,我说你…」",
                voice: Some("li/n235"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00149",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯？什么事？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00150",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「第一次…听说自己会死的时候……你哭了吗？」",
                voice: Some("li/n236"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00151",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……………」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00152",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她突然的提问使我觉得有些惊讶。\n面对这沉重的问题，我仔细地思考了一下。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00153",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…记得…我没有哭」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00154",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么…你是否诅咒过对自己如此不公的命运呢？」",
                voice: Some("li/n237"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00155",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这个…我记不清了」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00156",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "开始时，我并没有体会到这件事的真实感。\n因此，那时我也无法将它当作真实的事情来思考。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00157",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过…或许我也多多少少诅咒过自己的命运吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00158",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一起去过驾校的朋友买了新车，\n还得意地炫耀着３６次的分期付款是多么地不易。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00159",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "朋友中，有的人找到了工作，有的人不得不留级。\n有的人有了孩子。还有的人被女朋友甩掉了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00160",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而我…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00161",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "却失去了未来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00162",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以…我想我的确埋怨过命运对自己的不公。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00163",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "即使一次次地告诫自己这就是命运，但心中却依然难以放弃一切。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00164",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么…你又怎么样呢？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00165",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…我？」",
                voice: Some("li/n238"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00166",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，你哭过吗？诅咒过自己的命运吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00167",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……………」",
                voice: Some("li/n239"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00168",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…我平静地接受了一切。」",
                voice: Some("li/n240"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00169",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…为什么？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00170",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…因为我从一开始，就从没有抱过任何希望…」",
                voice: Some("li/n241"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00171",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…因为我放弃了一切」",
                voice: Some("li/n242"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00172",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是吗…」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00173",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "假如从一开始就放弃了希望，自然也不会有任何的失望。\n消极的人生的确不会快乐，但同样也不会痛苦。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00174",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，我感到这种想法本身就非常地悲哀。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00175",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "还是说，对她而言…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00176",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "已经没有其他的选择余地了吗…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00177",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "car_byoin_chusyajo_yoru",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
