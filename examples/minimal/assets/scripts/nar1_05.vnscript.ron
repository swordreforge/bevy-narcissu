        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一辆车从后边呼啸而过。\n悠闲行驶中的我们不由地对视了一眼。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00255",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在助手席上，她也显得与往常有些不同。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00256",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "平时，她总是静静地凝视着窗外远方的景色。\n而今天，却罕见地注视着来来往往的车辆。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00257",
