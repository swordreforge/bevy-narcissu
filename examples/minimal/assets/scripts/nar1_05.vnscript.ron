        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是在右侧的高速车道行驶时，\n从后边飞速驶来的车辆会让我感到有些恐怖。",
                voice: None,
            ),
