        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但看到平时极少开口的她能够一个接一个地回答我的问题，\n我感到非常高兴…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00268",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以，我也接二连三地问了下去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00269",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「蓝色的是依诺斯，红色的是阿尔法·罗密欧…」",
                voice: Some("li/n271"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00270",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她一口气回答出了２台飞驰而过的车辆的名字。",
