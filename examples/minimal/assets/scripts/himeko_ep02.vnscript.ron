        ),
        (
            cmd: label,
            args: (
                name: "block_00508",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「今天，请让我早退」",
                voice: Some("li/yukanp_1108"),
