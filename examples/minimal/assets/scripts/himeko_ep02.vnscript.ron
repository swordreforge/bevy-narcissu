            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在床上一直沉睡的姬子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00917",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果没有旁边不断刷新的心电图屏幕，\n几乎要让人怀疑是不是已经去世般地静静沉眠。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00918",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，姬子，刚刚在千寻那里听说了，\n说是还有一周左右」",
                voice: Some("li/yukanp_1196"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00919",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「还有，关于全勤奖，我把期间延长了…」",
                voice: Some("li/yukanp_1197"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00920",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这虽是我擅自改变的规则，我觉得也不坏吧」",
                voice: Some("li/yukanp_1198"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00921",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "独自坐在窄窄的折叠椅上说个不停。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00922",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "握住她从毯子里伸出的手，\n非常温暖。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00923",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然那天被打的疼痛已经消失，\n但那抚摸过我脸颊的手还是那么温暖。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00924",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「说起来……」",
                voice: Some("li/yukanp_1199"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00925",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "忽然想起了之前被打的事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00926",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽说过挚友之间也会互殴这样的话，\n但我们之间只是我一味被打。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00927",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "想到了这里的我，我慢慢伸出手去…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00928",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "温柔地拍了拍姬子的脸颊。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00929",
            ),
        ),
