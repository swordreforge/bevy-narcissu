            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从谈话室走向病房。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00895",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然姬子说过已经不用来了，\n 但我还是会照常过来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00896",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后走到了病房门口，站在那里小声说道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00897",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「进来了哦……」",
                voice: Some("li/yukanp_1191"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00898",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我知道姬子即使醒着也不能回答我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00899",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且现在，\n就算想要敲门，门也一直敞开着，只拦着布帘。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00900",
            ),
        ),
