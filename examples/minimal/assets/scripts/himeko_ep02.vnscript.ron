        (
            cmd: label,
            args: (
                name: "block_00315",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不用说其他人都竖起了耳朵，在等着我的回答吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00316",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这，那个，实在是很抱歉……」",
                voice: Some("li/yukanp_1081"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00317",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「也不是要你加到晚上十点、十一点，\n2个小时就可以了」",
                voice: Some("li/npetcm2_009"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00318",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然用词和语气还算平和，\n但明显比以前显得愠怒。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00319",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为最近一直是一到时间我就急匆匆溜号，所以更会如此吧……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00320",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是今天，\n千寻说有关于姬子的事要跟我谈。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00321",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以对我来说，无论如何都想要快点回去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00322",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对不起科长，可以的话果然还是……」",
                voice: Some("li/yukanp_1082"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00323",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是吗？果然还是不行吗？」",
                voice: Some("li/npetcm2_010"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00324",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这次的语气，任谁都听得出来带有厌恶的意味。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00325",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "附近桌子上的人小声嘟囔着『所以说没用的啦』。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00326",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "事到如今已不单单是加班和职场士气的问题，\n而是关系到办公室领导面子的问题了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00327",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……记得你是说要去探望朋友吧？」",
                voice: Some("li/npetcm2_011"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00328",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，嗯，是这样的……」",
                voice: Some("li/yukanp_1083"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00329",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我也不是不明白你的心情，\n因为是重要的朋友更加如此吧」",
                voice: Some("li/npetcm2_012"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00330",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后科长叹了一口气。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00331",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，昭岛，这话虽然很难说出口……\n公司只规定至亲的丧事可以请一周」",
                voice: Some("li/npetcm2_013"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00332",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「关于手术和探望\n 没有特别的规定」",
                voice: Some("li/npetcm2_014"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00333",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…………………」",
                voice: Some("li/yukanp_1084"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00334",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「所以，希望你明白，这也算常识」",
                voice: Some("li/npetcm2_015"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00335",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然是委婉的说法，\n但他想要说什么我已经十分明白了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00336",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，我要说的就这些了」",
                voice: Some("li/npetcm2_016"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00337",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……对不起」",
                voice: Some("li/yukanp_1085"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00338",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我深深地低下了头。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00339",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "想不出其它要说的话。\n即使想得出也不是说得出口的性格。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00340",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从远处能听到『科长，别把女孩子惹哭唷』，\n这样的起哄声让我又悲又悔。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00341",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "终于到了17点30的下班时间，\n我如同逃跑一般地离开了办公室。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00342",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然换衣服也比平时更快地完成了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00343",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……千寻，\n虽然不知道她要说什么但还是快点吧…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00344",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边这么想着，\n正要离开一楼大厅的时候。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00345",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsin_b07b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊？ 昭岛？」",
                voice: Some("li/npetcw4_108"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00346",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶？啊……前辈们…」",
                voice: Some("li/yukanp_1086"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00347",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "恐怕是因为加班而去便利店买东西正回来吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00348",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "时机不巧，正好碰上了一群OL前辈。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00349",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呼~每天的定时下班冲刺辛苦了」",
                voice: Some("li/npetcw4_109"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00350",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看着我一身轻飘飘的衣服说着，\n浮现出轻佻的笑脸，明显充满了厌恶。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00351",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「像我们这种人，只好啃着便利店的饭团，\n加班到坐末班车回家呢~」",
                voice: Some("li/npetcw2_144"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00352",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……对不起，再过一小段时间就好了……\n所以现在…」",
                voice: Some("li/yukanp_1087"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00353",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那我问你，一小段时间到底是多久？」",
                voice: Some("li/npetcw4_105"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00354",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶，这个……」",
                voice: Some("li/yukanp_1088"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00355",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "回答不上来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00356",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不，也不是回答不出。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00357",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从千寻那里，听说了可能还有一个月左右。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00358",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然没有明说，\n姬子自己也表达过类似微妙的话语。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00359",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，\n这个期限要我说出口时我犹豫了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00360",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……从我嘴里说出来的话，\n就仿佛承认了姬子的死期一样可怕。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00361",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「昭岛，你怎么不回答了？」",
                voice: Some("li/npetcw4_106"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00362",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「再说，你说是探望朋友，\n你这身打扮是想怎么个探望法呀」",
                voice: Some("li/npetcw4_110"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00363",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「笨蛋，这不摆明了是去找男人的吗」",
                voice: Some("li/npetcw2_145"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00364",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「果然是吧，一从科长那里尝到了甜头就嚣张起来了，\n现在的年轻人不教育一下不行啊」",
                voice: Some("li/npetcw4_107"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00365",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "接下来都是充斥着嘲笑和中伤的言语。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00366",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我只好一声不吭地听着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00367",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "即使想要解释，我也不认为\n凭我的口才能说清楚。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00368",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对不起，先失陪了……」",
                voice: Some("li/yukanp_1089"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00369",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只说了这一句，\n挤过前辈所组成的人墙，全力飞奔了出去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00370",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "完全不顾身后传来的『喂，站住！』的喊声\n全力飞奔。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00371",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsora_yoru01",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……明天上班的时候肯定会更难堪吧…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00372",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "想着这些，\n天色已稍显昏暗，我快步向着逐渐变得昏暗的车站走去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00373",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "心中充满了莫名的悲伤。\n现在立刻就想去到姬子的身边。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00374",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsin_b08",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
