                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsora01",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―烈日仍高挂在天空。\n繁华的车站前响彻着知了的叫声。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00017",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对了，千寻，你要什么味道的？ 和平时一样的柠檬？」",
                voice: Some("li/himenp_1053"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00018",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，嗯，\n我想要果子露冰激凌…姐姐要香草味的？」",
                voice: Some("li/tihinp_1004"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00019",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯…不，偶尔我也换换口味吧」",
                voice: Some("li/himenp_1054"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00020",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nbg_1020",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "两人一手拿着冰激凌在站前闲逛。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00021",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "流淌下的汗水，以及嘈杂的蝉鸣声。\n时而为些许小事传出笑声的我们。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00022",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这种感觉很久没有过了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00023",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哎呀？ 这件衣服，真可爱啊」",
                voice: Some("li/himenp_1055"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00024",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我们的脚步停在了一家杂货店前。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00025",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "姐姐拿起摆放在店前的几件衣服，\n如此说道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00026",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「怎么样千寻？ 这件不错吧？」",
                voice: Some("li/himenp_1056"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00027",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯…但总觉得有点孩子气啊…」",
                voice: Some("li/tihinp_1005"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00028",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真是的，这点不是挺好的吗。那么可爱」",
                voice: Some("li/himenp_1057"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00029",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那是一件很有夏天味道的，\n白底带黄色向日葵图案的连衣裙。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00030",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对。\n很早以前，姐姐就非常喜欢这种款式的裙子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00031",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，自己并不会穿，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00032",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这种衣服买来后实际被迫穿上的，\n通常是我和优花。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00033",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……也许优花的少女情结？也是姐姐造成的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00034",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那，我去买下来吧」",
                voice: Some("li/himenp_1058"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00035",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，等等，姐姐…」",
                voice: Some("li/tihinp_1006"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00036",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "无视了我的制止声，姐姐快步走向收银台，\n然后笑嘻嘻地拿着刚买的衣服回来了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00037",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「（……又会变成给我们穿的了吧？）」",
                voice: Some("li/tihinp_1007"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00038",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "高兴当然是很高兴，也许还是有些害羞…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00039",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「别害怕，不会说让你或者优花穿的」",
                voice: Some("li/himenp_1059"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00040",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……不让我们？\n姐姐的话出乎我的意料。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00041",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「难道说姐姐，打算自己穿？」",
                voice: Some("li/tihinp_1008"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00042",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「怎么会，我可没那么有少女情怀」",
                voice: Some("li/himenp_1060"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00043",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那么到底，是打算要怎么样呢……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00044",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，抱歉。果然还是稍微更正一下」",
                voice: Some("li/himenp_1061"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00045",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……更正？」",
                voice: Some("li/tihinp_1009"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00046",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，说不定……」",
                voice: Some("li/himenp_1062"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00047",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「千寻……你可能会穿上这衣服……」",
                voice: Some("li/himenp_1063"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00048",
            ),
        ),
        (
