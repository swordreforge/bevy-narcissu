                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "坐上折叠椅，先调整了一下呼吸。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00546",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然想尽量普通地，\n和往常一样的面对姬子…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00547",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "可今天的我却没什么自信。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00548",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，正因为是这个时候……\n我才更要伪装成平时的我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00549",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「说起来你今天不是要上班吗？ 现在还是上午吧？」",
                voice: Some("li/himenp_1138"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00550",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，啊啊，今天很闲所以就早退了」",
                voice: Some("li/yukanp_1117"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00551",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你的公司，明明是工作日的周五却很闲？」",
                voice: Some("li/himenp_1139"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00552",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「算是吧，现在哪儿都不景气。\n再这样的话年终奖没了都不奇怪」",
                voice: Some("li/yukanp_1118"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00553",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着尝试露出轻松的笑容。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00554",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……绝不能被察觉。\n本来姬子就比较敏锐。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00555",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在无论是多细微的细节，\n都不想让给她留下心理负担",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00556",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对了优花，难得那么上午就来了，\n带我去中庭吧」",
                voice: Some("li/himenp_1140"),
