        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是啊优花……我最放心不下的其实是你哦」",
                voice: Some("li/himenp_1102"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00297",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……我？」",
                voice: Some("li/yukanp_1080"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00298",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯嗯，所以至少有在为你祈祷哦……\n虽然只是普通的信徒，还达不到魔法的程度」",
                voice: Some("li/himenp_1103"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00299",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后静静地闭上了眼……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00300",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…愿主的恩惠与祝福降临于你…」",
                voice: Some("li/c77hime_0023"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00301",
            ),
