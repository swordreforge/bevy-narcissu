            cmd: label,
            args: (
                name: "block_00521",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "比起被公司炒鱿鱼，\n更害怕被人所厌恶。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00522",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不禁开始搜寻能摆脱现在的状况，\n可以脱离这个场面的说辞……",
