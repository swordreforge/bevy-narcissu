            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00565",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "连去一楼厕所换衣服都忘了，\n就这样奔了出来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00566",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，啊啊。\n今天有点冷，还穿得轻飘飘的就……」",
                voice: Some("li/yukanp_1121"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00567",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯？虽然不是很明白……\n不过挺适合你的」",
                voice: Some("li/himenp_1142"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00568",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶？真，真的吗？」",
                voice: Some("li/yukanp_1122"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00569",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是啊，看起来不是很出色的样子嘛，\n即便是又软弱又不可靠的你…」",
                voice: Some("li/himenp_1143"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00570",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「等下，你，你说谁软弱……」",
                voice: Some("li/yukanp_1123"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00571",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "刚想反驳，立刻停了下来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00572",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "长期交往的姬子，\n早把我的性格看透了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00573",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "继续动摇的话，很难再保持现在平静的状态了吧。",
                voice: None,
