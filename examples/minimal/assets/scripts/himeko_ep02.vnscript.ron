            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "窗外太阳已完全落山，街上亮起了路灯。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00197",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那15cm宽的夜景，映照出姬子那一如既往的表情……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
