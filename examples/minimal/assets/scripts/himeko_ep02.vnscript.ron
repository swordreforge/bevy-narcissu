        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哟！今天也很精神嘛」",
                voice: Some("li/yukanp_1064"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00207",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是啊，托你的福」",
                voice: Some("li/himenp_1082"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00208",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "isu2b",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "和往常一样打完招呼后，\n我立刻开始准备轮椅。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00209",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然晚上不太出去，\n但白天在医院里瞎逛却是惯例。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00210",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「快点啊，优花你可是引擎哦」",
                voice: Some("li/himenp_1083"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00211",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「知道了啦，\n我正在固定点滴稍微等一下嘛」",
                voice: Some("li/yukanp_1065"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00212",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "姬子搭着我的肩从病床移向轮椅。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00213",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "手里还拿着装薯片的袋子和塑料罐，\n像是去郊游一般。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00214",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "已经不会对每次都这样子感到惊讶了，\n但一开始看到要坐轮椅还是吃了一惊。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00215",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―姬子，明明两周前还能自己走路的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00216",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那天我们也和往常一样走在中庭，\n突然说『太累了，就坐这个吧』。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00217",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "姬子就这样坐上了走廊上排列着的轮椅。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00218",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后就催促着我帮她推行，刚推了没几步，\n她就大喊『太好玩了，太好玩了！』",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00219",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "结果那天，竟然从站前推到了商店街…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00220",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "结局，那天因为擅自离开医院，\n连我也被医生和护士骂了一顿―",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00221",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "na006",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么姬子，去哪里？ 食堂吗？」",
                voice: Some("li/yukanp_1066"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00222",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯…总之去中庭吧，天气那么好」",
                voice: Some("li/himenp_1084"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00223",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "以行动代替回答，\n我打开病房的门推着轮椅走了出去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00224",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在到达电梯的途中，\n向谈话室和护士站的人们一一打了招呼。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00225",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在脸熟的医生和护士越来越多了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00226",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsin_b06",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―来到了中庭。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00227",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "已是10月中旬的现在，\n相应的空气也开始让人感到有些寒冷。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00228",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然这么说，但是由于四周都是建筑物，所以也没有风。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00229",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "来到中庭后，我们首先走向了花坛……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00230",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "确切的说是走向了花坛的外围。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00231",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么优花，把水管给我吧」",
                voice: Some("li/himenp_1085"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00232",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，拿好咯」",
                voice: Some("li/yukanp_1067"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00233",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "花坛的外面有个水龙头。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00234",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在那上面，\n装了一根差不多20米长的软管。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00235",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这前面停下轮椅。\n我把软管的一头递给了姬子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00236",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「姬子，那么，我开水了哦」",
                voice: Some("li/yukanp_1068"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00237",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，随时都可以开哦」",
                voice: Some("li/himenp_1086"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00238",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "ato_w",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "shaw2b",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "哗―",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00239",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "与此同时，水从软管里喷涌而出。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00240",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "向着沿着中庭的小径建造的\n宽广的花坛撒去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00241",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在太阳的照射下，雾状的水滴折射出的彩虹，\n从轮椅上姬子的手中延伸出去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00242",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我缓缓地推着，\n这被小小彩虹缠绕着的轮椅前行。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00243",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsin_b06b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，优花，稍微再推地慢一点」",
                voice: Some("li/himenp_1087"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00244",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "时而，姬子发出速度上的指示。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00245",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为小径旁有好几个花坛，\n太快的话有的地方可能撒不到水。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00246",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就这样，\n姬子想要尽可能亲自帮这里浇水。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00247",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……到底她拘泥于什么呢？\n要亲自浇水…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00248",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这个疑问以前也曾有过，也询问过一次。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00249",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那时她只是一如既往地笑着回答\n『嗯，没什么特别的理由吧』。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00250",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，稍微停一下，这里要浇得仔细些」",
                voice: Some("li/himenp_1088"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00251",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "让我停下来的地方，\n长着些不知名的青草。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00252",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这夏天的花已完全消失，\n秋天的花也应该都凋谢了的时期竟然还是青草状态不由让我感到稀奇。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00253",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nnakaniwa",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「虽然还没有长花蕾，但这应该也是某种花吧？」",
                voice: Some("li/yukanp_1069"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00254",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊啊，这是水仙哦，水仙。\n你应该也听说过吧？」",
                voice: Some("li/himenp_1089"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00255",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，嗯。水仙的话还是知道的」",
                voice: Some("li/yukanp_1070"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00256",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我暧昧的回答道，其实我只见过它开花的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00257",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「因为这是冬天的花，所以最早也要到12月才开花」",
                voice: Some("li/himenp_1090"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00258",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如此说着，\n姬子专注地为这些青草浇着水。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00259",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我也在一旁专注地看着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00260",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
