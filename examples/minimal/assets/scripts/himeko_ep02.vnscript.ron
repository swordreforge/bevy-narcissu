        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「初次见面，您就是科长吗？\n我叫做姬子」",
                voice: Some("li/himenp_1167"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00704",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯…你难道就是……\n那位住院的，昭岛的朋友？」",
                voice: Some("li/npetcm2_024"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00705",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是的，\n 因为马上就要死了，所以想来打个招呼」",
                voice: Some("li/himenp_1168"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00706",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "『死』这个词，瞬间激起了办公室一阵骚动。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00707",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，话先说在前头，\n 我说我就要死了，并不是为了博取同情，也不是想要以此为资本威胁谁」",
                voice: Some("li/himenp_1169"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00708",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……不是很明白你的意思，你还是快回医院去吧」",
                voice: Some("li/npetcm2_025"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00709",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯嗯，事情完了马上就会回去的，但是……」",
                voice: Some("li/himenp_1170"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00710",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「招呼的话已经打过了，姬子小姐。喂，快叫救护车！」",
                voice: Some("li/npetcm2_026"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00711",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「等等，还有事……」",
                voice: Some("li/himenp_1171"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00712",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着搭着我的肩，将我推上前来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00713",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不是我……\n 优花也说想要打招呼哦」",
                voice: Some("li/himenp_1172"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00714",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶？姬子？」",
                voice: Some("li/yukanp_1150"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00715",
            ),
        ),
