            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……要是能快点开花就好了…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00261",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明明是理所当然的话，却在我口中犹豫不前。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00262",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "到了12月的话…到12月…\n听说姬子是撑不到那个时候的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00263",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsin_b06",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
