            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呼，你果然是笨蛋啊……\n我已经是要消失的人了，赶快忘记吧」",
                voice: Some("li/himenp_1207"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00954",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「做不到呢」",
                voice: Some("li/yukanp_1206"),
            ),
        ),
        (
