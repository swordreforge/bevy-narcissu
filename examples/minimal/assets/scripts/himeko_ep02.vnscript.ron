        (
            cmd: label,
            args: (
                name: "block_00692",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "意识到我抱着姬子，\n同事们都围拢过来看怎么回事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00693",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，昭岛，这位到底是……\n还有，你今天不是早退了吗？」",
