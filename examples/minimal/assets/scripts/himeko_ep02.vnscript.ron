            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "坐上快速电车，\n到达车站时已经是日暮时分。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00168",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我再次骑上自行车冲刺。\n所朝向的目的地，是路线全然熟悉的医院。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00169",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsin_b04",
