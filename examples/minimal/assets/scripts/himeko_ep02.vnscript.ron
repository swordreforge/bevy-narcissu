            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这个……」",
                voice: Some("li/yukanp_1110"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00517",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你也不是小孩子了，做好觉悟回答我！」",
                voice: Some("li/npetcm2_021"),
            ),
        ),
