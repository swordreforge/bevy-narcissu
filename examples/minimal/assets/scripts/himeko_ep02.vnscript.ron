            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……昭岛优花，23岁，11月25日生的射手座，O型血」",
                voice: Some("li/himenp_1182"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00773",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「兴趣是收集可爱的小物品和看动画片。\n喜欢轻飘飘的衣服，性格是不坦率的傲娇系……」",
                voice: Some("li/himenp_1183"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00774",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "突然说起了我的事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00775",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但这都只是表面上的，在家里一直爱穿套衫，\n性格其实是软弱而又腼腆……」",
                voice: Some("li/himenp_1184"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00776",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "都是别人谁都不知道，\n除了我以外只有姬子知道的事。",
                voice: None,
            ),
        ),
        (
