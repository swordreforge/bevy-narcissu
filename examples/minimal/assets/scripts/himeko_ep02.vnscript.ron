            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00586",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "必须和平时一样。\n直到最后，都绝不可露出悲伤的表情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00587",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对明天即将消失的姬子，\n绝不能让她抱有一丝的不安。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00588",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―这是把全勤奖作为目标的人，为自己施加的一条规则。",
