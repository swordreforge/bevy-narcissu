        ),
        (
            cmd: label,
            args: (
                name: "block_00514",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我也不是想生气……\n你认为朋友和工作，到底哪个重要？」",
                voice: Some("li/npetcm2_020"),
