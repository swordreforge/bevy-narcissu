        ),
        (
            cmd: label,
            args: (
                name: "block_00887",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，优花」",
                voice: Some("li/tihinp_1038"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00888",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "谈话室前。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00889",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一见到千寻我便开口询问到。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00890",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯…直到刚才一直都睡着，而且……」",
                voice: Some("li/tihinp_1039"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00891",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……而且？」",
                voice: Some("li/yukanp_1189"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00892",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「血压很低，\n今天恐怕是不会醒了……」",
                voice: Some("li/tihinp_1040"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00893",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是吗，总之我去看看吧」",
                voice: Some("li/yukanp_1190"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00894",
            ),
