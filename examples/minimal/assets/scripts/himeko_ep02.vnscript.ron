            cmd: label,
            args: (
                name: "block_00971",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……能成为你的挚友是我的荣幸…」",
                voice: Some("li/himenp_1214"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00972",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「姬，姬子……」",
                voice: Some("li/yukanp_1213"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00973",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "中途眼泪就夺眶而出。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00974",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然考虑了各种情况，\n进行了无数次的模拟对话……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00975",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明明是这么简单的话语……\n实际上听到了这样的话之后，我所做的一切模拟都不适用了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00976",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呜呜，在，在最后关头说这话太犯规了……」",
                voice: Some("li/yukanp_1214"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00977",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「好了啦，最后就哭一哭吧……\n只会互殴的话就不是挚友了嘛」",
                voice: Some("li/himenp_1215"),
            ),
        ),
