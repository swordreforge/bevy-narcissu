        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「姬，姬子。你意识清楚吗？」",
                voice: Some("li/yukanp_1201"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00937",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……声音，好吵…真是的…」",
                voice: Some("li/himenp_1202"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00938",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，啊啊，对不起。我还以为你不会再醒了」",
                voice: Some("li/yukanp_1202"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00939",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「其实，就算是现在这种状态，一天还是会清醒一次左右的……」",
                voice: Some("li/himenp_1203"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00940",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……真是，开心极了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00941",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "都没有期待过，\n还以为再也不能说话了……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00942",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是优花，你怎么又来了啊…\n不是说过不用再来了吗」",
                voice: Some("li/himenp_1204"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00943",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，嗯，那个……」",
                voice: Some("li/yukanp_1203"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00944",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然有些一时语塞但没关系。\n我早已准备好了回答。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00945",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这是我数日来，自己思考得出的答案。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00946",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "考虑到有个万一的情况，\n已经无数次模拟想象过，练习过了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00947",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「姬子，并不是我自己想要来，才来的哦」",
                voice: Some("li/yukanp_1204"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00948",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哈？ 那是为什么？」",
                voice: Some("li/himenp_1205"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00949",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「想着你一个人可能会寂寞，\n所以过来了，感谢我吧」",
                voice: Some("li/yukanp_1205"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00950",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…………………」",
                voice: Some("li/himenp_1206"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00951",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "练习果然是有意义的，\n我流畅地一口气说了出来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00952",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是姬子相对我的这种态度，缓缓开口说道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00953",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nn2e_0003g3",
