            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "发出细微的声音，坐上了小小的折叠椅。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00902",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "床上躺着带着氧气面罩静静沉睡的身影。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00903",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我开始对这样的姬子报告今天发生的事情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00904",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「说到公司，\n本想辞职的，但还是做下去了……」",
                voice: Some("li/yukanp_1193"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00905",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真是不可思议呢，\n自从那以后我周围的视线都好像变了」",
                voice: Some("li/yukanp_1194"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00906",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，不……改变的，大概是我吧」",
                voice: Some("li/yukanp_1195"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00907",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如同自言自语般地说着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00908",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样的行为并没有任何意义，\n也没有什么意图。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00909",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "即使是姬子偶尔清醒时候的对话，\n能发出“…嗯”的回答已经很好了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00910",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "基本和睡着的时候没有太大的差别。",
                voice: None,
            ),
        ),
