        ),
        (
            cmd: label,
            args: (
                name: "block_00673",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「优花，你别搞错，\n我可一点都没有去道歉的意思」",
                voice: Some("li/himenp_1163"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00674",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶？」",
                voice: Some("li/yukanp_1143"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00675",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「而且也不是为了你……而是为了我哦」",
