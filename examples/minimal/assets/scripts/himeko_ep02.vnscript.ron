            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶……」",
                voice: Some("li/yukanp_1153"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00729",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你没有道歉的必要，\n反倒是有什么怨气的话，就说出来吧」",
                voice: Some("li/himenp_1174"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00730",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，你们！再这样我可要叫保安了！」",
                voice: Some("li/npetcm2_030"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00731",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「吵死了，\n 你这讨厌的中年科长，给我安静点」",
                voice: Some("li/himenp_1175"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00732",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「什，什么？\n因为你是病人才对你这么客气的……」",
                voice: Some("li/npetcm2_031"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00733",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「来吧优花，你也说点什么吧」",
                voice: Some("li/himenp_1176"),
