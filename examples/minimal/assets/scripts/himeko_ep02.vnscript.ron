                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「优花，早上好」",
                voice: Some("li/tihinp_1033"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00799",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，千寻……」",
                voice: Some("li/yukanp_1171"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00800",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "回头一看，并不是平时那穿着围裙的千寻，\n而是身着正装的千寻。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00801",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那，那个……已经不能再见姬子了吗？」",
                voice: Some("li/yukanp_1172"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00802",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我不假思索有些焦急地询问道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00803",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不是，\n现在神父正在听取姬子的忏悔…」",
                voice: Some("li/tihinp_1034"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00804",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我想之后会一个接一个逐一叫进去告别的」",
                voice: Some("li/tihinp_1035"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00805",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那，还能见面咯？」",
                voice: Some("li/yukanp_1173"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00806",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，优花的话一定会叫你的，\n稍微等一下吧」",
                voice: Some("li/tihinp_1036"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00807",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说完千寻又走向谈话室。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00808",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "平时就很稳重的千寻，\n今天比以往更平静。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00809",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "差点忘了她是天主教徒，而姬子也是虔诚的天主教徒。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00810",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对于生死之事，至少相比起作为普通人的我们，\n想必早已有着坦然接受的觉悟吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00811",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "过了不久，谈话室的人们\n被逐一叫去了病房。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00812",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "亲戚，双亲，和姬子要好的护士和教堂的孩子们……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00813",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "每隔十分钟左右会叫进去一人，\n然后再从房间出来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00814",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "终于被千寻叫到的时候……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00815",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "na006",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「优花，姐姐叫你……」",
                voice: Some("li/tihinp_1037"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00816",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，知道了」",
                voice: Some("li/yukanp_1174"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00817",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "03_door_knock_02b",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "咚咚。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00818",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "带着些许紧张的神色，我敲了敲门。\n这样见面今天也是最后一次了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00819",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「请进……」",
                voice: Some("li/himenp_1187"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00820",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "门对面传来微弱的声音。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00821",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "忽然我如此思考。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00822",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就算在这种时候，也该采取同平常一样的态度吗？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00823",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "还是说今天的话，即使哭出来也是能被允许的吗……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00824",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一瞬间的犹豫后，\n我决定要以平常的态度来面对。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00825",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "握住口袋里的车钥匙，\n告诉自己全勤奖还没有结束。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00826",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "03_door_open_04",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―咔嚓",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00827",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsin_b05",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哟，今天很精神嘛」",
                voice: Some("li/yukanp_1175"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00828",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，托你的福」",
                voice: Some("li/himenp_1188"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00829",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "相互和平时一样俏皮的打着招呼。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00830",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这个地方已经不知重复了多少次的对话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00831",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "和以往不同的是，房间一角的桌子上铺着白布，\n上面放着十字架和两根点着的蜡烛。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00832",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "以及盛着麦饼的奇形怪状玻璃器皿。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00833",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，这些都是枕边装饰哦，\n我点滴前的准备也基本完成了」",
                voice: Some("li/himenp_1189"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00834",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着张开双手给我看，\n说是涂的圣香油。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00835",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没关系，慢慢说吧。你是最后一个了，时间有的是」",
                voice: Some("li/himenp_1190"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00836",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，知道了」",
                voice: Some("li/yukanp_1176"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00837",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "isu2b",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "嘿咻一声的同时。\n我照旧坐上了小小的折叠椅。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00838",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "以前我拿来的，印有小猫图案的靠枕。\n今天似乎也被各种各样的人们使用过了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00839",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么姬子，忏悔已经结束了？」",
                voice: Some("li/yukanp_1177"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00840",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，原以为会很多的，结果出人意料的少，\n大概因为我是个善人吧」",
                voice: Some("li/himenp_1191"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00841",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后开玩笑似地吐了吐舌头。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00842",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然说不出口，\n但我认为姬子毫无疑问是个善人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00843",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「（……如果有神明存在，有天堂存在的话，\n姬子一定能上天堂…）」",
                voice: Some("li/yukanp_1178"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00844",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "沉默不语的话就会不断浮现这样的想法，\n忍不住快要哭出来了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00845",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以说什么我都一定要把话接下去。\n毕竟能这样对话的时间，也已所剩不多了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00846",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「说起来昨天，你打我打得真狠啊」",
                voice: Some("li/yukanp_1179"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00847",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊啊，难道很疼吗？」",
                voice: Some("li/himenp_1192"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00848",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那当然了，而且是毫不客气打了两下啊」",
                voice: Some("li/yukanp_1180"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00849",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "其实已经不怎么痛了，\n也并不是想说这种事情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00850",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是，虽然想要说一声感谢，\n可在姬子面前，不坦率的我才是平时的我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00851",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是啊优花，所谓挚友，\n 偶尔也是会互殴的吧？」",
                voice: Some("li/himenp_1193"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00852",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这，这都什么鬼……哪部漫画的台词吗」",
                voice: Some("li/yukanp_1181"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00853",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "无意中说出的挚友一词讲到了我的心坎里，\n我高兴极了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00854",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「（……咕…抽泣…）」",
                voice: Some("li/yukanp_1182"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00855",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但还不能哭出来。\n全勤奖还没有完成。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00856",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我给自己定下过规定…\n在此之前我必须是往常的我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00857",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然而，不仅仅是高兴，还真切地感受到了无以复加的寂寞……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
