        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是呢……总之，这种衣服以后还是不要再穿了」",
                voice: Some("li/himenp_1198"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00876",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶，这种衣服？」",
                voice: Some("li/yukanp_1185"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00877",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这种轻飘飘的衣服，实在是容易招引男人……\n你也老大不小了」",
                voice: Some("li/himenp_1199"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00878",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「招引……这跟年纪没关系的吧」",
                voice: Some("li/yukanp_1186"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00879",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是真可惜啊，如果我是男人的话，一定会娶你的」",
                voice: Some("li/himenp_1200"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00880",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，你，你在说什么啊」",
                voice: Some("li/yukanp_1187"),
            ),
