            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "－千 寻－",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00375",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「来，姐姐，我把晚餐的盘子拿来了哦」",
                voice: Some("li/tihinp_1010"),
            ),
        ),
        (
            cmd: label,
