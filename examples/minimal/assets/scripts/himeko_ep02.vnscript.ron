        ),
        (
            cmd: label,
            args: (
                name: "block_00575",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "停下轮椅，所指的地方还是以前的那片青草区域。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00576",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，好像是水仙吧？」",
                voice: Some("li/yukanp_1124"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00577",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对对，虽然长得很高了\n 但距离结花蕾还早」",
                voice: Some("li/himenp_1145"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00578",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "以前听说是这花最早也要12月开。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00579",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "与之相对的现在才10月末。\n而且明天，姬子就决定要接受那点滴了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00580",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽说是在意料之内，\n姬子想看到这花的愿望是实现不了了吧……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00581",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: Some("li/yukanp_1125"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00582",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯？ 干嘛耷拉着脸啊」",
                voice: Some("li/himenp_1146"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00583",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，抱，抱歉……」",
                voice: Some("li/yukanp_1126"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00584",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "尽管我尽量不想表现出这样的态度，\n可还是无意间露出了这表情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00585",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……现在我绝不能表现出异样。",
