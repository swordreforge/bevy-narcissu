            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00653",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对，就是难道说」",
                voice: Some("li/himenp_1158"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00654",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不想被察觉的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00655",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "公司的事一点儿都没向别人提起过。\n不要说姬子，就连千寻也没有过。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00656",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "况且也没带谁来过公司，\n说到底没理由会知道过来的路啊。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00657",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这车子也没有导航系统，\n到底是怎么知道的……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00658",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……为什么会知道这个地方？」",
                voice: Some("li/yukanp_1139"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00659",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯？ 只要知道地址的话总有办法的哦」",
                voice: Some("li/himenp_1159"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00660",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…………………」",
                voice: Some("li/yukanp_1140"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00661",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哼哼，不要小看姬子我哦……\n记住全日本的地图可不是吹牛哦」",
                voice: Some("li/himenp_1160"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00662",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后立起躺在椅子上的身体。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00663",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，带我去吧」",
                voice: Some("li/himenp_1161"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00664",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着向外伸出了手。\n当然这里并没有轮椅。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00665",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "本来敞篷车就没放轮椅的空间，\n而且也没想到还要下车。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00666",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但，但是，姬子……」",
                voice: Some("li/yukanp_1141"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00667",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没关系，不用那么紧张，\n只是想去和公司的人稍微打下招呼而已」",
                voice: Some("li/himenp_1162"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00668",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…………………」",
                voice: Some("li/yukanp_1142"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00669",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……姬子到底已经察觉到了什么程度啊？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00670",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "的确我给公司增添了不少麻烦，这我也知道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00671",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "可如果，姬子要是对此感觉是自己的责任的话……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00672",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因此想要代替我去道歉的话，\n这种事绝对不可以。",
                voice: None,
