        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「果然啊……别看我这样，还是有许多事放不下心啊」",
                voice: Some("li/himenp_1091"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00264",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶？」",
                voice: Some("li/yukanp_1071"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00265",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "突然。姬子这样说道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00266",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「千寻呢，倒还好，可以放心」",
                voice: Some("li/himenp_1092"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00267",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是吗？ 不担心千寻啊」",
                voice: Some("li/yukanp_1072"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00268",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不，虽然不是完全放心，\n别看千寻那样，可是很坚强的孩子哦」",
                voice: Some("li/himenp_1093"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00269",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那你是担心谁呢？」",
                voice: Some("li/yukanp_1073"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00270",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯…果然还是濑津美吧」",
                voice: Some("li/himenp_1094"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00271",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……濑津美？」",
                voice: Some("li/yukanp_1074"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00272",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "第一次听到这个名字。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00273",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "和姬子也是老朋友了，\n互相的朋友应该都认识的……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00274",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那么应该是没有和姬子见面的，\n这几个月里认识的吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00275",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "想到这里，\n一个人影在我脑中一闪而过。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00276",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「难道说……是上次在海边碰到的那个孩子？」",
                voice: Some("li/yukanp_1075"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00277",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对，虽然才只有15岁，\n算是忘年之交吧」",
                voice: Some("li/himenp_1095"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00278",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "关于这个叫濑津美的女孩子，\n除了见过一面以外，其他什么都不知道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00279",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是，她既然让姬子那么不放心……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00280",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那么对于姬子来说，一定有着什么重要的意义吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00281",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，姬子，要是有什么我可以帮忙的你尽管说」",
                voice: Some("li/yukanp_1076"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00282",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯？ 濑津美的事情？」",
                voice: Some("li/himenp_1096"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00283",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对，\n 你也不想留下挂念吧」",
                voice: Some("li/yukanp_1077"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00284",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，也对呢……」",
                voice: Some("li/himenp_1097"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00285",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "姬子考虑了许久。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00286",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「要是看到那孩子穿着连衣裙……\n就带她去兜风吧」",
                voice: Some("li/himenp_1098"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00287",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哈？ 连衣裙？」",
                voice: Some("li/yukanp_1078"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00288",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是，要是穿着睡衣的话……\n那就别去管她吧…」",
                voice: Some("li/himenp_1099"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00289",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「因为要是穿着睡衣的话，\n那就表示还没给出回答吧」",
                voice: Some("li/himenp_1100"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00290",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "完全不知道是什么意思。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00291",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不对，字面上的意思我理解，但不知道她的意图是什么。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00292",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「知道了，不，说实话不是很清楚，\n总之我知道了」",
                voice: Some("li/yukanp_1079"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00293",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……不好意思啊，优花」",
                voice: Some("li/himenp_1101"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00294",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "之后帮所有的花坛都浇完水。\n我们离开了中庭。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00295",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "姬子突然转过头来对我说道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00296",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
