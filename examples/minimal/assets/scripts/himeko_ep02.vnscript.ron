        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "为的是把现在的职业套装换成轻飘飘的洋装。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00161",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然本来应该是在更衣室换的…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00162",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但考虑到自己现在的状况，\n这样轻飘飘的洋装打扮还是尽量别被看到为好。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00163",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……穿成这样去探望别人实在是没有说服力。\n反而会被怀疑。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00164",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "再说，\n我当然也想避免现在这种打扮。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00165",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然这么想，但这样能让姬子开心。\n让她安心。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00166",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以，我选择了“伪装”成平时的自己。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00167",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsora01bb",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
