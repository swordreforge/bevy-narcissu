            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00510",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不是发怒的语气。\n不，应该说是惊呆了吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00511",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但这结合我以往的表现和昨天的事情来看也是当然的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00512",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你，搞得清现在的状况吗？ 在最忙的时候早退？」",
                voice: Some("li/npetcm2_019"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00513",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，对，虽然很抱歉但……」",
                voice: Some("li/yukanp_1109"),
