        (
            cmd: label,
            args: (
                name: "block_00966",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯嗯，是只对你施展的（咒语)，\n但我迟迟找不到合适的…」",
                voice: Some("li/himenp_1211"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00967",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但在这些日子里思考过后，\n 终于被我找到了」",
                voice: Some("li/himenp_1212"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00968",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后一个深呼吸后，\n姬子直直地注视着我……",
                voice: None,
            ),
        ),
