            cmd: label,
            args: (
                name: "block_00911",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "据说有时也可能出现意识十分清醒的时候，\n但我也并不是很期待这种时候。",
                voice: None,
            ),
