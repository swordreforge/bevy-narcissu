        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「谢谢……千寻你今天也带自己的便当来了吗？」",
                voice: Some("li/himenp_1104"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00377",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，想和姐姐一起吃」",
                voice: Some("li/tihinp_1011"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00378",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，我在柜子上打开了便当。\n因为想分一点给姐姐所以稍稍多做了一些。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00379",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「今天做了你以前点名想吃的可乐饼哦」",
                voice: Some("li/tihinp_1012"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00380",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「谢谢，不知怎么就突然想吃了呢」",
                voice: Some("li/himenp_1105"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00381",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个…圆形的是蔬菜馅的，\n椭圆形的是蟹肉奶油馅的」",
                voice: Some("li/tihinp_1013"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00382",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，我就吃一个蟹肉奶油馅的吧」",
                voice: Some("li/himenp_1106"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00383",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从床上起身的姐姐，把筷子伸向柜子上的便当盒。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00384",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我也同样夹了一块，两个人一同吃起了可乐饼。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00385",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……以前兴起就会跑去食堂，\n随意吃想吃的东西的姐姐。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00386",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，也没有这样的事了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00387",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "即使姐姐不说，\n因为我也负责过几次7F的病人，所以我明白。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00388",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这其实不是不想吃而是不能吃。\n事实上能吃的东西已经相当有限了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00389",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "即便想吃，如果不是柔软的流质的食物，\n对她而言难以下咽……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00390",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsin_b05b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对了千寻，那个，快了吧？」",
                voice: Some("li/himenp_1107"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00391",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「什么？」",
                voice: Some("li/tihinp_1014"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00392",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，点滴啦点滴」",
                voice: Some("li/himenp_1108"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00393",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，这个大概还要吊一小时吧」",
                voice: Some("li/tihinp_1015"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00394",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不是指这个啦……是更换点滴的事」",
                voice: Some("li/himenp_1109"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00395",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我不由得打了个冷颤。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00396",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这并不是指现在的点滴吊完，\n单纯地换成下一瓶这件事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00397",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而是一个令人心情沉重的，\n也是这几天里不得不决定的重要决定。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00398",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……今天正好想跟优花商量的，\n没想到姐姐自己先提起了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00399",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「千寻，你瞒着我是没用的，\n无论如何我的经历(指7F的 helper)可比你长哦」",
                voice: Some("li/himenp_1110"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00400",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我决定放弃隐瞒实话实说了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00401",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "恐怕想要委婉一点也没用，\n迟早是不得不说的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00402",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……嗯，我想周末医生就会来找你谈话的」",
                voice: Some("li/tihinp_1016"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00403",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，比我想的还要早啊……\n因为是我才特别关照的吧？」",
                voice: Some("li/himenp_1111"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00404",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "更换点滴的意思。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00405",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "很遗憾止痛用的吗啡是有安全用量的，\n用量再怎么增加也是有界限的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00406",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么你打算怎么办，姐姐？」",
                voice: Some("li/tihinp_1017"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00407",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是啊，嗯…怎么办呢」",
                voice: Some("li/himenp_1112"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00408",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "姐姐手托着头，做出苦恼的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00409",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这“最后”的点滴并非强制，\n而是可以根据病人自己的想法决定。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00410",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知别的医院是怎么样的，\n但至少这个医院是采用这个方法。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00411",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……通常应该是在更晚期的时候才告知病人的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00412",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "恐怕正如姐姐所说，\n因为是熟人所以才会更早来征取意见的吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00413",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「难道说姐姐，你打算接受？」",
                voice: Some("li/tihinp_1018"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00414",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，我接受打点滴了，\n 也算是医生的一片厚意吧」",
                voice: Some("li/himenp_1113"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00415",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但，但是，姐姐……」",
                voice: Some("li/tihinp_1019"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00416",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没关系。\n 我自己也不想太疼痛的」",
                voice: Some("li/himenp_1114"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00417",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "姐姐一边说着，露出了笑脸。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00418",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……但其实不是这样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00419",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "姐姐不会因为这个理由就接受打点滴的，\n这点我是知道的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00420",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一定是不想让我和父母，\n还有朋友看到自己痛苦的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00421",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "特别是优花，绝对不想让她看到那样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00422",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsin_b05b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，千寻，\n你是一个比自己想象得还要坚强的孩子哦」",
                voice: Some("li/himenp_1115"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00423",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哎…」",
                voice: Some("li/tihinp_1020"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00424",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "话题突然转到我的身上让我吃了一惊。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00425",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不是吗？ 每天大学下课后都来七楼，\n休息天还要去辅读学校做志愿者」",
                voice: Some("li/himenp_1116"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00426",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「而且教会的善工活动也从不缺席……」",
                voice: Some("li/himenp_1117"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00427",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「如果有神存在的话，一定会让你去天堂的」",
                voice: Some("li/himenp_1118"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00428",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……姐姐…」",
                voice: Some("li/tihinp_1021"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00429",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「所以什么也别说了，\n我死后你就暂时别做helper了」",
                voice: Some("li/himenp_1119"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00430",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「以后即使再想当的话也要去别的医院当」",
                voice: Some("li/himenp_1120"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00431",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……那么，不能再来这个医院了吗？」",
                voice: Some("li/tihinp_1022"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00432",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那时的话……也要等你完全恢复过来再说哦」",
                voice: Some("li/himenp_1121"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00433",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "和平时不同，姐姐口吻平静地说道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00434",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然还不十分理解，但还是默默点了点头。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00435",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
