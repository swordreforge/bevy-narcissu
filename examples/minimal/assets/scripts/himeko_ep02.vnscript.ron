            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00543",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真是的，拿你没办法，医院里可不能奔跑哦」",
