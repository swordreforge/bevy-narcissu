            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…预料之外。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00716",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过想一想，这确实是姬子会做出的言行。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00717",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊？ 你们究竟是想要说什么？\n我们现在可是中断工作来接待你们的啊」",
                voice: Some("li/npetcm2_027"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00718",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「昭岛，你也真是的，这种情况把她带出来，\n未免也太缺乏常识了吧」",
                voice: Some("li/npetcm2_028"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00719",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「除此之外，\n 你根本就是一直在给科里添麻烦嘛」",
                voice: Some("li/npetcm2_029"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00720",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，是……对不起……」",
                voice: Some("li/yukanp_1151"),
            ),
        ),
