        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―回程的车中。\n白昼渐短的秋日，才下午5点天空已经开始暗了下来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00759",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "躺在副驾位上的姬子和握着方向盘的我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00760",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "互相保持着沉默，行驶在归程途中。",
