            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00996",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是，以前遇见她时给人轻飘飘的可爱的印象，\n今天却穿着笔挺的职业套装。",
                voice: None,
            ),
