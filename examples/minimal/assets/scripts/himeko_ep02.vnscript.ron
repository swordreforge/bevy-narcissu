            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呐，优花……」",
                voice: Some("li/himenp_1179"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00762",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "首先打破沉默的是姬子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00763",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「之后跟那科长说声抱歉吧……\n稍微利用了他一下」",
                voice: Some("li/himenp_1180"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00764",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，嗯……」",
                voice: Some("li/yukanp_1167"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00765",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "暂且先口头上答应了，\n但我还是不太明白。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00766",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "感觉事到如今公司的那些事已经是些无所谓的小事了，\n因为已经得到了更加珍贵的东西。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00767",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对了姬子……你怎么会知道的？」",
                voice: Some("li/yukanp_1168"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00768",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯？ 你公司的事？」",
                voice: Some("li/himenp_1181"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00769",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对啊，我应该对谁都没提起啊」",
                voice: Some("li/yukanp_1169"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00770",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "至少从去年春天，\n从姬子开始住院起，我不记得有提起过工作的话题。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00771",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，也不记得对千寻说过。\n不如说，经常还有意避开这个话题。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
