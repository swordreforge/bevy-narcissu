        (
            cmd: label,
            args: (
                name: "block_00860",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不准哭，优花……」",
                voice: Some("li/himenp_1194"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00861",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "勉强忍住的眼泪，\n正要夺眶而出之时。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00862",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这狭小的病房里，\n再次响起了昨天我被打脸的声音与姬子的声音。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00863",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不可以为这点小事哭哦」",
                voice: Some("li/himenp_1195"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00864",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呜，可，可是。\n 就算你这样说，呜……」",
                voice: Some("li/yukanp_1183"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00865",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，\n 你就把被打的疼痛当做继续哭泣的理由吧」",
                voice: Some("li/himenp_1196"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00866",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，姬子轻抚着我稍稍变红的脸颊。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00867",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从床上探出身子，\n抚摸着我脸颊的手让我感到无比温暖。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00868",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……比挨打的我更疼痛数倍的是姬子才对………姬子一定比被打的我更加痛苦吧…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00869",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以即使再勉强我也要忍住眼泪。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00870",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明天姬子就不在了，\n我将变得孤独一人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00871",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不只是为了姬子，为了自己我也不可以在这里哭泣。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00872",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「并，并不是很痛所以没关系的……」",
                voice: Some("li/yukanp_1184"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00873",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是吗，那就好……\n 不知为何总是想不出要对你施展的魔法该怎么说好」",
                voice: Some("li/himenp_1197"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00874",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后深深叹了口气。",
                voice: None,
            ),
        ),
        (
