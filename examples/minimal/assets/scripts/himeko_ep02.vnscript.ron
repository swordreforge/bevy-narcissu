            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "10月即将结束，\n今天我依然在这熟悉的地方度过。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00916",
            ),
        ),
        (
            cmd: set_bg,
            args: (
