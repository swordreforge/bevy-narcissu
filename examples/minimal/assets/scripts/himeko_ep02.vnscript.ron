            cmd: dialogue,
            args: (
                speaker: None,
                text: "想让姬子无论何时，\n永远都堂堂正正昂首挺胸。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00703",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nbg_2020b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
