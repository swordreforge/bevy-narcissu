            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "咚咚。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00206",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsin_b05",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
