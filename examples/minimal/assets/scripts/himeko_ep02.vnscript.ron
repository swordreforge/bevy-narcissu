            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―灼热的阳光。高悬的烈日。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00049",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "落在脚边的漆黑影子。\n暑假仅剩几天，前往泳池的孩子们的身影映入眼帘。",
