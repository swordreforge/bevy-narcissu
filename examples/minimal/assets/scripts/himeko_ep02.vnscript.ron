            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「总之，\n 想瞒我你还早了十年呢」",
                voice: Some("li/himenp_1185"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00778",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是啊，的确是这样……」",
                voice: Some("li/yukanp_1170"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00779",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「还用说吗？\n 多年的挚友可不是徒有虚名的」",
                voice: Some("li/himenp_1186"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00780",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，姬子露出了笑脸。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00781",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所谓“挚友”所指的不是别人，正是我。\n对此我感到十分高兴。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00782",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "无论对谁都能挺起胸膛，说这样的我是姬子的挚友，\n对此我感到无比荣耀。",
                voice: None,
