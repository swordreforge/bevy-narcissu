            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―就这样…\n我继承了她的爱车。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00099",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "还是初秋的时候。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00100",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "自那天开始，医院的停车场里，\n有了作为全勤奖品的红色敞篷车的身影。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00101",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nsora03",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
