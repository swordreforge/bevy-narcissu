            args: (
                name: "block_00724",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "终于麻痹的感觉在脸上扩散开来……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00725",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明白过来，是被姬子狠狠抽了一巴掌。",
                voice: None,
