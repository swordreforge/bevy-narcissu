            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "啪……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00930",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "轻轻的一声。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00931",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽说是拍，该说是抚摸吧，但这已经足够了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00932",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「果然，我们是挚友啊……」",
                voice: Some("li/yukanp_1200"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00933",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "随后准备结束今天的会面。\n我从折叠椅上站起身来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
