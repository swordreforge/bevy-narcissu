            cmd: label,
            args: (
                name: "block_00784",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "眼前不断出现熟悉的景物，\n毫无疑问距离医院已越来越近了。",
                voice: None,
            ),
        ),
        (
