            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "【   十 月   】",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00102",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嘿咻，嘿咻」",
                voice: Some("li/yukanp_1051"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00103",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我喘着粗气。\n站立骑着自行车，向着车站全力冲刺中。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00104",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在的时间是8点44分，\n公司的上班时间是9点30分。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00105",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "为了赶上时间，我必须乘上8点51分的快速电车。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00106",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……虽然往常的话，都是坐的上一班车…\n顺便一提，家里到车站是步行10分钟的距离。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00107",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以通常都是走着去车站的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00108",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "像今天这样不小心睡过了头的时候，\n为了缩短哪怕一点点时间就会用自行车冲刺。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00109",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…有寄放自行车的地方吧…」",
                voice: Some("li/yukanp_1052"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00110",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不留心的话可是会被没收的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00111",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边担心着这样无所谓的事，一边加快了自行车的速度。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00112",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "以最近的我的立场，要尽量避免迟到。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00113",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「早上好！」",
                voice: Some("li/yukanp_1053"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00114",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nbg_2020",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我打开办公室的门，精神满满地打着招呼。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00115",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后在走向自己的办公桌之前，\n先在咖啡机前准备15人份的咖啡。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00116",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这个数量，是这个科的总人数。\n每天早上泡咖啡，也是我的工作。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00117",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―我所供职的，是被称作所谓证券公司的地方。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00118",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然已经就职1年半了，\n但还是不变的像新人那样干着杂活。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00119",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在或许我成了个茶水·咖啡OL…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00120",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "他们也不可能把重要的工作，\n交给没有突出的才能，迟钝的不擅长与人交往的自己。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00121",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在同为女员工的前辈们，\n正和其他人一样干脆利落地处理着工作。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00122",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「（……算了，直截了当地说，\n我不怎么机灵吧…）」",
                voice: Some("li/yukanp_1054"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00123",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "原本，大学毕业时选择这家公司的理由，\n就只是报酬不错加上休息日比较多而已。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00124",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "最初就不是经过深思熟虑而决定的工作。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00125",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "正因如此对于现在的状况也不打算发什么牢骚……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00126",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是最近我的立场变得有些微妙。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00127",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "nbg_2020",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「昭岛，能来一下吗？」",
                voice: Some("li/npetcm2_005"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00128",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "叫我名字的，是科长。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00129",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "作为这个办公室的最高领导，\n这个人叫我的话只会有两件事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00130",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，好的，是咖啡要续杯吗？」",
                voice: Some("li/yukanp_1055"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00131",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不，不是这个，这周要开始进入结算报告的准备了」",
                voice: Some("li/npetcm2_006"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00132",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，嗯嗯……是这样的…」",
                voice: Some("li/yukanp_1056"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00133",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我暧昧地含糊了回答。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00134",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "简单来说，科长的话就是『给我加班！』的意思。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00135",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "确实这只是一个15人的小部门，\n真忙起来的话就算是我的协助也是需要的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00136",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……但是真正的理由不是这个。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00137",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "是想要展示全体员工的士气吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00138",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在其他人都加班加点甚至休息日都出勤拼搏的情况下…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00139",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "像我这样的新人每天整点定时下班，\n在气氛上也肯定不会有好的影响。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00140",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不好意思科长，今天有点…」",
                voice: Some("li/yukanp_1057"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00141",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是吗，其他人也很辛苦的，你自己也注意点啊」",
                voice: Some("li/npetcm2_007"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00142",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着科长露出轻快的笑脸。\n但是眼神却没有在笑。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00143",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从附近办公桌似乎竖起耳朵探听的某人处，\n听到了『啧』的咂舌声。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00144",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "暂且是跟课长说过，\n是为了要去朋友那里探病。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00145",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但这能说得过去的也只是几天的程度。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00146",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "要是连续数周，数月的话，\n即便是表面表示理解，但内心肯定也不能接受应该也是人之常情也说不一定。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00147",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……这种时候，如果是姬子的话…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00148",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "会更好地把自己想说的话说清楚吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00149",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就算是到时候闹到打起来，\n不如说感觉这之后互相之间会变成清楚明朗的关系。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00150",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明明明白这个道理，但始终说不出强硬话语的我……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00151",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "果然还是不得要领吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00152",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……大概还挺意外的，\n原本我的性格就不是强硬的那种。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00153",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "即便如此至今为止都能像普通人一样生活……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00154",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不可否认是因为有姬子在吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00155",
            ),
        ),
