        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "阳光洒在泛着水汽的花坛上，折射出几道彩虹。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00302",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "正在祈祷的姬子，坐在被这彩虹围绕着的轮椅之上。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00303",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这身影，让人感到十分美丽，十分梦幻。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00304",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明明是共处了多年，\n互相无所不知的挚友……",
                voice: None,
