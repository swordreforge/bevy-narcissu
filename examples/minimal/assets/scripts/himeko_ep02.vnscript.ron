        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "今天的谈话室\n是平时难见的摩肩接踵的状态。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00790",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "有医生和脸熟的护士们，\n不只是姬子的双亲、还有些大概是亲戚的人…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00791",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "教会的神父和\n修女们也都聚集在这里。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00792",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我和平时一样走向了姬子的病房。",
                voice: None,
            ),
        ),
        (
