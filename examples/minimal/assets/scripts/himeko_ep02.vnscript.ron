            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哟，很精神嘛」",
                voice: Some("li/yukanp_1059"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00175",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，我举起一只手爽朗地打招呼。\n也没忘记扬起轻飘飘的裙子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00176",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「身体感觉怎么样？」",
                voice: Some("li/yukanp_1060"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00177",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，一般般吧……」",
                voice: Some("li/himenp_1077"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00178",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从床上撑起身子的姬子回应道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00179",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "还是老样子摊着地图，床边的柜子上，\n放着盛满了刚削好的苹果的盘子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00180",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看这样子，应该是想削成小兔状样子吧。\n因为刚削好没多久，颜色还是雪白的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00181",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……我想这一定不用明说……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00182",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "是算好我来的时间，\n姬子特意准备的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00183",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "小兔的样子稍微有些走样，\n我也知道最近姬子的手指已经变得不灵活了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00184",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一想到行动不便的姬子，以姬子的方式努力为我做的，\n我的心中不禁悲伤。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00185",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "正因为如此我表现了和平常一样的样子。\n我觉得非得表现得和平常一样不可。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00186",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哇！很好吃的样子啊，让我吃一块吧~」",
                voice: Some("li/yukanp_1061"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00187",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂！优花，谁让你那么不客气地从头开始吃的啊。\n 削成小兔的话应该是有吃法的吧？」",
                voice: Some("li/himenp_1078"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00188",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯？ 这削的是小兔的吗？」",
                voice: Some("li/yukanp_1062"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00189",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真没礼貌啊。怎么看都是小兔子吧，\n再说苹果削成兔子也算是常识了吧」",
                voice: Some("li/himenp_1079"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00190",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，稍微闹别扭似地，姬子也吃了一块。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00191",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而我也同样往嘴里放了第二块。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00192",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「还有啊优花，\n 要好好先洗手再吃哦」",
                voice: Some("li/himenp_1080"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00193",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没关系的啦，偶尔的话无所谓的」",
                voice: Some("li/yukanp_1063"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00194",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不行哦，你不知道病从口入吗（原文：杂菌是万病之源）……\n不过，这种话从病人的我嘴里说出来好像没啥说服力啊，啊哈哈」",
                voice: Some("li/himenp_1081"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00195",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着姬子发出爽朗的笑声。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00196",
            ),
