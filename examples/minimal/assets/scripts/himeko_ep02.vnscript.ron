            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「大家辛苦了，我先走一步了」",
                voice: Some("li/yukanp_1058"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00157",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "平时更低地埋着头，我离开了办公室。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00158",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明明已经是全公司的下班时间，\n走廊上和电梯厅里却只有零星几个人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00159",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但我并没有这样直接走出公司，\n而是走向了其他楼层的厕所。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00160",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "n_b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
