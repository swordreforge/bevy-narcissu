            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……第一天在那里发呆，第二天便开始想是不是哪里出错了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00186",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后第三天便不再疑惑了……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00187",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "终于从口里吐出了那句话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00188",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……我要被杀死了」",
                voice: Some("li/n3kiri_0077"),
