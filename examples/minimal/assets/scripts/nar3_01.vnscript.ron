        ),
        (
            cmd: label,
            args: (
                name: "block_00207",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "窗外，今天也飘着雪。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00208",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这里真冷啊」",
                voice: Some("li/n3hei_0019"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00209",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你是……」",
                voice: Some("li/n3kiri_0082"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00210",
            ),
        ),
        (
            cmd: set_bg,
