        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "咔……随着金属的摩擦声，铁门打开了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00284",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样，那个士兵和我就再没东西阻隔。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00285",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么公主殿下，请做好觉悟吧……」",
                voice: Some("li/npetcm35_008"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00286",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，他一脚踏入了牢房。把刀锋转向我。因为太过恐惧我无法去看他的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00287",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……看来我要死掉了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00288",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "却不知为何完全没有现实感，仿佛是他人的事情那样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00289",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就算是全都已经预想到了，但在面对过于残酷的事实的时候，人都会变得那样吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00290",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然而，在我不禁闭上双眼，决定了接受死亡的时候，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00291",
            ),
        ),
        (
