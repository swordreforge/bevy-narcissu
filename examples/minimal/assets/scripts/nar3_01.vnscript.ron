        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……吓到了吧？」",
                voice: Some("li/n3hei_0016"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00124",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯……」",
                voice: Some("li/n3kiri_0066"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00125",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「看来在您的国家里也有呢」",
                voice: Some("li/n3hei_0017"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00126",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: Some("li/n3kiri_0067"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00127",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，这里所说的“也有”，是指想取我性命的人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00128",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "恐怕并非是与我有仇。只是单纯地想把我的死作为开战的借口吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00129",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那种程度，还是孩子的我也能理解到。何况，我也没活到可以与人结仇那么长的时间。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00130",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……不过，是你救了我了吧？」",
                voice: Some("li/n3kiri_0068"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00131",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这只是我分内的工作」",
                voice: Some("li/n3hei_0018"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00132",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "没错。这个人保护了我。貌似也有其他的人要保护我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00133",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "的确，我的性命虽然很脆弱，不过也是有人希望我活着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00134",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然不是很清楚，但还是有人需要我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00135",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……人是因为被他人所需要，才称之为人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00136",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "也就是说……这是我还作为人的证据。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00137",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "bg_0001",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那之后的数月……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00138",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "秋去冬来之时，终于，这个国家和我的母国开战了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00139",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "详细是什么时候开始的我也不知道。\n问了也不可能会告诉我，当我察觉到的时候就已经开始了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00140",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……看来，这与我的生死并无关系。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00141",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那是迟早都会发生，一开始就决定好的事。我的生死，也只是作为契机的程度吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00142",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一定只是，几个借口中的一个吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00143",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "na03_08",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……我，会怎样呢……」",
                voice: Some("li/n3kiri_0069"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00144",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我从窗边眺望天空，想着很多事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00145",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "听说，那个第二王子好像也战死了。据说是远征回来的途中死的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00146",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "到底是我的母国派人杀死的，还是因为生病或意外身亡，就不得而知了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00147",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……不过，我并不格外觉得伤心。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00148",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那是既没有和我见过面，也没有和我说过话的人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00149",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「比起王子的死，我更害怕……」",
                voice: Some("li/n3kiri_0070"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00150",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就算只是形式上的，\n但作为我未婚夫的人死了，这也就意味着我能依赖的人已经消失了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00151",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不由得害怕起我马上就要被处刑了吧，但不知什么原因我又被送回到这个房间。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00152",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在生活上和以前也没有什么变化，\n也没有变得不自由。从以前就跟我在一起的侍女和卫兵都在身边待命。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00153",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……但是，屋子的锁“只”装在外面」",
                voice: Some("li/n3kiri_0071"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00154",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那足以说明一切。那是什么意思，不用问也知道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00155",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那些事，我已经体会得够多了。我也不是白白过了八年那样的日子……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00156",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……但是，有一点跟以前有着决定性的不同……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00157",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我自己也微微感觉到，所以也害怕过。我害怕那一天会到来……",
                voice: None,
            ),
        ),
        (
