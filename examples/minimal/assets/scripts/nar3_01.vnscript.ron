            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……到底说的是什么东西要来？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00248",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那个卫兵，已经肯定说了不会帮我，难道是有谁会来帮我……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00249",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00250",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那是不可能的。我立刻否定了自己这个天真的想法。",
