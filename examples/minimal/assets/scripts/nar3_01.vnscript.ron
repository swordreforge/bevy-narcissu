        ),
        (
            cmd: label,
            args: (
                name: "block_00077",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这次把我嫁过去貌似就是作为同盟的证明",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00078",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然而，我的母国和北方的国家也有同盟关系。要说的话，这就是两难的境地。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00079",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「也就是说，如果您的安全出现了问题，恐怕贵国和我国的同盟也会随之解除」",
                voice: Some("li/n3hei_0008"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00080",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那样的话会怎样呢？」",
                voice: Some("li/n3kiri_0061"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00081",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「恐怕我国，会和贵国以及北方的国家，展开大规模的战争吧」",
