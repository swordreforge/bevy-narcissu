        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「伊丽丝公主安然无恙真是太好了」",
                voice: Some("li/npetcm34_008"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00103",
            ),
        ),
        (
            cmd: set_bg,
