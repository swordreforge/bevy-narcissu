            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说完，他弯腰坐在了地牢的出入口。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00234",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "无论我怎么叫他，他都不回答我，甚至都没有回头看这边……",
                voice: None,
