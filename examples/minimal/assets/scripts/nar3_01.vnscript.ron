        (
            cmd: label,
            args: (
                name: "block_00253",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那样的话，说是来监视我的他的工作又是什么呢？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00254",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知要领的想着那些事的时候……",
