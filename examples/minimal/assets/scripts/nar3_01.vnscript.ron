        ),
        (
            cmd: label,
            args: (
                name: "block_00074",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……公主殿下还小所以还不能理解吧……」",
                voice: Some("li/n3hei_0007"),
