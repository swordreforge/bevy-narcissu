            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，谢……」",
                voice: Some("li/n3kiri_0093"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00328",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没什么，不用谢我」",
                voice: Some("li/n3hei_0037"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00329",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "他一边看着倒在眼前的骑士，一边擦拭自己剑上的血迹。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00330",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那个骑士好像还活着，不过我不知道自己该怎么办好。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00331",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "首先我就对事态无法完全理解。发生了太多事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00332",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……但是，为什么要杀我呢？」",
                voice: Some("li/n3kiri_0094"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00333",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「什么，你连这个都不知道？」",
                voice: Some("li/n3hei_0038"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00334",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……嗯」",
                voice: Some("li/n3kiri_0097"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00335",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果正式处刑的话我还能接受，就是不明白背地里暗杀的意义。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00336",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这些家伙只是急功近利而已，不用管它」",
