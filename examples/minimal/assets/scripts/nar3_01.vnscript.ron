            args: (
                speaker: None,
                text: "隔着格子拿着剑，一直指向我这边。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00262",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……你是？」",
                voice: Some("li/n3kiri_0090"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00263",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不记得了吗？应该在殿堂见过几次面的」",
                voice: Some("li/npetcm35_003"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00264",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说真的，就算被这样说还是想不起来。刚刚来到这里的时候，每天都与数十人见面。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00265",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是不用担心……杀你时会让你死得没有痛苦的」",
                voice: Some("li/npetcm35_004"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00266",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「杀，杀……」",
                voice: Some("li/n3kiri_0091"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00267",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "还在想是不是耳朵听错了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00268",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "与此同时，之前所有的预感，预感忽然变为现实而感到强烈的恐惧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00269",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「虽然我并不是跟你有仇，杀死孩子感觉也不好……」",
                voice: Some("li/npetcm35_005"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00270",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但你还是死心吧」",
                voice: Some("li/npetcm35_006"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00271",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这个人就这么简单地宣告了那么可怕的事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00272",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，他并不是在开玩笑。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00273",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不管怎么，“杀”这个词，并不是对其他人说的，而是对我说的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00274",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，卫兵，把锁打开」",
                voice: Some("li/npetcm35_007"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00275",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "把里面的卫兵叫了过来。那卫兵之前一直只是在看着这边。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00276",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，听到话的那个人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00277",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "毫不犹豫，直接走了过来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00278",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……我不禁用眼神求助。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00279",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然不知道这个人是不是自己人，但对我来说已经没有其他人可以拜托了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00280",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然而……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00281",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「请」",
                voice: Some("li/n3hei_0031"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00282",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，我求助的眼神也只是徒然，门锁被很干脆地打开了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00283",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "3010c",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
