            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「看起来还很有精神啊」",
                voice: Some("li/n3hei_0020"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00211",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，嗯……」",
                voice: Some("li/n3kiri_0083"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00212",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "来的人，是以前的那个卫兵。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00213",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……难道是，来救我出去的吗？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00214",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知道他能不能放我出去。他以前曾经救过我一命。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00215",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "正在我打算开口的时候，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00216",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「喂，别误会了。 我并不是来救你的」",
                voice: Some("li/n3hei_0021"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00217",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶……」",
                voice: Some("li/n3kiri_0084"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00218",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "被他先制止了。而且那口吻是并不是以前的那种。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00219",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「反而说是为了防止你逃跑，来监视你的」",
                voice: Some("li/n3hei_0022"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00220",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那卫兵非常冷淡地说着。对我的称呼也已经改为“你”了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00221",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「还是说……你想从这里逃出去？」",
                voice: Some("li/n3hei_0023"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00222",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: Some("li/n3kiri_0085"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00223",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我稍微考虑了一下，摇了摇头。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00224",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「很好。 应该说这里才更加安全……」",
                voice: Some("li/n3hei_0024"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00225",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后他又对我说明了几项。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00226",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "据说有很多人憎恨我。想杀我的人要多少有多少。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00227",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是……我明明什么坏事都没做……」",
                voice: Some("li/n3kiri_0086"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00228",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……正是如此。 要是怨恨的话，就怨恨自己的命运不好吧」",
                voice: Some("li/n3hei_0025"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00229",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「怎么会……」",
                voice: Some("li/n3kiri_0087"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00230",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对着眼泪不禁流了出来的我，他毫不犹豫，继续冷漠地说着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00231",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我能对你说的只有一句……」",
                voice: Some("li/n3hei_0026"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00232",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「在这里信仰是没用的。 能相信的只有双眼所看到的东西」",
                voice: Some("li/n3hei_0027"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00233",
            ),
        ),
