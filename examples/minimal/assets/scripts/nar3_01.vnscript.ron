        ),
        (
            cmd: label,
            args: (
                name: "block_00083",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我也听说过，我的母国为了避免那样的战争，一直在劳心劳力。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00084",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "小国都尚且这样子，这个强大的国家也没有很大差别吧。",
