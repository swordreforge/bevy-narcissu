            cmd: label,
            args: (
                name: "block_00326",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然不理解他为什么要这样做。但，果然这个人还是帮了我。",
                voice: None,
