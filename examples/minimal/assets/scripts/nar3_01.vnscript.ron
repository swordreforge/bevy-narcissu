            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我捡起脚边的剑，边看边学着地摆着架势。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00305",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然、 我从未接受过剑术的教导。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00306",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "连把剑拿在手上都是第一次。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00307",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "杀死过很多人的士兵和完全没有任何经验的我，恐怕这场战斗根本不必谈论胜败。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00308",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现实不如想象这样的言词再次浮现在脑海。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00309",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就算说什么杀死无寸铁的我有违骑士精神，但给了我剑又有什么意义。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00310",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
