            cmd: label,
            args: (
                name: "block_00344",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为即使不那样做，处于劣势的我的母国，失败是迟早的事情，但更多人不赞同这样。",
                voice: None,
            ),
        ),
