            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "挷，沉重的铁门被打开的声音。一个全身包裹着盔甲的士兵出现了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00256",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是暼了眼门旁的人，就直直走向我这边。",
