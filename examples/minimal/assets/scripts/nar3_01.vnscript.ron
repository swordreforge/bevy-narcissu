            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "今天也能看到有很多人在我的身边。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00002",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「请问公主殿下觉得如何？」",
                voice: Some("li/n3zijo_0015"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00003",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，很好，谢谢你……」",
                voice: Some("li/n3kiri_0049"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00004",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "na03_07",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
