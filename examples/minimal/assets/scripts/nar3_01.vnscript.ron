        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……不可能的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00311",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不管是谁看见这种情况，都会这样想的吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00312",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "第一次拿起的剑，只是沉重且散发着血的气味而已。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00313",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，不要怨我了……」",
                voice: Some("li/npetcm35_011"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00314",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对渐渐靠近的对方，感觉到自己即将死亡。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00315",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知为何，我没发出声音也没流出眼泪。因为根本来不及。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00316",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……倒不如说，我嘴角一松，竟然笑了……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00317",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这时，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00318",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "kiru01_1",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「噶！~」",
                voice: Some("li/npetcm35_012"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00319",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在已经做好必死的觉悟的瞬间……眼前的对手，突然倒下了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00320",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "是背后被深深地砍了一刀吧，暗黑色的血液沿着黑暗的石床边扩散开来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00321",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你……你太……卑鄙了……」",
                voice: Some("li/npetcm35_013"),
