        (
            cmd: label,
            args: (
                name: "block_00172",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然脸上还是挂着平时的笑容，不过口吻明显不同。",
                voice: None,
            ),
