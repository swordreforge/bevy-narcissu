            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00082",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然听得很迷糊，但我也能够理解。",
                voice: None,
