        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「等一下」",
                voice: Some("li/n3hei_0032"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00292",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "突然，那个人，制止了对方。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00293",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你想干什么，想帮这家伙？」",
                voice: Some("li/npetcm35_009"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00294",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不，并没有这样的打算」",
                voice: Some("li/n3hei_0033"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00295",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "干脆地否定了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00296",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「只是，杀死一个手无寸铁的孩子，不太符合骑士精神……」",
                voice: Some("li/n3hei_0034"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00297",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「的确如此……好吧，把剑给她」",
                voice: Some("li/npetcm35_010"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00298",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "听完，那个人给我解开了手铐。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00299",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "继而又扔了一把剑在我脚下。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00300",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「难道，要我战斗吗……」",
                voice: Some("li/n3kiri_0092"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00301",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，如果你不想死的话」",
                voice: Some("li/n3hei_0035"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00302",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只说完这句，就走出了牢房了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00303",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只留下，面露微笑像是骑士的人。和连剑都拿不稳的我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00304",
            ),
        ),
        (
