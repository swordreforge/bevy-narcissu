        (
            cmd: label,
            args: (
                name: "block_00061",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我对他那样子有点在意，鼓起勇气地问了他一下。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00062",
            ),
        ),
        (
            cmd: set_bg,
            args: (
