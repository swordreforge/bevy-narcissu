        (
            cmd: label,
            args: (
                name: "block_00195",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "偶尔，被薄云遮挡，夜空渐渐变得漆黑一片。\n西方的天空和地平线一起融进了黑暗，分不清边界。",
                voice: None,
            ),
