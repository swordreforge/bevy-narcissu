            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00174",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，一把抓起我的吊坠。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
