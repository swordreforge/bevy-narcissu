        (
            cmd: label,
            args: (
                name: "block_00189",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "恐怕即使说“放我出去”也不会放我走的吧。这种程度的事就算是我也知道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00190",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从吊坠被拿走，到被锁在这样的地方……\n只要联系起来思考一下，我就能预感到，不久，迎接我的，将会是“死亡”。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00191",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一年前完全无法想象到我会变成这样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00192",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知为何，想到了现实远不如想象这句话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00193",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以，今天我也眺望着夜空。其他的什么都没做，什么也做不了……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00194",
            ),
        ),
        (
            cmd: set_bg,
            args: (
