            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在的她有着自由，大家也都欢迎她。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00038",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "已经不用再像以前那样，从窗口眺望夜空了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00039",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然而……其实并不是这样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00040",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那并非是不可动摇的……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00041",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而是非常脆弱的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00042",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如履薄冰一样，自己必须清楚地意识到这里所有的一切都可以轻易的崩溃。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
