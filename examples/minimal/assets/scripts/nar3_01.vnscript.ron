        ),
        (
            cmd: label,
            args: (
                name: "block_00322",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真吵，这也是没办法嘛……」",
                voice: Some("li/n3hei_0036"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00323",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一瞬间，并不知道发生了什么事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00324",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但，看到他剑上血痕，我立刻了解了情况。",
                voice: None,
