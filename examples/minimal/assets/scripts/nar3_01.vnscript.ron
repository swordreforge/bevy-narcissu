        (
            cmd: label,
            args: (
                name: "block_00237",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我跟往常一样从格子窗向夜空望去。在这里除了这样，再没有什么可以做的了。",
                voice: None,
