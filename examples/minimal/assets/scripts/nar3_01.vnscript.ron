            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「请问……难道是发生了什么事吗？」",
                voice: Some("li/n3kiri_0058"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00063",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "面对那样的提问，不知道为什么，卫兵压低声音仿佛耳语一样轻声回答。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00064",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，其实……又和北方发生了战争」",
                voice: Some("li/n3hei_0003"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00065",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「所以，公主殿下现在十分危险」",
                voice: Some("li/n3hei_0004"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00066",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「什，什么……？」",
                voice: Some("li/n3kiri_0059"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00067",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我不由得含糊的回答了句。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00068",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然我知道发生战争是很悲伤地事情，但我不明白为什么我会很危险。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00069",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "还是说，因为敌国的人会潜入城堡，所以叫我小心吗……？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00070",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不管怎样，我也觉得那是不可能的。\n再怎么说这里也是城堡内，而且现在处于战争中防卫就更加严密了吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00071",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我这样笼统的想着的时候，卫兵继续细声说道。",
