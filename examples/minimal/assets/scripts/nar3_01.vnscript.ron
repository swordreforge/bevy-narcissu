            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……于是，年幼的伊丽丝这样想着」",
                voice: Some("li/n3iri_0025"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00037",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "na03_03",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
