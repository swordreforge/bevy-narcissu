            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……小小的伊丽丝再一次这样想着」",
                voice: Some("li/n3kiri_0078"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00198",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "跟以前一样没有自由，这狭小的空间便是整个世界。\n冰冷严寒，让人吐出的白雾的这地方就是全部。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00199",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，跟以前不同……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00200",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "以前是，有着嫁到这国家这一目的。就算是被利用，也有着存在的理由。",
                voice: None,
