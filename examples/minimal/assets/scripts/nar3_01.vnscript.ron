        (
            cmd: label,
            args: (
                name: "block_00196",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "果然，黎明前的天空是最为黑暗的。月光犹如包裹着一块黑布，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00197",
            ),
        ),
        (
            cmd: set_bg,
