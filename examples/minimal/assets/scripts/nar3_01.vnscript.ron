                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "试穿了一件崭新的礼裙。这里准备的衣服多到仿佛每天都可以穿新的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00005",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "以前，在生育我的国家，一年为我做一件新衣服就算不错了……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00006",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「您觉得怎么样？ 有没有哪里觉得不舒服么？」",
                voice: Some("li/npetcm34_006"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00007",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没，很舒服……」",
                voice: Some("li/n3kiri_0050"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00008",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "在这里的生活和以前完全不同。当然不止是衣服和饰品。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00009",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "最重要的是，没有像以前那样将我的房门紧锁。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00010",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然也有护卫一直跟随着，但是可以自由地在城堡里面走动。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00011",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "和许多人打招呼，也到了有了几个谈话的对象的程度。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00012",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……只是，还没有和最重要的人见面。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00013",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个……关于王子殿下……」",
                voice: Some("li/n3kiri_0051"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00014",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，就像之前说过的一样，他一定会在夏天凯旋归来，\n所以还请耐心等待」",
                voice: Some("li/npetcm34_007"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00015",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「好的，我知道了……」",
                voice: Some("li/n3kiri_0052"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00016",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "是的。直至现在，我还没和我未来的结婚对象，第二王子见过面。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00017",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "听说是刚带兵去到远方，再怎么快，也要夏天才能回来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00018",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我完全不知道他是个什么样的人，再怎么说都是将成为自己的未来丈夫的人……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00019",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没事的，殿下一定会平安归来的」",
                voice: Some("li/n3zijo_0016"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00020",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说着，侍女的脸上露出温和的笑。但是那句话却总让人觉得有种寒意。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00021",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
