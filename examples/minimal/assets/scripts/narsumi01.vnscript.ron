        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不一会，经过X光这种很长的各种检查的结果出来了，说我是生病了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00201",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为稍微有些咳嗽，还以为只是感冒，但好像并不是的样子。具体我也不太清楚。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00202",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为并没有告诉我病名之类的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00203",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但我看见了爸爸很悲伤的表情，察觉到了应该是不太好的病。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00204",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后告诉我，今后每周都要来一次医院。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00205",
            ),
