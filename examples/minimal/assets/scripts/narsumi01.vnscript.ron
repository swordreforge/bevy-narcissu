            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然只有一张内存卡但也没觉得不够用，因为每个通关一个游戏后就会删除掉。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00233",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "再想玩那个游戏的时候，就从头开始。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00234",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然我也觉得这样很麻烦，但并不是很在意，本来也不是因为有多喜欢游戏才去玩的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00235",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "比起这个，新的问题出现了......待在家里变得辛苦了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00236",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然没有再像以前那样，说要我去上学什么的。\n反而是关心起每周都要去一次医院的我来了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00237",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过，毕竟只是偶尔胸口有些难受，还是和以往一样缺乏作为病人的自觉。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00238",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以更让我感觉，待在家里不舒服了，\n总觉得哪里有些疏远，这样被关心反而让我感觉更辛苦。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00239",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "以前总是唠叨的母亲也好，一张嘴就吵架的哥哥也好......",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00240",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "都来温柔的关照我，真是待不下去了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00241",
            ),
