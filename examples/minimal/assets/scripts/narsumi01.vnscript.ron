            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过，和那差不多一样，在我的心里的......某处松了口气，安心了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00214",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从很早以前开始， 我就常常会胸口难受，但过一会儿就好了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00215",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "事到如今被告知是得了某种病，老实说也没有太过吃惊。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00216",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "ns_11",
