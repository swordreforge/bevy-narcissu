            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没事的啦，马上就会好了」",
                voice: Some("li/0snhaha_0001"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00207",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "用开朗的语气如此说到的母亲。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00208",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，说起来客厅里的大电视，那个堇就拿去用吧」",
                voice: Some("li/0snhaha_0002"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00209",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「咦？可以吗？」",
                voice: Some("li/0snsumi_0015"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00210",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对对，那个已经变旧了，就放到你的房间里去吧」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00211",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "二人一齐向我投来了笑容。平时有点烦人的妈妈尤其的温柔。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00212",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "感觉非常地对不起。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00213",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "2b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
