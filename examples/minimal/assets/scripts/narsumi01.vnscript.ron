        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「......喷泉哥今天好像没来的样子」",
                voice: Some("li/0snsumi_0026"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00251",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我看着没有人坐着的长椅说到。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00252",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "顺便一提“喷泉哥”是指，\n一直以来都在喷泉里面的椅子上坐着的大叔。我只是擅自这么叫了而已。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00253",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不过轻小说哥和花坛婆婆好像来了......」",
                voice: Some("li/0snsumi_0027"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00254",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "bg3089",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
