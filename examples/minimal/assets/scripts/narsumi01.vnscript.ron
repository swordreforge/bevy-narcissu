            args: (
                name: "block_00421",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "本来的话，这个游戏是以多人组队游玩为主的，我并没有那样的朋友。",
                voice: None,
            ),
