            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「从“同情”变成“心上的烙印”了吧......」",
                voice: Some("li/0snsumi_0012"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00169",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "sora07",
                transition: Some(fade(
