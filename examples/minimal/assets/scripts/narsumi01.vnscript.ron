        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "轻小说哥说的是，在第三个横着的长椅上，总是在看小说的中年大叔。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00255",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "究竟是不是轻小说我也不知道。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00256",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "花坛婆婆，是指一直坐在花坛前的椅子上上了年纪的婆婆。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00257",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，这也是我擅自起的名字，没有和她说过话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00258",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "......已经往来公园快两年，这样的我发现了一件事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00259",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就是貌似，有每天都会到这里来的人。仅我知道的就有6人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00260",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且不知道有什么原因，这些人都有着固定的位置，坐在同样的长椅上。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00261",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "来的时间和走的时间，大致也是固定的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00262",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，我从没见到这些人之间有对过话。常常是一个人来，一个人坐着，一个人回去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00263",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我将这些人，将之称为公园的居民。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00264",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那些人都在做什么呢......」",
                voice: Some("li/0snsumi_0028"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00265",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽说都到现在了，才突然想到这个问题，\n明明快2年都没去在意，但不知为什么想了一下。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00266",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然了，至今连话都没说过，也没想要去说话，所以并不知道具体情况。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00267",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "......难不成，跟我一样吗？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00268",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为没有其他可以去的地方，只是在这里打发时间吗......",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00269",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "自然而然地，因为有这样的疑问所以就试着去搭搭话了。应该也没有什么深意吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00270",
            ),
