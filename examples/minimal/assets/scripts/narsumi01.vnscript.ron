            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―从那之后，又迎来了夏天。回想起来，距我不去上学已经正好两年了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00177",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "曾经的同级生们似乎已经是高中生了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00178",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果在外面碰到了，会感觉很不舒服。下意识的躲藏起来。肯定是因为自觉心虚吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00179",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且，马上我也要16岁了。某种意义上，也可以称之为社会的一员了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00180",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然也没有去升学，也没有上岗工作。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00181",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "依然还是老样子的家里蹲，社会上似乎也把这种情况称为“帮做家务”。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00182",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "估计因为是女性才会这样称呼吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00183",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说不定像我一样的人，还有很多的吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00184",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，变成现在这样之后就是每天都在家中玩游戏过活。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00185",
            ),
        ),
        (
