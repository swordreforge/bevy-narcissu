        ),
        (
            cmd: label,
            args: (
                name: "block_00026",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「或者，用一个恰当的比喻来形容家里蹲的话......」",
                voice: Some("li/c88mire_0009"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00027",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我“迷路”了」",
