            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「......您，不太普通呢，有点奇怪？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00164",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "离开时，说了这样一句话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00165",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "已经不用名字去称呼，而是用很刻板的“您”。也没有再笑眯眯的了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00166",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "......这时，我想到了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00167",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "ns_01",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
