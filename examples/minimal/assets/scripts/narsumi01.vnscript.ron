        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「于是，宝矿力酱找我有什么事吗？」",
                voice: Some("li/0snaka_0005"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00295",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「......宝矿力酱？」",
                voice: Some("li/0snsumi_0034"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00296",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「就是指你啦，当然，只是我随便这么叫的而已不必在意」",
                voice: Some("li/0snaka_0006"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00297",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一边回答，一边指着我一直坐的长椅，\n正确来说是指着椅子旁边的卖果汁的自动贩卖机。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00298",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "......原来如此。在她们那里，我被叫做宝矿力酱。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00299",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然被擅自起了奇怪的绰号，但我也没资格说别人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00300",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嘛，你总算是来跟我搭话了，也就是说你是有什么想问的吧？」",
                voice: Some("li/0snaka_0007"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00301",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯。也不是什么大事就是......」",
                voice: Some("li/0snsumi_0035"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00302",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「没事啦。反正我这边也说不出什么大事来」",
                voice: Some("li/0snaka_0008"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00303",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "都这么说了，我就把之前浮现的疑问说出了口。\n光是自己知道的，公园的居民就有6个左右。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00304",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「来这里......每天来这个公园的人，是为了什么目的来的？」",
                voice: Some("li/0snsumi_0036"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00305",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「谁知道呢。我也只是打个招呼的程度而已......但我想应该没有什么特别的原因」",
                voice: Some("li/0snaka_0009"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00306",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看起来白石小姐似乎也不清楚详情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00307",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「顺便问下，宝矿力酱是为什么来这里的呢？」",
                voice: Some("li/0snaka_0010"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00308",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「？？？我只是来打发时间的......」",
                voice: Some("li/0snsumi_0037"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00309",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那别人也一样吧。因为没有其他地方可去，所以到这里来了。\n你也是，我也一样」",
                voice: Some("li/0snaka_0011"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00310",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「.....................」",
                voice: Some("li/0snsumi_0038"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00311",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "没有其他可去的地方......这完全是单方面的说法。虽然不甘心但应该是正确答案。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00312",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「毕竟每天这样一个人到公园里发呆的人只能想到这个理由嘛」",
                voice: Some("li/0snaka_0012b"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00313",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「如果只是打发时间的话，只要去家里或者图书馆之类的就行了吧？」",
                voice: Some("li/0snaka_0012c"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00314",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「应该是的......」",
                voice: Some("li/0snsumi_0039"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00315",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嘛，宝矿力酱是不想上学的家里蹲吗？」",
                voice: Some("li/0snaka_0013"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00316",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「......为什么这么认为？」",
                voice: Some("li/0snsumi_0040"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00317",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「因为你还只是小学生、中学生那样而已吧？」",
                voice: Some("li/0snaka_0014"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00318",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是却在平日的白天，一直到这里来，都没见你要去上学的样子」",
                voice: Some("li/0snaka_0015"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00319",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然不知道她对我了解到了什么程度，但那句话都是正确的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00320",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是，我是小学生这点说错了。虽然知道自己看起来年纪不大，但怎么也17岁了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00321",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且，把我当小孩的她，看起来也只是高中生的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00322",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「......要说我不上学的话，你也一样的吧？」",
                voice: Some("li/0snsumi_0041"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00323",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「为啥？虽然我现在已经17岁了......但宝矿力酱你才12、13岁吧？」",
                voice: Some("li/0snaka_0016"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00324",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「......17岁了」",
                voice: Some("li/0snsumi_0042"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00325",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「诶呀，意想不到的同龄人？难道说，叫宝矿力小姐更好吗」",
                voice: Some("li/0snaka_0017"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00326",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「叫什么都好啦......比起那个我不是不去上学，也不是家里蹲」",
                voice: Some("li/0snsumi_0043"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00327",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那，也就是说是“帮忙做家务”的？」",
                voice: Some("li/0snaka_0018"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00328",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不是......」",
                voice: Some("li/0snsumi_0044"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00329",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然的确是长年没去学校，也没去考高中，基本上时间都用来一直在房间里玩游戏了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00330",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然也没有在工作。但是......",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00331",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "2b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我......是病人哦」",
                voice: Some("li/0snsumi_0045"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00332",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对，这是事实。哪怕只是每周去一次医院，我还没有病人的自觉也改变不了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00333",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以，我不是家里蹲。我有正当的理由。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00334",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "......虽然我现在是这样，但总有一天我会开始真正的人生的。\n和只是在这里打发时间的她们是不一样的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00335",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我这样是普通的......明明我曾经是如此想的，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00336",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "2fd_aka04",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我也生病了哦，宝矿力酱」",
                voice: Some("li/0snaka_0019"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00337",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「欸......」",
                voice: Some("li/0snsumi_0046"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00338",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「其实吧，大概，这里所有的人都病了。你也一样」",
                voice: Some("li/0snaka_0020"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00339",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "得到了意料之外的回答。而且不知为何，我想要否定她所说的“一样”。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00340",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不一样的......我已经来往医院有5年了」",
                voice: Some("li/0snsumi_0047"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00341",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是吗。我已经住院7年了哦」",
                voice: Some("li/0snaka_0021"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00342",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「..................」",
                voice: Some("li/0snsumi_0048"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00343",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个宝矿力酱，这里的人大家都是病人哦。\n虽然有的是身体疾病，有的是心理疾病」",
                voice: Some("li/0snaka_0022"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00344",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那.........白石小姐是哪边的？」",
                voice: Some("li/0snsumi_0049"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00345",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「Bai Shi？」",
                voice: Some("li/0snaka_0023"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00346",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对着满脸不可思议的她，我指了指她的长椅......",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00347",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "上面，用大大的字写着，“白石工务店”这几个字。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00348",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，原来如此......我是被你这么叫的呢」",
                voice: Some("li/0snaka_0024"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00349",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "也没有生气的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00350",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而是做着像是在微微思考我之前的提问的样子......",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00351",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「要说是哪边的话，我是后者......大概是心病吧。宝矿力酱呢？」",
                voice: Some("li/0snaka_0025"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00352",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我的话......可能两边都有吧」",
                voice: Some("li/0snsumi_0050"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00353",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是吗。那看起来你可能活不长呢」",
                voice: Some("li/0snaka_0026"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00354",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「......哈？」",
                voice: Some("li/0snsumi_0051"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00355",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不用在意。大概都差不多的，死这个事」",
                voice: Some("li/0snaka_0027"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00356",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她用明朗的语气回答着。至少对我来说，还没有“死”这种概念。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00357",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "明明我还在想当然地思考着前方会有光明的未来在等待......她这么轻松就说出了口。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00358",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "bg3089",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嘛，就是这么回事，那最开始的那个问题......」",
                voice: Some("li/0snaka_0028"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00359",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「为什么要来这里，因为没有其他能去的地方啊。\n因为大家都生病了嘛。这个回答怎么样？」",
                voice: Some("li/0snaka_0029"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00360",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「......嗯」",
                voice: Some("li/0snsumi_0052"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00361",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "有些暧昧的回答，因为这里说的“大家”，也包括我在内。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00362",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "......不过说回来，白石小姐真是让人搞不明白呢......",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00363",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看起来明明给人一种冷静无口的印象，实际对话过后却感觉意外的开朗阳光。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00364",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "关键是，还很能说。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00365",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「宝矿力酱，我可先告诉你，平时我可是不会跟任何人对话的」",
                voice: Some("li/0snaka_0030"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00366",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "仿佛是察觉到我当下想法一样的话语。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00367",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是，和你，以及这里的人们是例外。能够轻松地交谈」",
                voice: Some("li/0snaka_0031"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00368",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「为什么？」",
                voice: Some("li/0snsumi_0053"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00369",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「因为感觉你们活都不会活那么久。至少，也会比我先死吧？」",
                voice: Some("li/0snaka_0032"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00370",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "刚才也说过这样的话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00371",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但就算真如她所说，我也不认为这能跟“能轻松地交谈”的理由联系上。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00372",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我啊，讨厌和人产生什么关系......说具体点，不想跟任何人有什么人情来往」",
                voice: Some("li/0snaka_0033"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00373",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「......人情来往？」",
                voice: Some("li/0snsumi_0054"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00374",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
