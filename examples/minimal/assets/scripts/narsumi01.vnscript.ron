            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "......比起这个，虽然至今一直都是家里蹲......现在却不一样了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00217",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为是病人了。也不用觉得直不起腰板了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00218",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我想我有了一个“托词”。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00219",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "连我自己都感觉是个有点过分的念头，但按当时还是小孩子的心理，倒也是真心的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00220",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "......而且那时的我......也多少把自身上的事，当作其他人的事情了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00221",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在这样子并不是真正的我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00222",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "2b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
