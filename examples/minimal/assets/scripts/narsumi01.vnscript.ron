                text: "依然没有任何明确的根据，只是拿这当作所谓的“借口”，在逃避而已吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00100",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "2b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "渐渐地我变得经常不去学校了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00101",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "刚开始，是周二不去。因为第一节课是体育课。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00102",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "之后周四也不去了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00103",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为前一天晚上有个人气很高的电视剧，班上会很热烈的讨论那个话题。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00104",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "bg_maku_0002",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "起决定性作用的是，在某个周一的上学时间。偶尔周五也不去了，直到假期结束。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00105",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "已经是阔别4日学校了，去向学校的脚步也很沉重。\n如此下来，我肯定会被老师说些什么的吧，我不安地边这么想着边走。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00106",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不一会儿，在马上就能看到学校的十字路口。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00107",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "随意一瞥，看到了等红绿灯的同班女同学们。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00108",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "情不自禁的，我躲进了大楼的阴影里。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00109",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "2b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不知为何，下意识地。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00110",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我说，看昨天的电视了吗？很有意思的」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00111",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「欸——？真的？我没看到所以不知道。因为社团活动延长了。」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00112",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我录下来了，借给你吧」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00113",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「话说回来，下周开始体育课要上游泳了。有点期待啊」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00114",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "大家都热闹的边聊着天边等着变信号灯。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00115",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "bg_maku_0002",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我躲在阴影中，看着她们愉快的样子。自己主动去搭话什么的，想象都想象不出来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00116",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "肯定，不想要和我遇到吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00117",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "自己应该也察觉到了。平时就翘课不去学校，并不是什么好事。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00118",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「......估计这就是，最初的路口吧」",
                voice: Some("li/0snsumi_0006"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00119",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "如果在这时，充满精神地过去说声“早上好！”的话......说不定我就不会迷路了吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00120",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不久信号灯变绿了，欢闹着走了过去的同学们。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00121",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "与那样她们形成对比，我转向右边，朝着家折返了回去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00122",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这就是我对学校的，最后的回忆了。没有别的了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00123",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "2b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "―已经不再去学校的我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00124",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一开始也没有做什么，只是待在房间里发呆。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00125",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "220",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是单纯的讨厌去学校而已。别的也只是稍微玩玩游戏的程度。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00126",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "当然，家人是不许我那样的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00127",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，因为还有1个月就暑假了，所以也没有很强迫我去学校。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00128",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不如说我真正开始觉得家里人烦是，新学期开始的九月份之后。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00129",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "尤其是母亲，每天都念叨着催我去上学。早晚各两次。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00130",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "学校不只是学习的地方。也有为了结交朋友，适应群体生活这个目的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00131",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说是将来，走向社会前的准备时间。还说是只有现在才能创造的重要回忆。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00132",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "ns_11b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「......恐怕，那些都是正确的话语吧......」",
                voice: Some("li/0snsumi_0007"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00133",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但我的内心却毫无波动。说实话，在房间玩游戏更快乐些。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00134",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不久，学校的老师和被称为“协商员”的大人们也来了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00135",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "大家都说着跟母亲差不多的话，问我有没有什么烦恼啊这种惹人烦的问题。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00136",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以我就遵从自己的内心回答了。没有什么烦恼这样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00137",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样一来，那些烦人的老师们渐渐也不再过来了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00138",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "用他们的话来说，“没有问题才是问题”。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00139",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "也就是说，一般拒绝上学的儿童，\n都是有着什么问题，因为那个原因才不去学校的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00140",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "学习不好，被欺负，家庭原因......还有其他各种各样的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00141",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然一般来说，解决问题，\n给予帮助让其可以再回学校上学，似乎就是那些人的工作......",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00142",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对于像我这样，连那个“原因”本身都没有的学生，好像就束手无策了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00143",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对我自己来说，只是打算做个普通人的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00144",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "可貌似好孩子是不会不去上学的，也不会变成家里蹲的，说不定我就是个坏孩子呢。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00145",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "2b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我说，菫酱想要试试体育运动吗？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00146",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "开朗的笑着，向我投来这个问题的班主任老师。和其他人不同，他不到最后不肯罢休。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00147",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「活动身体的话，对健康跟美容都有好处的哦？\u{3000}和老师一起运动吧」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00148",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "20多岁正值年轻的老师。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00149",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "似乎是排球部的顾问，经常对我发出类似这样的邀请。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00150",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，不去上课也行，只是放学后，来社团玩玩就好......」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00151",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「..................」",
                voice: Some("li/0snsumi_0008"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00152",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「如何？总之先从试着到外面去开始吧？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00153",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "还是继续笑呵呵的向我搭话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00154",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "大概，这个人并没有恶意吧。我想，他肯定觉得那是很好的提案。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00155",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，对我而言只觉得痛苦。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00156",
            ),
        ),
