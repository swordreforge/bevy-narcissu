        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在的我，只是个替身。这样百害无利只玩游戏的，并不是真正的我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00194",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以，在光明的未来里......\n总有一天会出现真正的自己，这样没来由地想着。明明没有任何根据......",
                voice: None,
            ),
        ),
        (
