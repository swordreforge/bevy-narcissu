        (
            cmd: play_bgm,
            args: (
                id: "137",
                volume: Some(0.78431374),
                fade_ms: Some(500),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从某个时期开始，有个我经常去的地方。就是附近的公园。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00243",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "bg3089",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然不是每天都来，但每隔1天就会在这里打发2个小时左右的时间。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00244",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "晃眼间，已经这样泡了快2年的公园了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00245",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "选择来公园只是因为一直待在家里太难受了，其实去哪里都无所谓。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00246",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一开始也去过图书馆或者市政厅的等候室之类的地方。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00247",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但只有公园感觉最轻松，\n而且我知道是就算每天都在这里打发几个小时，也不会有问题的地方。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00248",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "坐在了一直坐的长椅上，开始啪嗒啪嗒翻着自己带来的小说。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00249",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为已经读过很多遍了，实际上与其说是在读书，不如说只是呆呆地盯着书看而已。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00250",
            ),
        ),
        (
