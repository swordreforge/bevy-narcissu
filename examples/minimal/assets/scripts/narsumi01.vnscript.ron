            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这么想着的时候，向远处的花坛婆婆挥手的白石小姐。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00291",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后花坛婆婆也点头示意了下。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00292",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看来跟以前上学的时候一样，看来是我没察觉到。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00293",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然只有很少的，但这里的居民之间也是有所交流的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00294",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "bg3089",
