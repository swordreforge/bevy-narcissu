        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "第5个椅子上坐着的，年轻的长发女性......白石小姐的第一次发声。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00272",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "顺便说下，“白石小姐”这个名字，\n是因为她一直坐的长椅上大大地写着“白石工务店”这几个字，所以才起的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00273",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "选择她的理由是，感觉和自己年龄相近。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00274",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是，长长的头发加上哥特萝莉风格服装这种个性的身姿，在这公园中显得有些轻浮。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00275",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「今天天气很好呢......」",
                voice: Some("li/0snsumi_0030"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00276",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「..................」",
                voice: Some("li/0snaka_0001"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00277",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「......你好像经常坐在这里呢？」",
                voice: Some("li/0snsumi_0031"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00278",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "随便找话题的我。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00279",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是白石小姐只是瞥了我一眼，并没有回答什么。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00280",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "......嘛，也不是那么想要聊天。也不是被无视了，都还想要问的东西。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00281",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "想到这里，正准备回自己的椅子的时候......",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00282",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真慢啊......」",
                voice: Some("li/0snaka_0002"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00283",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "总算，回了我这样的话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00284",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「......慢？」",
                voice: Some("li/0snsumi_0032"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00285",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「向我搭话的事」",
                voice: Some("li/0snaka_0003"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00286",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哈？」",
                voice: Some("li/0snsumi_0033"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00287",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我是说，从一开始看到你已经过去了2年......终于来向我搭话了」",
                voice: Some("li/0snaka_0004"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00288",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "现在有一个，她的话中我无法理解的点。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00289",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然我的确是从往来这里开始，已经过去了那么久了，这期间也没和任何人搭过话......",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00290",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "2b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
