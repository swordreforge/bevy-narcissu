            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我自己真正的“人生”还没有开始。这之后才会展开......」",
                voice: Some("li/0snsumi_0017"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00223",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "17岁的春天。含糊地这样想着，什么根据都没有，就这样想着......",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00224",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "ns_03",
                transition: Some(fade(
