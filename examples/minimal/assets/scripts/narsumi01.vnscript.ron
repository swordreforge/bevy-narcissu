            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00029",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「看起来我似乎从最初的交叉路口开始，就走错方向了吧」",
                voice: Some("li/c88mire_0012"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00030",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「应该去右边的地方，去了左边。应该去左边的地方，去了右边......」",
                voice: Some("li/c88mire_0013"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00031",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「但是，那时的我还在有印象的地方。察觉到错误后，还是可以马上回去的吧」",
                voice: Some("li/c88mire_0014"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00032",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「然而，我就这样将错就错，轻率地前进了」",
