            cmd: label,
            args: (
                name: "block_00443",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「是想说总有一天，时机成熟的时候，就能重获新生吗？」",
                voice: Some("li/c88aka_0118"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00444",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你的人生还没有开始之类的？」",
