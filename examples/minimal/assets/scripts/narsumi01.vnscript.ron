            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "-从那天开始的每一天，都在玩游戏中度过。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00225",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "相比以前，哥哥会把自己买的游戏给我了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00226",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但和以前有些不同，以前只是把自己玩腻的游戏，半强制地让我玩而已。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00227",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "“我说......你要玩这个吗？”",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00228",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "会这么说，也算是会先“询问”我了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00229",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "与其说是温柔......更像是有点变疏远了。感觉话变得特别的少。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00230",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "晚上在走廊碰到了，也不会来说话。\n以前的话，在擦身而过时，明明还会敲下我的头的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00231",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "也不会在玩对战游戏时，来把我打得落花流水了......",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00232",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "2b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
