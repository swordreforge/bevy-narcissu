            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "冬季即将结束，春天快要来临的时候。不知不觉家人也变得没那么啰嗦了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00170",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然母亲偶尔还是会发点小牢骚，倒是父亲采取的态度渐渐变得宽容了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00171",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你很可爱所以没关系的......啊，要不试试去料理教室学学看？\n果然作为女孩子还是得会点家务才行」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00172",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "经常向我投来有些生硬的笑容，说着这样的话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00173",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "绕着圈说，反正也是要嫁人就不用去学校了。我想是包含着这样的含义吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00174",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且我有一个年龄比我大的多的哥哥。我只是小女儿，说不定就更加会这么想了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00175",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以我偶尔会帮忙做下家务。这样的话，父母也就不会来烦我了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00176",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "w",
                transition: Some(fade(
                    duration: 0.8,
