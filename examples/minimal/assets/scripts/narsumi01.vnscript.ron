        ),
        (
            cmd: label,
            args: (
                name: "block_00446",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「看起来宝矿力酱还只是小孩子呢。跟宝矿力一样甜（天真）」",
