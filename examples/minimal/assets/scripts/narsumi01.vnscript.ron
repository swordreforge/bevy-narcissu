            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "-第二年。很晴朗的春日里发生的事情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00196",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "还是老样子家里蹲的我有了一个变化。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00197",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那天，从早上开始就有感觉身体无力，测了下体温有37.7度。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00198",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然并没感觉哪里难受，但父母很担心就把我带到了医院。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
