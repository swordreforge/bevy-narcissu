),
),
(
cmd: label,
args: (
name: "block_00313",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那反过来……\u{3000}如果这里有医生的话不就好了么？」",
voice: Some("li/np4imo_1044"),
),
),
(
cmd: label,
args: (
name: "block_00314",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00315",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这样的话，其他房间里的人也能安心」",
voice: Some("li/np4imo_1045"),
),
),
(
cmd: label,
args: (
name: "block_00316",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你说得对……可能是这样吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00317",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹妹将过去我曾考虑过的事说了出来。",
