),
),
(
cmd: label,
args: (
name: "block_00362",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "过来的是，３０２号房间的老奶奶。最近这段时间，她时常会来我们这。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00363",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "大概是很喜欢日下吧，她来的时候，老奶奶经常会来我们这露脸。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00364",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "可能也因为是这样，日下这家伙好像也很亲近老奶奶。",
