(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，那个莳绘君，关于明天的值班……」",
voice: Some("li/n4yoko_0242"),
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像这样的事，已经重复了很多很多次了……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00171",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "意外地不能掉以轻心啊，这日下陷阱。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00172",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，她应该也，还是想直呼我的名字吧……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00173",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这之上，她还希望我不叫她的姓氏而是直呼她的名字……希望我叫她阳子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00174",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……而且我，对直呼她的名字这件事，也并没有觉得那么害羞……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00175",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这种行为本身，就像两个人在做游戏一样……",
voice: None,
),
),
(
