),
),
(
cmd: label,
args: (
name: "block_00299",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这样啊……那也不需要我特别说些什么了吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00300",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹妹也大致明白。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00301",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "和我一样，从小时候开始，就一直在这个养老院帮忙的话，明白它是理所当然的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00302",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……博美这家伙一定也想着同样的事吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00303",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这次来的人，会住多长时间呢……」",
voice: Some("li/np4imo_1041"),
),
),
(
cmd: label,
args: (
name: "block_00304",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「谁知道呢……长一点估计也就１个月左右吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00305",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎哥哥，为什么那些人，\u{3000}不能一直，待在医院里呢？」",
voice: Some("li/np4imo_1042"),
),
),
(
cmd: label,
args: (
name: "block_00306",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那是不可能的。\u{3000}我以前也，问过老爹同样的事」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00307",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "医院是医疗设施。而不是可以不住院的人待着的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00308",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然如此，但这里也不是医疗设施。当然也不是家。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00309",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "既有家人住在远方的情况，也有本来就无依无靠的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00310",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，只要医院还是个医疗设施……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00311",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "今后就不会没人来１０７号房间……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00312",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，这样啊……」",
