),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "至今为止，这个莳绘之家，一共有２１间房间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00217",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "基本上不论是哪个房间，都是３人住在一起的房间，\n但是，唯一，只有这个房间是单人间。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00218",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "顺带一提，是１Ｆ最靠头的那间房，平常谁也不会进去。",
