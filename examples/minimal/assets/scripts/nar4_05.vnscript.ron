channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「早安，莳绘君在么？」",
voice: Some("li/n4yoko_0269"),
),
),
(
cmd: label,
args: (
name: "block_00428",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "刚好在思考这件事的时候日下来了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00429",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐，发生什么了？\u{3000}今天，没看见什么人啊……」",
voice: Some("li/n4yoko_0270"),
),
),
(
cmd: label,
args: (
name: "block_00430",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊啊，是有点事……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00431",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……该怎么说呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00432",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下这家伙，一定没有经历过亲近之人的死亡吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00433",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而我也是，因为这份家业才有了这种经历……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00434",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这对于普通的初中生来说是过于沉重的内容。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00435",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……虽是这么说，但一直隐瞒下去也是不可能的。而且，那样也没有意义。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00436",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "短暂的思考后，我决定将这件事原原本本的告诉她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00437",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呐日下，其实关于之前的那个老奶奶啊……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00438",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，我很期待哦，连衣裙」",
voice: Some("li/n4yoko_0271"),
),
),
(
cmd: label,
args: (
name: "block_00439",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好像，是说下周来着，是不是快做好了呢」",
voice: Some("li/n4yoko_0272"),
),
),
(
cmd: label,
args: (
name: "block_00440",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好像走了，今天」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00441",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「什么走了？」",
voice: Some("li/n4yoko_0273"),
),
),
(
cmd: label,
args: (
name: "block_00442",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就是说，去世了啊。那个老奶奶」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00443",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶？」",
voice: Some("li/n4yoko_0274"),
),
),
(
cmd: label,
args: (
name: "block_00444",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并不是……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00445",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……理解不了我说的话。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00446",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，从意义上……作为在现实中发生的事情，还未能理解吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00447",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后她那吃惊的表情……慢慢地变成了悲伤的表情……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00448",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……莳绘君，那是真的么？」",
voice: Some("li/n4yoko_0275"),
),
),
(
cmd: label,
args: (
name: "block_00449",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，我听说今天要守夜而明天就是告别式了……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00450",
),
),
(
