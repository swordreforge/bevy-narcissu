channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈——哈——，呼……」",
voice: Some("li/n4yoko_0060"),
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: set_bg,
args: (
image: "n4ime_002_01",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
