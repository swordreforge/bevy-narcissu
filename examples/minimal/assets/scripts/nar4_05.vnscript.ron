),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂，那里是岩浆啊，日下，你要着了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00037",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哇，哇啊，完了，好热好热」",
voice: Some("li/n4yoko_0144"),
),
),
(
cmd: label,
args: (
name: "block_00038",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就像这样，蹦蹦跳跳地回到我的身旁来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00039",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，我感觉这家伙也是乐在其中。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00040",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_007a",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话说回来明天，是要来新人对吧？」",
voice: Some("li/n4yoko_0216"),
),
),
(
cmd: label,
args: (
name: "block_00041",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊啊，从我爸那听说了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00042",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这里说的新人，当然是指养老院的新人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00043",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然在平时我们莳绘之家有４０多个人住着，\n但还是会以差不多每月一个的速度有新人加入。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00044",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难道说你，又要来帮忙么？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00045",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯。从学校回来的时候顺路就去了」",
voice: Some("li/n4yoko_0217"),
),
),
(
cmd: label,
args: (
name: "block_00046",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然日下这么说完并向我笑了笑，但实际上，她帮了很多忙。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00047",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "本来，人手就完全不够，而在新来的人住进来的日子，就会更忙了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00048",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……只是，就像她以前和我说过的那样，她好像想成为医生来着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00049",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "嘛，虽然不知道她认真到什么程度，\n但如果不很努力地学习的话我觉得这是很困难的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00050",
),
),
