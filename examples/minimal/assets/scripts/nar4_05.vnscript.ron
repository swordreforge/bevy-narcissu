),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "海潮的声音静静响起。海边一片漆黑空无一人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00462",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "黑暗的天空融入海里，海平线向远方无限延伸。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00463",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这之中，日下长长的头发随风飘扬。手里握着据说是那个老奶奶做的连衣裙。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00464",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……她的脸上，既不是平常的那副害羞的表情，也不是难为情的愁苦表情……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00465",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而是浮现出寂寞且……让人感觉有点严肃的表情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00466",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哎莳绘君……」",
voice: Some("li/n4yoko_0278"),
),
),
(
cmd: label,
args: (
name: "block_00467",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「之前你说的，就是指这件事嘛？」",
voice: Some("li/n4yoko_0279"),
),
),
(
cmd: label,
args: (
name: "block_00468",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊啊……和那些人，是不能约定什么事情的」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00469",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯……可能是这样吧……」",
voice: Some("li/n4yoko_0280"),
),
),
(
cmd: label,
args: (
name: "block_00470",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我也明白。毕竟从懂事的时候开始，就一直注视着养老院里面的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00471",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……死。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00472",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也就是指从这个世界消失。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00473",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那是，无论对谁都一样的平等之事。即避不开，也逃不掉。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00474",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「常常有人离去，也有人到来……没有穷尽」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00475",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「总觉得……就像是，在按顺序等待的等候室一样……」",
voice: Some("li/n4yoko_0281"),
),
),
(
cmd: label,
args: (
name: "block_00476",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊啊……但是，并不是按排好的顺序来的」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00477",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且……决定其顺序的是谁也不知道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00478",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「如果是走运与不走运的话，\u{3000}是决定这两个的人吧……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00479",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「果然，这是由神明来决定的么？」",
voice: Some("li/n4yoko_0282"),
),
),
(
cmd: label,
args: (
name: "block_00480",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「谁知道呢。肯定谁也不知道吧……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00481",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，如果……如果我是医生的话……」",
voice: Some("li/n4yoko_0283"),
),
),
(
cmd: label,
args: (
name: "block_00482",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……能够救她么？\u{3000}那个老奶奶」",
voice: Some("li/n4yoko_0284"),
),
),
(
cmd: label,
args: (
name: "block_00483",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶，这就…………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00484",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这我也不明白。而且，本来，养老院的人们就不是病人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00485",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "通常，要说在好好活着的人中谁更接近死亡的话，那就只有老年人了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00486",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在那个像是等候室一样的地方……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00487",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且并不是按顺序来的，我们究竟到底能做些什么呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00488",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是……我的话，因为成为不了神明……」",
voice: Some("li/n4yoko_0285"),
),
),
(
cmd: label,
args: (
name: "block_00489",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就只能成为医生了吧？」",
voice: Some("li/n4yoko_0286"),
),
),
(
cmd: label,
args: (
name: "block_00490",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样说着，日下像在凝望着很遥远的什么地方。",
voice: None,
),
),
(
