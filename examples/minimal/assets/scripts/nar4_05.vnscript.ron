),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呜呜，呜，呜呜，呜呜……」",
voice: Some("li/n4yoko_0276"),
),
),
(
cmd: label,
args: (
name: "block_00451",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不久便听到了她的呜咽声。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00452",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这是一直以来都无忧无虑地笑着的她，我所见到的第一次落泪。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00453",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎，怎么会，就在上周明明还好好的……」",
voice: Some("li/n4yoko_0277"),
),
),
(
cmd: label,
args: (
name: "block_00454",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就这样蹲在走廊里哭泣的她……看起来非常的痛苦。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00455",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这种时候，我也不明白到底该跟她说些什么才好……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00456",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是应该和以前一样，好好安慰她呢……还是说，该让她打起精神来呢我也不知道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00457",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……这是这世上不计其数的，“无计可施”之事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00458",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "当遇到的时候……果然我还是，除了沉默之外一无所措……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00459",
),
),
