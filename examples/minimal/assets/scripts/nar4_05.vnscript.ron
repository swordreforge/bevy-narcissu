args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么了吗，老爸？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00195",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊啊，事发突然有些抱歉，明天，要有新人来了所以……」",
voice: Some("li/np4papa_1039"),
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这样。无所谓啦，我反正也是以这里为优先的」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00197",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我爽快的回答道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然现在尽量做到不从学校缺席，但这其中的理由，也不过只是为了陪陪日下罢了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然知道那家伙说过想要成为医生……但是，说到底这还是她自己的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00200",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么要来的新人是个什么样的人呢？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00201",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「听说是叫村上，是个男性……」",
voice: Some("li/np4papa_1040"),
),
),
(
cmd: label,
args: (
name: "block_00202",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算双方不说出口，也知道毫无疑问是个老年人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00203",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那顺带明天，新来的人是要和家人一起来么？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00204",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，我想大概是一个人……」",
voice: Some("li/np4papa_1041"),
),
),
(
cmd: label,
args: (
name: "block_00205",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从刚才开始，老爸就有些闪烁其词。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00206",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "养老院的人们，亲人住在远方的也很多，在其中也有完全没有亲属的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00207",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以一个人来这件事本身，也并不是那么稀奇的事情……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00208",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "刚想问到底是怎么一回事的时候，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00209",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为他要住进１０７号房」",
voice: Some("li/np4papa_1042"),
),
),
(
cmd: label,
args: (
name: "block_00210",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「诶，那不是…」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00211",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，就是这么回事。\u{3000}你也做好相应的准备」",
voice: Some("li/np4papa_1043"),
),
),
(
cmd: label,
args: (
