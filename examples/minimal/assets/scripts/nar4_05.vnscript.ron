text: "妹妹博美大概也，和我差不多吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00425",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……但是，日下却不同。如果她知道这件事的话，一定会伤心吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00426",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那么我……该怎么告诉她才好呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00427",
),
),
(
