),
),
(
cmd: label,
args: (
name: "block_00297",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这么说，你可能也已经听说了，今天来的人是……」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00298",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊……嗯，从妈妈那听说了……」",
