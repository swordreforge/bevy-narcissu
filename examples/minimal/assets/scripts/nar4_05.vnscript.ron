channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我从房间里出来，前往父亲那里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00192",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "做饭和洗涤衣物是由母亲和妹妹来负责，粗活和诸项杂务则是在我和老爸的管辖范围。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00193",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，我和老爸商量着来做的事也必然会很多。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00194",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_004c",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
