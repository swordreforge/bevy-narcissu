),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「在啊博史，还没睡么？」",
voice: Some("li/np4mama_1005"),
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没，差不多要睡了……\u{3000}有什么事的话我可以帮忙哦」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00180",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没有哦，妈妈也才刚刚把事情忙完」",
voice: Some("li/np4mama_1006"),
),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妈妈边这么说着边摘下了围裙。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00182",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "直到刚才，还和妹妹一起准备明天的早饭来着，看来是终于做完了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像我们家这样的小型养老院，家里所有人分担工作是理所当然之事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而在这之中，负责做饭的妈妈的工作是很多的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说起来你，最近好像有认真去学校了啊」",
voice: Some("li/np4mama_1007"),
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯啊，已经不想留级了啊」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呼——，嘛，这挺好的」",
voice: Some("li/np4mama_1008"),
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还有如果翘课的话日下那家伙会很烦的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，刚才，你爸爸找你来着」",
voice: Some("li/np4mama_1009"),
),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「老爹？\u{3000}我知道了」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
