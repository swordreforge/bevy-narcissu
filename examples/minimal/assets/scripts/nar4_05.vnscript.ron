channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「早，早上好，莳绘君……」",
voice: Some("li/n4yoko_0061"),
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "日下喘着粗气来了。看来，今天也好像和平常一样睡过头了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「你又写日记熬夜了吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，啊哈哈哈……」",
voice: Some("li/n4yoko_0063"),
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从她用害羞地笑着来蒙混过关看来，是被我说中了吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……经由这一个多月的共同行动，我掌握了她的几个行动模式。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那本交换日记，日下写的那天的第二天，她经常会晚起。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "明明没有什么特别的事情，日下还是会满满地写上１页。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果当天发生了稍许有趣的事情的话，写个３～４页的情况也是存在的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛算了，那走吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嗯」",
voice: Some("li/n4yoko_0095"),
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: set_bg,
args: (
image: "sora01",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在清爽的春日阳光里，我们边聊着边向前走。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就像平常一样并排走在上学路上。现在的这个样子，已经逐渐变得理所当然了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「早上好，日下同学，莳绘君」",
voice: Some("li/etcw1_1008"),
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊啊，早上好」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "偶尔，和过来搭话的同班同学互相打招呼。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "最近，好像是我是不良的传闻？也渐渐开始消散了，\n相应地班里的同学们也开始与我接触。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽说取而代之的是……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「莳绘学长，今天你们俩也关系很好呢」",
voice: Some("li/etcm1_1005"),
),
),
(
cmd: label,
args: (
name: "block_00032",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「闭嘴啊」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00033",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然一如既往的被称呼为学长，\n因为总是和日下在一起，所以被开玩笑的次数也增多了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00034",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而每次被人开玩笑，日下和我的距离就会拉开一点。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00035",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……真没办法啊，这家伙也是。虽然，现在也知道那不是害羞……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00036",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_005_01a",
transition: Some(fade(
duration: 0.8,
)),
),
),
