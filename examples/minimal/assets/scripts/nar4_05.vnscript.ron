),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……在那一天。我们制定了新的规则。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00492",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "有人请假不去学校时的笔记，甜甜圈，交换日记，人行横道的岩浆，一直在一起……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00493",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "除此之外又追加了新的规则……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00494",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "和那些人们……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00495",
),
),
