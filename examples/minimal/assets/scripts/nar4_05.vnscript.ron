args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「喂——日下，还需要两人份，能拜托你么？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00051",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嗯，马上就准备」",
voice: Some("li/n4yoko_0218"),
),
),
(
cmd: label,
args: (
name: "block_00052",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "放学不久后，日下就直接来到了我家的厨房里。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00053",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "顺带一提做的是甜甜圈。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00054",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在新人住进来的那一天，会办一个称作欢迎会的简单宴会。\n而每到这个时候就会例行做这个东西。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00055",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不知道为什么会这样，但好像自然而然的就定下来了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00056",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但这，可以说是在这个没规定什么活动的养老院里，唯一的习俗吧。",
voice: None,
),
),
