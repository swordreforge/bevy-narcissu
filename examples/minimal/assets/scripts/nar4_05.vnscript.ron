),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，哥哥，我先出门啦」",
voice: Some("li/np4imo_1028"),
),
),
(
cmd: label,
args: (
name: "block_00003",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妹妹精神饱满地从房间里出去了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "边目送着她的背影，我也边慢悠悠地出了家门。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: set_bg,
args: (
image: "n4bg_001a",
