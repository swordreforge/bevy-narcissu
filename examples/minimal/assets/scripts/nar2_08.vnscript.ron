        ),
        (
            cmd: label,
            args: (
                name: "block_00127",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哎呀，不是什么大问题喔，果然用油就免不了这样呀」",
                voice: Some("li/mama_029"),
