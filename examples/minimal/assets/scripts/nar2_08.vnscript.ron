        ),
        (
            cmd: label,
            args: (
                name: "block_00229",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "听她这么一说，我突然感觉那张脸的确有见过。",
                voice: None,
