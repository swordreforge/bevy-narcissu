        (
            cmd: label,
            args: (
                name: "block_00251",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，这衣服，感觉真不错呢～」",
                voice: Some("li/hime1_0191"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00252",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从展示在店门口的衣服里，选了其中几件拿到手里。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00253",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过，那都是些轻飘飘的感觉，真要说的话，比较适合可爱的女孩子穿着。",
                voice: None,
            ),
        ),
        (
