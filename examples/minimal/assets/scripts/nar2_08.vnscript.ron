            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "以前，每当涂上漂亮的指甲油的时候，妈妈都会很骄傲地，给我和爸爸看。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00131",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看到因为这些琐碎的事，而开心地手舞足蹈的妈妈，我和爸爸也总是互相望着苦笑。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00132",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "每当买到奇怪的颜色的时候，也会一边说对我来说早了10年，一边又帮我涂上…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00133",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…不过现在不同了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00134",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "粉红色的指甲油消失了，取而代之的是，皮肤有点发红皱皱的手。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00135",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "为何而变，其理由不难想到。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00136",
            ),
        ),
        (
