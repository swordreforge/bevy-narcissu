        ),
        (
            cmd: label,
            args: (
                name: "block_00257",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "刚这样说完，把拿在手里的衣服在我面前摊开…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00258",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，很合适哦，濑津美」",
                voice: Some("li/hime1_0193"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00259",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「唉？我？」",
                voice: Some("li/setsumi_0150"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00260",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你看，虽然你总是都穿着校服，不过我觉得这种衣服应该也很合适吧」",
                voice: Some("li/hime1_0194"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00261",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……………」",
                voice: Some("li/setsumi_0151"),
