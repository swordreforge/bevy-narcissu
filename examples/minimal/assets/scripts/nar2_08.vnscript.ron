            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这样啊…医院的工作人员都从这车站经过呢」",
                voice: Some("li/hime1_0184"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00231",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哈哈，这样被发现的话会被骂呢」",
                voice: Some("li/hime1_0185"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00232",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "姬子满不在意地欢笑。\n看来她根本什么计划都没想。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00233",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且，记得明明她以前担任过陪护，怎么会连这种事情都不知道呢？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00234",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「因为，我的家就在附近，没搭过电车去医院嘛」",
                voice: Some("li/hime1_0186"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00235",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「我也一样啊」",
                voice: Some("li/setsumi_0146"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00236",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，不过果然那个，也不是平白无故就成了规则的呢…」",
