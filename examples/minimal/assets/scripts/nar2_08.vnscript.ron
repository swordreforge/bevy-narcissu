            args: (
                speaker: None,
                text: "「什么嘛，你这个表情？难不成把我当笨蛋么？」",
                voice: Some("li/hime1_0176"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00212",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不是这样的…只是觉得不可能」",
                voice: Some("li/setsumi_0141"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00213",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「真是的，明明是可乐饼博士，头脑却还这么顽固，\n什么事情都要实际考察下的吧」",
                voice: Some("li/hime1_0177"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00214",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…和博士，没关系的吧」",
                voice: Some("li/setsumi_0142b"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00215",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「而且，海枣树的话，医院也有，到处都有不是吗」",
                voice: Some("li/setsumi_0143"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00216",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不行，不试试更大的树不就没意思了吗」",
                voice: Some("li/hime1_0178"),
            ),
        ),
        (
