        (
            cmd: label,
            args: (
                name: "block_00120",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我一边点头，一边把今天也吃完的便当盒递到妈妈手上。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00121",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「给，多吃一点哦」",
                voice: Some("li/mama_027"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00122",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "桌上摆着几道家常菜，以及如往常一样从工作地点那边带回来的炸土豆。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00123",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，你看，又炸了些带回来了喔」",
                voice: Some("li/mama_028"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00124",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样说着推荐盘里的土豆。\n特点是切得厚厚的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00125",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过今天…那只拿着盘子的手，和以往有些不一样。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00126",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…妈妈，手…」",
                voice: Some("li/setsumi_0125b"),
