        (
            cmd: label,
            args: (
                name: "block_00165",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…剩下3件事？一开始，我没反应过来那是指什么，不过很快就想起来了。",
