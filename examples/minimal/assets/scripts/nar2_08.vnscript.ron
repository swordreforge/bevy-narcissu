        ),
        (
            cmd: label,
            args: (
                name: "block_00219",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然说才步行大约10分钟，不过在炎热的仲夏时节走得意外地辛苦。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00220",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "接着，果然穿睡衣的姬子还是有些显眼，经过的人都往这边瞧了过来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00221",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个…真的要去吗？」",
                voice: Some("li/setsumi_0144b"),
