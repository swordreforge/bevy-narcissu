        (
            cmd: label,
            args: (
                name: "block_00200",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…凤梨树？」",
                voice: Some("li/setsumi_0137"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00201",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不常听见的词汇。\n说到底，我从来就没听说过有凤梨树这种东西。",
                voice: None,
            ),
        ),
        (
