        ),
        (
            cmd: label,
            args: (
                name: "block_00240",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯？\u{3000}那当然是只能改天再来了呀」",
                voice: Some("li/hime1_0189"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00241",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "干脆的得出了结论。刚刚明明还打定主意要去的…",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00242",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "而且真的打算要去的话，在上下班人潮结束的午前午后前往，\n应该是可以顺利不被发现地搭上电车的。",
