            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「肚子饿了吧？」",
                voice: Some("li/mama_026"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00119",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…嗯」",
