        ),
        (
            cmd: label,
            args: (
                name: "block_00222",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「当然了啊，就为这个才来到这里…」",
                voice: Some("li/hime1_0179"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00223",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…嗯？」",
                voice: Some("li/hime1_0180"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00224",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呀，快藏起来」",
