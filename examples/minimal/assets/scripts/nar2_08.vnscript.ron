            cmd: label,
            args: (
                name: "block_00249",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为姬子穿着睡衣，经过的人都往这边看来，不过姬子似乎完全不在意的样子。",
                voice: None,
