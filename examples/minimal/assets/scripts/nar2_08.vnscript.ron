            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "为谁而变，则更无需思考。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00137",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…正因为这样，我很难受，心中无比痛苦。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00138",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「怎么了？今天的也是刚炸好的喔」",
                voice: Some("li/mama_030"),
