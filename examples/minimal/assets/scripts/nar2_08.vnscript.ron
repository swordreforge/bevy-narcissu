            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "突然，姬子躲进了角落的阴影处。\n不由得，我也躲在大楼的阴影处。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00226",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…怎么了？」",
                voice: Some("li/setsumi_0145"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00227",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，是外科楼层的医生」",
                voice: Some("li/hime1_0182"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00228",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对面还有4楼的护士长」",
                voice: Some("li/hime1_0183"),
