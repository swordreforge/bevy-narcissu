        ),
        (
            cmd: label,
            args: (
                name: "block_00219",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "已经变得连自己也不知道究竟睡没睡着了。一直迷迷糊糊的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00220",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这样的某天，突然，听到了一段引人注意的对话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00221",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「说起来，这里以前还有一个孩子来着，还记得吗？」",
                voice: Some("li/kanC_0037"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00222",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「还有一个？ 这里一直就她一个啦」",
                voice: Some("li/kana_0084"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00223",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你看，就是很早之前那个，暑假期间待在这里的……」",
                voice: Some("li/kanC_0038"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00224",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，说起来，好像还有过一个小男孩来着」",
                voice: Some("li/kana_0085"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00225",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……是那时的他的事情。下意识地，竖起耳朵听了起来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00226",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「在我表妹上的预备学校里，偶然发现了呢」",
                voice: Some("li/kanC_0039"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00227",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嘿~，很精神吧」",
                voice: Some("li/kana_0086"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00228",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不是啦，听说非常的阴沉，预备学校也不怎么认真」",
                voice: Some("li/kanC_0040"),
            ),
        ),
        (
            cmd: label,
            args: (
