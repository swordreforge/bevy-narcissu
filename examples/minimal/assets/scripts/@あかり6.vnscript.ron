        (
            cmd: label,
            args: (
                name: "block_00426",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是，汉字没有假名注音的书就很难看懂了。\n真应该像漫画一样，全都标上假名注音才好。",
                voice: None,
            ),
        ),
