),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我肚子饿了……」",
voice: Some("li/0snaka_0212"),
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "白石小姐突然说了这么一句。不是自言自语，明显是对着我说的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，指着路边的一个快餐店……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「去买汉堡来」",
voice: Some("li/0snaka_0213"),
),
),
(
cmd: label,
args: (
