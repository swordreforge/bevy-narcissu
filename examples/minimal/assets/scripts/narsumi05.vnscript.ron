),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我说宝矿力酱……不对，菫」",
voice: Some("li/0snaka_0221"),
),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "开朗地向我搭话的白石小姐……\n不对，是明。餐桌之上，有着4盘小小的冰淇淋。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00182",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然她很自然地买了过来，难道，这是一人吃2个的意思吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不一样口味的冰淇淋会更好些吗？」",
voice: Some("li/0snaka_0222"),
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「可这里只有香草味的呀」",
voice: Some("li/0snsumi_0153"),
),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「咦，原来你知道啊。真没意思」",
voice: Some("li/0snaka_0223"),
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她有点失望，把2个盘子向我推了过来。果然是要每人2个的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以，你刚才说的那个证人……具体来讲，我怎么做好？」",
voice: Some("li/0snaka_0224"),
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嗯，要……」",
voice: Some("li/0snsumi_0154"),
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话说，你究竟想要做什么啊？」",
voice: Some("li/0snaka_0225"),
),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/c88mire_0032"),
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……没有想过。准确的说，是还没想到那一步。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00192",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难不成，什么也没想过吗？」",
voice: Some("li/0snaka_0226"),
),
),
(
cmd: label,
args: (
name: "block_00193",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……嗯」",
voice: Some("li/0snsumi_0155"),
),
),
(
cmd: label,
args: (
name: "block_00194",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我坦率的点了点头。只是暧昧的思考了下……具体的细节还没考虑过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00195",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且，“活过的证明”这种东西太抽象了，更具体的，我就联想不到了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，试试做模特怎么样？专门杂志的那种」",
voice: Some("li/0snaka_0227"),
),
),
(
cmd: label,
args: (
name: "block_00197",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……模特？」",
voice: Some("li/0snsumi_0156"),
),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不是说想要活过的证明吗？要留下身形的话，这是最快的」",
voice: Some("li/0snaka_0228"),
),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「可是，就算如此，为什么是模特？」",
voice: Some("li/0snsumi_0157"),
),
),
(
cmd: label,
args: (
name: "block_00200",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为你很可爱嘛。弄些萝莉风格的Cosplay的话，说不定就火了哦」",
voice: Some("li/0snaka_0229"),
),
),
(
cmd: label,
args: (
name: "block_00201",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，我家开得有出版社所以不用担心门路哦」",
voice: Some("li/0snaka_0230"),
),
),
(
cmd: label,
args: (
name: "block_00202",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……是在开玩笑吗？这人还是老样子，总是有些让人搞不懂的地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00203",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而且要说写真偶像的话，比我好看的人多了去了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00204",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "要是像经常在花坛碰到的女孩那样可爱的话，说不定是挺合适的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00205",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呃，我想，我是做不了那种的了……」",
voice: Some("li/0snsumi_0158"),
),
),
(
cmd: label,
args: (
name: "block_00206",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，出些偶像风格的CD之类的怎么样？」",
voice: Some("li/0snaka_0231"),
),
),
(
cmd: label,
args: (
name: "block_00207",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，既然如此不如直接做个声优吧」",
voice: Some("li/0snaka_0232"),
),
),
(
cmd: label,
args: (
name: "block_00208",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……为什么会往那个方向想？」",
voice: Some("li/0snsumi_0159"),
),
),
(
cmd: label,
args: (
name: "block_00209",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为你看，要留下证明的话，除了影像，不就只有声音了吗？\u{3000}」",
voice: Some("li/0snaka_0233"),
),
),
(
cmd: label,
args: (
name: "block_00210",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "确实，按理说也许是这么回事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00211",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "可是，我觉得自己应该哪样都做不到。而且说到底，和我的整体印象也不符合。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00212",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呃，我觉得应该不是那样的……」",
voice: Some("li/0snsumi_0160"),
),
),
(
cmd: label,
args: (
name: "block_00213",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊哈哈，我知道的啦，开玩笑啦，玩笑」",
voice: Some("li/0snaka_0234"),
),
),
(
cmd: label,
args: (
name: "block_00214",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……果然是开玩笑的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00215",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "如果我这样，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00216",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我要——做♪\u{3000}就交给我吧＞＜",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00217",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "嗲嗲地回答的话，会变成什么样呢？实在不想去想象。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00218",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛，也是。刚才的那些例子，就算能留在很多人的记忆里，我也不会记得」",
voice: Some("li/0snaka_0235"),
),
),
(
cmd: label,
args: (
name: "block_00219",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嗯」",
voice: Some("li/0snsumi_0161"),
),
),
(
cmd: label,
args: (
name: "block_00220",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「也就是说，不论是谁，哪怕一个人都行……」",
voice: Some("li/0snaka_0236"),
),
),
(
cmd: label,
args: (
name: "block_00221",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「想要在那个人的心中，永远地活下去是吧？」",
voice: Some("li/0snaka_0237"),
),
),
(
cmd: label,
args: (
name: "block_00222",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「大概……是的吧……」",
voice: Some("li/0snsumi_0162"),
),
),
(
cmd: label,
args: (
name: "block_00223",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她很好地总结了我暧昧的说明。估计与我想象的样子十分接近。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00224",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「但是啊，虽然之前也有跟你说过……」",
voice: Some("li/0snaka_0238"),
),
),
(
cmd: label,
args: (
name: "block_00225",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我是个要清除所有的人情往来，然后离开这个世界的人哟？」",
voice: Some("li/0snaka_0239"),
),
),
(
cmd: label,
args: (
name: "block_00226",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，我知道」",
voice: Some("li/0snsumi_0163"),
),
),
(
cmd: label,
args: (
name: "block_00227",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「想留在这样的我的心里，可不是简单的事情哦？」",
voice: Some("li/0snaka_0240"),
),
),
(
cmd: label,
args: (
name: "block_00228",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "或许真的她所说吧。之前也听过了她的这个说明。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00229",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……难道你不想做我的证人了吗？」",
voice: Some("li/0snsumi_0164"),
),
),
(
cmd: label,
args: (
name: "block_00230",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛，内心的确是想要辞职，不过已经太迟了呢」",
voice: Some("li/0snaka_0241"),
),
),
(
cmd: label,
args: (
name: "block_00231",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「呃，我也不是……」",
voice: Some("li/0snsumi_0165"),
),
),
(
cmd: label,
args: (
name: "block_00232",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不行哦。因为已经和菫有了“借入”了」",
voice: Some("li/0snaka_0242"),
),
),
(
cmd: label,
args: (
name: "block_00233",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……借入？什么时候？」",
voice: Some("li/0snsumi_0166"),
),
),
(
cmd: label,
args: (
name: "block_00234",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「就在20分钟前」",
voice: Some("li/0snaka_0243"),
),
),
(
cmd: label,
args: (
name: "block_00235",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那就是刚才吃汉堡的时候。除此之外没有其他能对上的了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00236",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也就是说对于她而言，请她吃汉堡这件事，就是对我的“借入”了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00237",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……可明明只是仅120日元的最便宜的汉堡而已，还是分了一半的？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00238",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以说，事到如今，你想说不要也已经晚了。因为这就是我的规则……」",
voice: Some("li/0snaka_0244"),
),
),
(
cmd: label,
args: (
name: "block_00239",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/0snsumi_0167"),
),
),
(
cmd: label,
args: (
name: "block_00240",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以，目前会一直陪你一起啦」",
voice: Some("li/0snaka_0245"),
),
),
(
cmd: label,
args: (
name: "block_00241",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就像是宣誓一般，说了这些后，明继续啪嗒啪嗒地吃起了冰淇淋。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00242",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说到底，买汉堡的钱也算是借的话，那现在面前放着的冰淇淋的钱又怎么算？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00243",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然她是理所当然地帮我买了，但是光从价格上看就高出太多了……",
voice: None,
),
),
