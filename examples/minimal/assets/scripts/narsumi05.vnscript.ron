),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯。马上就要第10年了」",
voice: Some("li/0snaka_0256"),
),
),
(
cmd: label,
args: (
name: "block_00255",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那不回自己的医院没事吗？」",
voice: Some("li/0snsumi_0179"),
),
),
(
cmd: label,
args: (
name: "block_00256",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没事的。因为我的装病……装睡是谁也看不穿的」",
voice: Some("li/0snaka_0257"),
),
),
(
cmd: label,
args: (
name: "block_00257",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，给了我个不明不白的答案。关于她的事，我真的是完全搞不懂。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00258",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说到底原本的问题，是她为什么会在这7F吧？？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00259",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "其他的病房暂且不论，可这里是只有被宣告了死亡的末期患者，\n和患者家属以外都不能来的地方吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00260",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "此时，我突然想到了一件事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00261",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「难道明是教会的人？」",
voice: Some("li/0snsumi_0180"),
),
),
(
cmd: label,
args: (
name: "block_00262",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈？」",
voice: Some("li/0snaka_0258"),
),
),
(
cmd: label,
args: (
name: "block_00263",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为我经常看到做护工的基督教徒」",
voice: Some("li/0snsumi_0181"),
),
),
(
cmd: label,
args: (
name: "block_00264",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我看起来像是基督教徒吗？」",
voice: Some("li/0snaka_0259"),
),
),
(
cmd: label,
args: (
name: "block_00265",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不像」",
voice: Some("li/0snsumi_0182"),
),
),
(
cmd: label,
args: (
name: "block_00266",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是吧，完全没有关系」",
voice: Some("li/0snaka_0260"),
),
),
(
cmd: label,
args: (
name: "block_00267",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，为什么会在7F？」",
voice: Some("li/0snsumi_0183"),
),
),
(
cmd: label,
args: (
name: "block_00268",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「已经大概3年了吧？自从往返这里开始，我家就有在赞助了」",
voice: Some("li/0snaka_0261"),
),
),
(
cmd: label,
args: (
name: "block_00269",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "赞助（校注：kouen 音同日语的公园）？什么东西？好像不是指公园的样子……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00270",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嘛，那方面说明起来太麻烦了，就别在意了」",
voice: Some("li/0snaka_0262"),
),
),
(
cmd: label,
args: (
name: "block_00271",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「也有优花的原因，多少是看在她的面子上的」",
voice: Some("li/0snaka_0263"),
),
),
(
cmd: label,
args: (
name: "block_00272",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嗯，我明白了……」",
voice: Some("li/0snsumi_0184"),
),
),
(
cmd: label,
args: (
name: "block_00273",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我没再继续问下去。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00274",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算真跟我说明了，估计自己也听不懂吧，况且感觉她自己也并不想说的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00275",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「话说，菫平时都在做什么？」",
voice: Some("li/0snaka_0246"),
),
),
(
cmd: label,
args: (
name: "block_00276",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没什么……也就游戏吧？」",
voice: Some("li/0snsumi_0168"),
),
),
(
cmd: label,
args: (
name: "block_00277",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说起来，之前也这么说过来着……」",
voice: Some("li/0snaka_0247"),
),
),
(
cmd: label,
args: (
name: "block_00278",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯。也没其他事能做到的了……」",
voice: Some("li/0snsumi_0169"),
),
),
(
cmd: label,
args: (
name: "block_00279",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说是这么说，准确来讲并不一样。虽然做不到也是事实，更多的是什么也没去做。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00280",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「也就是10多年来，除了打游戏还是打游戏咯」",
voice: Some("li/0snaka_0248"),
),
),
(
cmd: label,
args: (
name: "block_00281",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，嘛，差不多吧……」",
voice: Some("li/0snsumi_0170"),
),
),
(
cmd: label,
args: (
name: "block_00282",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "直截了当地这么说，说不定她会受到些打击。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00283",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，玩给我看看嘛。正好我想看看专业尼特族的技术」",
voice: Some("li/0snaka_0249"),
),
),
(
cmd: label,
args: (
name: "block_00284",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/0snsumi_0167"),
),
),
(
cmd: label,
args: (
name: "block_00285",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这次被说成专业尼特族了。要论家里蹲的经历，明明她比我还长。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00286",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「明……很懂游戏吗？」",
voice: Some("li/0snsumi_0171"),
),
),
(
cmd: label,
args: (
name: "block_00287",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「还行吧，虽然比起你的话，完全就是个新手」",
voice: Some("li/0snaka_0250"),
),
),
