),
),
(
cmd: label,
args: (
name: "block_00295",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，虽然最开始不是这样的……」",
voice: Some("li/0snsumi_0173"),
),
),
(
cmd: label,
args: (
name: "block_00296",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一点一点的，开始跟她说明起来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00297",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为这个游戏是主打组队游戏的，不建议单人。\n当然，也不是不能单人，只是难度会噌的往上涨。",
voice: None,
),
),
