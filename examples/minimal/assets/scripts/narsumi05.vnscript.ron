name: "block_00117",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为以前看到过她从这里走进来过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00118",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……来了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00119",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎么了，宝矿力酱，怎么在这里？」",
voice: Some("li/0snaka_0206"),
),
),
(
cmd: label,
args: (
name: "block_00120",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「在等你，等白石小姐来」",
voice: Some("li/0snsumi_0138"),
),
),
(
cmd: label,
args: (
name: "block_00121",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「等我？有什么事吗？」",
voice: Some("li/0snaka_0207"),
),
),
(
cmd: label,
args: (
name: "block_00122",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "面对一脸不可思议的她，我向前一步，直接说了出口。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00123",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「和我成为……朋友这种话是不会说的」",
voice: Some("li/0snsumi_0139"),
),
),
(
cmd: label,
args: (
name: "block_00124",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……那要怎么样？」",
voice: Some("li/0snaka_0208"),
),
),
(
cmd: label,
args: (
name: "block_00125",
),
),
(
