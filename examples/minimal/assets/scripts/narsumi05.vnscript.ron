),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……完全搞不懂她。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "为什么突然从让她做证人的话题上，转移到给她买汉堡去？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但是，感觉这也不像是在开玩笑。那认真的表情和语气，和平时给人的感觉不一样。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "“为什么？”连这样的疑问，都不知为何迟疑了……",
