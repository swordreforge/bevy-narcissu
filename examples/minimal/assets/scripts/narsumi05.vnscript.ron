),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "到了熄灯的时间，病房里变得一片漆黑。\n哥哥在旁边的椅子上坐着，开始和我一起玩游戏。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，不好，被吃掉了，回血，快回血」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "病房里，哥哥开朗的声音不断回响。和平常那疏远生硬的感觉完全不同。",
