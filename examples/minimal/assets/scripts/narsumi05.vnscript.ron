args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「证人哦……」",
voice: Some("li/0snsumi_0140"),
),
),
(
cmd: label,
args: (
name: "block_00126",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「证人？什么的？」",
voice: Some("li/0snaka_0209"),
),
),
(
cmd: label,
args: (
name: "block_00127",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我在……这个世界活过的证人……」",
voice: Some("li/0snsumi_0141"),
),
),
(
cmd: label,
args: (
name: "block_00128",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "是的。这就是21年间最后选择了的，我的愿望。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00129",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就好像谁也无法让时光倒流一样，事到如今我也无法回到走错了的那个地方。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00130",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "走错路，假装没发现，迷了路的我……最后应尽的义务。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00131",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……我能先问个问题吗？」",
voice: Some("li/0snaka_0210"),
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯……」",
voice: Some("li/0snsumi_0142"),
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「为什么，让我来做？」",
voice: Some("li/0snaka_0211"),
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那是因为……」",
voice: Some("li/0snsumi_0143"),
),
),
(
cmd: label,
args: (
name: "block_00135",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……不知道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00136",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然白石小姐，是我人生最后阶段说过最多话的人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00137",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在游戏里，又是我唯一的同伴，可靠的辅助角色。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00138",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "但这到底是因为只是偶然的，没有其他人了呢……\n还是说我其实是想，与她成为朋友的呢……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "老实说，我自己也不知道原因所以无言以对。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "于是……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
