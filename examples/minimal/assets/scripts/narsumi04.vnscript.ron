        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "就像是分手吵架一样，一个人急匆匆地走了的白石小姐。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00210",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……我好像，看到了她的另一面。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00211",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我想要知道更多至今为止不太清楚的，关于她的事情，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00212",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "为什么会这么想，我也不太明白，但对此十分在意的我，还是追了出去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00213",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "232",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我还以为她会就这么到外面去，但她走向了中庭。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00214",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "sin_b06",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "我轻易地就找到了她，独自呆坐在椅子上。看起来好像没什么事做。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00215",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……怎么办？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00216",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "稍微犹豫了一下，我决定主动过去搭话。\n因为总感觉，她现在的身影跟以前在公园相遇时的重叠了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00217",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "sin_b06c",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个……在做什么呢？」",
                voice: Some("li/0snsumi_0107"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00218",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「咦，啊……是宝矿力酱啊……」",
                voice: Some("li/0snaka_0193"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00219",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "继续坐在椅子上，瞥了我一眼说到。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00220",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "看来稍微冷静一些了，没有刚才那种急躁的感觉了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00221",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「哎，坐下呗」",
                voice: Some("li/0snaka_0194"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00222",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯」",
                voice: Some("li/0snsumi_0108"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00223",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "按她说的，坐了下来。回想起来，像这样并排而坐也已是久违数年了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00224",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "那个时候，我们也没说太多话。总是白石小姐向我搭话。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00225",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "但是今天的她看来没有那种心情，所以我先开了口。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00226",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「刚才那个人……不是朋友吗？」",
                voice: Some("li/0snsumi_0109"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00227",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「看起来是吗？」",
                voice: Some("li/0snaka_0195"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00228",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯。虽然不太清楚，但是看起来很要好的样子」",
                voice: Some("li/0snsumi_0110"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00229",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「怎么可能，是错觉吧」",
                voice: Some("li/0snaka_0196"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00230",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "干脆地否定了。我无法判断那是不是真心的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00231",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「难道说，你……想和我做朋友吗？」",
                voice: Some("li/0snaka_0197"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00232",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「咦……」",
                voice: Some("li/0snsumi_0111"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00233",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「因为你看 “现在都这样过来搭话了，大概是想交朋友吧？”这样不是吗？」",
                voice: Some("li/0snaka_0198"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00234",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: Some("li/0snsumi_0113"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00235",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对于突如其来的提问，我无话可说。我并不是打算那样才来搭话的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00236",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "可是……那我又是为了什么来搭话的呢？自己也不明白，是“想交朋友”吗？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00237",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "所以，我无言以对。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00238",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……看起来是那样的吗？」",
                voice: Some("li/0snsumi_0112"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00239",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「多少有点。你比以前话更多了呢」",
                voice: Some("li/0snaka_0199"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00240",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嘛，如果是时日不多的宝矿力酱的话，和你做朋友也没关系啦」",
                voice: Some("li/0snaka_0200"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00241",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「吵死了。我又没那个意思……」",
                voice: Some("li/0snsumi_0114"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00242",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那也是当然的了。明明都知道自己就快要死了……」",
                voice: Some("li/0snaka_0201"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00243",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊哈哈，事到如今，连朋友都没有呢」",
                voice: Some("li/0snaka_0202"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00244",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: Some("li/0snsumi_0113"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00245",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她对着什么也没回答的我……不，是对着什么也回答不了的我，开朗地笑着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00246",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "2b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
