        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "没有什么可做的，没什么能做的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00158",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不对，正确来说应该是不知道做什么好。而且也没有做点什么的心情。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
