            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那再见了，宝矿力酱」",
                voice: Some("li/0snaka_0203"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00247",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后从椅子上站了起来，不知道到哪去了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00248",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "sin_b06c",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只有我一个人被留在了原地。不知为何，已经不想再追过去了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00249",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……我想过要和她做朋友吗？",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00250",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从相遇时开始，就搞不懂的白石小姐。但也是跟我说过最多话的人。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00251",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽说在游戏里，会来帮助宝矿力酱，是唯一的伙伴，很靠得住的辅助角色……",
                voice: None,
            ),
        ),
        (
