        (
            cmd: label,
            args: (
                name: "block_00291",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "仿佛要将这空无一物的屋顶收入其中一样设置在那里。不用问也知道是为了什么。",
