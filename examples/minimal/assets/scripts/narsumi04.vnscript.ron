            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "没什么事要做的我，坐在床上玩起了之前的游戏。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00157",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "ns_06c",
                transition: Some(fade(
                    duration: 0.8,
                )),
