        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你在干嘛呢？」",
                voice: Some("li/0snaka_0175"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00161",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊……白石小姐……」",
                voice: Some("li/0snsumi_0101"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00162",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她突然来到了我的病房。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00163",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然前几天就听说她在这边进出了，但这次太突然了，还以为发生了什么大事吓了一跳。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00164",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呃，有什么事吗？」",
                voice: Some("li/0snsumi_0102"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00165",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你啊，现在是悠哉玩游戏的时候吗？」",
                voice: Some("li/0snaka_0176"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00166",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啥？」",
                voice: Some("li/0snsumi_0103"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00167",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「转到这边来，可就真的是，没多少天可活了哦？」",
                voice: Some("li/0snaka_0177"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00168",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "仿佛是我做错了什么一样的口气。不知道为何，有种焦躁不安的感觉。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00169",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊啊，真是看不下去了，别再玩游戏了」",
                voice: Some("li/0snaka_0178"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00170",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "2b",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
