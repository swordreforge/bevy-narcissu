                text: "……说不定，直截了当地说清楚会更好吧……",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00147",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "每次浮现出这种疑问的时候，我就会摇摇脑袋否定掉。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00148",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「对。我并不是想要求得什么原谅……」",
                voice: Some("li/0snaka_0173"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00149",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "只是想要把与我相遇这件事做成像没发生过一样。\n想要让自己的存在本身，彻底消失而已。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00150",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "一直这样地向自己强调着。现在的我，已经不是曾经那个无力的小孩了。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00151",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "……可是却不知道为什么，最近的我似乎感觉有些焦躁。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00152",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "百无聊赖……倒也不是。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00153",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「非要说的话……“躁郁”是最合适的形容吧……」",
                voice: Some("li/0snaka_0174"),
            ),
        ),
