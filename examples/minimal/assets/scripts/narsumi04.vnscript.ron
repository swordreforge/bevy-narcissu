            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「……为什么要说那种话呢？」",
                voice: Some("li/0snsetu_0023"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00253",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "循声望去，是前几天借给我地图的女孩。手里拿着花洒，今天也是来给花坛浇水的吧。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00254",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「什么话？」",
                voice: Some("li/0snsumi_0077"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00255",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「你想和她交朋友的吧？」",
                voice: Some("li/0snsetu_0024"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00256",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「………………」",
                voice: Some("li/0snsumi_0150"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00257",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「才没有那种想法……」",
                voice: Some("li/0snsumi_0115"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00258",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "事到如今，交朋友也没什么意义了。毕竟也不是白白家里蹲到这个年纪的",
