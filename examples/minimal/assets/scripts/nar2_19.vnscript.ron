            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "很快的秋天也过了，迎来了街上播放圣诞歌的时候，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00050",
            ),
        ),
        (
            cmd: play_se,
            args: (
                file: "03_door_knock_02b",
                channel: Some(1),
                volume: Some(0.78431374),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "叩叩，",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00051",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「濑津美，收到东西了喔。」",
                voice: Some("li/mama_065"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00052",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，嗯...」",
                voice: Some("li/setsumi_0419"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00053",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "从妈妈那接过邮递包裹。\n一般的想，是不会有人寄东西给我的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00054",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "不过我，稍微有一些头绪。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00055",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "指定寄送日期的小包裹的寄信人。\n边想着或许是，边拿过来确认着...",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00056",
            ),
        ),
        (
            cmd: set_bg,
