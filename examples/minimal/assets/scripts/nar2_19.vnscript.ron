            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "...阿洛伊斯...",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00057",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "用圆珠笔写下的小小的字。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00058",
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 400,
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "...是姬子寄来的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00059",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "生前，虽然不知道是何时寄出的，不过说过要送我其他的东西。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00060",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，小心翼翼地...伴随着期待和同样的不安打开了...",
                voice: None,
            ),
