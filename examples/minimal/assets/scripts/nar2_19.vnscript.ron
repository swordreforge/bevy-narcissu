            args: (
                name: "block_00069",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "虽然很开心，不由得想起穿起来试试看。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00070",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "...不过，我停下了手。",
