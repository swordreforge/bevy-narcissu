            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「...连衣裙？」",
                voice: Some("li/setsumi_0421"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00062",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "夏天风格的纯白底色，绘有可爱的黄色向日葵。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00063",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "这是以前，说过好几次要买给我，我也蛮想要的东西。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00064",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "拿到手上摊开的连衣裙，窗边衣架上刚洗好的睡衣。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00065",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "...还有，现在正穿着的水手服。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00066",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "作为过去日常生活的证明的，唯一的，我所持有的睡衣以外的衣服...",
                voice: None,
