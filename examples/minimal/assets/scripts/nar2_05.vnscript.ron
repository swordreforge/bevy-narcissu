),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…嗯，欢迎回来」",
voice: Some("li/setsumi_0033"),
),
),
(
cmd: label,
args: (
name: "block_00139",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "打工回来的妈妈，大概都是在这个时间到家。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00140",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「濑津美，晚餐已经吃了吗？」",
voice: Some("li/mama_002"),
),
),
(
cmd: label,
args: (
name: "block_00141",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不，还没…」",
voice: Some("li/setsumi_0034"),
),
),
(
cmd: label,
args: (
name: "block_00142",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，一起吃吧，\u{3000}今天也收到好多的可乐饼喔」",
voice: Some("li/mama_003"),
),
),
(
cmd: label,
args: (
name: "block_00143",
),
),
