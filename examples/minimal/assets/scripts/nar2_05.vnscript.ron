),
),
(
cmd: label,
args: (
name: "block_00190",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说完这话之后，不认识的老奶奶离开了病房。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00191",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一开始，还以为是姬子的家人，不过看来不是。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00192",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…那么难道是陪护么？因为她穿着围裙，感觉上有些像…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00193",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，和自己见过的称做陪护的人相比，貌似又有点微妙的不同。",
