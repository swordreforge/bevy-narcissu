),
),
(
cmd: label,
args: (
name: "block_00087",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯？\u{3000}什么？什么？\u{3000}要问问题的话OK喔，我对转子引擎之类的很了解的哟」",
