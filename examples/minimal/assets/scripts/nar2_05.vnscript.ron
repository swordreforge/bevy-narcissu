),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "并不是在刻意隐瞒。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00287",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是无论如何…我都无法将说对方是7楼的人这件事说出口。\n为什么会这么做，详细的原因自己也不太清楚。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00288",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我知道这不是住在7楼的姬子的错。\n也不是任何人的错。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00289",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为自己也是从类似的状况中，朋友就这样不知不觉消失了，所以更能理解。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00290",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…大概是不想让妈妈担心吧…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00291",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "妈妈也一定以为是普通的住院病人，或是以为是护士之类的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00292",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "可是…我却没有办法说出，否定的话。",
voice: None,
),
),
(
