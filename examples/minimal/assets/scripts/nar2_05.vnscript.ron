args: (
speaker: None,
text: "趁着现在身体状况还不错，至少这种事情我想自己亲手来做。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00132",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "其实在自己的房间待着也没什么……但我却打开了客厅的电风扇。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00133",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…明明爸爸妈妈这么热也都还在工作。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00134",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只有我在有着空调的房间乘凉的话，会因此而感到无比愧疚，所以我做不到。",
voice: None,
),
),
(
