),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "面对面坐到椅子上，两个人早早地吃起了晚餐。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00144",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "爸爸因为往返时间的增加，变得更晚回家，\n像这样只有我和妈妈两个人用餐的情况也变多了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00145",
),
),
(
cmd: play_se,
args: (
file: "sara",
channel: Some(1),
volume: Some(0.78431374),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「怎样？\u{3000}好吃吗？」",
voice: Some("li/mama_004"),
),
),
(
cmd: label,
args: (
name: "block_00146",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…嗯」",
voice: Some("li/setsumi_0035"),
),
),
(
cmd: label,
args: (
name: "block_00147",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，土豆也多吃点吧，你不是喜欢吗？」",
voice: Some("li/mama_005"),
),
),
(
cmd: label,
args: (
name: "block_00148",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一边说着这些，一边把土豆的盘子推了过来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00149",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "自从默默吃着土豆的时候开始，妈妈就从此以为我是喜欢土豆的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00150",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「其实妈妈呢，昨天开始负责炸土豆的工作了喔」",
voice: Some("li/mama_006"),
),
),
(
cmd: label,
args: (
name: "block_00151",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唉？」",
voice: Some("li/setsumi_0036"),
),
),
(
cmd: label,
args: (
name: "block_00152",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以，其实只有这个不是剩菜喔」",
voice: Some("li/mama_007"),
),
),
(
cmd: label,
args: (
name: "block_00153",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00154",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，不用担心没关系的喔」",
voice: Some("li/mama_008"),
),
),
(
cmd: label,
args: (
name: "block_00155",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「只要你说喜欢的话…」",
voice: Some("li/mama_009"),
),
),
(
cmd: label,
args: (
name: "block_00156",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「店里的人们也说过，想吃多少都可以带多少回家的」",
voice: Some("li/mama_010"),
),
),
(
cmd: label,
args: (
name: "block_00157",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…明朗地，开心地谈论着这些的妈妈。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00158",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "到底做了些什么，才让店里的人这样说的原因我想象不出来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00159",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，光是想象到妈妈当时的样子，我就感到无比的愧疚，不由得痛苦。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00160",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，这之后也敬请期待吧。」",
voice: Some("li/mama_011"),
),
),
(
cmd: label,
args: (
name: "block_00161",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在这样的妈妈面前，我能做到的事情……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00162",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就只有默默地…装做很喜欢的样子，继续咀嚼着土豆。",
voice: None,
),
),
(
