),
),
(
cmd: label,
args: (
name: "block_00093",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一般来说的话，病人应该是不能这样吃冰淇淋的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00094",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "可是，对于我的疑问，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00095",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，你知道吗？\u{3000}7楼的访谈时间？」",
