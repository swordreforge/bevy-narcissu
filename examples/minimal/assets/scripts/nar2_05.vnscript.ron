channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「欢迎回来，刚好把晚餐做好了」",
voice: Some("li/mama_012"),
),
),
(
cmd: label,
args: (
name: "block_00264",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看看时钟已经指向了7点。\n今天在我之前到家的妈妈。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00265",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "依旧和妈妈两个人，像平常一样早早吃着晚餐。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00266",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说起来，今天回来的比较晚呢？」",
voice: Some("li/mama_013"),
),
),
(
cmd: label,
args: (
name: "block_00267",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…只是，去了一下医院」",
voice: Some("li/setsumi_0051b"),
),
),
(
cmd: label,
args: (
name: "block_00268",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊？\u{3000}今天是受诊日的吗？」",
voice: Some("li/mama_014"),
),
),
(
cmd: label,
args: (
name: "block_00269",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…不，不是这样的…」",
voice: Some("li/setsumi_0052"),
),
),
(
cmd: label,
args: (
name: "block_00270",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…烦恼着该怎么回答，姬子的事，到底该怎么说呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00271",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说只是认识的话好像也没什么问题…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00272",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "稍微思考了一下，像姬子所说的一样，回答道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00273",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…去了趟朋友那里」",
voice: Some("li/setsumi_0053b"),
),
),
(
cmd: label,
args: (
name: "block_00274",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…朋友？」",
voice: Some("li/mama_0152"),
),
),
(
cmd: label,
args: (
name: "block_00275",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我所说的话，被妈妈重复了一遍。\n然后，露出了惊讶和不敢相信的表情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00276",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，我觉得妈妈做出这样反应也是没办法的事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00277",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从我的口中，说出「朋友」这个词汇本身就很少见。\n至少在这几年是完全不可能发生的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00278",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这，这样啊，太好了濑津美，能交到朋友」",
voice: Some("li/mama_016"),
),
),
(
cmd: label,
args: (
name: "block_00279",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，很高兴地继续说着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00280",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对着这样的妈妈，我说出了到至今所发生的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00281",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…说对方，是一位非常温柔的姐姐。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00282",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还有最近常常跑去玩的事，还带我一起去吃冰淇淋的事…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00283",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唉~，真是位温柔的姐姐呢…」",
voice: Some("li/mama_017"),
),
),
(
cmd: label,
args: (
name: "block_00284",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…嗯」",
voice: Some("li/setsumi_0055b"),
),
),
(
cmd: label,
args: (
name: "block_00285",
),
),
