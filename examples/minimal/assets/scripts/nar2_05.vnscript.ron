),
),
(
cmd: label,
args: (
name: "block_00098",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…虽然不清楚她的反问和病人吃冰淇淋有什么关系，不过我还是坦白地摇了摇头。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00099",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "印象中我入住的3楼，是下午3点到晚上8点。",
