args: (
id: "62",
volume: Some(0.78431374),
fade_ms: Some(500),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…也许今天待在医院的时间太长了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00250",
),
),
(
