args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我说啊，濑津美…」",
voice: Some("li/hime1_0061"),
),
),
(
cmd: label,
args: (
name: "block_00237",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「圣经记载正确的话，世界是在7天中创立的喔」",
voice: Some("li/hime1_0062"),
),
),
(
cmd: label,
args: (
name: "block_00238",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…所以？」",
voice: Some("li/setsumi_0047"),
),
),
(
cmd: label,
args: (
name: "block_00239",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不觉得我所剩下的时间，也可以做到大部分的事情吗？」",
voice: Some("li/hime1_0063"),
),
),
(
cmd: label,
args: (
name: "block_00240",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/setsumi_0127"),
),
),
(
cmd: label,
args: (
name: "block_00241",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…不能，用这个作为例子的」",
voice: Some("li/setsumi_0048"),
),
),
(
cmd: label,
args: (
name: "block_00242",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「哈哈，哎呀，不要这样说嘛」",
voice: Some("li/hime1_0064"),
),
),
(
cmd: label,
args: (
name: "block_00243",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为只剩下3件事了，可以的话就陪我做完嘛」",
voice: Some("li/hime1_0065"),
),
),
(
cmd: label,
args: (
name: "block_00244",
),
),
