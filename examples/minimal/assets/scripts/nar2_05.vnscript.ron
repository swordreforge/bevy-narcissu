),
),
(
cmd: label,
args: (
name: "block_00088",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…不是这个，吃这样的东西没问题吗？」",
voice: Some("li/setsumi_0029c"),
),
),
(
cmd: label,
args: (
name: "block_00089",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，这件事啊…」",
voice: Some("li/hime1_0038"),
),
),
(
cmd: label,
args: (
name: "block_00090",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在我眼前，继续狼吞虎咽着冰淇淋的姬子。",
