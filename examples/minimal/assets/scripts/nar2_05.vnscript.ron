args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…不过…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00233",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在死之前想做的10件事啊…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00234",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "对我来说，还不知道那是什么事情，也不知道姬子所剩下的时间，大约还剩下多少。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00235",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "反过来，也可以说成是还剩下3件事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00236",
),
),
(
cmd: set_bg,
args: (
image: "byousitu",
transition: Some(fade(
duration: 0.8,
)),
),
),
