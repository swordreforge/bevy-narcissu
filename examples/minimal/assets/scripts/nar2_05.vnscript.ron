),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「午安」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00183",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "开门进来的是一位，不认识的老奶奶。\n在这房间，我还是第一次看见有人来拜访。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00184",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「姬子，身体状况还好吧？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00185",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，啊，没什么不舒服的感觉吧」",
voice: Some("li/hime1_0050"),
),
),
(
cmd: label,
args: (
name: "block_00186",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「今天是入浴的日子……要我帮你吗？」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00187",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不用了啦，谢谢你为我着想呢」",
voice: Some("li/hime1_0051"),
),
),
(
cmd: label,
args: (
name: "block_00188",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不过，要是有什么事情的话不用客气就跟我说吧」",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00189",
),
),
(
