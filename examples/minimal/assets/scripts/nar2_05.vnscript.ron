channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "高高的天花板，纯白的房间，我坐到旁边小小的折叠椅上。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00166",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，虽然说是来到这里，但真的就只是字面意义上的 “来到这里 ”而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00167",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "也没特别想说什么，至少我从没主动说过什么有趣的话题。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00168",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只是，在单方面坐在姬子旁边听她说，对着并不觉得有意思的话题点头附和而已。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00169",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那，可以问你一件事吗？」",
voice: Some("li/setsumi_0038"),
),
),
(
cmd: label,
args: (
name: "block_00170",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我想好之后，决定干脆地问出来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00171",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「和我在一起……你开心吗？」",
voice: Some("li/setsumi_0039"),
),
),
(
cmd: label,
args: (
name: "block_00172",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，和你在一起连什么叫无聊都不知道呢」",
voice: Some("li/hime1_0047"),
),
),
(
cmd: label,
args: (
name: "block_00173",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/setsumi_0127"),
),
),
(
cmd: label,
args: (
name: "block_00174",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…讽刺？」",
voice: Some("li/setsumi_0040"),
),
),
(
cmd: label,
args: (
name: "block_00175",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「没这回事，非常开心喔」",
voice: Some("li/hime1_0048"),
),
),
(
cmd: label,
args: (
name: "block_00176",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「像是和濑津美甜甜蜜蜜的感觉吧」",
voice: Some("li/hime1_0049"),
),
),
(
cmd: label,
args: (
name: "block_00177",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…大概，她在捉弄我吧？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00178",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然不由得这么想，但现在的姬子，也还是平常那样子",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00179",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "独自兴奋地说着，不管我说的是什么，也只是自顾自的在那一副高兴的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00180",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就这样，反复进行着这样的对话……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00181",
),
),
