name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为离家很近，所以从没来过这里吃饭，\n不过看来，到这边来用餐的人比想象中的还要多些。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
