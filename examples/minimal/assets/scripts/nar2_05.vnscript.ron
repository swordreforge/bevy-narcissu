args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…我们，似乎成为朋友。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00245",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "在认识了1周的时候，姬子说要我陪她完成死之前剩下想做的3件事。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00246",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我不知道她的话，到底有几分是认真的…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00247",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "看来我。\n有一段时间会天天跑来这里了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00248",
),
),
