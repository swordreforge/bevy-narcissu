),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，是做陪护的人哦，不过她是负责照顾另外一个人的」",
voice: Some("li/hime1_0052"),
),
),
(
cmd: label,
args: (
name: "block_00196",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她看起来很适合当陪护呢。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00197",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不，还是有点不太相同，姬子她，为我说明了有关于“这里”的陪护的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00198",
),
),
(
cmd: set_bg,
args: (
image: "black-2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "真要说的话一般病房的陪护似乎是，比较属于物质层面上的，负责病人的日常所需。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00199",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "医院也会发薪水，这当中也有以打工的心态来当陪护的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00200",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "相较之下，在这里7楼工作的陪护…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00201",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为把重心放在精神上的照顾，以打工的态度来做的人是做不好的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00202",
),
),
(
cmd: set_bg,
args: (
image: "byousitu",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不过啊，至少，这家医院…\u{3000}在7楼的全体员工都是义工喔。」",
voice: Some("li/hime1_0053"),
),
),
(
cmd: label,
args: (
name: "block_00203",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「这样啊…了不起呢…」",
voice: Some("li/setsumi_0043"),
),
),
(
cmd: label,
args: (
name: "block_00204",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我有点感到佩服。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00205",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然可能一些人是为了薪资理所应当，但如果不了解7楼的相关事宜，\n是不能进入7楼工作的。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00206",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "而对这些居民，发自内心地无偿为这些人付出的志愿者，我感到由衷地佩服。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00207",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，对于我这样的反应姬子却是，",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00208",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「是呢…真了不起呢」",
voice: Some("li/hime1_0054"),
),
),
(
cmd: label,
args: (
name: "block_00209",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样，没什么诚意的回答。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00210",
),
),
(
cmd: set_bg,
args: (
image: "black-2",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…一般来想的话，至少能感到一点点的感激之情才对…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00211",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过我对于姬子刚刚所说的话",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00212",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…不过姬子也是被别人责照顾的人…这里，我在意的是“别人”的部分。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00213",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "只看这句话的话，还以为也有负责照顾姬子的这么一个人。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00214",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，到现在都还没看到过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00215",
),
),
(
cmd: set_bg,
args: (
image: "byousitu",
transition: Some(fade(
duration: 0.8,
)),
),
),
(
cmd: wait,
args: (
time_ms: 500,
),
),
(
cmd: stop_se,
args: (
channel: Some(1),
),
),
(
cmd: stop_se,
args: (
channel: Some(2),
),
),
(
cmd: stop_se,
args: (
channel: Some(3),
),
),
(
cmd: stop_se,
args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…负责照顾姬子的人呢？」",
voice: Some("li/setsumi_0044"),
),
),
(
cmd: label,
args: (
name: "block_00216",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯？没有喔」",
voice: Some("li/hime1_0055"),
),
),
(
cmd: label,
args: (
name: "block_00217",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…没有？\u{3000}为什么？」",
voice: Some("li/setsumi_0045"),
),
),
(
cmd: label,
args: (
name: "block_00218",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为，我没有必要」",
voice: Some("li/hime1_0056"),
),
),
(
cmd: label,
args: (
name: "block_00219",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "很干脆地，这样回答了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00220",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然我不是很了解7楼的陪护，只要本人说不需要的话，就可以拒绝的吗？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00221",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "的确姬子，和其他住在7楼的人比起来，\n不但可以完全正常的行走，实际还是年轻也很有精神…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00222",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "说到这个，从我来到这里后，\n并没有见过姬子的家人，或是其他来探望姬子的人来过。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00223",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不过，如今你来了」",
voice: Some("li/hime1_0057"),
),
),
(
cmd: label,
args: (
name: "block_00224",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唉？」",
voice: Some("li/setsumi_0036"),
),
),
(
cmd: label,
args: (
name: "block_00225",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就好像，看透我在想什么似地回答道。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00226",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「谢谢，这样只剩下3件事了呢…」",
voice: Some("li/hime1_0058"),
),
),
(
cmd: label,
args: (
name: "block_00227",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…剩下3件事？」",
voice: Some("li/setsumi_0046"),
),
),
(
cmd: label,
args: (
name: "block_00228",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，我想要个和我年龄差距很大的朋友」",
voice: Some("li/hime1_0059"),
),
),
(
cmd: label,
args: (
name: "block_00229",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，不是常常会听到吗？\u{3000}在死之前想做的10件事之类的」",
voice: Some("li/hime1_0060"),
),
),
(
cmd: label,
args: (
name: "block_00230",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "然后，毫不避讳地使用「死」这个字。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00231",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然这大概也是因为是7楼的病人的关系也说不一定，\n但突然用着开朗的口气说出这种事情，还是着实吓人一跳。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00232",
),
),
(
cmd: set_bg,
args: (
image: "black-2",
transition: Some(fade(
duration: 0.8,
)),
),
),
