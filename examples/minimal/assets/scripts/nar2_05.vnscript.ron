),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "刚想着连这都说的时候，姬子突然站起身来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00077",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然其他人都不由得以为发生什么事地看过来，不过本人却似乎完全不在意的样子。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00078",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「别看我这样，非常喜欢车喔」",
voice: Some("li/hime1_0034"),
),
),
(
cmd: label,
args: (
name: "block_00079",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「而且，还有国内A级的执照呢，嗯哼」",
