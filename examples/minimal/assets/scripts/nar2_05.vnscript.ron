args: (
channel: Some(4),
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "想着这件事情，我看到了那个校园。\n今天也可以看见小孩子们活泼地奔跑着。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00251",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "上次在上面转了一圈的单杠，今天似乎也有很多客人光顾。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00252",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…暑假，黄昏时的暮蝉声，挥洒着汗水的孩子们。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00253",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这一切都是，夏日光景中近乎平常的一部分。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00254",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "…没有任何的违和感。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00255",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "像是在单杠上转一圈这种事情，也没有露出像自己一样辛苦的表情……",
voice: None,
),
),
