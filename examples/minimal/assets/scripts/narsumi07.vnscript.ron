),
),
(
cmd: label,
args: (
name: "block_00376",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，是一条小路……」",
voice: Some("li/0snsumi_0307"),
),
),
(
cmd: label,
args: (
name: "block_00377",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那里，应该往反方向转的……」",
