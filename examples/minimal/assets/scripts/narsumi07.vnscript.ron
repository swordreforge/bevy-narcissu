),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "忽然发现，明盘子里唯有胡萝卜被干干净净地留下来了。\n感觉跟把不爱吃的东西留下来的小孩子似得。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00307",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不可以挑食哦」",
voice: Some("li/0snsumi_0291"),
),
),
(
cmd: label,
args: (
name: "block_00308",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「算了吧。不吃自己讨厌的东西，也是大人的特权哟」",
voice: Some("li/0snaka_0368"),
),
),
(
cmd: label,
args: (
name: "block_00309",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "又是个奇怪的歪理。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00310",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「太浪费了，给我吧」",
voice: Some("li/0snsumi_0292"),
),
),
(
cmd: label,
args: (
name: "block_00311",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "一下一下地用叉子插起来吃掉了。",
