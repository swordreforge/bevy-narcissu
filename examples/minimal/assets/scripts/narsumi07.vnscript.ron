),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "狭窄的车内。握着方向盘的她和，在一旁展开地图导航的我。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00352",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "虽然从出发算起，已经过去了4个小时，但离目的地还有很远。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00353",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我说，要不要先折返一下？回到认识的路再说」",
voice: Some("li/0snsumi_0302"),
),
),
(
cmd: label,
args: (
name: "block_00354",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「事到如今？下个路口左转就没问题了」",
