),
),
(
cmd: label,
args: (
name: "block_00358",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「说到底啊，还不是因为你说想去奇怪的地方？」",
voice: Some("li/0snaka_0384"),
),
),
(
cmd: label,
args: (
name: "block_00359",
),
),
(
