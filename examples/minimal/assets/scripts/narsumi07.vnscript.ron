),
),
(
cmd: label,
args: (
name: "block_00292",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这么不清不楚的回答着。想想最后一次来家庭餐厅，还是上小学的时候。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00293",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "那时的我，不仅吃的是儿童套餐菜单也是爸爸决定的……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00294",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「我跟明吃一样的」",
voice: Some("li/0snsumi_0289"),
),
),
(
cmd: label,
args: (
name: "block_00295",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「等，等一下，别这样嘛。不觉得害羞吗」",
