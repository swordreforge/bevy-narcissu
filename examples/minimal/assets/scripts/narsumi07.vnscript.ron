),
),
(
cmd: label,
args: (
name: "block_00374",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "难得的从那个孩子手里得来了这份地图，\n但看地图的人是这种货色，也没起到什么作用。",
