            args: (
                channel: Some(2),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(3),
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(4),
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "像以前一样，她轻轻地打开了房门，我也朝里面迈出脚步。",
                voice: None,
            ),
        ),
        (
            cmd: label,
