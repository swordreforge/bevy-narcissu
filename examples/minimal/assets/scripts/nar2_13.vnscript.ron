        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…千寻。」",
                voice: Some("li/setsumi_0255"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00010",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊，濑津美…？」",
                voice: Some("li/chihiro-0129"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00011",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…我把这个，带来了。」",
                voice: Some("li/setsumi_0256"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00012",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说完，我把保管好的车钥匙转交给她。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00013",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「姬子要我转交给你的。」",
                voice: Some("li/setsumi_0257"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00014",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「这样，谢谢呢，在这么热的天气里…」",
                voice: Some("li/chihiro-0130"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00015",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "回答着收下钥匙的千寻，浮现出平常的稳重笑容。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00016",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后，从口袋取出手帕来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00017",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「啊………」",
                voice: Some("li/setsumi_0258"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00018",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "将我脸上流下的汗，温柔的拭去。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00019",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…谢谢…」",
                voice: Some("li/setsumi_0259"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00020",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那个，可以帮我传达给姐姐吗？」",
