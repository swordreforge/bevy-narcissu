        (
            cmd: label,
            args: (
                name: "block_00188",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「果然冰淇淋啊，在炎热的时候吃最棒呢。」",
                voice: Some("li/hime2_0127"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00189",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，虽然有点化了。」",
                voice: Some("li/onnanoko_0096"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00190",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "边这样谈论边享用着的我们。\n眼前的花坛中，三色堇和非洲菊正盛开着。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00191",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "前几天看见的冬用区域，也大概种植起什么了吧。",
