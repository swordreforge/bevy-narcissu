        ),
        (
            cmd: label,
            args: (
                name: "block_00214",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "说完，我再次从口袋里取出十字架来。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00215",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「唉？可以吗？我可以收下么。」",
                voice: Some("li/onnanoko_0103"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00216",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，而且我还有一个的…」",
                voice: Some("li/hime2_0136"),
