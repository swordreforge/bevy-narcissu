            args: (
                name: "block_00178",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「不过…姐姐的份呢？」",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00179",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「呼呼呼，不用担心喔。」",
