            cmd: label,
            args: (
                name: "block_00035",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "她说过星期六的时候要去特殊教育学校，而星期日则要去做协助弥撒的工作。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
