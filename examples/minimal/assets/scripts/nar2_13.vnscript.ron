            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00205",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "反正，我也只是一个信徒，只不过是效仿而已。\n理所当然的，那些句段都不可能是自己的话语。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00206",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「今天的，是谁说的呢？」",
                voice: Some("li/onnanoko_0100"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00207",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「当然是耶稣本人喔。」",
                voice: Some("li/hime2_0133"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00208",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，其他的人也有吗？」",
                voice: Some("li/onnanoko_0101"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00209",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「嗯，很伟大的圣者啊教皇啊，有很多人的句段呢。」",
                voice: Some("li/hime2_0134"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00210",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「唉～，这么多人的句段，姐姐都知道啊。」",
                voice: Some("li/onnanoko_0102"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00211",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "面对佩服着的她，我点了下头。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00212",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "全部的话是有点不太可能，不过像是福音书之类的我还是读过的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00213",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「那么，对了…这个，你想要吗？」",
                voice: Some("li/hime2_0135"),
