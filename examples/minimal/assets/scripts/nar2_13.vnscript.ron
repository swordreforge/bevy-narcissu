            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "教堂。在前几天去海边之前来过这里一次之后，我又一次来到了这里。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00005",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…不知为何，不再和千寻见面的姬子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00006",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "正确来说，大概不只是千寻而已吧。\n家人和朋友之类亲近的人，姬子也都全部回避着的样子。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00007",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因此，我代替她来到千寻的身边。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00008",
            ),
        ),
        (
            cmd: set_bg,
            args: (
                image: "black-2",
                transition: Some(fade(
                    duration: 0.8,
                )),
            ),
        ),
        (
            cmd: wait,
            args: (
                time_ms: 500,
            ),
        ),
        (
            cmd: stop_se,
            args: (
                channel: Some(1),
            ),
        ),
        (
