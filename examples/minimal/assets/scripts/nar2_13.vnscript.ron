            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "双手各拿着1个冰淇淋的她。\n一个是我的冰淇淋，另外一个是她自己的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00196",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "然后我，从口袋里将十字架取出后，像平常一样，静静地合上双手。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00197",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「正如我们饶恕了亏负我们的人…」",
                voice: Some("li/hime2_0129"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00198",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「饶恕我们对你的亏负吧…」",
                voice: Some("li/hime2_0130"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00199",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "…天主经。\n也就是所谓的主祷文。",
