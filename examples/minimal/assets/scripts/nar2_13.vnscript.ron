            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "因为流着汗，不由得扇起了裙子。\n在这盛夏中奔跑，流汗也是理所当然的。",
                voice: None,
            ),
        ),
        (
            cmd: label,
