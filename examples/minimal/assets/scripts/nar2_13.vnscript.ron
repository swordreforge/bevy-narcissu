            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00022",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「假如，有需要我的时候…」",
                voice: Some("li/chihiro-0132"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00023",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「随时都告诉我…」",
                voice: Some("li/chihiro-0133"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00024",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…嗯，我知道了。」",
                voice: Some("li/setsumi_0175"),
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00025",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "对话中，千寻，一直帮我擦拭着汗水。",
                voice: None,
            ),
        ),
        (
            cmd: label,
            args: (
                name: "block_00026",
            ),
        ),
        (
            cmd: dialogue,
            args: (
                speaker: None,
                text: "「…那么。」",
